// Coordinates System :
SetCoords(400,285.5,40,false,869,656);


// Geometry :
P1=Point("P1",-4.1,-0.3125);
P2=Point("P2",6.3,-2.1875);
P3=Point("P3",1.125,1.0625);
P6=Point("P6",-1.85,0.4125);
L1=Line("L1",P1,P2);
P4=PointOn("P4",L1,0.682187809560054);
L2=PerpendicularBisector("L2",P3,P4);
Perp1=Perpendicular("Perp1",L1,P4);
P5=OrderedIntersection("P5",Perp1,L2,0);
Locus1=Locus("Locus1",P5,P4);
M=PointOn("M",Locus1,689);
Symc1=Symmetry("Symc1",P6,M);
Locus2=Locus("Locus2",Symc1,M);


// Styles :
STL(P1,"c:#0000b2;s:6;f:30");
STL(P2,"c:#0000b2;s:6;f:30");
STL(P3,"c:#0000b2;s:6;f:30");
STL(P6,"c:#0000b2;s:6;f:30");
STL(L1,"c:#780013;s:1;f:30;p:0");
STL(P4,"c:#0000b2;s:6;f:30");
STL(L2,"c:#780013;s:1;f:30;p:0");
STL(Perp1,"c:#780013;s:1;f:30;p:0");
STL(P5,"c:#0000b2;s:6;f:30");
STL(Locus1,"c:#0b5b94;s:2.5;f:30;p:1000");
STL(M,"c:#e74405;o:1;s:9.5;sn:true;f:30");
STL(Symc1,"c:#0000b2;s:6;f:30");
STL(Locus2,"c:#8755d2;s:3;f:30;p:1000");
