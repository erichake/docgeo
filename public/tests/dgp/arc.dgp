// Coordinates System :
SetCoords(400,285.5,40,false,800,572);


// Geometry :
P1=Point("P1",-1.25,-1.0125);
P2=Point("P2",0.425,5.2875);
P3=Point("P3",4.25,2.0875);
C1=Arc3pts("C1",P1,P2,P3);
