// Coordinates System :
SetCoords(400,285.5,40,false,800,574);


// Geometry :
A=Point("A",-1.375,-1.0125);
B=Point("B",1.4,-3.6125);
C=Point("C",-2.35,3.8875);
I=Line("I",A,B);
Perp1=Perpendicular("Perp1",I,C);
Par1=Parallel("Par1",I,C);
Perp2=Perpendicular("Perp2",I,B);
H=OrderedIntersection("H",I,Perp1,0);
P1=OrderedIntersection("P1",Perp2,Par1,0);
Par2=Parallel("Par2",Perp1,A);
P2=OrderedIntersection("P2",Par2,Par1,0);


// Styles :
STL(A,"c:#0000b2;s:6;sn:true;f:30");
STL(B,"c:#0000b2;s:6;sn:true;f:30");
STL(C,"c:#0000b2;s:6;sn:true;f:30");
STL(I,"c:#780013;s:1;sn:true;f:30;p:0");
STL(Perp1,"c:#780013;s:1;f:30;p:0");
STL(Par1,"c:#780013;s:1;f:30;p:0");
STL(Perp2,"c:#780013;s:1;f:30;p:0");
STL(H,"c:#0000b2;s:6;sn:true;f:30");
STL(P1,"c:#0000b2;s:6;f:30");
STL(Par2,"c:#780013;s:1;f:30;p:0");
STL(P2,"c:#0000b2;s:6;f:30");
SetCoordsStyle("isAxis:false;isGrid:true;isOx:true;isOy:true;isLockOx:false;isLockOy:false;centerZoom:false;onlyPositive:false;color:#111111;fontSize:18;axisWidth:1;gridWidth:0.1");
SetGeneralStyle("background-color:#F8F8F8;degree:true;dragmoveable:true");
