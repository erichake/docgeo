{
    "id": "editor.html",
    "name": "DocGeo",
    "start_url": "editor.html",
    "scope": "editor",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#ffffff",
    "icons": [
        { "src": "icon_192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icon_512.png", "sizes": "512x512", "type": "image/png" },
        {
            "src": "icon_maskable_512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "file_handlers": [
        {
            "action": "editor.html",
            "accept": { "application/x-docgeo": [".dgo"] },
            "icons": [
                {
                    "src": "file_dgo.png",
                    "sizes": "512x512",
                    "type": "image/png"
                }
            ]
        },
        {
            "action": "editor.html",
            "accept": { "application/x-dgpad": [".dgp"] },
            "icons": [
                {
                    "src": "file_dgp.png",
                    "sizes": "512x512",
                    "type": "image/png"
                }
            ]
        },
        {
            "action": "editor.html",
            "accept": { "application/vnd.geogebra.file": [".ggb"] },
            "icons": [
                {
                    "src": "file_ggb.png",
                    "sizes": "512x512",
                    "type": "image/png"
                }
            ]
        }
    ]
}
