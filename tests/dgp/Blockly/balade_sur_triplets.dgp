 blockly_local_a % blockly_local_b);\n}\n\n\nblockly_var_n = parseFloat($L.number2(window.prompt(TURTLE_TEXT('entrer la longueur du cadre (en pixels)'))));\nblockly_var_count = 0;\nblockly_var_tab = [];\nfor (var blockly_var_i = 1 ; blockly_var_i <= blockly_var_n ; blockly_var_i = blockly_var_i + 1){\n  for (var blockly_var_j = Math.plus(blockly_var_i,1) ; blockly_var_j <= blockly_var_n ; blockly_var_j = blockly_var_j + 2){\n    if (gcd(blockly_var_i, blockly_var_j) == 1) {\n      blockly_var_hyp = Math.sqrt(Math.plus(Math.power(blockly_var_i,2),Math.power(blockly_var_j,2)));\n      if (blockly_var_hyp == Math.round(blockly_var_hyp)) {\n        blockly_var_elt = [];\n        blockly_var_elt.push(blockly_var_j);\n        blockly_var_elt.push(blockly_var_i);\n        blockly_var_tab.push(blockly_var_elt);\n        blockly_var_count = blockly_var_count + 1;\n      }\n    }\n  };\n};\nvar blockly_var_temp_var = blockly_var_n ;\nSET_EXP(\"n\",blockly_var_temp_var);\nvar blockly_var_temp_var2 = blockly_var_tab ;\nSET_EXP(\"T\",blockly_var_temp_var2);\nvar blockly_var_temp_var3 = blockly_var_count ;\nSET_EXP(\"COUNT\",blockly_var_temp_var3);","childs":["n","T","COUNT"]},"current":"onprogram"});
