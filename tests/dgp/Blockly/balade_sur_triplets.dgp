blk_turtle_exp_P1=Expression("blk_turtle_exp_P1","","","","var bl_ggbhdchjg=function(){\nTURTLE_INIT(\"P1\",P1);\n// Décrire cette fonction…\nfunction cadre() {\n  TURTLE_UP(false);\n  TURTLE_COLOUR(55);\n  TURTLE_MV(60,true);\n  TURTLE_TURN((90));\n  TURTLE_MV((Math.quotient(blockly_var_width,2)),true);\n  for (var blockly_var_count = 1 ; blockly_var_count <= 3 ; blockly_var_count++){\n    TURTLE_TURN(-(90));\n    TURTLE_MV(blockly_var_width,true);\n  };\n  TURTLE_TURN(-(90));\n  TURTLE_MV((Math.quotient(blockly_var_width,2)),true);\n  TURTLE_COLOUR(1);\n  TURTLE_FILL(60);\n  TURTLE_UP(true);\n  TURTLE_TURN(-(90));\n}\n\n// Décrire cette fonction…\nfunction texte() {\n   var blockly_var_pos = (TURTLE_POS());\n  TURTLE_UP(true);\n  TURTLE_COLOUR(7);\n  TURTLE_FONT('Arial',16,'bold','center');\n  TURTLE_MV(2,true);\n  TURTLE_TURN((90));\n  TURTLE_MV((Math.minus(Math.quotient(blockly_var_width,2),16)),true);\n  TURTLE_TURN(-(90));\n  TURTLE_MV((Math.quotient(blockly_var_width,2)),true);\n  TURTLE_PRINT(([blockly_var_a,TURTLE_TEXT('² + '),blockly_var_b,TURTLE_TEXT('² = '),blockly_var_c,TURTLE_TEXT('²')].join('')));\n  TURTLE_TURN(-(90));\n  TURTLE_MV(18,true);\n  TURTLE_TURN((90));\n  TURTLE_PRINT(([TURTLE_TEXT('α ≈ '),blockly_var_alpha,TURTLE_TEXT('°')].join('')));\n  TURTLE_JOIN_PT(blockly_var_pos);\n  TURTLE_RESET();\n}\n\n// Décrire cette fonction…\nfunction triangle() {\n  TURTLE_UP(true);\n  TURTLE_MV(blockly_var_margin,true);\n  TURTLE_TURN(-(90));\n  TURTLE_MV((Math.minus(Math.quotient(blockly_var_width,2),blockly_var_margin)),true);\n  TURTLE_TURN((90));\n  TURTLE_UP(false);\n   var blockly_var_pos = (TURTLE_POS());\n  TURTLE_MV((Math.minus(blockly_var_width,Math.times(2,blockly_var_margin))),true);\n  TURTLE_TURN((90));\n  TURTLE_MV((Math.times(Math.quotient(blockly_var_b,blockly_var_a),Math.minus(blockly_var_width,Math.times(2,blockly_var_margin)))),true);\n  TURTLE_JOIN_PT(blockly_var_pos);\n  TURTLE_COLOUR(18);\n  TURTLE_FILL(20);\n}\n\n\nblockly_var_width = 200;\nblockly_var_margin = 10;\nblockly_var_a = Math.round(Coordinate(\"P1\",0));\nblockly_var_b = Math.round(Coordinate(\"P1\",1));\nblockly_var_c = Math.round(Math.sqrt(Math.plus(Math.power(blockly_var_a,2),Math.power(blockly_var_b,2))));\nblockly_var_alpha = Math.atan(Math.quotient(blockly_var_b,blockly_var_a));\nblockly_var_alpha = Math.quotient(Math.round(Math.times(blockly_var_alpha,1000)),1000);\ncadre();\ntexte();\ntriangle();\nreturn TURTLE_RESULT()\n};\nbl_ggbhdchjg()","-521.9618528225074","3905.048445798523");
