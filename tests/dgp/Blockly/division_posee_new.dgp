Text("<div style=\"text-align:right;color:#FFF\"><div style=\"margin-bottom: 20px\"><span style=\"font-size:24px;display:inline-block\">Dividende :\u00a0</span><input id=\"input-box\" target=\"a\" type=\"texte\" pattern=\"[0-9]*\" onClick=\"this.setSelectionRange(0, this.value.length)\" style=\"vertical-align:middle;background-color: #555;color:#EEE;border: 0px;border-radius: 10px;outline: 0px solid transparent;text-align: center;font-size: 30px;height: 40px;width: 350px;margin-bottom:5px\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\"></div><div><span style=\"font-size:24px;display:inline-block\">Diviseur :\u00a0</span><input id=\"input-box\" target=\"b\" type=\"texte\" pattern=\"[0-9]*\" onClick=\"this.setSelectionRange(0, this.value.length)\" style=\"vertical-align:middle;background-color: #555;color:#EEE;border: 0px;border-radius: 10px;outline: 0px solid transparent;text-align: center;font-size: 30px;height: 40px;width: 350px;margin-bottom:5px\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" spellcheck=\"false\"></div></div>",0,0,554,128,"c:rgba(0,123,189,1);s:3;r:0;p:4");
