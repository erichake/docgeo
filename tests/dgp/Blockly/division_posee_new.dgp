xt></block></next></block></next></block></next></block></next></block></next></block></next></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction format(blockly_local_str) {\n  return blockly_local_str.toString().replace(/(\\d)(?=(\\d{3})+(?!\\d))/g, '$1 ');\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction tostring(blockly_local_str) {\n  return blockly_local_str.toString();\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction tonum(blockly_local_str) {\n  return parseInt(blockly_local_str);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction print2(blockly_local_str) {\n  TURTLE_PRINT(blockly_local_str);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction newline(blockly_local_x) {\n  TURTLE_TURN(-(90));\n  TURTLE_MV(blockly_local_x,false);\n  TURTLE_TURN((90));\n}\n\nfunction listsRepeat(blockly_local_value, blockly_local_n) {\n  var blockly_var_array = [];\n  for (var blockly_var_i = 0; blockly_var_i < blockly_local_n; blockly_var_i++) {\n    blockly_var_array[blockly_var_i] = blockly_local_value;\n  }\n  return blockly_var_array;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction createLine(blockly_local_n,blockly_local_ln,blockly_local_ind) {\n   var blockly_var_lne = listsRepeat(TURTLE_TEXT(''), blockly_local_ln);\n  blockly_local_n = (blockly_local_n.toString().split(\"\").reverse());\n  for (var blockly_var_j = 1 ; blockly_var_j <= blockly_local_n.length ; blockly_var_j = blockly_var_j + 1){\n    blockly_var_lne[(Math.plus(blockly_var_j,blockly_local_ind))-1] = (blockly_local_n[blockly_var_j-1]);\n  };\n  blockly_var_lne = (blockly_var_lne.reverse());\n  return blockly_var_lne;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction createMatrice() {\n   var blockly_var_LG = tostring((a)).length;\n   var blockly_var_ri = Math.times(blockly_var_r,10);\n   var blockly_var_QUO = (blockly_var_q.toString().split(\"\").reverse());\n   var blockly_var_indent = 0;\n   var blockly_var_MAT = [];\n  blockly_var_MAT.push(createLine(blockly_var_r, blockly_var_LG, 0));\n  for (var blockly_var_i = 1 ; blockly_var_i <= blockly_var_QUO.length ; blockly_var_i = blockly_var_i + 1){\n    blockly_var_ri = Math.floor(Math.quotient(blockly_var_ri,10));\n     var blockly_var_m = Math.times(tonum((blockly_var_QUO[blockly_var_i-1])),(b));\n     var blockly_var_lne = createLine(blockly_var_m, blockly_var_LG, blockly_var_indent);\n    blockly_var_MAT.push(blockly_var_lne);\n    blockly_var_ri = Math.plus(blockly_var_ri,blockly_var_m);\n    blockly_var_lne = createLine(blockly_var_ri, blockly_var_LG, blockly_var_indent);\n    blockly_var_MAT.push(blockly_var_lne);\n    blockly_var_indent = blockly_var_indent + 1;\n  };\n  blockly_var_MAT = (blockly_var_MAT.reverse());\n  blockly_var_MAT[1-1] = (createLine((a), blockly_var_LG, 0));\n  return blockly_var_MAT;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction displayMatrice(blockly_local_MAT) {\n  TURTLE_WIDTH(1e-13);\n  TURTLE_UP(true);\n  TURTLE_COLOUR(blockly_var_txtcolor);\n  TURTLE_FONT('Courier New',36,'bold','center');\n   var blockly_var_LG = (blockly_local_MAT[1-1]).length;\n  for (var blockly_var_i = 1 ; blockly_var_i <= blockly_local_MAT.length ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_COLOUR(blockly_var_txtcolor);\n     var blockly_var_lne = (blockly_local_MAT[blockly_var_i-1]);\n    for (var blockly_var_j = 1 ; blockly_var_j <= blockly_var_lne.length ; blockly_var_j = blockly_var_j + 1){\n      TURTLE_PRINT((blockly_var_lne[blockly_var_j-1]));\n      TURTLE_MV(blockly_var_spc,false);\n    };\n    TURTLE_MV(-(Math.times(blockly_var_spc,blockly_var_LG)),false);\n    if (blockly_var_i % 2 == 0) {\n      TURTLE_COLOUR(blockly_var_subcolor);\n      if (blockly_var_i != 2) {\n        blockly_var_lne = (blockly_local_MAT[(Math.minus(blockly_var_i,1))-1]);\n      }\n       var blockly_var_j = 1;\n      while ((blockly_var_lne[blockly_var_j-1]) == TURTLE_TEXT('')) {\n        blockly_var_j = blockly_var_j + 1;\n      }\n       var blockly_var_k = blockly_var_j;\n      TURTLE_MV((Math.times(Math.minus(blockly_var_j,2),blockly_var_spc)),false);\n      TURTLE_PRINT(TURTLE_TEXT('-'));\n      TURTLE_MV((Math.quotient(blockly_var_spc,2)),false);\n      TURTLE_TURN(-(90));\n      TURTLE_MV(blockly_var_vpc,false);\n      TURTLE_TURN((90));\n      TURTLE_UP(false);\n      TURTLE_WIDTH(blockly_var_stylo);\n      while (blockly_var_j <= blockly_var_lne.length && (blockly_var_lne[blockly_var_j-1]) != TURTLE_TEXT('')) {\n        TURTLE_MV(blockly_var_spc,false);\n        blockly_var_j = blockly_var_j + 1;\n      }\n      TURTLE_WIDTH(1e-13);\n      TURTLE_UP(true);\n      TURTLE_TURN((90));\n      TURTLE_MV(blockly_var_vpc,false);\n      TURTLE_TURN(-(90));\n      TURTLE_MV(-(Math.quotient(blockly_var_spc,2)),false);\n      TURTLE_MV(-(Math.times(Math.minus(blockly_var_j,2),blockly_var_spc)),false);\n    }\n    newline(1);\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction displayPotense(blockly_local_MAT) {\n  TURTLE_WIDTH(1e-13);\n  TURTLE_COLOUR(blockly_var_barcolor);\n   var blockly_var_LG = (blockly_local_MAT[1-1]).length;\n  TURTLE_JOIN_PT((Math.plus((P1),([(Math.minus(Math.times(blockly_var_LG,blockly_var_spc),Math.quotient(blockly_var_spc,2))),(Math.minus(1,blockly_var_vpc))]))));\n  TURTLE_RESET();\n  TURTLE_TURN(-(90));\n  TURTLE_UP(false);\n  TURTLE_WIDTH(blockly_var_stylo);\n  TURTLE_MV((blockly_local_MAT.length),false);\n  TURTLE_MV(-(blockly_local_MAT.length),false);\n  TURTLE_MV(1,false);\n  TURTLE_TURN((90));\n   var blockly_var_DIV = (b);\n  blockly_var_DIV = (blockly_var_DIV.toString().split(\"\"));\n   var blockly_var_QUO = (blockly_var_q.toString().split(\"\"));\n  TURTLE_MV((Math.max.apply(null, ([(blockly_var_DIV.length),(blockly_var_QUO.length)]))),false);\n  TURTLE_WIDTH(1e-13);\n  TURTLE_UP(true);\n  TURTLE_COLOUR(blockly_var_txtcolor);\n  TURTLE_JOIN_PT((Math.plus((P1),Math.times(blockly_var_LG,blockly_var_spc))));\n  TURTLE_RESET();\n  for (var blockly_var_i = 1 ; blockly_var_i <= blockly_var_DIV.length ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_PRINT((blockly_var_DIV[blockly_var_i-1]));\n    TURTLE_MV(blockly_var_spc,false);\n  };\n  TURTLE_JOIN_PT((Math.plus((P1),([(Math.times(blockly_var_LG,blockly_var_spc)),-1]))));\n  TURTLE_RESET();\n  for (var blockly_var_i = 1 ; blockly_var_i <= blockly_var_QUO.length ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_PRINT((blockly_var_QUO[blockly_var_i-1]));\n    TURTLE_MV(blockly_var_spc,false);\n  };\n}\n\n\nblockly_var_txtcolor = 55;\nblockly_var_subcolor = 68;\nblockly_var_barcolor = 41;\nblockly_var_stylo = 3;\nblockly_var_spc = 1;\nblockly_var_vpc = 0.2;\nblockly_var_q = Math.floor(Math.quotient((a),(b)));\nblockly_var_r = Math.minus((a),Math.times((b),blockly_var_q));\nblockly_var_MAT = createMatrice();\ndisplayMatrice(blockly_var_MAT);\ndisplayPotense(blockly_var_MAT);\nTURTLE_COLOUR(68);","parents":["a","b"]},"current":"onlogo"});


