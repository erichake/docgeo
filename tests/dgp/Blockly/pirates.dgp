blk_turtle_exp_P1=Expression("blk_turtle_exp_P1","","","","var bl_ccbfgcigi=function(){\nTURTLE_INIT(\"P1\",P1);\nif ((tour) % 2 == 0) {\n  blockly_var_img = (GLOBAL_GET(\"barberousse\"));\n  blockly_var_nom = TURTLE_TEXT('Barberousse');\n} else {\n  blockly_var_img = (GLOBAL_GET(\"jabuse\"));\n  blockly_var_nom = TURTLE_TEXT('Jabuse');\n}\nTURTLE_UP(true);\nTURTLE_COLOUR(13);\nTURTLE_FONT('Arial',24,'normal','right');\nTURTLE_PRINT(([TURTLE_TEXT('Il y a '),(rand),TURTLE_TEXT(' pièces d\'or dans le coffre. C\'est à '),blockly_var_nom,TURTLE_TEXT(' de jouer....')].join('')));\nTURTLE_MV(100,true);\nTURTLE_PRINT_IMG(blockly_var_img,-1,-1,0.7,1);\nreturn TURTLE_RESULT()\n};\nbl_ccbfgcigi()","-22.53244357878345","14.223962643599425");
