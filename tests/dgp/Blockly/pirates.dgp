ck></value></block></value><next><block type=\"turtle_turn\" id=\"oikFh0sZ*9ZqJjEhU~Ap\"><field name=\"DIR\">turnRight</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"B,UM1!uo.6y|Cl)hf%jJ\"><field name=\"ANGLE\">90</field></shadow></value><next><block type=\"turtle_move\" id=\"R#-VJSw[wL4)I+15Gg^X\"><field name=\"DIR\">moveForward</field><field name=\"UNITS\">px</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"O-2C_EGAMO:Rx2]bFza5\"><field name=\"NUM\">60</field></shadow><block type=\"variables_get\" id=\"tksvn7c,}`(nGt,lilYc\"><field name=\"VAR\">marge</field></block></value><next><block type=\"turtle_turn\" id=\"%79HE(s+Jhaqf^Za`GYr\"><field name=\"DIR\">turnLeft</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"kcxM`GE5VfKz%*c0|U.t\"><field name=\"ANGLE\">90</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","sync":"if ((choix) != -1) {\n  blockly_var_max = 600;\n  blockly_var_lignes = Math.quotient((rand),(choix));\n  blockly_var_marge = 65;\n  if (Math.times(blockly_var_marge,(choix)) > blockly_var_max) {\n    blockly_var_marge = Math.round(Math.quotient(blockly_var_max,(choix)));\n  }\n  if (Math.times(blockly_var_marge,Math.quotient((rand),(choix))) > blockly_var_max) {\n    blockly_var_marge = Math.round(Math.quotient(blockly_var_max,Math.quotient((rand),(choix))));\n  }\n  TURTLE_UP(true);\n  for (var blockly_var_i = 0 ; blockly_var_i <= Math.minus(blockly_var_lignes,1) ; blockly_var_i = blockly_var_i + 1){\n    for (var blockly_var_j = 1 ; blockly_var_j <= (choix) ; blockly_var_j = blockly_var_j + 1){\n      TURTLE_PRINT_IMG((GLOBAL_GET(\"pièce\")),blockly_var_marge,blockly_var_marge,1,1);\n      TURTLE_MV(blockly_var_marge,true);\n    };\n    TURTLE_MV(-(Math.times(blockly_var_marge,(choix))),true);\n    TURTLE_TURN(-(90));\n    TURTLE_MV(blockly_var_marge,true);\n    TURTLE_TURN((90));\n  };\n}","parents":["choix","rand"]},"current":"onlogo"});


