BLK_GLOB_SET({"barberousse":"data:image/png;base64,","trésor":"data:image/png;base64,","jabuse":"data:image/png;base64,","tour":0,"pièce":"data:image/png;base64,","joueur":""});


// Texts :
Text("<select style=\"text-indent:20px;padding: 5px;background: #E1E1E1 url('data:image/png;base64,') no-repeat 170px center;border:1px solid gray;border-radius:15px;text-align:center;outline:none;width:200px;-webkit-appearance: none;-moz-appearance: none;appearance: none;text-align:center;font-size:18px\" target=\"choix\" populate=\"E1\">\n        <option value=\"10\"></option>\n    </select>",310,187,246,56,"c:rgba(59,79,115,0);s:3;r:12;p:4");
Text("<div style=\"text-align:justify;font-size:22px\">Les pirates Barberousse et Jabuse ont trouv\u00e9 un coffre au tr\u00e9sor. Mais une l\u00e9gende des mers du Sud dit que celui qui prend la derni\u00e8re pi\u00e8ce du coffre sera victime de la redoutable mal\u00e9diction de Latourista !\nPar ailleurs, avant de retirer certaines pi\u00e8ces du coffre, il faut pouvoir ranger les pi\u00e8ces ligne par ligne et ne retirer qu'une ligne enti\u00e8re de pi\u00e8ces.</div>",193,-1,709,123,"c:rgba(59,79,115,0);s:3;r:15;p:4");
