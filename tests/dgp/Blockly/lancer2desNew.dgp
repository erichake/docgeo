" id=\"XGV8gAtAo(%V11%EwZv{\"><value name=\"VALUE\"><shadow type=\"dgpad_get_point_short_turtle\" id=\"KKJd8Wfuy)ko-b{Mpss1\"><field name=\"NAME\">P3</field></shadow></value><next><block type=\"turtle_reset_angles\" id=\"6::a4RrhQSn4djq#[h+v\"><next><block type=\"turtle_move\" id=\"9t}{/LRk?SiO#8)Gpg=[\"><field name=\"DIR\">moveBackward</field><field name=\"UNITS\">px</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"0vavkxslaN)SHGdcSw.c\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"turtle_turn\" id=\"cI%7fZ|)QMAydGSAq?u=\"><field name=\"DIR\">turnRight</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"U4^@Snq`@,;Fq3^500Q@\"><field name=\"ANGLE\">90</field></shadow></value><next><block type=\"turtle_move\" id=\"UqX3n.HPJ-~x0nZ%b|-;\"><field name=\"DIR\">moveForward</field><field name=\"UNITS\">px</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"jw6JX)1pk5iHDzwerlQZ\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"turtle_turn\" id=\"1nk`W8FuJP;0?jaByOZc\"><field name=\"DIR\">turnLeft</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"i=B:(f^T|WSKn_wI|SV)\"><field name=\"ANGLE\">90</field></shadow></value><next><block type=\"turtle_font\" id=\"MX4!3^*dcqh`3+g3ha3J\"><field name=\"FONT\">Georgia</field><field name=\"FONTSIZE\">30</field><field name=\"FONTSTYLE\">normal</field><field name=\"FONTALIGN\">right</field><next><block type=\"turtle_print\" id=\"8aO%ykE+0x)7J}..FL;Q\"><value name=\"TEXT\"><shadow type=\"text\" id=\"=B;sI=DzoN;MJ!Apw?=)\"><field name=\"TEXT\">20 %</field></shadow></value><next><block type=\"turtle_join_pt\" id=\"^[zWB4e=oA}-,Uq;z?2d\"><value name=\"VALUE\"><shadow type=\"dgpad_get_point_short_turtle\" id=\"VJb0kuJ#LRhNmSTvhuc,\"><field name=\"NAME\">P3</field></shadow></value><next><block type=\"turtle_reset_angles\" id=\"Ba;WTiHiRF.G~vY:ox4s\"><next><block type=\"turtle_pen\" id=\"uOM0gYby,HaS~j8.,z}%\"><field name=\"PEN\">penDown</field><next><block type=\"turtle_move\" id=\"QKxxU;9ldtPxinzMqdDe\"><field name=\"DIR\">moveForward</field><field name=\"UNITS\">un</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"T%K3Kj1AoxfIP]RTF07:\"><field name=\"NUM\">32</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type=\"procedures_callnoreturn\" id=\".unY39A;MCb(EEbK;FhH\" inline=\"true\" x=\"0\" y=\"211\"><mutation name=\"barres\"><arg name=\"largeur\"></arg><arg name=\"trou\"></arg></mutation><value name=\"ARG0\"><block type=\"math_number\" id=\"qhR,B[qMJ;.hhFKje?2,\"><field name=\"NUM\">2</field></block></value><value name=\"ARG1\"><block type=\"math_number\" id=\"pYZ`fD[l:QNMu|cLWSQv\"><field name=\"NUM\">1</field></block></value><next><block type=\"procedures_callnoreturn\" id=\"Z|o^}*HT8@J,+[FKguEd\"><mutation name=\"repère\"></mutation></block></next></block></xml>","sync":"// Décrire cette fonction…\nfunction arrondi(blockly_local_x) {\n   var blockly_var_arr = Math.quotient(Math.round(Math.times(blockly_local_x,100)),100);\n  return blockly_var_arr;\n}\n\n// Décrire cette fonction…\nfunction barres(blockly_local_largeur,blockly_local_trou) {\n  TURTLE_WIDTH(1);\n  TURTLE_COLOUR(9);\n   var blockly_var_cent = Math.times((d((P1),(P3))),5);\n   var blockly_var_tot = (GLOBAL_GET(\"tab\"))[0];\n  for (var blockly_var_i = 2 ; blockly_var_i <= 12 ; blockly_var_i = blockly_var_i + 1){\n    if (blockly_var_tot == 0) {\n       var blockly_var_ee = 0;\n       var blockly_var_h = 0;\n       var blockly_var_pc = 0;\n    } else {\n      blockly_var_ee = (GLOBAL_GET(\"tab\"))[blockly_var_i - 1];\n      blockly_var_h = Math.times(Math.quotient(blockly_var_ee,blockly_var_tot),blockly_var_cent);\n      blockly_var_pc = arrondi(Math.times(Math.quotient(blockly_var_ee,blockly_var_tot),100));\n    }\n     var blockly_var_dl = Math.quotient(blockly_local_largeur,2);\n    TURTLE_UP(false);\n    TURTLE_MV(blockly_local_largeur,false);\n    TURTLE_TURN((90));\n    TURTLE_MV(blockly_var_h,false);\n    TURTLE_TURN((90));\n    TURTLE_MV(blockly_var_dl,false);\n    TURTLE_TURN(-(90));\n    TURTLE_WIDTH(1e-13);\n    TURTLE_MV(5,true);\n    TURTLE_TURN(-(90));\n    TURTLE_FONT('Trebuchet MS',16,'bold','center');\n    TURTLE_PRINT((String(blockly_var_pc) + String(' %')));\n    TURTLE_FONT('Arial',24,'normal','center');\n    TURTLE_TURN(-(90));\n    TURTLE_MV(5,true);\n    TURTLE_WIDTH(1);\n    TURTLE_TURN(-(90));\n    TURTLE_MV(blockly_var_dl,false);\n    TURTLE_TURN((90));\n    TURTLE_MV(blockly_var_h,false);\n    TURTLE_TURN((90));\n    TURTLE_FILL(30);\n    TURTLE_UP(true);\n    TURTLE_TURN(-(90));\n    TURTLE_MV(30,true);\n    TURTLE_TURN((90));\n    TURTLE_MV(blockly_var_dl,false);\n    TURTLE_PRINT(blockly_var_i);\n    TURTLE_MV((Math.plus(blockly_var_dl,blockly_local_trou)),false);\n    TURTLE_TURN((90));\n    TURTLE_MV(30,true);\n    TURTLE_TURN(-(90));\n    TURTLE_COLOUR_INCREMENT(8);\n  };\n}\n\n// Décrire cette fonction…\nfunction rep_C3_A8re() {\n  TURTLE_COLOUR(5);\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((P3));\n  TURTLE_RESET();\n  TURTLE_MV(-10,true);\n  TURTLE_TURN(-(90));\n  TURTLE_MV(10,true);\n  TURTLE_TURN((90));\n  TURTLE_FONT('Georgia',30,'normal','right');\n  TURTLE_PRINT('20 %');\n  TURTLE_JOIN_PT((P3));\n  TURTLE_RESET();\n  TURTLE_UP(false);\n  TURTLE_MV(32,false);\n}\n\n\n// Pour forcer la tortue a être actualisée à chaque changement de compteur.\nblockly_var_bid = (cpt);\n\nbarres(2, 1);\nrep_C3_A8re();","parents":["cpt","P3"]},"current":"onlogo"});
