// Coordinates System :
SetCoords(393.4662242621613,537.5427728608196,28.47561218251801,false,859,650);


// Geometry :
A=Point("A","[0,0]","0");
B=Point("B","A+14","0");
S1=Segment("S1",A,B);
M=PointOn("M",S1,0.2857142857142857);
C1=Circle("C1",A,M);
C2=Circle("C2",M,A);
Perp1=Perpendicular("Perp1",S1,M);
C3=Circle("C3",M,B);
S4=Segment("S4",M,B);
S8=Segment("S8",M,A);
P4=OrderedIntersection("P4",C1,C2,0);
P5=OrderedIntersection("P5",Perp1,C3,0);
E1=Expression("E1","P\u00e9rim\u00e8tre du triangle : ","","","S8*3","0.22945163376856145","17.47259267585739");
S2=Segment("S2",A,P4);
S3=Segment("S3",P4,M);
M1=MidPoint("M1",P5,B);
S7=Segment("S7",P5,M);
Symc1=Symmetry("Symc1",M1,M);
S5=Segment("S5",B,Symc1);
S6=Segment("S6",Symc1,P5);
E2=Expression("E2","P\u00e9rim\u00e8tre du carr\u00e9 : ","","","S6*4","0.22945163376856145","16.067881874782596");


// Styles :
STL(A,"c:#0000b2;s:6;sn:true;f:30;np:3.482480603803169");
