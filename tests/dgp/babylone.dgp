Text("<p style=\"font-size:24px;text-align:center\">$\\sqrt{%a%}\\approx%sqrt(a)%$</p><p style=\"font-size:22px;text-align:left\"><span style=\"color:#75000F\">$Longueur=\\frac{%E2[0][0]%}{%E2[0][1]%}\\approx%E2[0][0]/E2[0][1]%$</span>\n<span style=\"color:#0000B2\">\n$Largeur=\\frac{%E2[1][0]%}{%E2[1][1]%}\\approx%E2[1][0]/E2[1][1]%$</span></p><p style=\"font-size:24px;text-align:center\">Erreur : %abs(sqrt(a)-E2[0][0]/E2[0][1])%\n</p>",418,106,569,264,"c:rgba(59,79,115,0.18);s:3;r:15;p:13");
