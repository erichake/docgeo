// Coordinates System :
SetCoords(400,285.5,40,false,800,572);


// Geometry :
P1=Point("P1",-0.4,0.3875);
P3=Point("P3",2.2,0.8375);
C1=Circle1("C1",P1,4.285148772213166);
P2=PointOn("P2",C1,1.4073903124117024);
L1=Line("L1",P1,P2);
L2=PerpendicularBisector("L2",P2,P3);
P4=OrderedIntersection("P4",L2,L1,0);
Locus1=Locus("Locus1",P4,P2);


// Styles :
STL(P1,"c:#0000b2;s:6;f:30");
STL(P3,"c:#0000b2;s:6;f:30");
