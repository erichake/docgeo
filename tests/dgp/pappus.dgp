// Macros :
$macros={};
$macros["CoordBary3exp"]={
	name:"CoordBary 3 exp",
	parameters:["point","point","point","line","line","line","expression","point","point"],
	exec:
	function (I,J,K,L2,L1,L3,mIJ,A,P1){
mIJ=Expression("mIJ","","","","x(K)-x(J)","-14.11438957919402","11.250041357232451");
Par1=Parallel("Par1",L2,A);
Par2=Parallel("Par2",L3,A);
Ua=OrderedIntersection("Ua",Par1,L1,0);
Va=OrderedIntersection("Va",Par2,L1,0);
xA=ExpressionOn("xA","","","","(x(Va)-x(Ua))/mIJ",P1,[30,-30]);
yA=ExpressionOn("yA","","","","(x(K)-x(Va))/mIJ",P1,[30,0]);
zA=ExpressionOn("zA","","","","(x(Ua)-x(J))/mIJ",P1,[30,30]);
STL(xA,"c:#126b31;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(yA,"c:#015175;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(zA,"c:#44324c;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [xA,yA,zA];
}};

$macros["CoordBary3pts"]={
	name:"CoordBary3pts",
	parameters:["point","point","point","line","line","line","expression","point","point","point","point"],
	exec:
	function (I,J,K,L2,L1,L3,mIJ,P1,A,B,C){
Par22=Parallel("Par22",L3,C);
Par12=Parallel("Par12",L2,C);
Par2=Parallel("Par2",L3,A);
Par11=Parallel("Par11",L2,B);
Par1=Parallel("Par1",L2,A);
Par21=Parallel("Par21",L3,B);
Ua2=OrderedIntersection("Ua2",Par12,L1,0);
Ua=OrderedIntersection("Ua",Par1,L1,0);
Va1=OrderedIntersection("Va1",Par21,L1,0);
Ua1=OrderedIntersection("Ua1",Par11,L1,0);
Va2=OrderedIntersection("Va2",Par22,L1,0);
Va=OrderedIntersection("Va",Par2,L1,0);
xB=ExpressionOn("xB","","","","(x(Va1)-x(Ua1))/mIJ",P1,[175,-30]);
zB=ExpressionOn("zB","","","","(x(Ua1)-x(J))/mIJ",P1,[175,30]);
zA=ExpressionOn("zA","","","","(x(Ua)-x(J))/mIJ",P1,[30,30]);
yB=ExpressionOn("yB","","","","(x(K)-x(Va1))/mIJ",P1,[175,0]);
xC=ExpressionOn("xC","","","","(x(Va2)-x(Ua2))/mIJ",P1,[320,-30]);
xA=ExpressionOn("xA","","","","(x(Va)-x(Ua))/mIJ",P1,[30,-30]);
yC=ExpressionOn("yC","","","","(x(K)-x(Va2))/mIJ",P1,[320,0]);
yA=ExpressionOn("yA","","","","(x(K)-x(Va))/mIJ",P1,[30,0]);
zC=ExpressionOn("zC","","","","(x(Ua2)-x(J))/mIJ",P1,[320,30]);
STL(xB,"c:#126b31;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(zB,"c:#44324c;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(zA,"c:#44324c;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(yB,"c:#015175;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(xC,"c:#126b31;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(xA,"c:#126b31;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(yC,"c:#015175;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(yA,"c:#015175;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(zC,"c:#44324c;s:7;sn:true;f:17;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [xB,zB,zA,yB,xC,xA,yC,yA,zC];
}};

$macros["InterCalc"]={
	name:"Inter Calc",
	parameters:["expression","expression","expression","expression","expression","expression","expression","expression","expression","expression","expression","expression","point"],
	exec:
	function (xA,yA,zA,xB1,yB1,zB1,xB,yB,zB,xA1,yA1,zA1,P3){
yM=ExpressionOn("yM","yM calc = ","","","(xA*yB1-xB1*yA)*(yB*zA1-yA1*zB)-(xB*yA1-xA1*yB)*(yA*zB1-yB1*zA)",P3,[30,10]);
xM=ExpressionOn("xM","xM calc = ","","","(xB*yA1-xA1*yB)*(xB1*zA-xA*zB1)-(xA*yB1-xB1*yA)*(xA1*zB-xB*zA1)",P3,[30,-30]);
zM=ExpressionOn("zM","zM calc = ","","","(xA1*zB-xB*zA1)*(yA*zB1-yB1*zA)-(yB*zA1-yA1*zB)*(xB1*zA-xA*zB1)",P3,[30,50]);
STL(yM,"c:#802224;s:7;f:16;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(xM,"c:#775a5c;s:7;sn:true;f:16;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(zM,"c:#457b4d;s:7;f:16;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [xM,yM,zM];
}};

$macros["Mixte3pts"]={
	name:"Mixte 3pts",
	parameters:["expression","expression","expression","expression","expression","expression","expression","expression","expression"],
	exec:
	function (xA,yA,zA,xB,yB,zB,xC,yC,zC){
ABC=Expression("ABC","","","","xA*yB*zC+xB*yC*zA+xC*yA*zB-xC*yB*zA-xB*yA*zC-xA*yC*zB","-14.15478525005769","-4.451950710112971");
STL(ABC,"c:#7c0025;s:7;sn:true;f:14;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [ABC];
}};

