field><value name=\"A\"><block type=\"variables_get\" id=\"4][zkVCrlD(l-(g~{Z](\"><field name=\"VAR\">i</field></block></value><value name=\"B\"><block type=\"dgpad_get_object_short\" id=\")-!7nW_w`YgTCx_@)cF~\"><field name=\"NAME\">n</field></block></value></block></value></block></value><next><block type=\"dgpad_push\" id=\"4;{q]S^zq|qXmBjSP]^L\"><field name=\"VARNAME\">LaCourbe</field><value name=\"NAME\"><block type=\"dgpad_pt3d\" id=\"MpzGV4naJ(9sMa=9J3#Y\"><value name=\"a0\"><block type=\"dgpad_expression_input\" id=\"paKhJ}?Iej8)I^T/%,4I\"><field name=\"NAME\">f(blockly_var_tLoc)</field></block></value><value name=\"a1\"><block type=\"dgpad_expression_input\" id=\"-80vW3ZJhwoeAf54cRRB\"><field name=\"NAME\">g(blockly_var_tLoc)</field></block></value><value name=\"a2\"><block type=\"dgpad_expression_input\" id=\",Je%K:=rx^yvu8f%|a)c\"><field name=\"NAME\">h(blockly_var_tLoc)</field></block></value></block></value></block></next></block></statement><next><block type=\"dgpad_return\" id=\"rh5#5OE4Y4Z`.Lj.W)sa\"><value name=\"NAME\"><block type=\"variables_get\" id=\"2,@w8}N3Am{^baD{;6QW\"><field name=\"VAR\">LaCourbe</field></block></value></block></next></block></next></block></next></block></xml>","sync":"blockly_var_LaCourbe = [];\nblockly_var_taille = Math.ceil(Math.times((n),Math.minus((tmax),(tmin))));\nfor (var blockly_var_i = 1 ; blockly_var_i <= blockly_var_taille ; blockly_var_i = blockly_var_i + 1){\n  blockly_var_tLoc = Math.plus((tmin),Math.quotient(blockly_var_i,(n)));\n  blockly_var_LaCourbe.push([(f(blockly_var_tLoc)),(g(blockly_var_tLoc)),(h(blockly_var_tLoc))]);\n};\nreturn (blockly_var_LaCourbe);","parents":["n","tmax","tmin"]},"current":"oncompute"});


// Texts :
Text("<span style=\"color:#0000FF\">$Rep\\grave{e}re \\;  de \\; Serret-Frenet$\n<span style=\"color:#FF0000\">$M(t)=(x(t),y(t), z(t))$\n<span style=\"color:#0000FF\">\n$x(t)$ = <input target=\"f\">\n$y(t)$ = <input target=\"g\">\n$z(t)$ = <input target=\"h\">\n<span style=\"color:#FF0000\">\n$t_{min}$ = <input target=\"tmin\">\n$t_{max}$ = <input target=\"tmax\">\n<div style='font-size:14px;color:#AA3300;text-align:left'>\nCacher : \nLe rep\u00e8re <input type=checkbox target=\"cachRep\">  T <input type=checkbox target=\"cachT\">   N <input type=checkbox target=\"cachN\">   B <input type=checkbox target=\"cachB\">\nPlan osculateur  <input type=checkbox target=\"cachPlan\">\nCercle osculateur  <input type=checkbox target=\"cachCercle\">  Son centre  <input type=checkbox target=\"cachCtr\">\nLa sph\u00e8re osculatrice <input type=checkbox target=\"cachSph\"><div style='font-size:14px;color:#3366CC;text-align:left'>\nSph\u00e8re en pointill\u00e9  <input type=checkbox target=\"ptSph\">",20,65,275,364,"c:rgba(113,202,246,0.18);s:3;r:15;p:4");
Text("<div style='font-size:14px;color:#0000FF;text-align:left'>Donn\u00e9es du point courant de la courbe\n<div style='font-size:14px;color:#FF0000;text-align:left'>\n$M$ $(%M[0]% \\; ; \\; %M[1]% \\; ; \\; %M[2]%)$\n\n<div style='font-size:14px;color:#0000FF;text-align:left'>$Courbure = %c%$\n$Rayon \\; de \\; courbure = %1/c%$\n$Rayon \\; de \\; la \\; sph\\grave{e}re$ \n$osculatrice \\; = \\;  %Rso%$",18,454,270,174,"c:rgba(240,237,57,0.18);s:3;r:15;p:3");
