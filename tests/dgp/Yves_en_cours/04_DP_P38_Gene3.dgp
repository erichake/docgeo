// Macros :
$macros={};
$macros["CercleHypCtrPt"]={
	name:"Cercle Hyp Ctr Pt",
	parameters:["circle","point","point"],
	exec:
	function (Hz,O,A){
OHz=Center("OHz",Hz);
mInvO=Point("mInvO","(OHz+(O-OHz)*Hz^2/d(OHz,O)^2+O)/2","0");
mAA=Point("mAA","(mInvO+(A-mInvO)*d(mInvO,O)^2/d(mInvO,A)^2+A)/2","0");
L2=Line("L2",mInvO,A);
L1=Line("L1",OHz,mInvO);
Perp1=Perpendicular("Perp1",L2,mAA);
P1=OrderedIntersection("P1",L1,Perp1,0);
chOA=Circle("chOA",P1,A);
STL(chOA,"c:#b40000;s:2;sn:true;f:30;p:0");
return [chOA];
}};

$macros["DroiteHyper"]={
	name:"Droite Hyper",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
IdA=Point("IdA","[(2*c1^2*x(oAB)^2+2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2-2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*c1^2*x(oAB)^2-2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2+2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P2=Point("P2","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
C1=Arc3pts("C1",IdA,P2,IdB);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

$macros["Inverse1pt"]={
	name:"Inverse 1pt",
	parameters:["circle","point"],
	exec:
	function (C1,M){
Aa=DefinitionPoint("Aa",C1,0);
Oo=Center("Oo",C1);
P1=Point("P1","Oo+(M-Oo)*d(Oo,Aa)^2/d(Oo,M)^2","0");
STL(P1,"c:#0000b2;s:6;f:30");
return [P1];
}};

$macros["PerpHyper"]={
	name:"PerpHyper",
	parameters:["circle","circle","point"],
	exec:
	function (c1,C1,P){
OHz=Center("OHz",c1);
mPC1=Point("mPC1","(OHz+(P-OHz)*c1^2/d(OHz,P)^2+P)/2","0");
IdA=DefinitionPoint("IdA",C1,0);
L1=Line("L1",OHz,mPC1);
Perp1=Perpendicular("Perp1",L1,mPC1);
CtrAB=Center("CtrAB",C1);
mPAB=Point("mPAB","(CtrAB+(P-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P)^2+P)/2","0");
L2=Line("L2",CtrAB,P);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P);
R1=Ray("R1",P1,mPAB);
P4=OrderedIntersection("P4",R1,C2,0);
P5=OrderedIntersection("P5",C2,c1,1);
P6=OrderedIntersection("P6",C2,c1,0);
Hperp=Arc3pts("Hperp",P5,P4,P6);
STL(Hperp,"c:#007c00;s:2;sn:true;f:30;p:0");
return [Hperp];
}};

$macros["Segmenthyper"]={
	name:"Segment hyper",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
P2=Point("P2","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
C1=Arc3pts("C1",A,P2,B);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

