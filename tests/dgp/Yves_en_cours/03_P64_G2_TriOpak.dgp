// Macros :
$macros={};
$macros["DroiteHyper"]={
	name:"Droite Hyper",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
IdA=Point("IdA","[(2*c1^2*x(oAB)^2+2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2-2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*c1^2*x(oAB)^2-2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2+2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P2=Point("P2","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
C1=Arc3pts("C1",IdA,P2,IdB);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

$macros["HEXABleu"]={
	name:"HEXA Bleu",
	parameters:["circle","point","point","point","point","point","point"],
	exec:
	function(Hz,M,N,P,Q,R,S){
E1=Expression("E1","","","","var nmax=10;var tab=[]; var Rhz=Hz;function Ctr(dep,arr) {return [(arr[1]*(dep[0]*dep[0]+dep[1]*dep[1]+Rhz*Rhz)-dep[1]*(arr[0]*arr[0]+arr[1]*arr[1]+Rhz*Rhz))/(2*(dep[0]*arr[1]-arr[0]*dep[1])),(dep[0]*(arr[0]*arr[0]+arr[1]*arr[1]+Rhz*Rhz)-arr[0]*(dep[0]*dep[0]+dep[1]*dep[1]+Rhz*Rhz))/(2*(dep[0]*arr[1]-arr[0]*dep[1]))]};function UnSeg(dep,arr) {var LeCtr=Ctr(dep,arr);var r=sqrt((LeCtr[0]-dep[0])*(LeCtr[0]-dep[0])+(LeCtr[1]-dep[1])*(LeCtr[1]-dep[1])); for (var i=0;i<=nmax;i++){var Si = [dep[0] +i*(arr[0]-dep[0])/nmax,dep[1]+i*(arr[1]-dep[1])/nmax];var Ri=sqrt((LeCtr[0]-Si[0])*(LeCtr[0]-Si[0])+(LeCtr[1]-Si[1])*(LeCtr[1]-Si[1]));var Mi=[LeCtr[0]+(Si[0]-LeCtr[0])*r/Ri,LeCtr[1]+(Si[1]-LeCtr[1])*r/Ri];tab.push(Mi);}};UnSeg(M,N);UnSeg(N,P);UnSeg(P,Q);UnSeg(Q,R);UnSeg(R,S);UnSeg(S,M);tab","-3.662202959262218","1.6674140765010221");
List1=List("List1",E1);
STL(List1,"c:#0024ff;o:0.13;s:0;f:30;p:0;sg:0.4");
return [List1];
}};

