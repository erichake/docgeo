// Macros :
$macros={};
$macros["HDroiteparPQF"]={
	name:"H Droite par P Q F",
	parameters:["point","point","point"],
	exec:
	function(Ph,Ph2,F){
C2=Circle3pts("C2",Ph,Ph2,F);
mPhPh2=MidPoint("mPhPh2",Ph,Ph2);
CtrPhPh2=Center("CtrPhPh2",C2);
ExPh=Symmetry("ExPh",Ph,mPhPh2);
ExPh2=Symmetry("ExPh2",Ph2,mPhPh2);
mPh2arc=Point("mPh2arc","CtrPhPh2+(mPhPh2-CtrPhPh2)*d(CtrPhPh2,F)/d(CtrPhPh2,mPhPh2)","0");
R3=Ray("R3",Ph,ExPh);
R4=Ray("R4",Ph2,ExPh2);
C3=Arc3pts("C3",Ph,mPh2arc,Ph2);
STL(R3,"c:#0024ff;s:1;f:30;p:0");
STL(R4,"c:#0024ff;s:1;f:30;p:0");
STL(C3,"c:#0024ff;s:1;f:30;p:0");
return [R3,R4,C3];
}};

