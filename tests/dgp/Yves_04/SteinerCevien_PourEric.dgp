// Macros :
$macros={};
$macros["Cnk1P2PT"]={
	name:"Cnk 1P 2PT",
	parameters:["point","point","line","point","line"],
	exec:
	function (C,AB1,L1,A1B,L2){
L6=Line("L6",A1B,C);
L8=Line("L8",C,AB1);
P=OrderedIntersection("P",L1,L2,0);
C1=Circle("C1",P,A1B);
P4=PointOn("P4",C1,3.1229568473857423);
L5=Line("L5",P4,P);
Q=OrderedIntersection("Q",L6,L5,0);
R=OrderedIntersection("R",L8,L5,0);
L7=Line("L7",AB1,Q);
L9=Line("L9",A1B,R);
P3=OrderedIntersection("P3",L7,L9,0);
Locus1=Locus("Locus1",P3,P4);
return [Locus1];
}};

$macros["Cnk1T2PT"]={
	name:"Cnk 1T 2PT",
	parameters:["line","point","line","point","line"],
	exec:
	function (L3,AB1,L1,A1B,L2){
P=OrderedIntersection("P",L1,L2,0);
P5=OrderedIntersection("P5",L2,L3,0);
P6=OrderedIntersection("P6",L1,L3,0);
P9=OrderedIntersection("P9",L1,L2,0);
L4=Line("L4",P5,AB1);
L5=Line("L5",A1B,P6);
C1=Circle("C1",P9,A1B);
P7=OrderedIntersection("P7",L4,L5,0);
P41=PointOn("P41",C1,3.1229568473857423);
L6=Line("L6",P,P7);
L51=Line("L51",P41,P9);
P8=OrderedIntersection("P8",L3,L6,0);
L61=Line("L61",A1B,P8);
L8=Line("L8",P8,AB1);
Q=OrderedIntersection("Q",L61,L51,0);
R=OrderedIntersection("R",L8,L51,0);
L7=Line("L7",AB1,Q);
L9=Line("L9",A1B,R);
P31=OrderedIntersection("P31",L7,L9,0);
Locus1=Locus("Locus1",P31,P41);
return [Locus1];
}};

$macros["Cnk3P1PT"]={
	name:"Cnk 3P 1PT",
	parameters:["point","point","point","point","line"],
	exec:
	function (AB1, A1, B, C, L1) {
L2=Line("L2",B,A1);
L3=Line("L3",A1,C);
L4=Line("L4",AB1,C);
P=OrderedIntersection("P",L1,L2,0);
C1=Circle1("C1",P,86.15121390934696);
P1=PointOn("P1",C1,2.0810057325125095);
L5=Line("L5",P1,P);
Q=OrderedIntersection("Q",L4,L5,0);
P3=OrderedIntersection("P3",L3,L5,0);
L6=Line("L6",B,Q);
L7=Line("L7",AB1,P3);
P4=OrderedIntersection("P4",L6,L7,0);
Locus1=Locus("Locus1",P4,P1);
return [Locus1];
}};

$macros["Cnk5P"]={
	name:"Cnk 5P",
	parameters:["point","point","point","point","point"],
	exec:
	function (P1,P2,P3,P4,P5){
C1=Circle("C1",P1,P2);
L2=Line("L2",P3,P4);
L3=Line("L3",P1,P2);
L4=Line("L4",P4,P5);
L5=Line("L5",P2,P3);
P6=PointOn("P6",C1,4.351552197351599);
P8=OrderedIntersection("P8",L3,L4,0);
L1=Line("L1",P1,P6);
P7=OrderedIntersection("P7",L2,L1,0);
L6=Line("L6",P8,P7);
P9=OrderedIntersection("P9",L5,L6,0);
L7=Line("L7",P9,P5);
P10=OrderedIntersection("P10",L1,L7,0);
Locus1=Locus("Locus1",P10,P6);
return [Locus1];
}};

