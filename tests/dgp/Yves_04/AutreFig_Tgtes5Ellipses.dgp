$macros["CnkParExp"]={
	name:"CnkParExp",
	parameters:["expression"],
	exec:
	function(expCnkA){
A1=Point("A1","expCnkA[0]","0");
A2=Point("A2","expCnkA[1]","0");
A3=Point("A3","expCnkA[2]","0");
A4=Point("A4","expCnkA[3]","0");
A5=Point("A5","expCnkA[4]","0");
Quad=Quadric("Quad",A1,A2,A3,A4,A5);
STL(Quad,"c:#18daea;o:0.06;s:1.5;f:30;p:500");
return [Quad];
}};

