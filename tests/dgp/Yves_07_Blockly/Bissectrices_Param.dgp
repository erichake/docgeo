blk_turtle_exp_A=Expression("blk_turtle_exp_A","","","","var bl_ecfecjfic=function(){\nTURTLE_INIT(\"A\",A);\n// Décrire cette fonction…\nfunction Bissectrice(blockly_local_Sommet,blockly_local_adj1,blockly_local_adj2) {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT(blockly_local_Sommet);\n  TURTLE_ROTATE_PT(blockly_local_adj1);\n  TURTLE_UP(false);\n  TURTLE_COLOUR(53);\n  TURTLE_WIDTH(1);\n  TURTLE_MV((d(blockly_local_Sommet,blockly_local_adj2)),false);\n  TURTLE_ROTATE_PT(blockly_local_adj2);\n  TURTLE_MV((Math.quotient((d((TURTLE_POS()),blockly_local_adj2)),2)),false);\n  TURTLE_COLOUR(10);\n  TURTLE_WIDTH(2);\n  TURTLE_JOIN_PT(blockly_local_Sommet);\n}\n\n\nBissectrice((A), (B), (C));\nBissectrice((B), (C), (A));\nBissectrice((C), (A), (B));\nreturn TURTLE_RESULT()\n};\nbl_ecfecjfic()","-23.929647532099594","7.4548856564224995");
