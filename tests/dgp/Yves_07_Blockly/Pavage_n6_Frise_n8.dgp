blk_turtle_exp_P1=Expression("blk_turtle_exp_P1","","","","var bl_gggfaecad=function(){\nTURTLE_INIT(\"P1\",P1);\n// Décrire cette fonction…\nfunction Cas6ou8() {\n  if ((n) == 6) {\n     var blockly_var_pas = 1;\n  } else {\n    blockly_var_pas = 2;\n  }\n  for (var blockly_var_i = 0 ; blockly_var_i <= Math.minus((n),1) ; blockly_var_i = blockly_var_i + blockly_var_pas){\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT((P1));\n    TURTLE_ROTATE_PT((P2));\n    TURTLE_TURN(-(Math.quotient(Math.times(360,blockly_var_i),(n))));\n    TURTLE_MV((Math.times(2,(GLOBAL_GET(\"AB\")))),false);\n    if ((n) == 6) {\n      TURTLE_TURN((60));\n    } else {\n      TURTLE_TURN((45));\n    }\n    TURTLE_MV((Math.times(2,(GLOBAL_GET(\"AB\")))),false);\n    if ((n) == 8) {\n      TURTLE_TURN((45));\n      TURTLE_MV((Math.times(2,(GLOBAL_GET(\"AB\")))),false);\n    }\n    TURTLE_UP(false);\n    RotationFigure();\n  };\n}\n\n// Décrire cette fonction…\nfunction RotationFigure() {\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= (n) ; blockly_var_count2++){\n    TURTLE_TURN((Math.quotient(360,(n))));\n    for (var blockly_var_count = 1 ; blockly_var_count <= (n) ; blockly_var_count++){\n      TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n      TURTLE_TURN((Math.quotient(360,(n))));\n    };\n  };\n}\n\n\nTURTLE_COLOUR(53);\nGLOBAL_SET(\"AB\",(d((P1),(P2))));\nTURTLE_ROTATE_PT((P2));\nRotationFigure();\nCas6ou8();\nreturn TURTLE_RESULT()\n};\nbl_gggfaecad()","-19.858732714367466","7.216781797449542");
