Text("<span style=\"color:#0000FF\">$Rep\\grave{e}re \\;  de \\; Serret-Frenet$\n\n<span style=\"color:#FF0000\">$M(t)=(x(t),y(t), z(t))$\n<span style=\"color:#0000FF\">\n$x(t)$ = <input target=\"f\">\n$y(t)$ = <input target=\"g\">\n$z(t)$ = <input target=\"h\"><span style=\"color:#FF0000\">\n\n$t_{min}$ = <input target=\"tmin\">\n$t_{max}$ = <input target=\"tmax\">\n<div style='font-size:14px;color:#AA3300;text-align:left'>\nCacher : \nLe rep\u00e8re <input type=checkbox target=\"cachRep\">  T <input type=checkbox target=\"cachT\">   N <input type=checkbox target=\"cachN\">   B <input type=checkbox target=\"cachB\">\nPlan osculateur  <input type=checkbox target=\"cachPlan\">\nCercle osculateur  <input type=checkbox target=\"cachCercle\">  Son centre  <input type=checkbox target=\"cachCtr\">",12,75,278,336,"c:rgba(113,202,246,0.18);s:3;r:15;p:4");
Text("<div style='font-size:14px;color:#0000FF;text-align:left'>Donn\u00e9es du point courant de la courbe\n<div style='font-size:14px;color:#FF0000;text-align:left'>\n$M$ $(%M[0]% \\; ; \\; %M[1]% \\; ; \\; %M[2]%)$\n\n<div style='font-size:14px;color:#0000FF;text-align:left'>$Courbure = %c%$\n$Rayon \\; de \\; courbure = %1/c%$",9,485,268,127,"c:rgba(240,237,57,0.18);s:3;r:15;p:3");
