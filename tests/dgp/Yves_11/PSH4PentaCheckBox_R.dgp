Text("<div style='font-size:14px;color:#0000FF;text-align:left'>\nD\u00e9cocher la case \npour d\u00e9sactiver\nles restrictions\n\nActiver Restriction <input type=checkbox target=\"ActivRes\"> ",24,702,177,128,"c:rgba(242,255,69,0.18);s:3;r:15;p:4");
Text("<div style='font-size:18px;color:#CC0000;text-align:center'>PSH - 4 Pentagones orthogonaux<div style='font-size:14px;color:#FF0000;text-align:left'>\nCacher : <div style='color:#0000FF'>Le rep\u00e8re <input type=checkbox target=\"ChRep\">    La latitude du centre <input type=checkbox target=\"ChAlt\">\nLes fronti\u00e8res de la feuille principale <input type=checkbox target=\"ChFr\">\nLes noms <input type=checkbox target=\"ChNoms\">    Les points <input type=checkbox target=\"ChPts\">\nLes pentagones \nVert <input type=checkbox target=\"PentaVert\"> Bleu <input type=checkbox target=\"PentaBleu\"> Rose <input type=checkbox target=\"PentaRose\"> Rouge <input type=checkbox target=\"PentaRouge\">\n\n",500,14,316,162,"c:rgba(246,249,114,0.18);s:3;r:15;p:4");
