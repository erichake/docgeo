// Macros :
$macros={};
$macros["DivHoptABCD"]={
	name:"DivH opt ABC D",
	parameters:["point","point","point"],
	exec:
	function(A,B,C){
D=Point("D","[(2*x(A)*x(B)-x(C)*(x(A)+x(B)))/(x(A)+x(B)-2*x(C)),(2*y(A)*y(B)-y(C)*(y(A)+y(B)))/(y(A)+y(B)-2*y(C))]","0");
STL(D,"c:#fc092f;s:6;sn:true;f:30;sp:2");
return [D];
}};

$macros["KBKBsurPSHLesCoefgOdlPtkb"]={
	name:"KB/KB sur PSH LesCoef g Odl Ptkb",
	parameters:["expression","expression","point","point"],
	exec:
	function(LesCoef,g,Odl,Ptkb){
longPt=Expression("longPt","","","","log((1+x(Ptkb)-x(Odl))/(1-x(Ptkb)+x(Odl)))/(2*xp)","2.25","-0.9");
uPt=Expression("uPt","","","","log((1+(y(Ptkb)-y(Odl))*(exp(LesCoef[0]*longPt)+exp(-LesCoef[0]*longPt))/2)/(1-(y(Ptkb)-y(Odl))*(exp(LesCoef[0]*longPt)+exp(-LesCoef[0]*longPt))/2))/2","1.7","-3.3");
zSGpt=Expression("zSGpt","","","","(-0.102319*xp^4-0.0138416*xp^3-0.0870262*xp^2-0.0124497*xp-0.000789732)*uPt^5+(-0.00863112*xp^4+0.0368179*xp^3-0.159956*xp^2+0.0582975*xp+0.0133804)*uPt^3+(-0.0115381*xp^4+0.0459398*xp^3-0.071502*xp^2+0.0547965*xp+0.96737)*uPt","-1.6","-0.5");
PtS=Point("PtS","[xp*(exp(uPt)+exp(-uPt))*cos(longPt-\u03C0)/2,xp*(exp(uPt)+exp(-uPt))*sin(longPt-\u03C0)/2,g(uPt)]","1");
STL(PtS,"c:#ff8a1c;s:6;f:15;sp:2");
return [PtS];
}};

$macros["KBKBSymortho1pt"]={
	name:"KB/KB Sym ortho 1 pt",
	parameters:["point","line","circle"],
	exec:
	function (M,S1,DL){
Odl=Center("Odl",DL);
Perp1=Perpendicular("Perp1",S1,Odl);
P41=OrderedIntersection("P41",Perp1,S1,0);
P11=Point("P11","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
L2=Line("L2",M,P11);
P6=OrderedIntersection("P6",L2,S1,0);
d1=Line("d1",P11,P6);
C11=Circle("C11",P6,P11);
Perp11=Perpendicular("Perp11",d1,P6);
Perp2=Perpendicular("Perp2",d1,P11);
P42=OrderedIntersection("P42",Perp11,C11,1);
L11=Line("L11",P42,M);
P51=OrderedIntersection("P51",Perp2,L11,0);
Symc1=Symmetry("Symc1",P11,P51);
L21=Line("L21",P42,Symc1);
D=OrderedIntersection("D",L21,d1,0);
STL(D,"c:#b40000;s:6;sn:true;f:15;sp:2");
return [D];
}};

$macros["KBKBSymparDrtePoleM"]={
	name:"KB/KB Sym par Drte Pole M",
	parameters:["line","point","point"],
	exec:
	function(L1,Po,M){
L2=Line("L2",Po,M);
P3=OrderedIntersection("P3",L1,L2,0);
D=Point("D","[(2*x(Po)*x(P3)-x(M)*(x(Po)+x(P3)))/(x(Po)+x(P3)-2*x(M)),(2*y(Po)*y(P3)-y(M)*(y(Po)+y(P3)))/(y(Po)+y(P3)-2*y(M))]","0");
STL(D,"c:#fc092f;s:6;sn:true;f:15;sp:2");
return [D];
}};

$macros["Poledunedroite"]={
	name:"Pole d'une droite",
	parameters:["circle","line"],
	exec:
	function (DL,L1){
Odl=Center("Odl",DL);
Perp1=Perpendicular("Perp1",L1,Odl);
P4=OrderedIntersection("P4",Perp1,L1,0);
Pole1=Point("Pole1","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
STL(Pole1,"c:#0000b2;s:5;f:15");
return [Pole1];
}};

$macros["POrthoDLA2r4572"]={
	name:"POrtho DL A 2r45 72",
	parameters:["circle","point","expression","expression"],
	exec:
	function(DL,A,Deuxr45enO,ang72){
Odl=Center("Odl",DL);
L1=Line("L1",Odl,A);
L20=Line("L20",Odl,A);
Perp1=Perpendicular("Perp1",L1,Odl);
Perp2=Perpendicular("Perp2",L1,A);
P1=OrderedIntersection("P1",Perp1,DL,0);
P2=OrderedIntersection("P2",Perp2,DL,0);
L2=Line("L2",P1,P2);
P3=OrderedIntersection("P3",L2,L1,0);
P12=Point("P12","Odl+(P3-Odl)*DL^2/d(Odl,P3)^2","0");
L21=Line("L21",Odl,P12);
Perp21=Perpendicular("Perp21",L21,P12);
uU=OrderedIntersection("uU",Perp21,DL,0);
Perp10=Perpendicular("Perp10",Perp21,Odl);
P4=Point("P4","Odl+Deuxr45enO*(uU-Odl)","0");
P40=OrderedIntersection("P40",Perp10,Perp21,0);
Po=Point("Po","Odl+(P40-Odl)*DL^2/d(Odl,P40)^2","0");
L3=Line("L3",Po,P4);
P5=OrderedIntersection("P5",Perp21,L3,0);
Cnk=Point("Cnk","[(2*x(Po)*x(P5)-x(P4)*(x(Po)+x(P5)))/(x(Po)+x(P5)-2*x(P4)),(2*y(Po)*y(P5)-y(P4)*(y(Po)+y(P5)))/(y(Po)+y(P5)-2*y(P4))]","0");
Drt1=Line("Drt1",A,Cnk);
Syma1=Reflection("Syma1",L20,Cnk);
Perp11=Perpendicular("Perp11",Drt1,Odl);
Perp110=Perpendicular("Perp110",Drt1,A);
P41=OrderedIntersection("P41",Perp11,Drt1,0);
P11=Point("P11","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
L11=Line("L11",A,P11);
L10=Line("L10",Cnk,P11);
Perp12=Perpendicular("Perp12",L11,Odl);
P410=OrderedIntersection("P410",Perp12,L11,0);
P120=Point("P120","Odl+(P410-Odl)*DL^2/d(Odl,P410)^2","0");
C11=Circle("C11",A,P120);
Perp20=Perpendicular("Perp20",Drt1,P120);
P42=OrderedIntersection("P42",Perp110,C11,1);
L12=Line("L12",P42,Cnk);
P51=OrderedIntersection("P51",Perp20,L12,0);
Symc1=Symmetry("Symc1",P120,P51);
L211=Line("L211",P42,Symc1);
D=OrderedIntersection("D",L211,Drt1,0);
Syma2=Reflection("Syma2",L20,D);
L4=Line("L4",D,Syma1);
L22=Line("L22",Syma2,Syma1);
P=OrderedIntersection("P",L22,L10,0);
Perp13=Perpendicular("Perp13",Drt1,P);
N=OrderedIntersection("N",Perp13,Drt1,0);
M=OrderedIntersection("M",L4,Perp13,0);
L5=Line("L5",Cnk,M);
L6=Line("L6",Syma2,N);
Pt12=OrderedIntersection("Pt12",L6,L5,0);
Quad=Quadric("Quad",Syma2,D,Syma1,Pt12,Cnk);
K=PointOn("K",Quad,[0.25243703491266634,0.8101647317812711]);
L7=Line("L7",Po,K);
P6=OrderedIntersection("P6",Perp21,L7,0);
sK=Point("sK","[(2*x(Po)*x(P6)-x(K)*(x(Po)+x(P6)))/(x(Po)+x(P6)-2*x(K)),(2*y(Po)*y(P6)-y(K)*(y(Po)+y(P6)))/(y(Po)+y(P6)-2*y(K))]","0");
A1=FixedAngle("A1",sK,Odl,"ang72",false);
C1=Circle("C1",Odl,sK);
sk2=Reflection("sk2",A1,sK);
sk1=OrderedIntersection("sk1",A1,C1,0);
S1=Segment("S1",Odl,sk2);
L8=Line("L8",Po,sk1);
L9=Line("L9",Po,sk2);
sk3=Reflection("sk3",S1,sk1);
sk4=Reflection("sk4",S1,sK);
P7=OrderedIntersection("P7",Perp21,L8,0);
P8=OrderedIntersection("P8",Perp21,L9,0);
K1=Point("K1","[(2*x(Po)*x(P7)-x(sk1)*(x(Po)+x(P7)))/(x(Po)+x(P7)-2*x(sk1)),(2*y(Po)*y(P7)-y(sk1)*(y(Po)+y(P7)))/(y(Po)+y(P7)-2*y(sk1))]","0");
K2=Point("K2","[(2*x(Po)*x(P8)-x(sk2)*(x(Po)+x(P8)))/(x(Po)+x(P8)-2*x(sk2)),(2*y(Po)*y(P8)-y(sk2)*(y(Po)+y(P8)))/(y(Po)+y(P8)-2*y(sk2))]","0");
L13=Line("L13",Po,sk3);
L14=Line("L14",Po,sk4);
P9=OrderedIntersection("P9",Perp21,L13,0);
P10=OrderedIntersection("P10",Perp21,L14,0);
K3=Point("K3","[(2*x(Po)*x(P9)-x(sk3)*(x(Po)+x(P9)))/(x(Po)+x(P9)-2*x(sk3)),(2*y(Po)*y(P9)-y(sk3)*(y(Po)+y(P9)))/(y(Po)+y(P9)-2*y(sk3))]","0");
K4=Point("K4","[(2*x(Po)*x(P10)-x(sk4)*(x(Po)+x(P10)))/(x(Po)+x(P10)-2*x(sk4)),(2*y(Po)*y(P10)-y(sk4)*(y(Po)+y(P10)))/(y(Po)+y(P10)-2*y(sk4))]","0");
STL(Quad,"c:#00adff;s:1;f:30;p:500");
STL(K,"c:#0000b2;s:6;sn:true;f:15");
STL(K1,"c:#fc092f;s:5;sn:true;f:15;sp:2");
STL(K2,"c:#fc092f;s:5;sn:true;f:15;sp:2");
STL(K3,"c:#fc092f;s:5;sn:true;f:15;sp:2");
STL(K4,"c:#fc092f;s:5;sn:true;f:15;sp:2");
return [Quad,K,K1,K2,K3,K4];
}};

$macros["PSHCoordparAoAuA"]={
	name:"PSH/Coord par A oA uA",
	parameters:["point","point","point"],
	exec:
	function (A,oA,uA){
Ea=Expression("Ea","","","","A-oA","0.4","-0.7");
CdA=Expression("CdA","","","","[uA[2],IF(Ea[1]>0,-\u03C0+acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)),\u03C0-acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)))]","-1","-1.5");
STL(CdA,"c:#435805;s:7;sn:true;f:24;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [CdA];
}};

$macros["PSHDrtLesCoefgOdlMab"]={
	name:"PSH/Drt LesCoef g Odl Mab",
	parameters:["expression","expression","point","point"],
	exec:
	function(LesCoef,g,Odl,Mab){
LongM=Expression("LongM","","","","log((1+x(Mab)-x(Odl))/(1-x(Mab)+x(Odl)))/(2*LesCoef[0])","2.7","-1");
uMab=Expression("uMab","","","","log((1+(y(Mab)-y(Odl))*(exp(LesCoef[0]*LongM)+exp(-LesCoef[0]*LongM))/2)/(1-(y(Mab)-y(Odl))*(exp(LesCoef[0]*LongM)+exp(-LesCoef[0]*LongM))/2))/2","2","-1.5");
LePt=Point("LePt","[xp*(exp(uMab)+exp(-uMab))*cos(LongM-\u03C0)/2,xp*(exp(uMab)+exp(-uMab))*sin(LongM-\u03C0)/2,g(uMab)]","1");
DrtAB=Locus("DrtAB",LePt,Mab);
STL(DrtAB,"c:#fc092f;s:2;sn:true;f:30;p:200");
return [DrtAB];
}};

$macros["PSHEquidistLesCoefguA"]={
	name:"PSH/Equidist LesCoef g uA",
	parameters:["expression","expression","point"],
	exec:
	function(LesCoef,g,uA){
Pxap=Point("Pxap","[LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,0,g(uA[2])]","1");
Pxam=Point("Pxam","[-LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,0,g(uA[2])]","1");
Pya=Point("Pya","[0,LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,g(uA[2])]","1");
EquidA=Circle3pts3D("EquidA",Pxap,Pxam,Pya);
STL(EquidA,"c:#0000b2;s:1;sn:true;f:30;p:0");
return [EquidA];
}};

$macros["PSHPSHversKBxpCdAOdl"]={
	name:"PSH/PSH vers KB xp CdA Odl",
	parameters:["expression","expression","point"],
	exec:
	function(xp,CdA,Odl){
Akb=Point("Akb","Odl+[(exp(xp*CdA[1])-exp(-xp*CdA[1]))/(exp(xp*CdA[1])+exp(-xp*CdA[1])),((exp(CdA[0])-exp(-CdA[0]))/(exp(CdA[0])+exp(-CdA[0])))/((exp(xp*CdA[1])+exp(-xp*CdA[1]))/2)]","0");
STL(Akb,"c:#0000b2;s:6;sn:true;f:14;sp:1");
return [Akb];
}};

