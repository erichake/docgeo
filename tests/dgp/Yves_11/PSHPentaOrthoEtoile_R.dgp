Text("<div style='font-size:14px;color:#0000FF;text-align:left'>\nD\u00e9cocher la case \npour d\u00e9sactiver\nles restrictions\n\nActiver Restriction <input type=checkbox target=\"ActivRes\"> ",29,645,177,128,"c:rgba(242,255,69,0.18);s:3;r:15;p:4");
Text("<div style='font-size:18px;color:#CC0000;text-align:center'>PSH - Pentagone orthogonal<div style='font-size:14px;color:#FF0000;text-align:left'>\nCacher : \n\n<div style='color:#0000FF'>Le rep\u00e8re <input type=checkbox target=\"ChRep\">    La latitude de O <input type=checkbox target=\"ChAlt\">\nLes noms <input type=checkbox target=\"ChNoms\">   Les points <input type=checkbox target=\"ChPts\">\nLe cercle sur PSH <input type=checkbox target=\"ChCercle\">\nLe polygone \u00e9toil\u00e9 <input type=checkbox target=\"ChEtoile\">\n",488,10,271,171,"c:rgba(246,249,114,0.18);s:3;r:15;p:4");
