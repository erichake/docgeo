// Macros :
$macros={};
$macros["CyclesCercleHypCtrPt"]={
	name:"Cycles/Cercle Hyp Ctr Pt",
	parameters:["circle","point","point"],
	exec:
	function (Hz,O,A){
OHz=Center("OHz",Hz);
mInvO=Point("mInvO","(OHz+(O-OHz)*Hz^2/d(OHz,O)^2+O)/2","0");
mAA=Point("mAA","(mInvO+(A-mInvO)*d(mInvO,O)^2/d(mInvO,A)^2+A)/2","0");
L2=Line("L2",mInvO,A);
L1=Line("L1",OHz,mInvO);
Perp1=Perpendicular("Perp1",L2,mAA);
P1=OrderedIntersection("P1",L1,Perp1,0);
chOA=Circle("chOA",P1,A);
STL(chOA,"c:#b40000;s:2;sn:true;f:30;p:0");
return [chOA];
}};

$macros["CyclesEquidistanteAxePt"]={
	name:"Cycles/Equidistante Axe Pt",
	parameters:["circle","circle","point"],
	exec:
	function (Hz,C1,A){
OHz=Center("OHz",Hz);
IdA=DefinitionPoint("IdA",C1,0);
IdB=DefinitionPoint("IdB",C1,2);
P20=DefinitionPoint("P20",C1,1);
CtrAB=Center("CtrAB",C1);
S1=Segment("S1",CtrAB,OHz);
P3=OrderedIntersection("P3",S1,C1,0);
C2=Circle("C2",CtrAB,P3);
P4=OrderedIntersection("P4",Hz,C2,1);
P5=OrderedIntersection("P5",Hz,C2,0);
C3=Arc3pts("C3",P4,A,P5);
Center1=Center("Center1",C3);
STL(C3,"c:#f90808;s:2;f:30;p:0");
return [C3];
}};

$macros["DroitesBissectriceAOB"]={
	name:"Droites/Bissectrice AOB",
	parameters:["circle","point","point","point"],
	exec:
	function (c1,P3,P2,P4){
OHz=Center("OHz",c1);
oAB=Point("oAB","[(y(P3)*(x(P2)^2+y(P2)^2+c1^2)-y(P2)*(x(P3)^2+y(P3)^2+c1^2))/(2*(x(P2)*y(P3)-x(P3)*y(P2))),(x(P2)*(x(P3)^2+y(P3)^2+c1^2)-x(P3)*(x(P2)^2+y(P2)^2+c1^2))/(2*(x(P2)*y(P3)-x(P3)*y(P2)))]","0");
oAB0=Point("oAB0","[(y(P4)*(x(P2)^2+y(P2)^2+c1^2)-y(P2)*(x(P4)^2+y(P4)^2+c1^2))/(2*(x(P2)*y(P4)-x(P4)*y(P2))),(x(P2)*(x(P4)^2+y(P4)^2+c1^2)-x(P4)*(x(P2)^2+y(P2)^2+c1^2))/(2*(x(P2)*y(P4)-x(P4)*y(P2)))]","0");
mPC1=Point("mPC1","(OHz+(P2-OHz)*c1^2/d(OHz,P2)^2+P2)/2","0");
U=Point("U","[(2*c1^2*x(oAB)^2+2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2-2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*c1^2*x(oAB)^2-2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2+2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
U0=Point("U0","[(2*c1^2*x(oAB0)^2+2*c1*y(oAB0)*sqrt(x(oAB0)^2+y(oAB0)^2-c1^2)*abs(x(oAB0)))/(2*x(oAB0)*(x(oAB0)^2+y(oAB0)^2)),(2*y(oAB0)*c1^2-2*c1*sqrt(x(oAB0)^2+y(oAB0)^2-c1^2)*abs(x(oAB0)))/(2*(x(oAB0)^2+y(oAB0)^2))]","0");
V0=Point("V0","[(2*c1^2*x(oAB0)^2-2*c1*y(oAB0)*sqrt(x(oAB0)^2+y(oAB0)^2-c1^2)*abs(x(oAB0)))/(2*x(oAB0)*(x(oAB0)^2+y(oAB0)^2)),(2*y(oAB0)*c1^2+2*c1*sqrt(x(oAB0)^2+y(oAB0)^2-c1^2)*abs(x(oAB0)))/(2*(x(oAB0)^2+y(oAB0)^2))]","0");
L1=Line("L1",OHz,mPC1);
IdB=Point("IdB","V*(d(P2,V)>d(P3,V))+U*(d(P2,V)<d(P3,V))","0");
IdB0=Point("IdB0","V0*(d(P2,V0)>d(P4,V0))+U0*(d(P2,V0)<d(P4,V0))","0");
Perp1=Perpendicular("Perp1",L1,mPC1);
oAB1=Point("oAB1","[(y(IdB)*(x(IdB0)^2+y(IdB0)^2+c1^2)-y(IdB0)*(x(IdB)^2+y(IdB)^2+c1^2))/(2*(x(IdB0)*y(IdB)-x(IdB)*y(IdB0))),(x(IdB0)*(x(IdB)^2+y(IdB)^2+c1^2)-x(IdB)*(x(IdB0)^2+y(IdB0)^2+c1^2))/(2*(x(IdB0)*y(IdB)-x(IdB)*y(IdB0)))]","0");
P20=Point("P20","oAB1+d(IdB0,oAB1)*((IdB0+IdB)/2-oAB1)/d((IdB0+IdB)/2,oAB1)","0");
U1=Point("U1","[(2*c1^2*x(oAB1)^2+2*c1*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-c1^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*c1^2-2*c1*sqrt(x(oAB1)^2+y(oAB1)^2-c1^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
V1=Point("V1","[(2*c1^2*x(oAB1)^2-2*c1*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-c1^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*c1^2+2*c1*sqrt(x(oAB1)^2+y(oAB1)^2-c1^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
IdB1=Point("IdB1","V1*(d(IdB0,V1)>d(IdB,V1))+U1*(d(IdB0,V1)<d(IdB,V1))","0");
IdA=Point("IdA","V1*(d(IdB0,V1)<d(IdB,V1))+U1*(d(IdB0,V1)>d(IdB,V1))","0");
C11=Arc3pts("C11",IdA,P20,IdB1);
CtrAB=Center("CtrAB",C11);
mPAB=Point("mPAB","(CtrAB+(P2-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P2)^2+P2)/2","0");
L2=Line("L2",CtrAB,P2);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P2);
R1=Ray("R1",P1,mPAB);
P40=OrderedIntersection("P40",R1,C2,0);
P5=OrderedIntersection("P5",C2,c1,1);
P6=OrderedIntersection("P6",C2,c1,0);
Hperp=Arc3pts("Hperp",P5,P40,P6);
STL(Hperp,"c:#2ea3e4;s:1;sn:true;f:30;p:0");
return [Hperp];
}};

$macros["DroitesDroiteHyper"]={
	name:"Droites/Droite Hyper",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
IdA=Point("IdA","[(2*c1^2*x(oAB)^2+2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2-2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*c1^2*x(oAB)^2-2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2+2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P2=Point("P2","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
C1=Arc3pts("C1",IdA,P2,IdB);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

$macros["DroitesMédiatriceHyper"]={
	name:"Droites/M\u00e9diatrice Hyper",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
OHz=Center("OHz",Hz);
mInvO=Point("mInvO","(OHz+(A-OHz)*Hz^2/d(OHz,A)^2+A)/2","0");
mInvO1=Point("mInvO1","(OHz+(B-OHz)*Hz^2/d(OHz,B)^2+B)/2","0");
mAA=Point("mAA","(mInvO+(B-mInvO)*d(mInvO,A)^2/d(mInvO,B)^2+B)/2","0");
L2=Line("L2",mInvO,B);
L1=Line("L1",OHz,mInvO);
mAA1=Point("mAA1","(mInvO1+(A-mInvO1)*d(mInvO1,B)^2/d(mInvO1,A)^2+A)/2","0");
L21=Line("L21",mInvO1,A);
L11=Line("L11",OHz,mInvO1);
Perp1=Perpendicular("Perp1",L2,mAA);
Perp11=Perpendicular("Perp11",L21,mAA1);
P1=OrderedIntersection("P1",L1,Perp1,0);
P11=OrderedIntersection("P11",L11,Perp11,0);
chOA=Circle("chOA",P1,B);
chOA1=Circle("chOA1",P11,A);
P2=OrderedIntersection("P2",chOA1,chOA,1);
P5=OrderedIntersection("P5",chOA1,chOA,0);
oAB=Point("oAB","[(y(P2)*(x(P5)^2+y(P5)^2+Hz^2)-y(P5)*(x(P2)^2+y(P2)^2+Hz^2))/(2*(x(P5)*y(P2)-x(P2)*y(P5))),(x(P5)*(x(P2)^2+y(P2)^2+Hz^2)-x(P2)*(x(P5)^2+y(P5)^2+Hz^2))/(2*(x(P5)*y(P2)-x(P2)*y(P5)))]","0");
IdA=Point("IdA","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P21=Point("P21","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
C1=Arc3pts("C1",IdA,P21,IdB);
STL(C1,"c:#0026ff;s:1.5;f:30;p:0");
return [C1];
}};

$macros["DroitesPerpCommune"]={
	name:"Droites/Perp Commune",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdU=DefinitionPoint("IdU",C1,0);
IdV=DefinitionPoint("IdV",C1,2);
IdN=DefinitionPoint("IdN",C11,0);
IdM=DefinitionPoint("IdM",C11,2);
L1=Line("L1",IdN,IdM);
L2=Line("L2",IdU,IdV);
oPC=OrderedIntersection("oPC",L2,L1,0);
C2=Circle1("C2",oPC,"sqrt(d(OHz,oPC)^2-Hz^2)");
S1=Segment("S1",OHz,oPC);
P1=OrderedIntersection("P1",C2,Hz,1);
P3=OrderedIntersection("P3",S1,C2,1);
P4=OrderedIntersection("P4",C2,Hz,0);
PComm=Arc3pts("PComm",P1,P3,P4);
STL(PComm,"c:#007c00;s:1.5;sn:true;f:30;p:0");
return [PComm];
}};

$macros["DroitesPerpendiculaireHyper"]={
	name:"Droites/Perpendiculaire Hyper",
	parameters:["circle","circle","point"],
	exec:
	function (c1,C1,P){
OHz=Center("OHz",c1);
mPC1=Point("mPC1","(OHz+(P-OHz)*c1^2/d(OHz,P)^2+P)/2","0");
IdA=DefinitionPoint("IdA",C1,0);
L1=Line("L1",OHz,mPC1);
Perp1=Perpendicular("Perp1",L1,mPC1);
CtrAB=Center("CtrAB",C1);
mPAB=Point("mPAB","(CtrAB+(P-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P)^2+P)/2","0");
L2=Line("L2",CtrAB,P);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P);
R1=Ray("R1",P1,mPAB);
P4=OrderedIntersection("P4",R1,C2,0);
P5=OrderedIntersection("P5",C2,c1,1);
P6=OrderedIntersection("P6",C2,c1,0);
Hperp=Arc3pts("Hperp",P5,P4,P6);
STL(Hperp,"c:#007c00;s:2;sn:true;f:30;p:0");
return [Hperp];
}};

$macros["DroitesSegmenthyper"]={
	name:"Droites/Segment hyper",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
P2=Point("P2","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
C1=Arc3pts("C1",A,P2,B);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

$macros["FaisceauxDroiteFaisceau1pt"]={
	name:"Faisceaux/Droite Faisceau 1 pt",
	parameters:["circle","circle","circle","point"],
	exec:
	function (Hz,C1,C11,P){
OHz=Center("OHz",Hz);
L1=Line("L1",OHz,P);
P1=Point("P1","(OHz+(P-OHz)*Hz^2/d(OHz,P)^2+P)/2","0");
Perp1=Perpendicular("Perp1",L1,P1);
Center1=Center("Center1",C1);
Center2=Center("Center2",C11);
L2=Line("L2",Center2,Center1);
P3=OrderedIntersection("P3",L2,Perp1,0);
C2=Circle("C2",P3,P);
P4=OrderedIntersection("P4",C2,Hz,1);
P5=OrderedIntersection("P5",C2,Hz,0);
C3=Arc3pts("C3",P4,P,P5);
STL(C3,"c:#0000b2;s:2.5;f:30;p:0");
return [C3];
}};

$macros["FaisceauxHauteurdefaisceauffd"]={
	name:"Faisceaux/Hauteur de faisceau ffd",
	parameters:["circle","circle","circle","circle"],
	exec:
	function (Hz,C11,C1,C12){
OHz=Center("OHz",Hz);
IdA=DefinitionPoint("IdA",C12,0);
IdB=DefinitionPoint("IdB",C12,2);
L3=Line("L3",IdB,IdA);
Center1=Center("Center1",C1);
Center2=Center("Center2",C11);
L1=Line("L1",Center2,Center1);
P1=OrderedIntersection("P1",L3,L1,0);
M1=MidPoint("M1",OHz,P1);
C2=Circle("C2",M1,OHz);
P5=OrderedIntersection("P5",C2,Hz,0);
P6=OrderedIntersection("P6",C2,Hz,1);
oAB3=Point("oAB3","[(y(P6)*(x(P5)^2+y(P5)^2+Hz^2)-y(P5)*(x(P6)^2+y(P6)^2+Hz^2))/(2*(x(P5)*y(P6)-x(P6)*y(P5))),(x(P5)*(x(P6)^2+y(P6)^2+Hz^2)-x(P6)*(x(P5)^2+y(P5)^2+Hz^2))/(2*(x(P5)*y(P6)-x(P6)*y(P5)))]","0");
P23=Point("P23","oAB3+d(P5,oAB3)*((P5+P6)/2-oAB3)/d((P5+P6)/2,oAB3)","0");
C13=Arc3pts("C13",P5,P23,P6);
STL(C13,"c:#cc66cc;s:1;f:30;p:0");
return [C13];
}};

$macros["FaisceauxInter2faisceaux"]={
	name:"Faisceaux/Inter 2 faisceaux",
	parameters:["circle","circle","circle","circle","circle"],
	exec:
	function (Hz,C1,C10,C11,C12){
OHz=Center("OHz",Hz);
Center1=Center("Center1",C1);
Center2=Center("Center2",C10);
Center3=Center("Center3",C11);
Center4=Center("Center4",C12);
L1=Line("L1",Center2,Center1);
L2=Line("L2",Center3,Center4);
P1=OrderedIntersection("P1",L1,L2,0);
M1=MidPoint("M1",P1,OHz);
R1=Ray("R1",P1,OHz);
C2=Circle("C2",M1,P1);
P3=OrderedIntersection("P3",Hz,C2,0);
P4=OrderedIntersection("P4",Hz,C2,1);
C3=Circle("C3",P1,P3);
P5=OrderedIntersection("P5",R1,C3,0);
C4=Arc3pts("C4",P4,P5,P3);
STL(C4,"c:#cc66cc;s:1;f:30;p:0");
return [C4];
}};

$macros["FaisceauxProduitabca1"]={
	name:"Faisceaux/Produit abc a1",
	parameters:["circle","circle","circle","circle","point"],
	exec:
	function(Hz,C1,C3,C10,a1){
OHz=Center("OHz",Hz);
P1=DefinitionPoint("P1",C3,1);
L1=Line("L1",OHz,P1);
P10=Point("P10","(OHz+(P1-OHz)*Hz^2/d(OHz,P1)^2+P1)/2","0");
mInvO=Point("mInvO","(OHz+(a1-OHz)*Hz^2/d(OHz,a1)^2+a1)/2","0");
IdA0=DefinitionPoint("IdA0",C10,0);
Perp1=Perpendicular("Perp1",L1,P10);
L10=Line("L10",OHz,mInvO);
Oo=Center("Oo",C1);
Oo1=Center("Oo1",C10);
L2=Line("L2",Oo1,Oo);
P3=OrderedIntersection("P3",L2,Perp1,0);
C2=Circle("C2",P3,P1);
P4=DefinitionPoint("P4",C3,0);
Oo0=Center("Oo0",C3);
P11=Point("P11","Oo0+(a1-Oo0)*d(Oo0,P4)^2/d(Oo0,a1)^2","0");
P12=Point("P12","Oo1+(P11-Oo1)*d(Oo1,IdA0)^2/d(Oo1,P11)^2","0");
mInvO1=Point("mInvO1","(OHz+(P12-OHz)*Hz^2/d(OHz,P12)^2+P12)/2","0");
mAA=Point("mAA","(mInvO+(P12-mInvO)*d(mInvO,a1)^2/d(mInvO,P12)^2+P12)/2","0");
L20=Line("L20",mInvO,P12);
mAA1=Point("mAA1","(mInvO1+(a1-mInvO1)*d(mInvO1,P12)^2/d(mInvO1,a1)^2+a1)/2","0");
L21=Line("L21",mInvO1,a1);
L11=Line("L11",OHz,mInvO1);
Perp10=Perpendicular("Perp10",L20,mAA);
Perp11=Perpendicular("Perp11",L21,mAA1);
P13=OrderedIntersection("P13",L10,Perp10,0);
P110=OrderedIntersection("P110",L11,Perp11,0);
chOA=Circle("chOA",P13,P12);
chOA1=Circle("chOA1",P110,a1);
P21=OrderedIntersection("P21",chOA1,chOA,1);
P50=OrderedIntersection("P50",chOA1,chOA,0);
oAB1=Point("oAB1","[(y(P21)*(x(P50)^2+y(P50)^2+Hz^2)-y(P50)*(x(P21)^2+y(P21)^2+Hz^2))/(2*(x(P50)*y(P21)-x(P21)*y(P50))),(x(P50)*(x(P21)^2+y(P21)^2+Hz^2)-x(P21)*(x(P50)^2+y(P50)^2+Hz^2))/(2*(x(P50)*y(P21)-x(P21)*y(P50)))]","0");
IdA1=Point("IdA1","[(2*Hz^2*x(oAB1)^2+2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2-2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
IdB1=Point("IdB1","[(2*Hz^2*x(oAB1)^2-2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2+2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
P210=Point("P210","oAB1+d(IdA1,oAB1)*((IdA1+IdB1)/2-oAB1)/d((IdA1+IdB1)/2,oAB1)","0");
C11=Arc3pts("C11",IdA1,P210,IdB1);
STL(C11,"c:#0026ff;s:1;f:30;p:0");
STL(IdA1,"c:#0026ff;s:4.5;sn:true;f:15");
STL(IdB1,"c:#0026ff;s:4.5;sn:true;f:15");
return [IdA1,IdB1,C11];
}};

$macros["TechniqueDroiteetptsidéaux"]={
	name:"Technique/Droite et pts id\u00e9aux",
	parameters:["circle","point","point"],
	exec:
	function (c1,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+c1^2)-y(A)*(x(B)^2+y(B)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+c1^2)-x(B)*(x(A)^2+y(A)^2+c1^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
P2=Point("P2","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
U=Point("U","[(2*c1^2*x(oAB)^2+2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2-2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*c1^2*x(oAB)^2-2*c1*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*c1^2+2*c1*sqrt(x(oAB)^2+y(oAB)^2-c1^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","V*(d(A,V)>d(B,V))+U*(d(A,V)<d(B,V))","0");
IdA=Point("IdA","V*(d(A,V)<d(B,V))+U*(d(A,V)>d(B,V))","0");
C1=Arc3pts("C1",IdA,P2,IdB);
STL(IdB,"c:#0000b2;s:6;sn:true;f:30");
STL(IdA,"c:#0000b2;s:6;sn:true;f:30");
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [IdB,IdA,C1];
}};

$macros["TechniqueDroiteHyporientée"]={
	name:"Technique/Droite Hyp orient\u00e9e",
	parameters:["circle","point","point"],
	exec:
	function (Hz,U,V){
oAB=Point("oAB","[(y(V)*(x(U)^2+y(U)^2+Hz^2)-y(U)*(x(V)^2+y(V)^2+Hz^2))/(2*(x(U)*y(V)-x(V)*y(U))),(x(U)*(x(V)^2+y(V)^2+Hz^2)-x(V)*(x(U)^2+y(U)^2+Hz^2))/(2*(x(U)*y(V)-x(V)*y(U)))]","0");
IdU=Point("IdU","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdV=Point("IdV","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P2=Point("P2","oAB+d(IdU,oAB)*((IdU+IdV)/2-oAB)/d((IdU+IdV)/2,oAB)","0");
IdUor=Point("IdUor","IdU*(d(IdU,U)<d(IdV,U))+IdV*(d(IdU,U)>d(IdV,U))","0");
IdVor=Point("IdVor","IdV*(d(IdV,V)<d(IdV,U))+IdU*(d(IdV,V)>d(IdV,U))","0");
C1=Arc3pts("C1",IdUor,P2,IdVor);
STL(C1,"c:#cc66cc;s:1;f:20;p:0");
return [C1];
}};

$macros["TechniqueIntersection2droites"]={
	name:"Technique/Intersection 2 droites",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdU=DefinitionPoint("IdU",C1,0);
IdN=DefinitionPoint("IdN",C11,0);
cMN=Center("cMN",C11);
cUV=Center("cUV",C1);
C2=Circle("C2",cMN,IdN);
C3=Circle("C3",cUV,IdU);
Int1=OrderedIntersection("Int1",C3,C2,0);
Int2=OrderedIntersection("Int2",C3,C2,1);
Inter=Point("Inter","Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
STL(Inter,"c:#0000b2;s:6;sn:true;f:17");
return [Inter];
}};

$macros["TechniqueSymorthogonale1pt"]={
	name:"Technique/Sym orthogonale 1pt",
	parameters:["circle","point"],
	exec:
	function (C1,M){
Aa=DefinitionPoint("Aa",C1,0);
Oo=Center("Oo",C1);
P1=Point("P1","Oo+(M-Oo)*d(Oo,Aa)^2/d(Oo,M)^2","0");
STL(P1,"c:#0000b2;s:6;f:30");
return [P1];
}};

