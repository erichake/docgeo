$macros["MesureAngle"]={
	name:"Mesure Angle",
	parameters:["point","point","point","point","point","point","point","point","point"],
	exec:
	function(Pac,Qac,CtrArcAC,Pbc,Qbc,CtrArcBC,A,C,B){
CintCoteA=Point("CintCoteA","(x(A)^2+4*y(A)^2>1)?(d(A,Qac)<d(A,Pac))?Qac:Pac:A","0");
CexCoteB=Point("CexCoteB","(x(C)^2+4*y(C)^2>1)?isNaN(Pbc.getX())?B:(d(C,Qbc)<d(C,Pbc))?Qbc:Pbc:NaN","0");
CexCoteA=Point("CexCoteA","(x(C)^2+4*y(C)^2>1)?isNaN(Pac.getX())?A:(d(C,Pac)<d(C,Qac))?Pac:Qac:NaN","0");
S1=Segment("S1",CtrArcAC,C);
S2=Segment("S2",CtrArcBC,C);
Perp2=Perpendicular("Perp2",S1,C);
Perp4=Perpendicular("Perp4",S2,C);
Perp3=Perpendicular("Perp3",Perp2,CintCoteA);
Perp5=Perpendicular("Perp5",Perp4,B);
tgA=OrderedIntersection("tgA",Perp2,Perp3,0);
tgB=OrderedIntersection("tgB",Perp4,Perp5,0);
ptCoteA=Point("ptCoteA","(x(C)^2+4*y(C)^2>1)?CexCoteA:tgA","0");
ptCoteB=Point("ptCoteB","(x(C)^2+4*y(C)^2>1)?CexCoteB:tgB","0");
A1=Angle("A1",ptCoteA,C,ptCoteB);
STL(A1,"c:#007c7c;o:0.1;s:2;f:12;p:2");
return [A1];
}};

