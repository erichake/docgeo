// Macros :
$macros={};
$macros["Arcintérieur"]={
	name:"Arc int\u00e9rieur",
	parameters:["point","point","point"],
	exec:
	function (F,A,B){
C1a=Circle3pts("C1a",A,B,F);
mAB=MidPoint("mAB",A,B);
Iab=Center("Iab",C1a);
P3=Point("P3","Iab+(mAB-Iab)*d(Iab,F)/d(Iab,mAB)","0");
C4=Arc3pts("C4",A,P3,B);
STL(C4,"c:#cc66cc;s:1;f:30;p:0");
return [C4];
}};

$macros["Constituantdroite3obj"]={
	name:"Constituant droite 3 obj",
	parameters:["line","circle","line"],
	exec:
	function(Rb,Archb,Rh){
Ph=DefinitionPoint("Ph",Archb,0);
Qb=DefinitionPoint("Qb",Archb,2);
Exh=DefinitionPoint("Exh",Rh,1);
Exb=DefinitionPoint("Exb",Rb,1);
Ptgg=DefinitionPoint("Ptgg",Archb,1);
CtrArchb=Center("CtrArchb",Archb);
aPQ=Angle("aPQ",Ph,CtrArchb,Qb);
STL(Ph,"c:#fc092f;s:4.5;sn:true;f:16;sp:1;np:0.7065633064279783");
STL(Qb,"c:#fc092f;s:4;sn:true;f:16;sp:1;np:4.749323907051956");
STL(Exh,"c:#fc092f;s:4.5;sn:true;f:16;sp:1");
STL(Exb,"c:#fc092f;s:4.5;sn:true;f:16;sp:1;np:0.8583691685006293");
STL(CtrArchb,"c:#fc092f;s:4.5;sn:true;f:16;sp:1");
return [Ph,Qb,Exh,Exb,CtrArchb];
}};

$macros["DroiteHilbertFHellAB"]={
	name:"Droite Hilbert F Hell AB",
	parameters:["point","quadric","point","point"],
	exec:
	function(F,Quad,A,B){
AExt=Expression("AExt","","","","x(A)^2+4*y(A)^2>1","-1.9489200141606147","0.9415408131213986");
BExt=Expression("BExt","","","","x(B)^2+4*y(B)^2>1","-1.579120090761074","0.9415408131213986");
C1=Circle3pts("C1",A,B,F);
L4=Line("L4",A,B);
DrtAB=Line("DrtAB",A,B);
CtrABint=Center("CtrABint",C1);
xA=Expression("xA","","","","x(A)*(AExt==0)+x(B)*(BExt==0)","-2.031097774916068","-0.1267700766994961");
yA=Expression("yA","","","","y(A)*(AExt==0)+y(B)*(BExt==0)","-1.3736756888724408","-0.0856811963217694");
xB=Expression("xB","","","","x(A)*(AExt==1)+x(B)*(BExt==1)","-1.291497928116987","-0.20894783745494955");
yB=Expression("yB","","","","y(A)*(AExt==1)+y(B)*(BExt==1)","-1.3736756888724408","0.07867432518913749");
ABExt=Point("ABExt","B*BExt+A*AExt","0");
coef=Expression("coef","","","","-4*(128*yA^6*yB*(9*(3-2*xB)^2+16*yB^2)+48*yA^4*yB*(-1297+72*xA^2*(3-2*xB)^2+3105*xB-6*xA*(-3+2*xB)*(-35+9*xB*(1+xB))-3*xB^2*(901+6*xB*(-57+8*xB))+36*yB^2+8*(xA*(-27+16*xA-6*xB)+9*xB)*yB^2)+(-3+2*xA)^3*yB*(9*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(3+3*(8-3*xB)*xB+8*xA^2*(-3+2*xB)+xA*(-34-6*(-5+xB)*xB))+4*(3+2*xA-3*xB)*(45+32*xA^2-9*(-2+xB)*xB+6*xA*(-11+2*xB))*yB^2)+4*yA^3*(4906-11205*xB+9*(-8*xA^2*(3-2*xB)^2*(-7+3*(-3+xB)*xB)+2*xA*(-3+2*xB)*(136+3*xB*(39+xB*(-35+3*(-3+xB)*xB)))+xB^2*(2519+3*xB*(-903+xB*(433-90*xB+8*xB^2))))+7560*yB^2+60*(8*xA^2*(29+12*(-3+xB)*xB)+9*xB*(1+3*xB*(-5+2*xB))-6*xA*(72+xB*(-71+9*xB+6*xB^2)))*yB^2)-3*(3-2*xA)^2*yA*(3*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(-17+2*xA*(-3+2*xB)*(-7+3*(-3+xB)*xB)+3*xB*(-2+xB*(-7+6*xB)))-4*(20*xA^2*(29+12*(-3+xB)*xB)-30*xA*(14+xB-15*xB^2+6*xB^3)+9*(41+xB*(-41+xB*(31+3*xB*(-7+2*xB)))))*yB^2)+48*yA^5*(189+580*yB^2-3*(-3+xB)*xB*(-1+12*(-3+xB)*xB-80*yB^2))+12*(-3+2*xA)*yA^2*yB*(16*xA^3*(9*(3-2*xB)^2+16*yB^2)+3*(344+7*xB-615*xB^2+561*xB^3-225*xB^4+36*xB^5+36*(2+(-5+xB)*xB)*yB^2)-24*xA^2*(4*(6+5*yB^2)+xB*(11+9*xB*(-5+2*xB)+8*yB^2))+2*xA*(-1786+3*xB*(1209-925*xB+315*xB^2-39*xB^3-12*(-9+xB)*yB^2))))","-2.031097774916068","-0.5376588804767634");
U=Expression("U","","","","-((2*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB))/(3*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)))","-1.990008894538341","-0.7841921627431236");
coef2=Expression("coef2","","","","(-16*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB)^2+6*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)*(6+5*xA-6*xA^2-9*xB+4*xA^2*xB-6*yA^2+4*xB*yA^2-36*yA*yB+24*xB*yA*yB+18*yB^2-12*xA*yB^2))","-2.031097774916068","-1.153992086142664");
coefV=Expression("coefV","","","","3*2^(2/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-1.990008894538341","-0.9485476842540305");
coefW=Expression("coefW","","","","6*2^(1/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-1.990008894538341","-1.318347607653571");
EllF1=Point("EllF1","CtrABint+(F-CtrABint)*(cos(40)+i*sin(40))","0");
EllF2=Point("EllF2","CtrABint+(F-CtrABint)*(cos(80)+i*sin(80))","0");
EllF3=Point("EllF3","CtrABint+(F-CtrABint)*(cos(140)+i*sin(140))","0");
EllF4=Point("EllF4","CtrABint+(F-CtrABint)*(cos(230)+i*sin(230))","0");
EllF5=Point("EllF5","CtrABint+(F-CtrABint)*(cos(310)+i*sin(310))","0");
Qe=OrderedIntersection("Qe",L4,Quad,1);
Pe=OrderedIntersection("Pe",L4,Quad,0);
expVW=Expression("expVW","","","","(coef*coef+4*coef2^3)","-2.031097774916068","-0.41439223934358316");
Quad1=Quadric("Quad1",EllF1,EllF2,EllF3,EllF4,EllF5);
Uee=Point("Uee","(AExt+BExt==2)?Pe:NaN","0");
Vee=Point("Vee","(AExt+BExt==2)?Qe:NaN","0");
LesR3=Expression("LesR3","","","","(AExt+BExt==1)?((expVW>0)?[coef+sqrt(expVW),0]^(1/3):[coef,sqrt(-expVW)]^(1/3)):NaN","-2.154364416049248","0.5306520093441311");
PF1=OrderedIntersection("PF1",Quad,Quad1,0);
QF1=OrderedIntersection("QF1",Quad,Quad1,1);
PF10=OrderedIntersection("PF10",Quad,Quad1,2);
QF10=OrderedIntersection("QF10",Quad,Quad1,3);
chAff=Expression("chAff","","","","DrtAB.setHidden(AExt+BExt<2 || !isNaN(Uee.getX()));\"cache DrtAB\"","-1.4969423300056204","0.736096411232765");
expa2=Expression("expa2","","","","U-[-0.5,sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,-sqrt(3)/2]*LesR3[0]/coefW","-1.1271424066060802","0.2841187270777711");
expa1=Expression("expa1","","","","U-(coef2/coefV)/LesR3[0]+LesR3[0]/coefW","-2.0721866552937946","0.2841187270777711");
expa3=Expression("expa3","","","","U-[-0.5,-sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,sqrt(3)/2]*LesR3[0]/coefW","-0.2231870382960923","0.2841187270777711");
PF11=Point("PF11","isNaN(PF1.getX())?PF10:PF1","0");
QF11=Point("QF11","isNaN(QF1.getX())?QF10:QF1","0");
Ptdr1=Point("Ptdr1","(abs(expa1[1])<0.001)?[0,expa1[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr2=Point("Ptdr2","(abs(expa2[1])<0.001)?[0,expa2[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr3=Point("Ptdr3","(abs(expa3[1])<0.001)?[0,expa3[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Uii=Point("Uii","(AExt+BExt==0)?PF11:NaN","0");
Vii=Point("Vii","(AExt+BExt==0)?QF11:NaN","0");
L1=Line("L1",ABExt,Ptdr1);
L2=Line("L2",ABExt,Ptdr2);
L3=Line("L3",ABExt,Ptdr3);
U1=OrderedIntersection("U1",L1,Quad,1);
V1=OrderedIntersection("V1",L1,Quad,0);
U3=OrderedIntersection("U3",L3,Quad,1);
V3=OrderedIntersection("V3",L3,Quad,0);
U2=OrderedIntersection("U2",L2,Quad,1);
V2=OrderedIntersection("V2",L2,Quad,0);
Uie=Point("Uie","isNaN(U1.getX())?(isNaN(U2.getX())?U3:U2):U1","0");
Vie=Point("Vie","isNaN(V1.getX())?(isNaN(V2.getX())?V3:V2):V1","0");
Ugg=Point("Ugg","isNaN(Uie.getX())?(isNaN(Uee.getX())?Uii:Uee):Uie","0");
Vgg=Point("Vgg","isNaN(Vie.getX())?(isNaN(Vee.getX())?Vii:Vee):Vie","0");
C2=Circle3pts("C2",Ugg,Vgg,F);
Ph=Point("Ph","(y(Vgg)>y(Ugg))?Vgg:Ugg","0");
Mgg=MidPoint("Mgg",Ugg,Vgg);
CtrCgg=Center("CtrCgg",C2);
Qb=Symmetry("Qb",Mgg,Ph);
Exh=Symmetry("Exh",Ph,Mgg);
R3=Ray("R3",CtrCgg,Mgg);
Exb=Symmetry("Exb",Qb,Mgg);
Rh=Ray("Rh",Ph,Exh);
Ptgg=OrderedIntersection("Ptgg",R3,C2,0);
Rb=Ray("Rb",Qb,Exb);
Archb=Arc3pts("Archb",Ph,Ptgg,Qb);
STL(DrtAB,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(chAff,"c:#60531d;s:7;sn:true;f:15;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(Rh,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(Rb,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(Archb,"c:#fc092f;s:1;sn:true;f:30;p:0");
return [DrtAB,chAff,Rh,Rb,Archb];
}};

$macros["HperpCtrIFEllArcDrt"]={
	name:"Hperp Ctr I F Ell Arc Drt",
	parameters:["point","point","point","quadric","circle","line"],
	exec:
	function(CtrArcAB,I,F,Quad,ArcAB,DrtAB){
A=DefinitionPoint("A",DrtAB,0);
B=DefinitionPoint("B",DrtAB,1);
AExt=Expression("AExt","","","","x(A)^2+4*y(A)^2>1","0.3071076962927295","1.3877378918013084");
BExt=Expression("BExt","","","","x(B)^2+4*y(B)^2>1","-0.051606153488536616","1.3877378918013084");
C1=Circle3pts("C1",A,B,F);
L4=Line("L4",A,B);
xI=Expression("xI","","","","I[0]","-2.914289367477827","1.2287362192232296");
yI=Expression("yI","","","","I[1]","-2.914289367477827","1.4657435774570486");
IExt=Expression("IExt","","","","x(I)^2+4*y(I)^2>1","-1.7292525763087316","1.169484379664775");
L6=PerpendicularBisector("L6",I,F);
CtrABint=Center("CtrABint",C1);
xA=Expression("xA","","","","x(A)*(AExt==0)+x(B)*(BExt==0)","-3.2105485652701","0.3311379265993714");
yA=Expression("yA","","","","y(A)*(AExt==0)+y(B)*(BExt==0)","-2.54254977298893","0.3929805007123921");
xB=Expression("xB","","","","x(A)*(AExt==1)+x(B)*(BExt==1)","-2.4188646247628878","0.20745277837333004");
yB=Expression("yB","","","","y(A)*(AExt==1)+y(B)*(BExt==1)","-2.54254977298893","0.6403507971644745");
ABExt=Point("ABExt","B*BExt+A*AExt","0");
Qe=OrderedIntersection("Qe",L4,Quad,1);
Pe=OrderedIntersection("Pe",L4,Quad,0);
Perp1=Perpendicular("Perp1",DrtAB,I);
coef=Expression("coef","","","","-4*(128*yA^6*yB*(9*(3-2*xB)^2+16*yB^2)+48*yA^4*yB*(-1297+72*xA^2*(3-2*xB)^2+3105*xB-6*xA*(-3+2*xB)*(-35+9*xB*(1+xB))-3*xB^2*(901+6*xB*(-57+8*xB))+36*yB^2+8*(xA*(-27+16*xA-6*xB)+9*xB)*yB^2)+(-3+2*xA)^3*yB*(9*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(3+3*(8-3*xB)*xB+8*xA^2*(-3+2*xB)+xA*(-34-6*(-5+xB)*xB))+4*(3+2*xA-3*xB)*(45+32*xA^2-9*(-2+xB)*xB+6*xA*(-11+2*xB))*yB^2)+4*yA^3*(4906-11205*xB+9*(-8*xA^2*(3-2*xB)^2*(-7+3*(-3+xB)*xB)+2*xA*(-3+2*xB)*(136+3*xB*(39+xB*(-35+3*(-3+xB)*xB)))+xB^2*(2519+3*xB*(-903+xB*(433-90*xB+8*xB^2))))+7560*yB^2+60*(8*xA^2*(29+12*(-3+xB)*xB)+9*xB*(1+3*xB*(-5+2*xB))-6*xA*(72+xB*(-71+9*xB+6*xB^2)))*yB^2)-3*(3-2*xA)^2*yA*(3*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(-17+2*xA*(-3+2*xB)*(-7+3*(-3+xB)*xB)+3*xB*(-2+xB*(-7+6*xB)))-4*(20*xA^2*(29+12*(-3+xB)*xB)-30*xA*(14+xB-15*xB^2+6*xB^3)+9*(41+xB*(-41+xB*(31+3*xB*(-7+2*xB)))))*yB^2)+48*yA^5*(189+580*yB^2-3*(-3+xB)*xB*(-1+12*(-3+xB)*xB-80*yB^2))+12*(-3+2*xA)*yA^2*yB*(16*xA^3*(9*(3-2*xB)^2+16*yB^2)+3*(344+7*xB-615*xB^2+561*xB^3-225*xB^4+36*xB^5+36*(2+(-5+xB)*xB)*yB^2)-24*xA^2*(4*(6+5*yB^2)+xB*(11+9*xB*(-5+2*xB)+8*yB^2))+2*xA*(-1786+3*xB*(1209-925*xB+315*xB^2-39*xB^3-12*(-9+xB)*yB^2))))","-3.2105485652701","-0.2872878145308351");
U=Expression("U","","","","-((2*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB))/(3*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)))","-3.2105485652701","-0.6583432592089592");
coef2=Expression("coef2","","","","(-16*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB)^2+6*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)*(6+5*xA-6*xA^2-9*xB+4*xA^2*xB-6*yA^2+4*xB*yA^2-36*yA*yB+24*xB*yA*yB+18*yB^2-12*xA*yB^2))","-3.2105485652701","-1.2149264262261448");
coefV=Expression("coefV","","","","3*2^(2/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-3.2105485652701","-0.9057135556610413");
coefW=Expression("coefW","","","","6*2^(1/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-3.2105485652701","-1.4622967226782275");
EllF1=Point("EllF1","CtrABint+(F-CtrABint)*(cos(40)+i*sin(40))","0");
EllF2=Point("EllF2","CtrABint+(F-CtrABint)*(cos(80)+i*sin(80))","0");
EllF3=Point("EllF3","CtrABint+(F-CtrABint)*(cos(140)+i*sin(140))","0");
EllF4=Point("EllF4","CtrABint+(F-CtrABint)*(cos(230)+i*sin(230))","0");
EllF5=Point("EllF5","CtrABint+(F-CtrABint)*(cos(310)+i*sin(310))","0");
Uee=Point("Uee","(AExt+BExt==2)?Pe:NaN","0");
Vee=Point("Vee","(AExt+BExt==2)?Qe:NaN","0");
Hee=OrderedIntersection("Hee",DrtAB,Perp1,0);
expVW=Expression("expVW","","","","(coef*coef+4*coef2^3)","-3.2105485652701","-0.10176009219177304");
Quad1=Quadric("Quad1",EllF1,EllF2,EllF3,EllF4,EllF5);
DrtHee=Line("DrtHee",I,Hee);
LesR3=Expression("LesR3","","","","(AExt+BExt==1)?((expVW>0)?[coef+sqrt(expVW),0]^(1/3):[coef,sqrt(-expVW)]^(1/3)):NaN","-3.2105485652701","1.3206191124077014");
PF1=OrderedIntersection("PF1",Quad,Quad1,0);
QF1=OrderedIntersection("QF1",Quad,Quad1,1);
PF10=OrderedIntersection("PF10",Quad,Quad1,2);
QF10=OrderedIntersection("QF10",Quad,Quad1,3);
Pee=OrderedIntersection("Pee",DrtHee,Quad,0);
Qee=OrderedIntersection("Qee",DrtHee,Quad,1);
expa2=Expression("expa2","","","","U-[-0.5,sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,-sqrt(3)/2]*LesR3[0]/coefW","-2.1714943283108052","0.9495636677295778");
expa1=Expression("expa1","","","","U-(coef2/coefV)/LesR3[0]+LesR3[0]/coefW","-3.2105485652701","0.9495636677295778");
expa3=Expression("expa3","","","","U-[-0.5,-sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,sqrt(3)/2]*LesR3[0]/coefW","-0.8109576978243509","0.9495636677295778");
PF11=Point("PF11","isNaN(PF1.getX())?PF10:PF1","0");
QF11=Point("QF11","isNaN(QF1.getX())?QF10:QF1","0");
Peeh=Point("Peeh","y(Pee)>y(Qee)?Pee:Qee","0");
Qeeh=Point("Qeeh","y(Pee)<y(Qee)?Pee:Qee","0");
Ptdr1=Point("Ptdr1","(abs(expa1[1])<0.001)?[0,expa1[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr2=Point("Ptdr2","(abs(expa2[1])<0.001)?[0,expa2[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr3=Point("Ptdr3","(abs(expa3[1])<0.001)?[0,expa3[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Uii=Point("Uii","(AExt+BExt==0)?PF11:NaN","0");
Vii=Point("Vii","(AExt+BExt==0)?QF11:NaN","0");
mHee=MidPoint("mHee",Peeh,Qeeh);
C7=Circle3pts("C7",Peeh,Qeeh,F);
CtrCHee=Center("CtrCHee",C7);
L1=Line("L1",ABExt,Ptdr1);
L2=Line("L2",ABExt,Ptdr2);
L3=Line("L3",ABExt,Ptdr3);
ExHeeh=Symmetry("ExHeeh",Peeh,mHee);
ExHeeb=Symmetry("ExHeeb",Qeeh,mHee);
U1=OrderedIntersection("U1",L1,Quad,1);
V1=OrderedIntersection("V1",L1,Quad,0);
U3=OrderedIntersection("U3",L3,Quad,1);
V3=OrderedIntersection("V3",L3,Quad,0);
U2=OrderedIntersection("U2",L2,Quad,1);
V2=OrderedIntersection("V2",L2,Quad,0);
maHee=Point("maHee","CtrCHee+(mHee-CtrCHee)*d(CtrCHee,F)/d(CtrCHee, mHee)","0");
RHeeh=Ray("RHeeh",Peeh,ExHeeh);
RHeeb=Ray("RHeeb",Qeeh,ExHeeb);
