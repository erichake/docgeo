angExAB=Expression("angExAB","","","","180*(arcPQ+d(NewEx,NewBord))/(d(CtrArchb,NewBord)*2*\u03C0)","-2.3730782133590855","1.0506049362097685");
longMil=Expression("longMil","","","","(d(NewBord,NewEx)+arcPQ)/2","0.7842492707051768","1.0012716942712643");
milT1=Point("milT1","CtrArchb+(BordAB-CtrArchb)*(cos(angAB)+i*sin(angAB))","0");
milT2=Point("milT2","CtrArchb+(BordAB-CtrArchb)*(cos(angAB)-i*sin(angAB))","0");
mil2exT1=Point("mil2exT1","CtrArchb+(LeExBord-CtrArchb)*(cos(angExAB)-i*sin(angExAB))","0");
mil2exT2=Point("mil2exT2","CtrArchb+(LeExBord-CtrArchb)*(cos(angExAB)+i*sin(angExAB))","0");
milT1int=Expression("milT1int","","","","x(milT1)^2+4*y(milT1)^2<1","-0.153082326126401","1.7412703233488258");
mil2exT1int=Expression("mil2exT1int","","","","x(mil2exT1)^2+4*y(mil2exT1)^2<1","0.044250641627615384","1.445270871717801");
Mie=Point("Mie","(d(BordAB,ABExt)>hLongAB/2)?ABExt+(BordAB-ABExt)*hLongAB/(2*d(ABExt,BordAB)):(milT1int==1)?milT1:milT2","0");
Mee=Point("Mee","(d(NewBord,NewEx)>longMil)?NewEx+(NewBord-NewEx)*longMil/(d(NewEx,NewBord)):(mil2exT1int ==1)? mil2exT1: mil2exT2","0");
LeMil=Point("LeMil","(AExt+BExt==0)?Mii:(AExt+BExt==1)?Mie:EntreAetB?(A+B)/2:Mee","0");
