\n  caHP_240_11();\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((252));\n}\n\n// Décrire cette fonction…\nfunction Hexa(blockly_local_a) {\n  if (blockly_local_a == 1) {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caHH\")),false);\n  } else {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  }\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 6 ; blockly_var_count2++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(-(60));\n  };\n  if ((mono) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    if ((mono) == 1) {\n      TURTLE_COLOUR((Math.plus((coul),(dekal))));\n    }\n  }\n  TURTLE_FILL((op));\n  TURTLE_TURN(-(120));\n}\n\n// Décrire cette fonction…\nfunction Penta() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= 5 ; blockly_var_count4++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(-(72));\n  };\n  if ((mono) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    if ((mono) == 1) {\n      TURTLE_COLOUR((coul));\n    }\n  }\n  TURTLE_TURN(-(108));\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction caHP_240_11() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((240));\n  Avancerkaretes(1, 1);\n}\n\n// Décrire cette fonction…\nfunction CornesP1() {\n  DeuxHexaUnPenta();\n  Avancerkaretes(2, 2);\n  Hexa(2);\n  Avancerkaretes(5, 1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((252));\n  Avancerkaretes(3, 2);\n  Hexa(2);\n  Avancerkaretes(3, 1);\n  Penta();\n  Avancerkaretes(1, 2);\n  DeuxHexaUnPenta();\n  Avancerkaretes(2, 2);\n}\n\n// Décrire cette fonction…\nfunction caHP_240() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((240));\n}\n\n// Décrire cette fonction…\nfunction Fleur_2_P2() {\n  Hexa(2);\n  Avancerkaretes(1, 1);\n  Penta();\n  Avancerkaretes(2, 2);\n  Hexa(2);\n  for (var blockly_var_count5 = 1 ; blockly_var_count5 <= 2 ; blockly_var_count5++){\n    Hexa(1);\n    Avancerkaretes(5, 1);\n    caHH();\n    Penta();\n    Avancerkaretes(4, 2);\n    caHP_240();\n  };\n  Hexa(1);\n  Avancerkaretes(5, 1);\n  caHH();\n  caHP_252_12();\n  caHP_240_11();\n  Avancerkaretes(2, 1);\n  caHP_252();\n}\n\n// Décrire cette fonction…\nfunction Fleur_2_P1() {\n  Avancerkaretes(2, 2);\n  Hexa(2);\n  Avancerkaretes(5, 1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((252));\n  Hexa(2);\n  Avancerkaretes(5, 1);\n  caHP_252_12();\n  DeuxHexaUnPenta();\n  Avancerkaretes(1, 2);\n  Hexa(2);\n  Avancerkaretes(3, 1);\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction CornesP3_RetourCentre() {\n  Avancerkaretes(5, 1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHH\")),false);\n  TURTLE_TURN((240));\n  caHP_252_12();\n  caHP_240_11();\n  caHP_252_12();\n  caHP_240_11();\n  caHP_252_12();\n  Avancerkaretes(1, 2);\n  caHP_240_11();\n  caHP_252_12();\n  caHP_240_11();\n  Avancerkaretes(1, 1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHH\")),false);\n  TURTLE_TURN((240));\n  Avancerkaretes(2, 1);\n  caHP_252_12();\n  Avancerkaretes(2, 2);\n}\n\n// Décrire cette fonction…\nfunction Fleur_2_P3() {\n  Hexa(2);\n  Avancerkaretes(2, 1);\n  Hexa(1);\n  for (var blockly_var_count6 = 1 ; blockly_var_count6 <= 2 ; blockly_var_count6++){\n    Penta();\n    Avancerkaretes(4, 2);\n    caHP_240();\n    Hexa(1);\n    Avancerkaretes(5, 1);\n    caHH();\n  };\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction caHH() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHH\")),false);\n  TURTLE_TURN((240));\n}\n\n// Décrire cette fonction…\nfunction Fleur_2_P4() {\n  Avancerkaretes(4, 2);\n  caHP_240();\n  caHH();\n  Avancerkaretes(2, 1);\n  caHP_252();\n  Hexa(2);\n  Avancerkaretes(5, 1);\n  caHP_252();\n}\n\n// Décrire cette fonction…\nfunction CornesP4_droite() {\n  DeuxHexaUnPenta();\n  Avancerkaretes(1, 2);\n  Hexa(2);\n  Avancerkaretes(1, 1);\n  Penta();\n  Avancerkaretes(2, 2);\n  for (var blockly_var_count7 = 1 ; blockly_var_count7 <= 2 ; blockly_var_count7++){\n    Hexa(2);\n    Avancerkaretes(1, 1);\n    Penta();\n    Avancerkaretes(1, 2);\n  };\n  Hexa(2);\n  Hexa(1);\n}\n\n// Décrire cette fonction…\nfunction caHP_252() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((252));\n}\n\n// Décrire cette fonction…\nfunction CornesP2_gauche() {\n  DeuxHexaUnPenta();\n  Avancerkaretes(2, 2);\n  Hexa(2);\n  Avancerkaretes(3, 1);\n  Penta();\n  Avancerkaretes(1, 2);\n  for (var blockly_var_count8 = 1 ; blockly_var_count8 <= 2 ; blockly_var_count8++){\n    Hexa(2);\n    Avancerkaretes(3, 1);\n    Penta();\n    Avancerkaretes(2, 2);\n  };\n  Hexa(2);\n  Avancerkaretes(4, 1);\n  Hexa(1);\n}\n\n// Décrire cette fonction…\nfunction InitPentaSol() {\n  GLOBAL_SET(\"cote\",(Math.times((d((O),(A))),Math.times(2,Math.sin(36)))));\n  GLOBAL_SET(\"adHH\",(Math.plus(138,Math.plus(Math.quotient(11,60),Math.quotient(22,3600)))));\n  GLOBAL_SET(\"adHP\",(Math.plus(142,Math.plus(Math.quotient(37,60),Math.quotient(21,3600)))));\n  GLOBAL_SET(\"caHH\",(Math.times((coef),Math.minus(180,(GLOBAL_GET(\"adHH\"))))));\n  GLOBAL_SET(\"caHP\",(Math.times((coef),Math.minus(180,(GLOBAL_GET(\"adHP\"))))));\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(54));\n  TURTLE_COLOUR((coul));\n  for (var blockly_var_count9 = 1 ; blockly_var_count9 <= 5 ; blockly_var_count9++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN((72));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction DeuxHexaUnPenta() {\n  Hexa(2);\n  Avancerkaretes(2, 1);\n  Hexa(1);\n  Avancerkaretes(2, 1);\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction PeauOrange_P3etP4() {\n  Avancerkaretes(2, 1);\n  for (var blockly_var_count10 = 1 ; blockly_var_count10 <= 4 ; blockly_var_count10++){\n    Penta();\n    Avancerkaretes(1, 2);\n    Hexa(2);\n    Avancerkaretes(3, 1);\n  };\n  Penta();\n  Avancerkaretes(2, 2);\n  Hexa(2);\n  Avancerkaretes(2, 1);\n  for (var blockly_var_count11 = 1 ; blockly_var_count11 <= 4 ; blockly_var_count11++){\n    Hexa(1);\n    Avancerkaretes(3, 1);\n  };\n  Avancerkaretes(1, 1);\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction caHP_252_12() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caHP\")),false);\n  TURTLE_TURN((252));\n  Avancerkaretes(1, 2);\n}\n\n// Décrire cette fonction…\nfunction PeauOrange_P1etP2() {\n  Hexa(2);\n  for (var blockly_var_count12 = 1 ; blockly_var_count12 <= 4 ; blockly_var_count12++){\n    Hexa(1);\n    Avancerkaretes(1, 1);\n  };\n  Avancerkaretes(1, 1);\n  Penta();\n  Avancerkaretes(1, 2);\n  Hexa(2);\n  Avancerkaretes(1, 1);\n  for (var blockly_var_count13 = 1 ; blockly_var_count13 <= 4 ; blockly_var_count13++){\n    Penta();\n    Avancerkaretes(2, 2);\n    Hexa(2);\n    Avancerkaretes(1, 1);\n  };\n  Avancerkaretes(1, 1);\n  Hexa(1);\n}\n\n// Décrire cette fonction…\nfunction Fleur_2_P5() {\n  Hexa(2);\n  Avancerkaretes(2, 1);\n  Hexa(1);\n  Avancerkaretes(1, 1);\n  Hexa(1);\n  for (var blockly_var_count14 = 1 ; blockly_var_count14 <= 2 ; blockly_var_count14++){\n    Penta();\n    Avancerkaretes(4, 2);\n    caHP_240();\n    Hexa(1);\n    Avancerkaretes(5, 1);\n    caHH();\n  };\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction Avancerkaretes(blockly_local_k,blockly_local_p) {\n   var blockly_var_rotloc = 60;\n  if (blockly_local_p == 2) {\n    blockly_var_rotloc = Math.plus(blockly_var_rotloc,12);\n  }\n  TURTLE_UP(true);\n  for (var blockly_var_count15 = 1 ; blockly_var_count15 <= blockly_local_k ; blockly_var_count15++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(blockly_var_rotloc);\n  };\n  TURTLE_UP(false);\n}\n\n\nTURTLE_COLOUR((coul));\nTURTLE_WIDTH((ep));\nInitPentaSol();\nif ((Pat) == 1) {\n  PeauOrange_P1etP2();\n  PeauOrange_P3etP4();\n} else {\n  if ((Pat) == 2) {\n    CornesP1();\n    CornesP2_gauche();\n    CornesP3_RetourCentre();\n    CornesP4_droite();\n  } else {\n    if ((Pat) == 3) {\n      for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 4 ; blockly_var_count3++){\n        UnePetale();\n        RetourPetale();\n      };\n      UnePetale();\n      Penta();\n    } else {\n      if ((Pat) == 4) {\n        DoublePeauOrange_P1();\n        TURTLE_UP(true);\n        TURTLE_JOIN_PT((A));\n        TURTLE_UP(false);\n        TURTLE_RESET();\n        TURTLE_ROTATE_PT((O));\n        TURTLE_TURN(-(54));\n        DoublePeauOrange_P2();\n      } else {\n        Fleur_2_P1();\n        Fleur_2_P2();\n        Fleur_2_P3();\n        Fleur_2_P4();\n        Fleur_2_P5();\n      }\n    }\n  }\n}","parents":["mono","dekal","coul","op","ep","Pat","O","coef"]},"current":"onlogo"});


