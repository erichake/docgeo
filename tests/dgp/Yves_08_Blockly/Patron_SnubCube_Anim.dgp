(0, 2);\n    TURTLE_TURN((60));\n    TURTLE_ROTATE((GLOBAL_GET(\"caTC\")),false);\n    Avance_k_aretes(1, 90);\n  };\n  TURTLE_TURN((90));\n  TURTLE_ROTATE((GLOBAL_GET(\"caTC\")),false);\n  Avance_k_aretes(1, 120);\n  TriangleD(1);\n}\n\n// Décrire cette fonction…\nfunction TriangleG(blockly_local_Somm,blockly_local_TrCa) {\n  if (blockly_local_TrCa == 1) {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  } else {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caTC\")),false);\n  }\n  TURTLE_TURN(-(60));\n  if ((ChCoul) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    if ((ChCoul) == 1) {\n      TURTLE_COLOUR((Math.plus((coul),Math.times(Math.plus(1,blockly_local_Somm),(dekal)))));\n    } else {\n      TURTLE_COLOUR((coul));\n    }\n  }\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 3 ; blockly_var_count2++){\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_TURN((120));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction CarreD() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTC\")),false);\n  TURTLE_TURN(-(90));\n  if ((ChCoul) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    TURTLE_COLOUR((coul));\n  }\n  for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 4 ; blockly_var_count3++){\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_TURN((90));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction TriangleD(blockly_local_Somm) {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  TURTLE_TURN(-(60));\n  if ((ChCoul) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    if ((ChCoul) == 1) {\n      TURTLE_COLOUR((Math.plus((coul),Math.times(Math.plus(1,blockly_local_Somm),(dekal)))));\n    } else {\n      TURTLE_COLOUR((coul));\n    }\n  }\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= 3 ; blockly_var_count4++){\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_TURN((120));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction Feuille_droite() {\n  TriangleG(0, 2);\n  TriangleD(0);\n  TriangleG(1, 1);\n  TURTLE_TURN((60));\n  TURTLE_ROTATE((GLOBAL_GET(\"caTT\")),false);\n  Avance_k_aretes(1, 120);\n  CarreD();\n  for (var blockly_var_count5 = 1 ; blockly_var_count5 <= 3 ; blockly_var_count5++){\n    TriangleG(0, 2);\n    TURTLE_TURN((60));\n    TURTLE_ROTATE((GLOBAL_GET(\"caTC\")),false);\n    Avance_k_aretes(1, 90);\n  };\n  Avance_k_aretes(1, 90);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTC\")),false);\n  TURTLE_TURN(-(60));\n  Avance_k_aretes(1, 120);\n  TriangleD(1);\n}\n\n// Décrire cette fonction…\nfunction InitPatron() {\n  GLOBAL_SET(\"AB\",(Math.times((d((O),(A))),Math.sqrt(2))));\n  GLOBAL_SET(\"adTC\",(Math.plus(142,Math.quotient(59,60))));\n  GLOBAL_SET(\"adTT\",(Math.plus(153,Math.plus(Math.quotient(14,60),Math.quotient(4,3600)))));\n  GLOBAL_SET(\"caTT\",(Math.times((a),Math.minus(180,(GLOBAL_GET(\"adTT\"))))));\n  GLOBAL_SET(\"caTC\",(Math.times((a),Math.minus(180,(GLOBAL_GET(\"adTC\"))))));\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(45));\n  TURTLE_WIDTH((ep));\n  TURTLE_COLOUR((coul));\n  for (var blockly_var_count6 = 1 ; blockly_var_count6 <= 4 ; blockly_var_count6++){\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_TURN((90));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction Coupole_Sup_C3_A9rieure_gauche() {\n  TriangleG(null, 1);\n  Avance_k_aretes(1, 120);\n  CarreD();\n  for (var blockly_var_count7 = 1 ; blockly_var_count7 <= 3 ; blockly_var_count7++){\n    TriangleG(null, 2);\n    TURTLE_TURN((60));\n    TURTLE_ROTATE((GLOBAL_GET(\"caTC\")),false);\n    Avance_k_aretes(1, 90);\n  };\n}\n\n// Décrire cette fonction…\nfunction Avance_k_aretes(blockly_local_k,blockly_local_ang) {\n  TURTLE_UP(true);\n  for (var blockly_var_count8 = 1 ; blockly_var_count8 <= blockly_local_k ; blockly_var_count8++){\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_TURN(blockly_local_ang);\n  };\n  TURTLE_UP(false);\n}\n\n// Décrire cette fonction…\nfunction ReInitLocal() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n  TURTLE_UP(false);\n  TURTLE_RESET();\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(45));\n}\n\n// Décrire cette fonction…\nfunction Coupole_Sup_C3_A9rieure_droite() {\n  Avance_k_aretes(1, 120);\n  TriangleG(0, 1);\n  CarreD();\n  for (var blockly_var_count9 = 1 ; blockly_var_count9 <= 3 ; blockly_var_count9++){\n    TriangleG(0, 2);\n    TURTLE_TURN((60));\n    TURTLE_ROTATE((GLOBAL_GET(\"caTC\")),false);\n    Avance_k_aretes(1, 90);\n  };\n}\n\n\nInitPatron();\nfor (var blockly_var_i = 1 ; blockly_var_i <= 4 ; blockly_var_i = blockly_var_i + 1){\n  ReInitLocal();\n  Avance_k_aretes(blockly_var_i, 90);\n  if ((chiral) == 0) {\n    Feuille_gauche();\n  } else {\n    Feuille_droite();\n  }\n};\nif ((chiral) == 0) {\n  Coupole_Sup_C3_A9rieure_gauche();\n} else {\n  Coupole_Sup_C3_A9rieure_droite();\n}\n","parents":["ChCoul","dekal","coul","op","chiral","O","a","ep"]},"current":"onlogo"});


