blk_turtle_exp_A=Expression("blk_turtle_exp_A","","","","var bl_hcghiccd=function(){\nTURTLE_INIT(\"A\",A);\n// Décrire cette fonction…\nfunction Triangle_et_suivre(blockly_local_Somm,blockly_local_TrPenta,blockly_local_suiv) {\n  if (blockly_local_TrPenta == 1) {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  } else {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caTP\")),false);\n  }\n  TURTLE_TURN(-(60));\n  if ((ChCoul) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    if ((ChCoul) == 1) {\n      TURTLE_COLOUR((Math.plus((coul),Math.times(Math.plus(1,blockly_local_Somm),(dekal)))));\n    } else {\n      TURTLE_COLOUR((coul));\n    }\n  }\n  for (var blockly_var_count = 1 ; blockly_var_count <= 3 ; blockly_var_count++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN((120));\n  };\n  TURTLE_FILL((op));\n  Avance_k_AretePlan(blockly_local_suiv, 120);\n}\n\n// Décrire cette fonction…\nfunction Penta() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTP\")),false);\n  if ((ChCoul) == 0) {\n    TURTLE_COLOUR_INCREMENT((dekal));\n  } else {\n    TURTLE_COLOUR((coul));\n  }\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 5 ; blockly_var_count2++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(-(72));\n  };\n  TURTLE_FILL((op));\n  TURTLE_TURN(-(108));\n}\n\n// Décrire cette fonction…\nfunction Fleur_Principale(blockly_local_k) {\n  Monter_Bande6();\n  Descendre_Bande6();\n  Triangle_et_suivre(0, 1, 1);\n  Penta();\n  Avance_k_AretePlan(1, 72);\n  Monter_Bande6();\n  if (blockly_local_k == 4) {\n    Penta();\n    Avance_k_AretePlan(4, 72);\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caTP\")),false);\n    TURTLE_TURN(-(60));\n    Avance_k_AretePlan(2, 120);\n  }\n  Descendre_Bande6();\n  TURTLE_TURN((60));\n  TURTLE_ROTATE((GLOBAL_GET(\"caTP\")),false);\n  Avance_k_AretePlan(1, 72);\n  Triangle_et_suivre(0, 2, 0);\n  Triangle_et_suivre(0, 1, 1);\n  Penta();\n  Avance_k_AretePlan(1, 72);\n  Triangle_et_suivre(0, 2, 0);\n}\n\n// Décrire cette fonction…\nfunction InitPentaSol() {\n  GLOBAL_SET(\"cote\",(Math.times((d((O),(A))),Math.times(2,Math.sin(36)))));\n  GLOBAL_SET(\"adTT\",(Math.plus(164,Math.plus(Math.quotient(10,60),Math.quotient(31,3600)))));\n  GLOBAL_SET(\"adTP\",(Math.plus(152,Math.plus(Math.quotient(55,60),Math.quotient(53,3600)))));\n  GLOBAL_SET(\"caTT\",(Math.times((coef),Math.minus(180,(GLOBAL_GET(\"adTT\"))))));\n  GLOBAL_SET(\"caTP\",(Math.times((coef),Math.minus(180,(GLOBAL_GET(\"adTP\"))))));\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(54));\n  TURTLE_WIDTH((ep));\n  TURTLE_COLOUR((coul));\n  for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 5 ; blockly_var_count3++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN((72));\n  };\n  TURTLE_FILL((op));\n}\n\n// Décrire cette fonction…\nfunction Retour_en_A() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n  TURTLE_UP(false);\n  TURTLE_RESET();\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(54));\n}\n\n// Décrire cette fonction…\nfunction Avance_k_AretePlan(blockly_local_k,blockly_local_angG) {\n  TURTLE_UP(true);\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= blockly_local_k ; blockly_var_count4++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(blockly_local_angG);\n  };\n  TURTLE_UP(false);\n}\n\n// Décrire cette fonction…\nfunction Descendre_Bande6() {\n  TURTLE_TURN((60));\n  TURTLE_ROTATE((GLOBAL_GET(\"caTT\")),false);\n  Avance_k_AretePlan(1, 120);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  TURTLE_TURN(-(60));\n  Avance_k_AretePlan(1, 120);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  TURTLE_TURN(-(60));\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  TURTLE_TURN(-(60));\n  Avance_k_AretePlan(1, 120);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caTT\")),false);\n  TURTLE_TURN(-(60));\n  Avance_k_AretePlan(1, 120);\n}\n\n// Décrire cette fonction…\nfunction Monter_Bande6() {\n  Triangle_et_suivre(0, 2, 1);\n  Triangle_et_suivre(1, 1, 0);\n  Triangle_et_suivre(0, 1, 1);\n  Triangle_et_suivre(0, 1, 0);\n  Triangle_et_suivre(1, 1, 1);\n  Triangle_et_suivre(0, 1, 0);\n}\n\n\nInitPentaSol();\nfor (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n  Retour_en_A();\n  Avance_k_AretePlan(blockly_var_i, 72);\n  Fleur_Principale(blockly_var_i);\n};\nreturn TURTLE_RESULT()\n};\nbl_hcghiccd()","-14.578122840388035","-56.616021106705155");
