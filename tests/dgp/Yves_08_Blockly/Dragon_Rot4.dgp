blk_turtle_exp_P1=Expression("blk_turtle_exp_P1","","","","var bl_eibfhfcgi=function(){\nTURTLE_INIT(\"P1\",P1);\n// Décrire cette fonction…\nfunction DragonRec(blockly_local_p,blockly_local_oriente) {\n  if (blockly_local_p == 0) {\n    TURTLE_MV((taille),true);\n  } else {\n    DragonRec(Math.minus(blockly_local_p,1), 1);\n    TURTLE_TURN((Math.times(90,blockly_local_oriente)));\n    DragonRec(Math.minus(blockly_local_p,1), -1);\n  }\n}\n\n\nTURTLE_COLOUR((coul));\nTURTLE_WIDTH(0.7);\nfor (var blockly_var_i = 1 ; blockly_var_i <= 4 ; blockly_var_i = blockly_var_i + 1){\n  DragonRec((n), 1);\n  TURTLE_COLOUR_INCREMENT(9);\n};\nreturn TURTLE_RESULT()\n};\nbl_eibfhfcgi()","-12.225","7.8125");
blk_turtle_list_P1=List("blk_turtle_list_P1",blk_turtle_exp_P1);
E1=Expression("E1","longueur de la trace : ","","","var bl_begijfejabaab=function(){\nreturn ((TURTLE_LENGTH(\"P1\")));\n};\nbl_begijfejabaab()","-8.475","8.3125");


