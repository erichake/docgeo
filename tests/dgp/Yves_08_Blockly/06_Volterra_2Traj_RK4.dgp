)];\n}\n\n\nblockly_var_VolteraRK = [];\nblockly_var_VolteraRK.push(M);\nblockly_var_Un = (M);\nblockly_var_demih = quotient((h),2);\nblockly_var_sixiemh = quotient((h),6);\nfor (var blockly_var_i = 1 ; blockly_var_i <= (n) ; blockly_var_i = blockly_var_i + 1){\n  blockly_var_U1 = blockly_var_Un;\n  blockly_var_U2 = plus(blockly_var_Un,times(blockly_var_demih,fnctRK(blockly_var_U1)));\n  blockly_var_U3 = plus(blockly_var_Un,times(blockly_var_demih,fnctRK(blockly_var_U2)));\n  blockly_var_U4 = plus(blockly_var_Un,times((h),fnctRK(blockly_var_U3)));\n  blockly_var_LesSom = plus(fnctRK(blockly_var_U1),plus(times(2,plus(fnctRK(blockly_var_U2),fnctRK(blockly_var_U3))),fnctRK(blockly_var_U4)));\n  blockly_var_Usuiv = plus(blockly_var_Un,times(blockly_var_sixiemh,blockly_var_LesSom));\n  blockly_var_VolteraRK.push(blockly_var_Usuiv);\n  blockly_var_Un = blockly_var_Usuiv;\n};\nreturn (blockly_var_VolteraRK);","parents":["M","h","n","a","b","d","c"]},"current":"oncompute"});


// Texts :
Text("<span style=\"color:#0000FF\">$\\large Les \\;trajectoires \\;du \\; mod\\grave{e}le \\; de \\; Volterra$\n<span style=\"color:#FF0000\">$\\large D'une \\; mani\\grave{e}re \\; g\\acute{e}n\\acute{e}rale \\; les \\; trajectoires$\n$\\large ne \\; se \\;coupent \\; pas, \\; et \\; il \\; en \\;passe \\;une$\n$\\large (et \\; une \\; seule) \\; en \\; chaque \\; point \\; M(x_0,y_0)$\n",567,20,453,124,"c:rgba(232,246,125,0.18);s:3;r:15;p:4");
Text("<div style='color:#0000FF;text-align:left'>Pour le confort d'utilisation, les trajectoires\nsont approxim\u00e9es par une m\u00e9thode plus efficace\nque celle d'Euler (dite Runge-Kutta 4)\nqui sera \u00e9tudi\u00e9es dans les ann\u00e9es suivantes.",700,576,372,88,"c:rgba(47,107,214,0.18);s:3;r:15;p:4");
