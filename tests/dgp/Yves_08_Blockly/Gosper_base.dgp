blk_turtle_exp_P1=Expression("blk_turtle_exp_P1","","","","var bl_hbibdjhij=function(){\nTURTLE_INIT(\"P1\",P1);\n// Décrire cette fonction…\nfunction GosperG(blockly_local_p) {\n  if (blockly_local_p == 0) {\n    TURTLE_MV((taille),true);\n  } else {\n     var blockly_var_pMoins1G = Math.minus(blockly_local_p,1);\n    GosperG(blockly_var_pMoins1G);\n    TURTLE_TURN((60));\n    GosperD(blockly_var_pMoins1G);\n    TURTLE_TURN((120));\n    GosperD(blockly_var_pMoins1G);\n    TURTLE_TURN(-(60));\n    GosperG(blockly_var_pMoins1G);\n    TURTLE_TURN(-(120));\n    GosperG(blockly_var_pMoins1G);\n    GosperG(blockly_var_pMoins1G);\n    TURTLE_TURN(-(60));\n    GosperD(blockly_var_pMoins1G);\n    TURTLE_TURN((60));\n  }\n}\n\n// Décrire cette fonction…\nfunction GosperD(blockly_local_p) {\n  if (blockly_local_p == 0) {\n    TURTLE_MV((taille),true);\n  } else {\n    TURTLE_TURN(-(60));\n     var blockly_var_pMoins1D = Math.minus(blockly_local_p,1);\n    GosperG(blockly_var_pMoins1D);\n    TURTLE_TURN((60));\n    GosperD(blockly_var_pMoins1D);\n    GosperD(blockly_var_pMoins1D);\n    TURTLE_TURN((120));\n    GosperD(blockly_var_pMoins1D);\n    TURTLE_TURN((60));\n    GosperG(blockly_var_pMoins1D);\n    TURTLE_TURN(-(120));\n    GosperG(blockly_var_pMoins1D);\n    TURTLE_TURN(-(60));\n    GosperD(blockly_var_pMoins1D);\n  }\n}\n\n\nGosperG((n));\nreturn TURTLE_RESULT()\n};\nbl_hbibdjhij()","-12.225","7.8125");
blk_turtle_list_P1=List("blk_turtle_list_P1",blk_turtle_exp_P1);


