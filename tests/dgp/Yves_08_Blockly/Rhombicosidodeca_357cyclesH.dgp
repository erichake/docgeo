BLK_GLOB_SET({"cote":1.3056359613344823,"Nouvelle variable…":12.54316666666667,"Renommer la variable…":null,"adCP":148.2825,"adCT":159.09472222222223,"caCP":31.7175,"caCT":20.90527777777777,"angleDec":32,"UnCycleH":[1,2,13,8,9,22,290,27,26,31,21,20,41,36,52,53,54,323,59,58,124,191,259,254,264,269,253,291,242,237]});


// Texts :
Text("<div style=\u2018font-size:20px;color:#CC0000;text-align:center\u2019>357 cycles hamiltoniens sur le Rhombicosidod\u00e9ca\u00e8dre.\n<div style=\u2018font-size:16px;color:#0000FF;text-align:left;\u2019>\ncycle : qui revient \u00e0 son point de d\u00e9part.\nhamiltonien : parcours des sommets, une seule fois.\n\nUn premier cycle hamiltonien est cr\u00e9\u00e9 (chDeb=1,chFin=1) avec les 30 premiers sommets plus ou moins sur un seul h\u00e9misph\u00e8re et les 30 autres sur l\u2019autre.\n\nSur cette base, deux partitions sont cr\u00e9es, celles des 30 premiers sommets utilis\u00e9s, et celle des 30 derniers (31 avec le retour en A - croix bleue).\nPour chaque partition on cr\u00e9e plusiers variantes du parcours de ces 30 sommets, que l\u2019on obtient par les deux curseurs de choix chDeb pour les 30 premiers (17 possibilit\u00e9s) et chFin pour les 30 derniers (21 possibilit\u00e9s). Il y a donc 357 cycles hamiltoniens dans cette figure, construits sur deux partitions d\u2019un cycle.\n\nPour s\u00e9lectionner la premi\u00e8re partition mettre khdeb \u00e0 1 et kHfin \u00e0 30, pour la derni\u00e8re, kHdeb \u00e0 30 et kHfin \u00e0 61.\n\nOn peut afficher ou non les indices des points dans la trace de A. Le code de ces traitements est dans le point O (croix rouge, origine du rep\u00e8re 3D).",33,18,558,421,"c:rgba(145,218,242,0.18);s:3;r:15;p:4");
