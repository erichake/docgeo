d</field><field name=\"UNITS\">un</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"?NL{#26bi`0)z4;Mf|9U\"><field name=\"NUM\">60</field></shadow><block type=\"dgpad_global_get\" id=\"iZ^MW_khBxlp`:E-BBKj\"><field name=\"VAR\">cote</field></block></value><next><block type=\"turtle_turn\" id=\"SMZSvHr7u__0i:3_T0ue\"><field name=\"DIR\">turnRight</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"`]i*4;=1b)r_{uC:QvRR\"><field name=\"ANGLE\">72</field></shadow></value></block></next></block></statement><next><block type=\"turtle_turn\" id=\"lQxHU`g.e?,JGQ(yb!]:\"><field name=\"DIR\">turnRight</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\":17*NkwYd*V?DLPPAj[y\"><field name=\"ANGLE\">108</field></shadow></value></block></next></block></next></block></statement></block><block type=\"procedures_defnoreturn\" id=\"n5d(/(F*|[^vWOmCkyP=\" x=\"-4869\" y=\"-1054\"><mutation><arg name=\"k\"></arg><arg name=\"angG\"></arg></mutation><field name=\"NAME\">Avance_k_AretePlan</field><comment pinned=\"false\" h=\"80\" w=\"160\">Décrire cette fonction…</comment><statement name=\"STACK\"><block type=\"turtle_pen\" id=\"mbL,c6}*.iX9+00mV,@,\"><field name=\"PEN\">penUp</field><next><block type=\"controls_repeat_ext\" id=\"0Gg;phodg5BhUM;ykHsS\"><value name=\"TIMES\"><block type=\"variables_get\" id=\"Ma~yxwJ[kF~vVLj{cqLG\"><field name=\"VAR\">k</field></block></value><statement name=\"DO\"><block type=\"turtle_move\" id=\"fVhPLPDUerT5A++Lb+jq\"><field name=\"DIR\">moveForward</field><field name=\"UNITS\">un</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\"We[lbS4pvife*k#PO/_)\"><field name=\"NUM\">60</field></shadow><block type=\"dgpad_global_get\" id=\"TH.*kr%Ia4{HP@u^Qt^j\"><field name=\"VAR\">cote</field></block></value><next><block type=\"turtle_turn\" id=\")7X,sr/b}wQO5C!cqVZr\"><field name=\"DIR\">turnLeft</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\";b6U;i|[rlK-Te^%n+^@\"><field name=\"ANGLE\">72</field></shadow><block type=\"variables_get\" id=\"Ijs*w~}awF5ex53q}x9g\"><field name=\"VAR\">angG</field></block></value></block></next></block></statement><next><block type=\"turtle_pen\" id=\"!T8.O,nzY~KSq+I|SXZ3\"><field name=\"PEN\">penDown</field></block></next></block></next></block></statement></block></xml>","sync":"// Décrire cette fonction…\nfunction Feuille_principale() {\n  Motif_Carr_C3_A9_TR_gauche(3);\n  Penta();\n  Avance_k_AretePlan(1, 72);\n  Motif_Carr_C3_A9_TR_gauche(1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caCP\")),false);\n  TURTLE_TURN(-(108));\n  Motif_Carr_C3_A9_TR_gauche(1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caCP\")),false);\n  TURTLE_TURN(-(108));\n  Carre(2);\n  TURTLE_TURN((90));\n  TURTLE_ROTATE((GLOBAL_GET(\"caCP\")),false);\n  TURTLE_TURN((108));\n  TURTLE_ROTATE((GLOBAL_GET(\"caCP\")),false);\n  Avance_k_AretePlan(2, 90);\n  Penta();\n  Avance_k_AretePlan(1, 72);\n  Motif_Carr_C3_A9_TR_gauche(1);\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caCP\")),false);\n  TURTLE_TURN(-(108));\n  Carre(2);\n}\n\n// Décrire cette fonction…\nfunction Motif_Carr_C3_A9_TR_gauche(blockly_local_k) {\n  Carre(2);\n  Avance_k_AretePlan(2, 90);\n  Triangle_et_suivre(blockly_local_k);\n}\n\n// Décrire cette fonction…\nfunction InitPentaSol() {\n  GLOBAL_SET(\"cote\",(Math.times((d((O),(A))),Math.times(2,Math.sin(36)))));\n  GLOBAL_SET(\"adCT\",(Math.plus(159,Math.plus(Math.quotient(5,60),Math.quotient(41,3600)))));\n  GLOBAL_SET(\"adCP\",(Math.plus(148,Math.plus(Math.quotient(16,60),Math.quotient(57,3600)))));\n  GLOBAL_SET(\"caCT\",(Math.minus(180,(GLOBAL_GET(\"adCT\")))));\n  GLOBAL_SET(\"caCP\",(Math.minus(180,(GLOBAL_GET(\"adCP\")))));\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(54));\n  for (var blockly_var_count = 1 ; blockly_var_count <= 5 ; blockly_var_count++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN((72));\n  };\n}\n\n// Décrire cette fonction…\nfunction Carre(blockly_local_TrPenta) {\n  if (blockly_local_TrPenta == 1) {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caCT\")),false);\n  } else {\n    TURTLE_ROTATE(-(GLOBAL_GET(\"caCP\")),false);\n  }\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 4 ; blockly_var_count2++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(-(90));\n  };\n  TURTLE_TURN(-(90));\n}\n\n// Décrire cette fonction…\nfunction Dernier_Penta() {\n  TURTLE_TURN((90));\n  TURTLE_ROTATE((GLOBAL_GET(\"caCP\")),false);\n  TURTLE_TURN((108));\n  TURTLE_ROTATE((GLOBAL_GET(\"caCP\")),false);\n  Avance_k_AretePlan(2, 90);\n  Penta();\n}\n\n// Décrire cette fonction…\nfunction Triangle_et_suivre(blockly_local_suiv) {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caCT\")),false);\n  TURTLE_TURN(-(60));\n  for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 3 ; blockly_var_count3++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN((120));\n  };\n  TURTLE_TURN((60));\n  TURTLE_ROTATE((GLOBAL_GET(\"caCT\")),false);\n  Avance_k_AretePlan(blockly_local_suiv, 90);\n}\n\n// Décrire cette fonction…\nfunction Retour_en_A(blockly_local_decal) {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n  TURTLE_UP(false);\n  TURTLE_RESET();\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(54));\n  Avance_k_AretePlan(blockly_local_decal, 72);\n}\n\n// Décrire cette fonction…\nfunction Penta() {\n  TURTLE_ROTATE(-(GLOBAL_GET(\"caCP\")),false);\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= 5 ; blockly_var_count4++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(-(72));\n  };\n  TURTLE_TURN(-(108));\n}\n\n// Décrire cette fonction…\nfunction Avance_k_AretePlan(blockly_local_k,blockly_local_angG) {\n  TURTLE_UP(true);\n  for (var blockly_var_count5 = 1 ; blockly_var_count5 <= blockly_local_k ; blockly_var_count5++){\n    TURTLE_MV((GLOBAL_GET(\"cote\")),false);\n    TURTLE_TURN(blockly_local_angG);\n  };\n  TURTLE_UP(false);\n}\n\n\nTURTLE_COLOUR(53);\nTURTLE_WIDTH(0.3);\nInitPentaSol();\nFeuille_principale();\nfor (var blockly_var_i = 1 ; blockly_var_i <= 4 ; blockly_var_i = blockly_var_i + 1){\n  Retour_en_A(blockly_var_i);\n  Feuille_principale();\n};\nDernier_Penta();","parents":["O"]},"current":"onlogo"});


