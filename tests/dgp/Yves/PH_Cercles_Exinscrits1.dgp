Text("<div style='font-size:16px;color:#CC0000;text-align:center'>PSH - Cercles exinscrits d'un triangle<div style='font-size:14px;color:#FF0000;text-align:left'>\nCacher : <div style='color:#0000FF'>Le rep\u00e8re <input type=checkbox target=\"ChRep\">    Les latitudes <input type=checkbox target=\"ChAlt\">\nLes noms des points <input type=checkbox target=\"ChNom\">\nLe remplissage du triangle <input type=checkbox target=\"ChRemplissage\">\nLes bissectrices int\u00e9rieures <input type=checkbox target=\"ChBissInt\">\nLes bissectrices ext\u00e9rieures <input type=checkbox target=\"ChBissExt\">\n",565,15,303,167,"c:rgba(246,249,114,0.18);s:3;r:15;p:4");
