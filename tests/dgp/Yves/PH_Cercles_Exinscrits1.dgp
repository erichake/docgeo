Perp21=Perpendicular("Perp21",L21,P12);
STL(Perp21,"c:#780013;s:1;f:30;p:0");
return [Perp21];
}};

$macros["KBKBMediatrice"]={
	name:"KB/KB Mediatrice",
	parameters:["point","point","circle"],
	exec:
	function (A,B,DL){
Odl=Center("Odl",DL);
L1=Line("L1",A,B);
Perp1=Perpendicular("Perp1",L1,Odl);
