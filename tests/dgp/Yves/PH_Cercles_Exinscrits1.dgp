L2=Line("L2",P11,B);
L3=Line("L3",P11,A);
P2=OrderedIntersection("P2",L3,DL,1);
P3=OrderedIntersection("P3",L2,DL,1);
L4=Line("L4",P2,P3);
Q=OrderedIntersection("Q",L4,L1,0);
P12=Point("P12","Odl+(Q-Odl)*DL^2/d(Odl,Q)^2","0");
L21=Line("L21",Odl,P12);
Perp2=Perpendicular("Perp2",L21,P12);
STL(Perp2,"c:#780013;s:1;f:30;p:0");
return [Perp2];
}};

