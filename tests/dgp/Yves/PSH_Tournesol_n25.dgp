// Macros :
$macros={};
$macros["KBKBCercle"]={
	name:"KB/KB Cercle",
	parameters:["point","point","circle"],
	exec:
	function (O,A,DL){
Odl=Center("Odl",DL);
S1=Line("S1",O,A);
L2=Line("L2",Odl,O);
Perp11=Perpendicular("Perp11",S1,Odl);
Perp1=Perpendicular("Perp1",S1,Odl);
Syma1=Reflection("Syma1",L2,A);
P41=OrderedIntersection("P41",Perp11,S1,0);
P4=OrderedIntersection("P4",Perp1,S1,0);
P111=Point("P111","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
L11=Line("L11",O,P111);
L1=Line("L1",A,P11);
Perp12=Perpendicular("Perp12",L11,Odl);
P411=OrderedIntersection("P411",Perp12,L11,0);
P112=Point("P112","Odl+(P411-Odl)*DL^2/d(Odl,P411)^2","0");
L21=Line("L21",A,P112);
P6=OrderedIntersection("P6",L21,L11,0);
d1=Line("d1",P112,P6);
C11=Circle("C11",P6,P112);
Perp111=Perpendicular("Perp111",d1,P6);
Perp2=Perpendicular("Perp2",d1,P112);
P42=OrderedIntersection("P42",Perp111,C11,1);
L111=Line("L111",P42,A);
P51=OrderedIntersection("P51",Perp2,L111,0);
Symc1=Symmetry("Symc1",P112,P51);
L211=Line("L211",P42,Symc1);
D=OrderedIntersection("D",L211,d1,0);
Syma2=Reflection("Syma2",L2,D);
L4=Line("L4",D,Syma1);
L3=Line("L3",D,A);
L22=Line("L22",Syma2,Syma1);
P=OrderedIntersection("P",L22,L1,0);
Perp13=Perpendicular("Perp13",L3,P);
N=OrderedIntersection("N",Perp13,L3,0);
M=OrderedIntersection("M",L4,Perp13,0);
L5=Line("L5",A,M);
L6=Line("L6",Syma2,N);
C12=OrderedIntersection("C12",L6,L5,0);
KBC=Quadric("KBC",Syma2,D,Syma1,C12,A);
STL(KBC,"c:#007c7c;s:2.5;f:30;p:200");
return [KBC];
}};

$macros["KBKBdrtFPMNFr12et34Cnk"]={
	name:"KB/KB drtFP M N Fr12et34 Cnk",
	parameters:["point","point","line","line","quadric"],
	exec:
	function(M,N,Fr12,Fr34,Quad){
L2=Line("L2",M,N);
f12mn=OrderedIntersection("f12mn",Fr12,L2,0);
iM=OrderedIntersection("iM",L2,Quad,0);
iN=OrderedIntersection("iN",L2,Quad,1);
f34mn=OrderedIntersection("f34mn",Fr34,L2,0);
Bg=Point("Bg","iN*(x(iN)<x(iM))+iM*(x(iM)<x(iN))","0");
Bd=Point("Bd","iM*(x(iM)>x(iN))+iN*(x(iN)>x(iM))","0");
BgFP=Point("BgFP","isNaN(f12mn.getX())?Bg:f12mn","0");
BdFP=Point("BdFP","isNaN(f34mn.getX())?Bd:f34mn","0");
drtFPmn=Segment("drtFPmn",BgFP,BdFP);
STL(drtFPmn,"c:#006633;s:1;sn:true;f:24");
return [drtFPmn];
}};

$macros["KBKBMeddontOdl"]={
	name:"KB/KB Med dont Odl",
	parameters:["circle","point"],
	exec:
	function (DL,A){
Odl=Center("Odl",DL);
L1=Line("L1",Odl,A);
Perp1=Perpendicular("Perp1",L1,Odl);
Perp2=Perpendicular("Perp2",L1,A);
P1=OrderedIntersection("P1",Perp1,DL,0);
P2=OrderedIntersection("P2",Perp2,DL,0);
L2=Line("L2",P1,P2);
P3=OrderedIntersection("P3",L2,L1,0);
P12=Point("P12","Odl+(P3-Odl)*DL^2/d(Odl,P3)^2","0");
L21=Line("L21",Odl,P12);
Perp21=Perpendicular("Perp21",L21,P12);
STL(Perp21,"c:#780013;s:1;f:30;p:0");
return [Perp21];
}};

$macros["KBKBMediatrice"]={
	name:"KB/KB Mediatrice",
	parameters:["point","point","circle"],
	exec:
	function (A,B,DL){
Odl=Center("Odl",DL);
L1=Line("L1",A,B);
Perp1=Perpendicular("Perp1",L1,Odl);
P4=OrderedIntersection("P4",Perp1,L1,0);
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
L2=Line("L2",P11,B);
L3=Line("L3",P11,A);
P2=OrderedIntersection("P2",L3,DL,1);
P3=OrderedIntersection("P3",L2,DL,1);
L4=Line("L4",P2,P3);
Q=OrderedIntersection("Q",L4,L1,0);
P12=Point("P12","Odl+(Q-Odl)*DL^2/d(Odl,Q)^2","0");
L21=Line("L21",Odl,P12);
Perp2=Perpendicular("Perp2",L21,P12);
STL(Perp2,"c:#780013;s:1;f:30;p:0");
return [Perp2];
}};

$macros["KBKBPerp"]={
	name:"KB/KB Perp",
	parameters:["point","line","circle"],
	exec:
	function (M,S1,DL){
Odl=Center("Odl",DL);
Perp1=Perpendicular("Perp1",S1,Odl);
P4=OrderedIntersection("P4",Perp1,Odl);
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
L1=Line("L1",M,P11);
P5=OrderedIntersection("P5",L1,DL,1);
P6=OrderedIntersection("P6",L1,DL,0);
S2=Segment("S2",P5,P6);
STL(S2,"c:#006633;s:1;f:24");
return [S2];
}};

$macros["KBKBPerpcommune"]={
	name:"KB/KB Perp commune",
	parameters:["line","line","circle"],
	exec:
	function (S2,S1,DL){
Odl=Center("Odl",DL);
Perp11=Perpendicular("Perp11",S2,Odl);
Perp1=Perpendicular("Perp1",S1,Odl);
P4=OrderedIntersection("P4",Perp1,S1,0);
P41=OrderedIntersection("P41",Perp11,S2,0);
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
P111=Point("P111","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
L1=Line("L1",P111,P11);
P7=OrderedIntersection("P7",L1,DL,1);
P8=OrderedIntersection("P8",L1,DL,0);
S3=Segment("S3",P7,P8);
STL(S3,"c:#006633;s:1;f:24");
return [S3];
}};

$macros["KBKBSymortho1pt"]={
	name:"KB/KB Sym ortho 1 pt",
	parameters:["point","line","circle"],
	exec:
	function (M,S1,DL){
Odl=Center("Odl",DL);
Perp1=Perpendicular("Perp1",S1,Odl);
P41=OrderedIntersection("P41",Perp1,S1,0);
P11=Point("P11","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
L2=Line("L2",M,P11);
P6=OrderedIntersection("P6",L2,S1,0);
d1=Line("d1",P11,P6);
C11=Circle("C11",P6,P11);
Perp11=Perpendicular("Perp11",d1,P6);
Perp2=Perpendicular("Perp2",d1,P11);
P42=OrderedIntersection("P42",Perp11,C11,1);
L11=Line("L11",P42,M);
P51=OrderedIntersection("P51",Perp2,L11,0);
Symc1=Symmetry("Symc1",P11,P51);
L21=Line("L21",P42,Symc1);
D=OrderedIntersection("D",L21,d1,0);
STL(D,"c:#b40000;s:6;sn:true;f:30;sp:2");
return [D];
}};

$macros["PSHCoordparAoAuA"]={
	name:"PSH/Coord par A oA uA",
	parameters:["point","point","point"],
	exec:
	function (A,oA,uA){
Ea=Expression("Ea","","","","A-oA","0.4","-0.7");
CdA=Expression("CdA","","","","[uA[2],IF(Ea[1]>0,-\u03C0+acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)),\u03C0-acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)))]","-1","-1.5");
STL(CdA,"c:#435805;s:7;sn:true;f:24;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [CdA];
}};

$macros["PSHDrtLesCoefgOdlMab"]={
	name:"PSH/Drt LesCoef g Odl Mab",
	parameters:["expression","expression","point","point"],
	exec:
	function(LesCoef,g,Odl,Mab){
LongM=Expression("LongM","","","","log((1+x(Mab)-x(Odl))/(1-x(Mab)+x(Odl)))/(2*LesCoef[0])","2.7","-1");
uMab=Expression("uMab","","","","log((1+(y(Mab)-y(Odl))*(exp(LesCoef[0]*LongM)+exp(-LesCoef[0]*LongM))/2)/(1-(y(Mab)-y(Odl))*(exp(LesCoef[0]*LongM)+exp(-LesCoef[0]*LongM))/2))/2","2","-1.5");
LePt=Point("LePt","[xp*(exp(uMab)+exp(-uMab))*cos(LongM-\u03C0)/2,xp*(exp(uMab)+exp(-uMab))*sin(LongM-\u03C0)/2,g(uMab)]","1");
DrtAB=Locus("DrtAB",LePt,Mab);
STL(DrtAB,"c:#fc092f;s:2;sn:true;f:30;p:200");
return [DrtAB];
}};

$macros["PSHEquidistLesCoefguA"]={
	name:"PSH/Equidist LesCoef g uA",
	parameters:["expression","expression","point"],
	exec:
	function(LesCoef,g,uA){
Pxap=Point("Pxap","[LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,0,g(uA[2])]","1");
Pxam=Point("Pxam","[-LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,0,g(uA[2])]","1");
Pya=Point("Pya","[0,LesCoef[0]*(exp(uA[2])+exp(-uA[2]))/2,g(uA[2])]","1");
EquidA=Circle3pts3D("EquidA",Pxap,Pxam,Pya);
STL(EquidA,"c:#0000b2;s:1;sn:true;f:30;p:0");
return [EquidA];
}};

$macros["PSHKBvsPSLesCgOdlPtkb"]={
	name:"PSH/KB vs PS LesC g Odl Ptkb",
	parameters:["expression","expression","point","point"],
	exec:
	function(LesCoef,g,Odl,Ptkb){
longPt=Expression("longPt","","","","log((1+x(Ptkb)-x(Odl))/(1-x(Ptkb)+x(Odl)))/(2*LesCoef[0])","2.25","-0.9");
uPt=Expression("uPt","","","","log((1+(y(Ptkb)-y(Odl))*(exp(LesCoef[0]*longPt)+exp(-LesCoef[0]*longPt))/2)/(1-(y(Ptkb)-y(Odl))*(exp(LesCoef[0]*longPt)+exp(-LesCoef[0]*longPt))/2))/2","1.7","-3.3");
PtS=Point("PtS","[LesCoef[0]*(exp(uPt)+exp(-uPt))*cos(longPt-\u03C0)/2,LesCoef[0]*(exp(uPt)+exp(-uPt))*sin(longPt-\u03C0)/2,g(uPt)]","1");
STL(PtS,"c:#ff8a1c;s:6;f:15;sp:2");
return [PtS];
}};

$macros["PSHPSversKBxpCdAOdl"]={
	name:"PSH/PS vers KB xp CdA Odl",
	parameters:["expression","expression","point"],
	exec:
	function(xp,CdA,Odl){
Akb=Point("Akb","Odl+[(exp(xp*CdA[1])-exp(-xp*CdA[1]))/(exp(xp*CdA[1])+exp(-xp*CdA[1])),((exp(CdA[0])-exp(-CdA[0]))/(exp(CdA[0])+exp(-CdA[0])))/((exp(xp*CdA[1])+exp(-xp*CdA[1]))/2)]","0");
STL(Akb,"c:#0000b2;s:6;sn:true;f:14;sp:1");
return [Akb];
}};

