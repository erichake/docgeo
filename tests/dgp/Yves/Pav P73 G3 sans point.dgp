Center1=Center("Center1",C1);
Center2=Center("Center2",C11);
L1=Line("L1",Center2,Center1);
P1=OrderedIntersection("P1",L3,L1,0);
M1=MidPoint("M1",OHz,P1);
C2=Circle("C2",M1,OHz);
P5=OrderedIntersection("P5",C2,Hz,0);
P6=OrderedIntersection("P6",C2,Hz,1);
oAB3=Point("oAB3","[(y(P6)*(x(P5)^2+y(P5)^2+Hz^2)-y(P5)*(x(P6)^2+y(P6)^2+Hz^2))/(2*(x(P5)*y(P6)-x(P6)*y(P5))),(x(P5)*(x(P6)^2+y(P6)^2+Hz^2)-x(P6)*(x(P5)^2+y(P5)^2+Hz^2))/(2*(x(P5)*y(P6)-x(P6)*y(P5)))]","0");
P23=Point("P23","oAB3+d(P5,oAB3)*((P5+P6)/2-oAB3)/d((P5+P6)/2,oAB3)","0");
C13=Arc3pts("C13",P5,P23,P6);
STL(C13,"c:#cc66cc;s:1;f:30;p:0");
return [C13];
}};

$macros["4Pinceaux3CyclePinceauPt"]={
	name:"4.Pinceaux/3 Cycle Pinceau Pt",
	parameters:["circle","circle","circle","point"],
	exec:
	function(Hz,u,v,M){
OHz=Center("OHz",Hz);
IdA=DefinitionPoint("IdA",u,0);
IdA0=DefinitionPoint("IdA0",v,0);
cMN=Center("cMN",u);
cUV=Center("cUV",v);
SymM=Point("SymM","cMN+(M-cMN)*d(cMN,IdA)^2/d(cMN,M)^2","0");
C2=Circle("C2",cMN,IdA);
C3=Circle("C3",cUV,IdA0);
Sym2M=Point("Sym2M","cUV+(SymM-cUV)*d(cUV,IdA0)^2/d(cUV,SymM)^2","0");
Int1=OrderedIntersection("Int1",C3,C2,0);
Int2=OrderedIntersection("Int2",C3,C2,1);
C1=Circle3pts("C1",M,SymM,Sym2M);
Ctr=Point("Ctr","Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
IdEq1=OrderedIntersection("IdEq1",Hz,C1,1);
IdEq2=OrderedIntersection("IdEq2",Hz,C1,0);
mInvO=Point("mInvO","(OHz+(Ctr-OHz)*Hz^2/d(OHz,Ctr)^2+Ctr)/2","0");
Equi=Arc3pts("Equi",IdEq1,M,IdEq2);
mAA=Point("mAA","(mInvO+(M-mInvO)*d(mInvO,Ctr)^2/d(mInvO,M)^2+M)/2","0");
L2=Line("L2",mInvO,M);
L1=Line("L1",OHz,mInvO);
Perp1=Perpendicular("Perp1",L2,mAA);
P1=OrderedIntersection("P1",L1,Perp1,0);
chOA=Circle("chOA",P1,M);
STL(Ctr,"c:#fc092f;s:4.5;sn:true;f:15;sp:1");
STL(IdEq1,"c:#fc092f;s:4.5;f:15;sp:1");
STL(IdEq2,"c:#fc092f;s:4.5;f:15;sp:1");
STL(Equi,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(chOA,"c:#fc092f;s:1;sn:true;f:30;p:0");
return [Ctr,IdEq1,IdEq2,Equi,chOA];
}};

$macros["4Pinceaux4BissOrient2drtOr"]={
	name:"4.Pinceaux/4 Biss Orient 2drt Or",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdUor=DefinitionPoint("IdUor",C1,0);
IdVor=DefinitionPoint("IdVor",C1,2);
IdCor=DefinitionPoint("IdCor",C11,0);
IdDor=DefinitionPoint("IdDor",C11,2);
L1=Line("L1",IdDor,IdVor);
L2=Line("L2",IdCor,IdUor);
L3=Line("L3",IdDor,IdUor);
L4=Line("L4",IdCor,IdVor);
Pa=OrderedIntersection("Pa",L2,L1,0);
Pb=OrderedIntersection("Pb",L3,L4,0);
Psol=Point("Psol","Pa*(d(Pa,OHz)>Hz)+Pb*(d(Pa,OHz)<=Hz)","0");
M1=MidPoint("M1",Psol,OHz);
C2=Circle("C2",M1,OHz);
P3=OrderedIntersection("P3",C2,Hz,1);
P4=OrderedIntersection("P4",C2,Hz,0);
CtrBiss=Point("CtrBiss","[(y(P3)*(x(P4)^2+y(P4)^2+Hz^2)-y(P4)*(x(P3)^2+y(P3)^2+Hz^2))/(2*(x(P4)*y(P3)-x(P3)*y(P4))),(x(P4)*(x(P3)^2+y(P3)^2+Hz^2)-x(P3)*(x(P4)^2+y(P4)^2+Hz^2))/(2*(x(P4)*y(P3)-x(P3)*y(P4)))]","0");
PCtr=Point("PCtr","CtrBiss+d(P4,CtrBiss)*((P4+P3)/2-CtrBiss)/d((P4+P3)/2,CtrBiss)","0");
IdB=Point("IdB","P3*(d(IdUor,P3)>d(IdVor,P3))+P4*(d(IdUor,P3)<d(IdVor,P3))","0");
IdA=Point("IdA","P3*(d(IdUor,P3)<d(IdVor,P3))+P4*(d(IdUor,P3)>d(IdVor,P3))","0");
BissTO=Arc3pts("BissTO",IdB,PCtr,IdA);
STL(BissTO,"c:#0035ff;s:2;f:30;p:0");
return [IdB,IdA,BissTO];
}};

$macros["4Pinceaux5Inter2pinceaux"]={
	name:"4.Pinceaux/5 Inter 2 pinceaux",
	parameters:["circle","circle","circle","circle","circle"],
	exec:
	function (Hz,C1,C10,C11,C12){
OHz=Center("OHz",Hz);
Center1=Center("Center1",C1);
Center2=Center("Center2",C10);
Center3=Center("Center3",C11);
Center4=Center("Center4",C12);
L1=Line("L1",Center2,Center1);
L2=Line("L2",Center3,Center4);
P1=OrderedIntersection("P1",L1,L2,0);
M1=MidPoint("M1",P1,OHz);
R1=Ray("R1",P1,OHz);
C2=Circle("C2",M1,P1);
P3=OrderedIntersection("P3",Hz,C2,0);
P4=OrderedIntersection("P4",Hz,C2,1);
C3=Circle("C3",P1,P3);
P5=OrderedIntersection("P5",R1,C3,0);
C4=Arc3pts("C4",P4,P5,P3);
STL(C4,"c:#cc66cc;s:1;f:30;p:0");
return [C4];
}};

$macros["4Pinceaux6ProduitabcA"]={
	name:"4.Pinceaux/6 Produit abc A",
	parameters:["circle","circle","circle","circle","point"],
	exec:
	function(Hz,C1,C3,C10,a1){
OHz=Center("OHz",Hz);
P1=DefinitionPoint("P1",C3,1);
L1=Line("L1",OHz,P1);
P10=Point("P10","(OHz+(P1-OHz)*Hz^2/d(OHz,P1)^2+P1)/2","0");
mInvO=Point("mInvO","(OHz+(a1-OHz)*Hz^2/d(OHz,a1)^2+a1)/2","0");
IdA0=DefinitionPoint("IdA0",C10,0);
Perp1=Perpendicular("Perp1",L1,P10);
L10=Line("L10",OHz,mInvO);
Oo=Center("Oo",C1);
Oo1=Center("Oo1",C10);
L2=Line("L2",Oo1,Oo);
P3=OrderedIntersection("P3",L2,Perp1,0);
C2=Circle("C2",P3,P1);
P4=DefinitionPoint("P4",C3,0);
Oo0=Center("Oo0",C3);
P11=Point("P11","Oo0+(a1-Oo0)*d(Oo0,P4)^2/d(Oo0,a1)^2","0");
P12=Point("P12","Oo1+(P11-Oo1)*d(Oo1,IdA0)^2/d(Oo1,P11)^2","0");
mInvO1=Point("mInvO1","(OHz+(P12-OHz)*Hz^2/d(OHz,P12)^2+P12)/2","0");
mAA=Point("mAA","(mInvO+(P12-mInvO)*d(mInvO,a1)^2/d(mInvO,P12)^2+P12)/2","0");
L20=Line("L20",mInvO,P12);
mAA1=Point("mAA1","(mInvO1+(a1-mInvO1)*d(mInvO1,P12)^2/d(mInvO1,a1)^2+a1)/2","0");
L21=Line("L21",mInvO1,a1);
L11=Line("L11",OHz,mInvO1);
Perp10=Perpendicular("Perp10",L20,mAA);
Perp11=Perpendicular("Perp11",L21,mAA1);
P13=OrderedIntersection("P13",L10,Perp10,0);
P110=OrderedIntersection("P110",L11,Perp11,0);
chOA=Circle("chOA",P13,P12);
chOA1=Circle("chOA1",P110,a1);
P21=OrderedIntersection("P21",chOA1,chOA,1);
P50=OrderedIntersection("P50",chOA1,chOA,0);
oAB1=Point("oAB1","[(y(P21)*(x(P50)^2+y(P50)^2+Hz^2)-y(P50)*(x(P21)^2+y(P21)^2+Hz^2))/(2*(x(P50)*y(P21)-x(P21)*y(P50))),(x(P50)*(x(P21)^2+y(P21)^2+Hz^2)-x(P21)*(x(P50)^2+y(P50)^2+Hz^2))/(2*(x(P50)*y(P21)-x(P21)*y(P50)))]","0");
IdA1=Point("IdA1","[(2*Hz^2*x(oAB1)^2+2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2-2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
IdB1=Point("IdB1","[(2*Hz^2*x(oAB1)^2-2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2+2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
P210=Point("P210","oAB1+d(IdA1,oAB1)*((IdA1+IdB1)/2-oAB1)/d((IdA1+IdB1)/2,oAB1)","0");
C11=Arc3pts("C11",IdA1,P210,IdB1);
STL(C11,"c:#0026ff;s:1;f:30;p:0");
STL(IdA1,"c:#0026ff;s:4.5;sn:true;f:15");
STL(IdB1,"c:#0026ff;s:4.5;sn:true;f:15");
return [IdA1,IdB1,C11];
}};

$macros["5Calculs1Distance2pts"]={
	name:"5.Calculs/1 Distance 2 pts",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
prepAB=Expression("prepAB","","","","Hz*mod(A-B)/(mod(Hz*Hz-conj(A)*B))","-14.46255643588112","0.7338509518761671");
dAB=Expression("d"+A+B,"","","","log((1+prepAB)/(1-prepAB))","-5.2","4.8");
STL(dAB,"c:#674958;s:7;sn:true;f:17;p:7;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [dAB];
}};

$macros["5Calculs2chdedistance2pts"]={
	name:"5.Calculs/2 ch de distance 2 pts",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
prepAB=Expression("prepAB","","","","Hz*mod(A-B)/(mod(Hz*Hz-conj(A)*B))","-14.462556435881119","0.7338509518761666");
dist=Expression("dist","","","","log((1+prepAB)/(1-prepAB))","-9.431768024365248","3.9495697637538267");
chdAB=Expression("chd"+A+B,"","","","(exp(dist)+exp(-dist))/2","-5.5","1.2");
STL(chdAB,"c:#524b7b;s:7;sn:true;f:24;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [chdAB];
}};

$macros["5Calculs3AngleBACenA"]={
	name:"5.Calculs/3 Angle BAC en A",
	parameters:["circle","point","point","point"],
	exec:
	function(Hz,B,A,C){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
oAB0=Point("oAB0","[(y(C)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(C)^2+y(C)^2+Hz^2))/(2*(x(A)*y(C)-x(C)*y(A))),(x(A)*(x(C)^2+y(C)^2+Hz^2)-x(C)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(C)-x(C)*y(A)))]","0");
P2=Point("P2","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
P20=Point("P20","oAB0+d(A,oAB0)*((A+C)/2-oAB0)/d((A+C)/2,oAB0)","0");
C1=Arc3pts("C1",A,P2,B);
C10=Arc3pts("C10",A,P20,C);
cAB=Center("cAB",C1);
cAC=Center("cAC",C10);
S1=Segment("S1",cAB,A);
S2=Segment("S2",cAC,A);
Perp1=Perpendicular("Perp1",S1,A);
Perp3=Perpendicular("Perp3",S2,A);
Perp2=Perpendicular("Perp2",Perp1,B);
Perp4=Perpendicular("Perp4",Perp3,C);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
P3=OrderedIntersection("P3",Perp3,Perp4,0);
A1=Angle("A1",P1,A,P3);
STL(A1,"c:#006633;s:4;f:15;p:2");
return [A1];
}};

