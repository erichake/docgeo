STL(PComm,"c:#007c00;s:1.5;sn:true;f:30;p:0");
STL(IdPC1,"c:#0000b2;s:4.5;f:15");
STL(IdPC2,"c:#0000b2;s:4.5;f:15");
return [PComm,IdPC1,IdPC2];
}};

$macros["3Cycles1CercleCentrePt"]={
	name:"3.Cycles/1 Cercle Centre Pt",
	parameters:["circle","point","point"],
	exec:
	function (Hz,O,A){
OHz=Center("OHz",Hz);
