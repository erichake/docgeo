$macros["3Cycles5HoricycleCentrePoint"]={
	name:"3.Cycles/5 Horicycle Centre Point",
	parameters:["circle","point","point"],
	exec:
	function (Hz,I,A){
OHz=Center("OHz",Hz);
L1=Line("L1",I,OHz);
Perp1=Perpendicular("Perp1",L1,OHz);
P2=OrderedIntersection("P2",Perp1,Hz,1);
oAB=Point("oAB","[(y(P2)*(x(I)^2+y(I)^2+Hz^2)-y(I)*(x(P2)^2+y(P2)^2+Hz^2))/(2*(x(I)*y(P2)-x(P2)*y(I))),(x(I)*(x(P2)^2+y(P2)^2+Hz^2)-x(P2)*(x(I)^2+y(I)^2+Hz^2))/(2*(x(I)*y(P2)-x(P2)*y(I)))]","0");
IdA=Point("IdA","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P20=Point("P20","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
C1=Arc3pts("C1",IdA,P20,IdB);
P10=Center("P10",C1);
C2=Circle("C2",P10,I);
L10=Line("L10",A,P10);
C20=Circle("C20",P10,A);
Perp10=Perpendicular("Perp10",L10,P10);
P4=OrderedIntersection("P4",L10,C2,1);
P3=OrderedIntersection("P3",Perp10,C20,0);
P5=OrderedIntersection("P5",Perp10,C2,0);
L2=Line("L2",P3,P4);
Par1=Parallel("Par1",L2,P5);
P6=OrderedIntersection("P6",Par1,L10,0);
Hori=Circle3pts("Hori"+I,I,P6,A);
STL(C3,"c:#f90808;s:2;f:30;p:0");
return [Hori];
}};

$macros["4Pinceaux1DroitePinceau1pt"]={
	name:"4.Pinceaux/1 Droite Pinceau 1 pt",
