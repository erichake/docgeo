}};

$macros["3Cycles2CercleCentreRexp"]={
	name:"3.Cycles/2 Cercle Centre Rexp",
	parameters:["circle","point","expression"],
	exec:
	function(Hz,Q,dQR){
OHz=Center("OHz",Hz);
R2=Ray("R2",OHz,Q);
mInvO2=Point("mInvO2","(OHz+(Q-OHz)*Hz^2/d(OHz,Q)^2+Q)/2","0");
C3=Circle("C3",OHz,Q);
U=OrderedIntersection("U",R2,Hz,0);
mAA2=Point("mAA2","(mInvO2+(OHz-mInvO2)*d(mInvO2,Q)^2/d(mInvO2,OHz)^2+OHz)/2","0");
L25=Line("L25",mInvO2,OHz);
Perp16=Perpendicular("Perp16",L25,mAA2);
P17=OrderedIntersection("P17",L25,Perp16,0);
chOA2=Circle("chOA2",P17,OHz);
repQR=Expression("repQR","","","","-(1-exp((dQR)))/(1+exp((dQR)))","-4.683618541569629","-0.0508186607139333");
QRa=Point("QRa","OHz+repQR*(U-OHz)","0");
P7=OrderedIntersection("P7",chOA2,C3,0);
P8=OrderedIntersection("P8",chOA2,C3,1);
oAB5=Point("oAB5","[(y(P8)*(x(P7)^2+y(P7)^2+Hz^2)-y(P7)*(x(P8)^2+y(P8)^2+Hz^2))/(2*(x(P7)*y(P8)-x(P8)*y(P7))),(x(P7)*(x(P8)^2+y(P8)^2+Hz^2)-x(P8)*(x(P7)^2+y(P7)^2+Hz^2))/(2*(x(P7)*y(P8)-x(P8)*y(P7)))]","0");
IdA1=Point("IdA1","[(2*Hz^2*x(oAB5)^2+2*Hz*y(oAB5)*sqrt(x(oAB5)^2+y(oAB5)^2-Hz^2)*abs(x(oAB5)))/(2*x(oAB5)*(x(oAB5)^2+y(oAB5)^2)),(2*y(oAB5)*Hz^2-2*Hz*sqrt(x(oAB5)^2+y(oAB5)^2-Hz^2)*abs(x(oAB5)))/(2*(x(oAB5)^2+y(oAB5)^2))]","0");
IdB1=Point("IdB1","[(2*Hz^2*x(oAB5)^2-2*Hz*y(oAB5)*sqrt(x(oAB5)^2+y(oAB5)^2-Hz^2)*abs(x(oAB5)))/(2*x(oAB5)*(x(oAB5)^2+y(oAB5)^2)),(2*y(oAB5)*Hz^2+2*Hz*sqrt(x(oAB5)^2+y(oAB5)^2-Hz^2)*abs(x(oAB5)))/(2*(x(oAB5)^2+y(oAB5)^2))]","0");
P25=Point("P25","oAB5+d(IdA1,oAB5)*((IdA1+IdB1)/2-oAB5)/d((IdA1+IdB1)/2,oAB5)","0");
C15=Arc3pts("C15",IdA1,P25,IdB1);
Oo0=Center("Oo0",C15);
P18=Point("P18","Oo0+(QRa-Oo0)*d(Oo0,IdA1)^2/d(Oo0,QRa)^2","0");
mAA3=Point("mAA3","(mInvO2+(P18-mInvO2)*d(mInvO2,Q)^2/d(mInvO2,P18)^2+P18)/2","0");
L26=Line("L26",mInvO2,P18);
Perp17=Perpendicular("Perp17",L26,mAA3);
P19=OrderedIntersection("P19",L25,Perp17,0);
Cercle=Circle("Cercle",P19,P18);
STL(Cercle,"c:#b40000;s:2;sn:true;f:30;p:0");
return [Cercle];
}};

$macros["3Cycles3CercleCentreChR"]={
	name:"3.Cycles/3 Cercle Centre ChR",
	parameters:["circle","point","expression"],
	exec:
	function(Hz,A,chAB){
OHz=Center("OHz",Hz);
R2=Ray("R2",OHz,A);
C3=Circle("C3",OHz,A);
mInvO2=Point("mInvO2","(OHz+(A-OHz)*Hz^2/d(OHz,A)^2+A)/2","0");
U=OrderedIntersection("U",R2,Hz,0);
mAA2=Point("mAA2","(mInvO2+(OHz-mInvO2)*d(mInvO2,A)^2/d(mInvO2,OHz)^2+OHz)/2","0");
L25=Line("L25",mInvO2,OHz);
Perp16=Perpendicular("Perp16",L25,mAA2);
P17=OrderedIntersection("P17",L25,Perp16,0);
chOA2=Circle("chOA2",P17,OHz);
P7=OrderedIntersection("P7",chOA2,C3,0);
P8=OrderedIntersection("P8",chOA2,C3,1);
oAB50=Point("oAB50","[(y(P8)*(x(P7)^2+y(P7)^2+Hz^2)-y(P7)*(x(P8)^2+y(P8)^2+Hz^2))/(2*(x(P7)*y(P8)-x(P8)*y(P7))),(x(P7)*(x(P8)^2+y(P8)^2+Hz^2)-x(P8)*(x(P7)^2+y(P7)^2+Hz^2))/(2*(x(P7)*y(P8)-x(P8)*y(P7)))]","0");
IdA1=Point("IdA1","[(2*Hz^2*x(oAB50)^2+2*Hz*y(oAB50)*sqrt(x(oAB50)^2+y(oAB50)^2-Hz^2)*abs(x(oAB50)))/(2*x(oAB50)*(x(oAB50)^2+y(oAB50)^2)),(2*y(oAB50)*Hz^2-2*Hz*sqrt(x(oAB50)^2+y(oAB50)^2-Hz^2)*abs(x(oAB50)))/(2*(x(oAB50)^2+y(oAB50)^2))]","0");
IdB1=Point("IdB1","[(2*Hz^2*x(oAB50)^2-2*Hz*y(oAB50)*sqrt(x(oAB50)^2+y(oAB50)^2-Hz^2)*abs(x(oAB50)))/(2*x(oAB50)*(x(oAB50)^2+y(oAB50)^2)),(2*y(oAB50)*Hz^2+2*Hz*sqrt(x(oAB50)^2+y(oAB50)^2-Hz^2)*abs(x(oAB50)))/(2*(x(oAB50)^2+y(oAB50)^2))]","0");
P250=Point("P250","oAB50+d(IdA1,oAB50)*((IdA1+IdB1)/2-oAB50)/d((IdA1+IdB1)/2,oAB50)","0");
C15=Arc3pts("C15",IdA1,P250,IdB1);
Oo0=Center("Oo0",C15);
AB=Expression("AB","","","","log(chAB+sqrt(chAB^2-1))","-5.83334199591036","-3.9634456635978337");
repQR=Expression("repQR","","","","-(1-exp((AB)))/(1+exp((AB)))","-1.991493576248745","-2.3616071083443977");
QRa=Point("QRa","OHz+repQR*(U-OHz)","0");
P18=Point("P18","Oo0+(QRa-Oo0)*d(Oo0,IdA1)^2/d(Oo0,QRa)^2","0");
mAA3=Point("mAA3","(mInvO2+(P18-mInvO2)*d(mInvO2,A)^2/d(mInvO2,P18)^2+P18)/2","0");
L26=Line("L26",mInvO2,P18);
Perp17=Perpendicular("Perp17",L26,mAA3);
P19=OrderedIntersection("P19",L25,Perp17,0);
Cercle=Circle("Cercle",P19,P18);
STL(Cercle,"c:#0024ff;s:1;sn:true;f:30;p:0");
return [Cercle];
}};

$macros["3Cycles4EquidistanteAxePt"]={
	name:"3.Cycles/4 Equidistante Axe Pt",
	parameters:["circle","circle","point"],
