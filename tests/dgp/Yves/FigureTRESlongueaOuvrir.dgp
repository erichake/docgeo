mApg=OrderedIntersection("mApg",R1,C3,0);
C4=Arc3pts("C4",Qbh,mApg,Pph);
CtrApar=Center("CtrApar",C4);
STL(Exph,"c:#2687e4;s:6;sn:true;f:15;sp:1");
STL(E1,"c:#514e0b;s:7;f:15;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(Expb,"c:#2687e4;s:6;sn:true;f:15;sp:1");
STL(Rph,"c:#2687e4;s:1;sn:true;f:30;p:0");
