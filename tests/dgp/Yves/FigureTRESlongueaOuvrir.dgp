STL(C4,"c:#2687e4;s:1;f:30;p:0");
STL(CtrApar,"c:#2687e4;s:6;sn:true;f:15;sp:1");
return [Exph,E1,Expb,Rph,Rpb,C4,CtrApar];
}};

