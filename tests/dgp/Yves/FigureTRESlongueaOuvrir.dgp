// Macros :
$macros={};
$macros["Constituantdroite3obj"]={
	name:"Constituant droite 3 obj",
	parameters:["line","circle","line"],
	exec:
	function(Rb,Archb,Rh){
Ph=DefinitionPoint("Ph",Archb,0);
Qb=DefinitionPoint("Qb",Archb,2);
Exh=DefinitionPoint("Exh",Rh,1);
Exb=DefinitionPoint("Exb",Rb,1);
Ptgg=DefinitionPoint("Ptgg",Archb,1);
CtrArchb=Center("CtrArchb",Archb);
aPQ=Angle("aPQ",Ph,CtrArchb,Qb);
STL(Ph,"c:#fc092f;s:4.5;sn:true;f:16;sp:1;np:0.7065633064279783");
STL(Qb,"c:#fc092f;s:4;sn:true;f:16;sp:1;np:4.749323907051956");
STL(Exh,"c:#fc092f;s:4.5;sn:true;f:16;sp:1");
STL(Exb,"c:#fc092f;s:4.5;sn:true;f:16;sp:1;np:0.8583691685006293");
STL(CtrArchb,"c:#fc092f;s:4.5;sn:true;f:16;sp:1");
return [Ph,Qb,Exh,Exb,CtrArchb];
}};

$macros["DroiteHilbertFHellAB"]={
	name:"Droite Hilbert F Hell AB",
	parameters:["point","quadric","point","point"],
	exec:
	function(F,Quad,A,B){
AExt=Expression("AExt","","","","x(A)^2+4*y(A)^2>1","-1.9489200141606147","0.9415408131213986");
BExt=Expression("BExt","","","","x(B)^2+4*y(B)^2>1","-1.579120090761074","0.9415408131213986");
C1=Circle3pts("C1",A,B,F);
L4=Line("L4",A,B);
DrtAB=Line("DrtAB",A,B);
CtrABint=Center("CtrABint",C1);
xA=Expression("xA","","","","x(A)*(AExt==0)+x(B)*(BExt==0)","-2.031097774916068","-0.1267700766994961");
yA=Expression("yA","","","","y(A)*(AExt==0)+y(B)*(BExt==0)","-1.3736756888724408","-0.0856811963217694");
xB=Expression("xB","","","","x(A)*(AExt==1)+x(B)*(BExt==1)","-1.291497928116987","-0.20894783745494955");
yB=Expression("yB","","","","y(A)*(AExt==1)+y(B)*(BExt==1)","-1.3736756888724408","0.07867432518913749");
ABExt=Point("ABExt","B*BExt+A*AExt","0");
coef=Expression("coef","","","","-4*(128*yA^6*yB*(9*(3-2*xB)^2+16*yB^2)+48*yA^4*yB*(-1297+72*xA^2*(3-2*xB)^2+3105*xB-6*xA*(-3+2*xB)*(-35+9*xB*(1+xB))-3*xB^2*(901+6*xB*(-57+8*xB))+36*yB^2+8*(xA*(-27+16*xA-6*xB)+9*xB)*yB^2)+(-3+2*xA)^3*yB*(9*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(3+3*(8-3*xB)*xB+8*xA^2*(-3+2*xB)+xA*(-34-6*(-5+xB)*xB))+4*(3+2*xA-3*xB)*(45+32*xA^2-9*(-2+xB)*xB+6*xA*(-11+2*xB))*yB^2)+4*yA^3*(4906-11205*xB+9*(-8*xA^2*(3-2*xB)^2*(-7+3*(-3+xB)*xB)+2*xA*(-3+2*xB)*(136+3*xB*(39+xB*(-35+3*(-3+xB)*xB)))+xB^2*(2519+3*xB*(-903+xB*(433-90*xB+8*xB^2))))+7560*yB^2+60*(8*xA^2*(29+12*(-3+xB)*xB)+9*xB*(1+3*xB*(-5+2*xB))-6*xA*(72+xB*(-71+9*xB+6*xB^2)))*yB^2)-3*(3-2*xA)^2*yA*(3*(-1-3*(-2+xB)*xB+xA*(-6+4*xB))*(-17+2*xA*(-3+2*xB)*(-7+3*(-3+xB)*xB)+3*xB*(-2+xB*(-7+6*xB)))-4*(20*xA^2*(29+12*(-3+xB)*xB)-30*xA*(14+xB-15*xB^2+6*xB^3)+9*(41+xB*(-41+xB*(31+3*xB*(-7+2*xB)))))*yB^2)+48*yA^5*(189+580*yB^2-3*(-3+xB)*xB*(-1+12*(-3+xB)*xB-80*yB^2))+12*(-3+2*xA)*yA^2*yB*(16*xA^3*(9*(3-2*xB)^2+16*yB^2)+3*(344+7*xB-615*xB^2+561*xB^3-225*xB^4+36*xB^5+36*(2+(-5+xB)*xB)*yB^2)-24*xA^2*(4*(6+5*yB^2)+xB*(11+9*xB*(-5+2*xB)+8*yB^2))+2*xA*(-1786+3*xB*(1209-925*xB+315*xB^2-39*xB^3-12*(-9+xB)*yB^2))))","-2.031097774916068","-0.5376588804767634");
U=Expression("U","","","","-((2*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB))/(3*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)))","-1.990008894538341","-0.7841921627431236");
coef2=Expression("coef2","","","","(-16*(8*yA-9*xB*yA+3*xB^2*yA-9*yB+4*xA^2*yB+9*xB*yB-6*xA*xB*yB+4*yA^2*yB)^2+6*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)*(6+5*xA-6*xA^2-9*xB+4*xA^2*xB-6*yA^2+4*xB*yA^2-36*yA*yB+24*xB*yA*yB+18*yB^2-12*xA*yB^2))","-2.031097774916068","-1.153992086142664");
coefV=Expression("coefV","","","","3*2^(2/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-1.990008894538341","-0.9485476842540305");
coefW=Expression("coefW","","","","6*2^(1/3)*(3+16*xA-12*xA^2-18*xB+8*xA^2*xB+9*xB^2-6*xA*xB^2-12*yA^2+8*xB*yA^2)","-1.990008894538341","-1.318347607653571");
EllF1=Point("EllF1","CtrABint+(F-CtrABint)*(cos(40)+i*sin(40))","0");
EllF2=Point("EllF2","CtrABint+(F-CtrABint)*(cos(80)+i*sin(80))","0");
EllF3=Point("EllF3","CtrABint+(F-CtrABint)*(cos(140)+i*sin(140))","0");
EllF4=Point("EllF4","CtrABint+(F-CtrABint)*(cos(230)+i*sin(230))","0");
EllF5=Point("EllF5","CtrABint+(F-CtrABint)*(cos(310)+i*sin(310))","0");
Qe=OrderedIntersection("Qe",L4,Quad,1);
Pe=OrderedIntersection("Pe",L4,Quad,0);
expVW=Expression("expVW","","","","(coef*coef+4*coef2^3)","-2.031097774916068","-0.41439223934358316");
Quad1=Quadric("Quad1",EllF1,EllF2,EllF3,EllF4,EllF5);
Uee=Point("Uee","(AExt+BExt==2)?Pe:NaN","0");
Vee=Point("Vee","(AExt+BExt==2)?Qe:NaN","0");
LesR3=Expression("LesR3","","","","(AExt+BExt==1)?((expVW>0)?[coef+sqrt(expVW),0]^(1/3):[coef,sqrt(-expVW)]^(1/3)):NaN","-2.154364416049248","0.5306520093441311");
PF1=OrderedIntersection("PF1",Quad,Quad1,0);
QF1=OrderedIntersection("QF1",Quad,Quad1,1);
PF10=OrderedIntersection("PF10",Quad,Quad1,2);
QF10=OrderedIntersection("QF10",Quad,Quad1,3);
chAff=Expression("chAff","","","","DrtAB.setHidden(AExt+BExt<2 || !isNaN(Uee.getX()));\"cache DrtAB\"","-1.4969423300056204","0.736096411232765");
expa2=Expression("expa2","","","","U-[-0.5,sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,-sqrt(3)/2]*LesR3[0]/coefW","-1.1271424066060802","0.2841187270777711");
expa1=Expression("expa1","","","","U-(coef2/coefV)/LesR3[0]+LesR3[0]/coefW","-2.0721866552937946","0.2841187270777711");
expa3=Expression("expa3","","","","U-[-0.5,-sqrt(3)/2]*(coef2/coefV)/LesR3[0]+[-0.5,sqrt(3)/2]*LesR3[0]/coefW","-0.2231870382960923","0.2841187270777711");
PF11=Point("PF11","isNaN(PF1.getX())?PF10:PF1","0");
QF11=Point("QF11","isNaN(QF1.getX())?QF10:QF1","0");
Ptdr1=Point("Ptdr1","(abs(expa1[1])<0.001)?[0,expa1[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr2=Point("Ptdr2","(abs(expa2[1])<0.001)?[0,expa2[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Ptdr3=Point("Ptdr3","(abs(expa3[1])<0.001)?[0,expa3[0]*(x(B)*(BExt==1)+x(A)*(AExt==1))+y(B)*(BExt==1)+y(A)*(AExt==1)]:[NaN,NaN]","0");
Uii=Point("Uii","(AExt+BExt==0)?PF11:NaN","0");
Vii=Point("Vii","(AExt+BExt==0)?QF11:NaN","0");
L1=Line("L1",ABExt,Ptdr1);
L2=Line("L2",ABExt,Ptdr2);
L3=Line("L3",ABExt,Ptdr3);
U1=OrderedIntersection("U1",L1,Quad,1);
V1=OrderedIntersection("V1",L1,Quad,0);
U3=OrderedIntersection("U3",L3,Quad,1);
V3=OrderedIntersection("V3",L3,Quad,0);
U2=OrderedIntersection("U2",L2,Quad,1);
V2=OrderedIntersection("V2",L2,Quad,0);
Uie=Point("Uie","isNaN(U1.getX())?(isNaN(U2.getX())?U3:U2):U1","0");
Vie=Point("Vie","isNaN(V1.getX())?(isNaN(V2.getX())?V3:V2):V1","0");
Ugg=Point("Ugg","isNaN(Uie.getX())?(isNaN(Uee.getX())?Uii:Uee):Uie","0");
Vgg=Point("Vgg","isNaN(Vie.getX())?(isNaN(Vee.getX())?Vii:Vee):Vie","0");
C2=Circle3pts("C2",Ugg,Vgg,F);
Ph=Point("Ph","(y(Vgg)>y(Ugg))?Vgg:Ugg","0");
Mgg=MidPoint("Mgg",Ugg,Vgg);
CtrCgg=Center("CtrCgg",C2);
Qb=Symmetry("Qb",Mgg,Ph);
Exh=Symmetry("Exh",Ph,Mgg);
R3=Ray("R3",CtrCgg,Mgg);
Exb=Symmetry("Exb",Qb,Mgg);
Rh=Ray("Rh",Ph,Exh);
Ptgg=OrderedIntersection("Ptgg",R3,C2,0);
Rb=Ray("Rb",Qb,Exb);
Archb=Arc3pts("Archb",Ph,Ptgg,Qb);
STL(DrtAB,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(chAff,"c:#60531d;s:7;sn:true;f:15;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
STL(Rh,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(Rb,"c:#fc092f;s:1;sn:true;f:30;p:0");
STL(Archb,"c:#fc092f;s:1;sn:true;f:30;p:0");
return [DrtAB,chAff,Rh,Rb,Archb];
}};

$macros["Inter2arcs"]={
	name:"Inter 2 arcs",
	parameters:["circle","circle"],
	exec:
	function (LeC1,LeC2){
Int1=OrderedIntersection("Int1",LeC1,LeC2,0);
Int2=OrderedIntersection("Int2",LeC1,LeC2,1);
Int=Point("Int","isNaN(Int1.getX())?Int2:Int1","0");
STL(Int,"c:#966400;s:6;sn:true;f:17");
return [Int];
}};

$macros["Inter2Dtr4Ex4pt2arcs"]={
	name:"Inter 2 Dtr 4Ex 4pt 2arcs",
	parameters:["point","point","point","point","point","point","point","point","circle","circle"],
	exec:
	function(ExABh,ExABb,ExCDh,ExCDb,A,B,C,D,ArcAB,ArcCD){
DrtAB=Line("DrtAB",A,B);
DrtCD=Line("DrtCD",ExABh,ExABb);
DrtAB3=Line("DrtAB3",C,D);
Mdd=OrderedIntersection("Mdd",DrtAB,DrtAB3,0);
Mdid=OrderedIntersection("Mdid",DrtCD,DrtAB3,0);
CDi=Line("CDi",ExCDh,ExCDb);
Mdii=OrderedIntersection("Mdii",CDi,DrtCD,0);
Mddi=OrderedIntersection("Mddi",DrtAB,CDi,0);
Int1=OrderedIntersection("Int1",ArcCD,ArcAB,0);
Int2=OrderedIntersection("Int2",ArcCD,ArcAB,1);
Mi=Point("Mi","isNaN(Int1.getX())?Int2:Int1","0");
M=Point("M","isNaN(Mi.getX())?(isNaN(Mdii.getX()))?(isNaN(Mddi.getX()))?(isNaN(Mdid.getX()))?Mdd:Mdid:Mddi:Mdii:Mi","0");
STL(M,"c:#006633;o:1;s:4;sn:true;f:16;sp:2");
return [M];
}};

$macros["InterArcRay"]={
	name:"Inter Arc Ray",
	parameters:["circle","line"],
	exec:
	function (LeCercle,LeRay){
Int1=OrderedIntersection("Int1",LeRay,LeCercle,1);
Int2=OrderedIntersection("Int2",LeRay,LeCercle,0);
Int=Point("Int","isNaN(Int1.getX())?Int2:Int1","0");
STL(Int,"c:#e410e4;s:6;sn:true;f:15");
return [Int];
}};

$macros["InterCCtrFHell"]={
	name:"Inter C(Ctr, F) Hell",
	parameters:["point","point","quadric"],
	exec:
	function (Ce,F,Hell){
EllF1=Point("EllF1","Ce+(F-Ce)*(cos(40)+i*sin(40))","0");
EllF2=Point("EllF2","Ce+(F-Ce)*(cos(80)+i*sin(80))","0");
EllF3=Point("EllF3","Ce+(F-Ce)*(cos(140)+i*sin(140))","0");
EllF4=Point("EllF4","Ce+(F-Ce)*(cos(230)+i*sin(230))","0");
EllF5=Point("EllF5","Ce+(F-Ce)*(cos(310)+i*sin(310))","0");
QuadF=Quadric("Quad1",EllF1,EllF2,EllF3,EllF4,EllF5);
PF1a=OrderedIntersection("PF1",Hell,QuadF,0);
QF1a=OrderedIntersection("QF1",Hell,QuadF,1);
PF1b=OrderedIntersection("PF1",Hell,QuadF,2);
QF1b=OrderedIntersection("QF1",Hell,QuadF,3);
PF1=Point("PF1","isNaN(PF1a.getX())?PF1b:PF1a","0");
QF1=Point("QF1","isNaN(QF1a.getX())?QF1b:QF1a","0");
STL(PF1,"c:#e70505;s:6;sn:true;f:13");
STL(QF1,"c:#006633;s:6;sn:true;f:13");
return [PF1,QF1];
}};

$macros["LongABPQCtrAB"]={
	name:"LongAB P Q Ctr AB",
	parameters:["point","point","point","point","point"],
	exec:
	function(Ph,Qb,CtrArchb,A,B){
AExt=Expression("AExt","","","","x(A)^2+4*y(A)^2>1","-2.8554828575544433","1.619114855086046");
BExt=Expression("BExt","","","","x(B)^2+4*y(B)^2>1","-2.3764616591735654","1.619114855086046");
ABExt=Point("ABExt","B*BExt+A*AExt","0");
ABInt=Point("ABInt","A*(AExt==0)+B*(BExt==0)","0");
pCoup=Expression("pCoup","","","","(Qb[1]-Ph[1])/(Qb[0]-Ph[0])","0.3912163759159481","1.0868690791072937");
aAB=Angle("aAB",A,CtrArchb,B);
aPQ=Angle("aPQ",Ph,CtrArchb,Qb);
aIntQ=Angle("aIntQ",ABInt,CtrArchb,Qb);
aIntP=Angle("aIntP",Ph,CtrArchb,ABInt);
hLongAB=Expression("hLongAB","","","","var Lg1=0;var LgArc=0;var Lg2=0;var Long=0; if (AExt+BExt==0){var LgArc=d(CtrArchb,A)*aAB*\u03C0/180} else {if (AExt+BExt==2){if (isNaN(Ph.getX())|| (y(B)-y(Ph))*(y(A)-y(Ph))>0){Lg1=d(A,B)} else {var LgArc=d(CtrArchb,Ph)*aPQ*\u03C0/180;if(d(A,Ph)<d(A,Qb)){var Lg1=d(A,Ph);var Lg2=d(B,Qb)} else {var Lg1=d(A,Qb);var Lg2=d(B,Ph)}}} else {var Lg2=0;if (pCoup>0) {if (ABExt[0]>Ph[0]) {var Lg1=d(ABExt,Ph);var LgArc=d(CtrArchb,Ph)*aIntP*\u03C0/180} else {var Lg1=d(ABExt,Qb);var LgArc=d(CtrArchb,Qb)*aIntQ*\u03C0/180}} else {if (ABExt[0]>Qb[0]) {var Lg1=d(ABExt,Qb);var LgArc=d(CtrArchb,Qb)*aIntQ*\u03C0/180} else {var Lg1=d(ABExt,Ph);var LgArc=d(CtrArchb,Ph)*aIntP*\u03C0/180}}}};var Long=Lg1+LgArc+Lg2;Long","-1.471643840009686","1.0868690791072937");
STL(hLongAB,"c:#7e5978;s:7;sn:true;f:15;p:3;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [hLongAB];
}};

$macros["MilieuLongPQAB"]={
	name:"Milieu Long P Q AB",
	parameters:["expression","point","point","point","point","point"],
	exec:
	function(hLongAB,Ph,Qb,CtrArchb,A,B){
AExt=Expression("AExt","","","","x(A)^2+4*y(A)^2>1","-1.4111876770309202","1.2079403195893208");
BExt=Expression("BExt","","","","x(B)^2+4*y(B)^2>1","-1.0413877536313794","1.2079403195893208");
ABExt=Point("ABExt","B*BExt+A*AExt","0");
EntreAetB=Expression("EntreAetB","","","","isNaN(Ph.getX()) || (y(B)-y(Ph))*(y(A)-y(Ph))>0","-0.695747987449946","1.0999381781482724");
BordAB=Point("BordAB","Ph*(d(ABExt,Ph)<d(ABExt,Qb))+Qb*(d(ABExt,Ph)>d(ABExt,Qb))","0");
BordA=Point("BordA","Ph*(d(A,Ph)<d(A,Qb))+Qb*(d(A,Ph)>d(A,Qb))","0");
BordB=Point("BordB","Ph*(d(B,Ph)<d(B,Qb))+Qb*(d(B,Ph)>d(B,Qb))","0");
dBbord=Expression("dBbord","","","","d(B,BordB)","-2.4224114552975893","1.4946041136563053");
dAbord=Expression("dAbord","","","","d(A,BordA)","-0.9917474390809706","1.4946041136563053");
NewEx=Point("NewEx","(dAbord<dBbord)*(B+(BordB-B)*dAbord/dBbord)+(dAbord>dBbord)*(A+(BordA-A)*dBbord/dAbord)","0");
LeExBord=Point("LeExBord","(dAbord<dBbord)*BordA+(dAbord>dBbord)*BordB","0");
NewBord=Point("NewBord","(dAbord<dBbord)*BordB+(dAbord>dBbord)*BordA","0");
aPQ=Angle("aPQ",Ph,CtrArchb,Qb);
Mii=Point("Mii","CtrArchb+((A+B)/2-CtrArchb)*d(A,CtrArchb)/d((A+B)/2,CtrArchb)","0");
arcPQ=Expression("arcPQ","","","","d(CtrArchb,LeExBord)*aPQ*\u03C0/180","-2.2744117294820767","0.45860603294771923");
angAB=Expression("angAB","","","","180*(hLongAB/2-d(ABExt,BordAB))/(d(CtrArchb, BordAB)*\u03C0)","-0.9424141971424665","1.7412703233488258");
angExAB=Expression("angExAB","","","","180*(arcPQ+d(NewEx,NewBord))/(d(CtrArchb,NewBord)*2*\u03C0)","-2.3730782133590855","1.0506049362097685");
longMil=Expression("longMil","","","","(d(NewBord,NewEx)+arcPQ)/2","0.7842492707051768","1.0012716942712643");
milT1=Point("milT1","CtrArchb+(BordAB-CtrArchb)*(cos(angAB)+i*sin(angAB))","0");
milT2=Point("milT2","CtrArchb+(BordAB-CtrArchb)*(cos(angAB)-i*sin(angAB))","0");
mil2exT1=Point("mil2exT1","CtrArchb+(LeExBord-CtrArchb)*(cos(angExAB)-i*sin(angExAB))","0");
mil2exT2=Point("mil2exT2","CtrArchb+(LeExBord-CtrArchb)*(cos(angExAB)+i*sin(angExAB))","0");
milT1int=Expression("milT1int","","","","x(milT1)^2+4*y(milT1)^2<1","-0.153082326126401","1.7412703233488258");
mil2exT1int=Expression("mil2exT1int","","","","x(mil2exT1)^2+4*y(mil2exT1)^2<1","0.044250641627615384","1.445270871717801");
Mie=Point("Mie","(d(BordAB,ABExt)>hLongAB/2)?ABExt+(BordAB-ABExt)*hLongAB/(2*d(ABExt,BordAB)):(milT1int==1)?milT1:milT2","0");
Mee=Point("Mee","(d(NewBord,NewEx)>longMil)?NewEx+(NewBord-NewEx)*longMil/(d(NewEx,NewBord)):(mil2exT1int ==1)? mil2exT1: mil2exT2","0");
LeMil=Point("LeMil","(AExt+BExt==0)?Mii:(AExt+BExt==1)?Mie:EntreAetB?(A+B)/2:Mee","0");
STL(LeMil,"c:#fc092f;o:1;s:5;sn:true;f:17;sp:2");
return [LeMil];
}};

$macros["ParalleleFell4pts1pt"]={
	name:"Parallele F ell 4pts 1 pt",
	parameters:["point","quadric","point","point","point","point","point"],
	exec:
	function(F,Quad,Exh,Exb,A,B,ptM){
xM=Expression("xM","","","","x(ptM)","-0.8876251501797099","-0.8672120965767426");
yM=Expression("yM","","","","y(ptM)","-0.8876251501797099","-1.134626271634287");
ptMint=Expression("ptMint","","","","xM^2+4*yM^2<1","-1.779005733704858","-1.134626271634287");
pAB=Expression("pAB","","","","isNaN(Exh.getX())?(y(B)-y(A))/(x(B)-x(A)):(y(Exb)-y(Exh))/(x(Exb)-x(Exh))","-1.779005733704858","-0.911781125753");
ptMt=Point("ptMt","(isNaN(Exh.getX()))? ptM+B-A:ptM+Exb-Exh","0");
