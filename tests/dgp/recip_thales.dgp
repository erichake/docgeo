// Macros :
$macros={};
$macros["dte2pts"]={
	name:"dte2pts",
	parameters:["point","point","expression"],
	exec:
	function (P12, P10, E1) {
L7=Line("L7",P10,P12);
C3=Circle1("C3",P10,"E1");
C4=Circle1("C4",P12,"E1");
P14=OrderedIntersection("P14",L7,C4,0);
P13=OrderedIntersection("P13",L7,C3,1);
S2=Segment("S2",P13,P14);
STL(S2,"c:#006633;s:1;f:24");
return [S2];
}};

$macros["dte3pts"]={
	name:"dte3pts",
	parameters:["point","point","point","expression"],
	exec:
	function (A, M, B, E1) {
L1=Line("L1",A,B);
P4=Point("P4","[max(x(A),x(M),x(B)),max(y(A),y(M),y(B))]","0");
P1=Point("P1","[min(x(A),x(M),x(B)),min(y(A),y(M),y(B))]","0");
P5=Point("P5","P4+1","0");
P2=Point("P2","P1+1","0");
L2=Line("L2",P4,P5);
L3=Line("L3",P1,P2);
P6=OrderedIntersection("P6",L1,L3,0);
P3=OrderedIntersection("P3",L1,L2,0);
C1=Circle1("C1",P3,"E1");
C2=Circle1("C2",P6,"E1");
L4=Line("L4",P3,P6);
P7=OrderedIntersection("P7",L4,C1,1);
P8=OrderedIntersection("P8",L4,C2,0);
S1=Segment("S1",P7,P8);
STL(S1,"c:#006633;s:1;f:24");
return [S1];
}};

