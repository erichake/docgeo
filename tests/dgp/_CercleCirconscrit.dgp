// Coordinates System :
SetCoords(400,285.5,40,false,800,572);


// Geometry :
P1=Point("P1",-0.9,3.1875);
P2=Point("P2",-4.9,-0.2375);
P3=Point("P3",4.3,-2.2125);
S1=Segment("S1",P1,P2);
S2=Segment("S2",P2,P3);
S3=Segment("S3",P3,P1);
L1=PerpendicularBisector("L1",P1,P2);
L2=PerpendicularBisector("L2",P2,P3);
P4=OrderedIntersection("P4",L2,L1,0);
C1=Circle("C1",P4,P2);


// Styles :
STL(P1,"c:#0000b2;s:6;f:30");
STL(P2,"c:#0000b2;s:6;f:30");
STL(P3,"c:#0000b2;s:6;f:30");
STL(S1,"c:#006633;s:1;f:24");
STL(S2,"c:#006633;s:1;f:24");
STL(S3,"c:#006633;s:1;f:24");
STL(L1,"c:#780013;s:1;f:30;p:0");
STL(L2,"c:#780013;s:1;f:30;p:0");
STL(P4,"c:#0000b2;s:6;f:30");
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
SetCoordsStyle("isAxis:false;isGrid:true;isOx:true;isOy:true;isLockOx:false;isLockOy:false;centerZoom:false;onlyPositive:false;color:#111111;fontSize:18;axisWidth:1;gridWidth:0.1");
SetGeneralStyle("background-color:#F8F8F8;degree:true;dragmoveable:true");
