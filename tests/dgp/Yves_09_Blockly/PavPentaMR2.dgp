t></block></statement></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction CDEAB(blockly_local_s,blockly_local_k) {\n  PentaListe([(GLOBAL_GET(\"d\")), (GLOBAL_GET(\"e\")), (GLOBAL_GET(\"a\")), (GLOBAL_GET(\"b\")), (GLOBAL_GET(\"c\"))], [(GLOBAL_GET(\"angD\")), (GLOBAL_GET(\"angE\")), (GLOBAL_GET(\"angA\")), (GLOBAL_GET(\"angB\")), (GLOBAL_GET(\"angC\"))], blockly_local_s, blockly_local_k);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Translation(blockly_local_P,blockly_local_Q) {\n  TURTLE_UP(true);\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus(blockly_local_Q,blockly_local_P))));\n  TURTLE_MV((d(blockly_local_P,blockly_local_Q)),false);\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction DCBAE(blockly_local_s,blockly_local_k) {\n  PentaListe([(GLOBAL_GET(\"d\")), (GLOBAL_GET(\"c\")), (GLOBAL_GET(\"b\")), (GLOBAL_GET(\"a\")), (GLOBAL_GET(\"e\"))], [(GLOBAL_GET(\"angC\")), (GLOBAL_GET(\"angB\")), (GLOBAL_GET(\"angA\")), (GLOBAL_GET(\"angE\")), (GLOBAL_GET(\"angD\"))], blockly_local_s, blockly_local_k);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Init() {\n  GLOBAL_SET(\"angA\",(Math.Angle180((E),(A),(B))));\n  GLOBAL_SET(\"angB\",(Math.Angle180((A),(B),(C))));\n  GLOBAL_SET(\"angC\",(Math.Angle180((B),(C),(D))));\n  GLOBAL_SET(\"angD\",(Math.Angle180((C),(D),(E))));\n  GLOBAL_SET(\"angE\",(Math.Angle180((D),(E),(A))));\n  GLOBAL_SET(\"a\",(d((A),(E))));\n  GLOBAL_SET(\"b\",(d((A),(B))));\n  GLOBAL_SET(\"c\",(d((B),(C))));\n  GLOBAL_SET(\"d\",(d((C),(D))));\n  GLOBAL_SET(\"e\",(d((D),(E))));\n  TURTLE_ROTATE_PT((D));\n  TURTLE_WIDTH(2);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction fcABCDEg() {\n   var blockly_var_Suite = [];\n  TURTLE_COLOUR(10);\n  TURTLE_MV((GLOBAL_GET(\"b\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angA\")))));\n  TURTLE_MV((GLOBAL_GET(\"a\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angE\")))));\n  TURTLE_MV((GLOBAL_GET(\"e\")),false);\n  blockly_var_Suite.push(TURTLE_POS());\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angD\")))));\n  TURTLE_MV((GLOBAL_GET(\"d\")),false);\n  blockly_var_Suite.push(TURTLE_POS());\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angC\")))));\n  TURTLE_MV((GLOBAL_GET(\"c\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angB\")))));\n  TURTLE_COLOUR(19);\n  TURTLE_FILL(30);\n  return blockly_var_Suite;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Bande1() {\n  Translation(Math.times(2,(U)), Math.times(2,(V)));\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((D),(C)))));\n  for (var blockly_var_count = 1 ; blockly_var_count <= 5 ; blockly_var_count++){\n    CDEAB(1, 40);\n    TransCEdirA();\n    DCBAE(1, 53);\n    Translation((A), (C));\n    Translation((V), (U));\n    TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((D),(C)))));\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Bande2() {\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 5 ; blockly_var_count2++){\n    TURTLE_UP(false);\n    GLOBAL_SET(\"SuiteG\",(fcABCDEg()));\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT(((GLOBAL_GET(\"SuiteG\"))[2-1]));\n    TURTLE_ROTATE_PT(((GLOBAL_GET(\"SuiteG\"))[1-1]));\n    TURTLE_UP(false);\n    GLOBAL_SET(\"SuiteG\",(fcEABCDg()));\n    TURTLE_UP(true);\n    TURTLE_MV((GLOBAL_GET(\"c\")),false);\n    Translation((V), (U));\n    TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((E),(D)))));\n    TURTLE_TURN(-(GLOBAL_GET(\"angB\")));\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction fcEABCDg() {\n   var blockly_var_Suite = [];\n  TURTLE_COLOUR(10);\n  TURTLE_MV((GLOBAL_GET(\"a\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angA\")))));\n  TURTLE_MV((GLOBAL_GET(\"b\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angB\")))));\n  blockly_var_Suite.push(TURTLE_POS());\n  TURTLE_MV((GLOBAL_GET(\"c\")),false);\n  blockly_var_Suite.push(TURTLE_POS());\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angC\")))));\n  TURTLE_MV((GLOBAL_GET(\"d\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angD\")))));\n  TURTLE_MV((GLOBAL_GET(\"e\")),false);\n  TURTLE_COLOUR(67);\n  TURTLE_FILL(30);\n  return blockly_var_Suite;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction PentaListe(blockly_local_LL,blockly_local_LA,blockly_local_sens,blockly_local_couleur) {\n  TURTLE_COLOUR(10);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_MV((blockly_local_LL[blockly_var_i-1]),false);\n    if (blockly_local_sens == 1) {\n      TURTLE_TURN((Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    } else {\n      TURTLE_TURN(-(Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    }\n  };\n  TURTLE_COLOUR(blockly_local_couleur);\n  TURTLE_FILL(30);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction DeuxBandes(blockly_local_Depart) {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT(blockly_local_Depart);\n  Bande1();\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((Math.plus(blockly_local_Depart,Math.minus((D),(C)))));\n  Translation(Math.times(2,(U)), Math.times(2,(V)));\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((E),(D)))));\n  TURTLE_TURN(-(GLOBAL_GET(\"angB\")));\n  Bande2();\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction TransCEdirA() {\n  TURTLE_UP(true);\n  TURTLE_MV((GLOBAL_GET(\"d\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angD\")))));\n  TURTLE_MV((GLOBAL_GET(\"e\")),false);\n  TURTLE_TURN((Math.minus(180,(GLOBAL_GET(\"angE\")))));\n  TURTLE_MV((GLOBAL_GET(\"a\")),false);\n  TURTLE_TURN((180));\n  TURTLE_UP(false);\n}\n\n\nInit();\nfor (var blockly_var_i = -4 ; blockly_var_i <= 4 ; blockly_var_i = blockly_var_i + 1){\n  DeuxBandes(Math.plus((C),Math.minus(Math.times(blockly_var_i,(W)),Math.times(blockly_var_i,(U)))));\n};","parents":["E","A","B","D","W","U","V"]},"current":"onlogo"});


