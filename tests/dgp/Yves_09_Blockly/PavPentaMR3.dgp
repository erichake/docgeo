"FROM\"><block type=\"dgpad_get_point_short\" id=\"qvl}o-,GNoneY5{K@G9h\"><field name=\"NAME\">A</field></block></value><value name=\"TO\"><block type=\"dgpad_get_point_short\" id=\"ION*+9u{BQON-.uva85/\"><field name=\"NAME\">B</field></block></value></block></value><next><block type=\"dgpad_global_set\" id=\"X!pPE-W0}o4EYM`EZ.I3\"><field name=\"VAR\">c</field><value name=\"NAME\"><block type=\"dgpad_distance\" id=\"PJluiE.r(2ind#Q2XlA?\"><value name=\"FROM\"><block type=\"dgpad_get_point_short\" id=\":e6^]?Fdk71`6_VdogY_\"><field name=\"NAME\">B</field></block></value><value name=\"TO\"><block type=\"dgpad_get_point_short\" id=\"[EfhwSw%Od)#+S+n4]_^\"><field name=\"NAME\">C</field></block></value></block></value><next><block type=\"dgpad_global_set\" id=\"qeAwr5w3kx_O0@*b`Js7\"><field name=\"VAR\">d</field><value name=\"NAME\"><block type=\"dgpad_distance\" id=\"85B4R)[BcA;UvD^fIL,N\"><value name=\"FROM\"><block type=\"dgpad_get_point_short\" id=\"~MLQr|Pc9;G5sntQrVd?\"><field name=\"NAME\">C</field></block></value><value name=\"TO\"><block type=\"dgpad_get_point_short\" id=\"dV@sues+OKB6%Am{oeFk\"><field name=\"NAME\">D</field></block></value></block></value><next><block type=\"dgpad_global_set\" id=\"ilkyb{WI?oZgoO!zE5Q!\"><field name=\"VAR\">e</field><value name=\"NAME\"><block type=\"dgpad_distance\" id=\"fa?M9)g.,f*~X.)4pED/\"><value name=\"FROM\"><block type=\"dgpad_get_point_short\" id=\"X}I?jDo29x;q6iK`s!Qj\"><field name=\"NAME\">D</field></block></value><value name=\"TO\"><block type=\"dgpad_get_point_short\" id=\":e;c1o5xR}u%`ARou.,j\"><field name=\"NAME\">E</field></block></value></block></value><next><block type=\"turtle_width\" id=\"V]Ocx%`6lna*EB#VCJHW\"><field name=\"WHAT\">pen</field><value name=\"WIDTH\"><shadow type=\"math_number\" id=\"q^:;S{8:5l+z@3CVP=D-\"><field name=\"NUM\">2</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction HexaGene(blockly_local_r,blockly_local_LeCh) {\n  TURTLE_UP(true);\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((C),(A)))));\n  TURTLE_TURN((Math.plus(30,Math.times(blockly_local_r,120))));\n  TURTLE_MV((Math.times((d((A),(D))),Math.sqrt(3))),false);\n  TURTLE_UP(false);\n  if (blockly_local_LeCh == 1) {\n    TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((B),(A)))));\n     var blockly_var_RotAlea = Math.floor(Math.random()*(Math.abs(0-2)+1)+(0+2-Math.abs(0-2))/2);\n    TURTLE_TURN((Math.times(blockly_var_RotAlea,120)));\n    for (var blockly_var_i = 1 ; blockly_var_i <= 3 ; blockly_var_i = blockly_var_i + 1){\n      BCDEA(1, blockly_var_i);\n      BugCouleurBord();\n      TURTLE_TURN((120));\n    };\n  }\n  if (blockly_local_LeCh == 2) {\n    TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((sB),(A)))));\n    blockly_var_RotAlea = Math.floor(Math.random()*(Math.abs(0-2)+1)+(0+2-Math.abs(0-2))/2);\n    TURTLE_TURN((Math.times(blockly_var_RotAlea,120)));\n    for (var blockly_var_i = 1 ; blockly_var_i <= 3 ; blockly_var_i = blockly_var_i + 1){\n      BCDEA(0, Math.plus(blockly_var_i,4));\n      BugCouleurBord();\n      TURTLE_TURN((120));\n    };\n  }\n  if (blockly_local_LeCh == 3) {\n     var blockly_var_Indirect = Math.floor(Math.random()*(Math.abs(0-1)+1)+(0+1-Math.abs(0-1))/2);\n    if (blockly_var_Indirect == 0) {\n      TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((B),(A)))));\n      blockly_var_RotAlea = Math.floor(Math.random()*(Math.abs(0-2)+1)+(0+2-Math.abs(0-2))/2);\n      TURTLE_TURN((Math.times(blockly_var_RotAlea,120)));\n      for (var blockly_var_i = 1 ; blockly_var_i <= 3 ; blockly_var_i = blockly_var_i + 1){\n        BCDEA(1, blockly_var_i);\n        BugCouleurBord();\n        TURTLE_TURN((120));\n      };\n    } else {\n      TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((sB),(A)))));\n      blockly_var_RotAlea = Math.floor(Math.random()*(Math.abs(0-2)+1)+(0+2-Math.abs(0-2))/2);\n      TURTLE_TURN((Math.times(blockly_var_RotAlea,120)));\n      for (var blockly_var_i = 1 ; blockly_var_i <= 3 ; blockly_var_i = blockly_var_i + 1){\n        BCDEA(0, Math.plus(blockly_var_i,4));\n        BugCouleurBord();\n        TURTLE_TURN((120));\n      };\n    }\n  }\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction BugCouleurBord() {\n  TURTLE_UP(true);\n  TURTLE_MV(60,true);\n  TURTLE_MV(-60,true);\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction PentaListe(blockly_local_LL,blockly_local_LA,blockly_local_sens,blockly_local_couleur) {\n  TURTLE_COLOUR(10);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_MV((blockly_local_LL[blockly_var_i-1]),false);\n    if (blockly_local_sens == 1) {\n      TURTLE_TURN((Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    } else {\n      TURTLE_TURN(-(Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    }\n  };\n  TURTLE_COLOUR((Math.plus(10,Math.times(6,blockly_local_couleur))));\n  TURTLE_FILL(30);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction BCDEA(blockly_local_s,blockly_local_k) {\n  PentaListe([(GLOBAL_GET(\"b\")), (GLOBAL_GET(\"c\")), (GLOBAL_GET(\"d\")), (GLOBAL_GET(\"e\")), (GLOBAL_GET(\"a\"))], [(GLOBAL_GET(\"angB\")), (GLOBAL_GET(\"angC\")), (GLOBAL_GET(\"angD\")), (GLOBAL_GET(\"angE\")), (GLOBAL_GET(\"angA\"))], blockly_local_s, Math.plus(7,Math.times(5,blockly_local_k)));\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Translation(blockly_local_P,blockly_local_Q) {\n  TURTLE_UP(true);\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus(blockly_local_Q,blockly_local_P))));\n  TURTLE_MV((d(blockly_local_P,blockly_local_Q)),false);\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Init() {\n  GLOBAL_SET(\"angA\",(Math.Angle180((E),(A),(B))));\n  GLOBAL_SET(\"angB\",(Math.Angle180((A),(B),(C))));\n  GLOBAL_SET(\"angC\",(Math.Angle180((B),(C),(D))));\n  GLOBAL_SET(\"angD\",(Math.Angle180((C),(D),(E))));\n  GLOBAL_SET(\"angE\",(Math.Angle180((D),(E),(A))));\n  GLOBAL_SET(\"a\",(d((A),(E))));\n  GLOBAL_SET(\"b\",(d((A),(B))));\n  GLOBAL_SET(\"c\",(d((B),(C))));\n  GLOBAL_SET(\"d\",(d((C),(D))));\n  GLOBAL_SET(\"e\",(d((D),(E))));\n  TURTLE_WIDTH(2);\n}\n\n\nInit();\nTURTLE_UP(true);\nTURTLE_JOIN_PT((A));\nTURTLE_ROTATE_PT((B));\nTURTLE_UP(false);\nfor (var blockly_var_i = 1 ; blockly_var_i <= 3 ; blockly_var_i = blockly_var_i + 1){\n  BCDEA(1, blockly_var_i);\n  BugCouleurBord();\n  TURTLE_TURN((120));\n};\nfor (var blockly_var_count = 1 ; blockly_var_count <= 3 ; blockly_var_count++){\n  if ((ch) < 3) {\n    HexaGene(0, 1);\n  } else {\n    HexaGene(0, 3);\n  }\n};\nTURTLE_UP(true);\nTURTLE_JOIN_PT((A));\nTURTLE_UP(false);\nHexaGene(1, (ch));\nblockly_var_Ctr = (TURTLE_POS());\nfor (var blockly_var_count2 = 1 ; blockly_var_count2 <= 4 ; blockly_var_count2++){\n  HexaGene(0, (ch));\n};\nTURTLE_UP(true);\nTURTLE_JOIN_PT(blockly_var_Ctr);\nTURTLE_UP(false);\nif ((ch) < 3) {\n  HexaGene(1, 1);\n  blockly_var_Ctr = (TURTLE_POS());\n  for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 4 ; blockly_var_count3++){\n    HexaGene(0, 1);\n  };\n} else {\n  HexaGene(1, 3);\n  blockly_var_Ctr = (TURTLE_POS());\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= 4 ; blockly_var_count4++){\n    HexaGene(0, 3);\n  };\n}\nTURTLE_UP(true);\nTURTLE_JOIN_PT(blockly_var_Ctr);\nTURTLE_UP(false);\nif ((ch) < 3) {\n  HexaGene(1, (ch));\n  for (var blockly_var_count5 = 1 ; blockly_var_count5 <= 5 ; blockly_var_count5++){\n    HexaGene(0, (ch));\n  };\n} else {\n  HexaGene(1, 3);\n  blockly_var_Ctr = (TURTLE_POS());\n  for (var blockly_var_count6 = 1 ; blockly_var_count6 <= 5 ; blockly_var_count6++){\n    HexaGene(0, 3);\n  };\n}","parents":["A","D","B","sB","ch","E"]},"current":"onlogo"});


