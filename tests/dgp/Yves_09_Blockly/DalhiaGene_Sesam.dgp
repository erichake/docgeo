blk_turtle_exp_T=Expression("blk_turtle_exp_T","","","","var bl_iaaaijfhi=function(){\nTURTLE_INIT(\"T\",T);\n/**\n * Décrire cette fonction…\n */\nfunction PolyCote1() {\n  TURTLE_UP(true);\n  TURTLE_COLOUR(55);\n  for (var blockly_var_count = 1 ; blockly_var_count <= (GLOBAL_GET(\"TronkPoly\")) ; blockly_var_count++){\n    TURTLE_MV(1,false);\n    TURTLE_TURN((Math.quotient(360,(nbPoly))));\n  };\n  var blockly_var_temp_var = TURTLE_POS() ;\n  SET_EXP(\"M\",blockly_var_temp_var);\n}\n\n\nGLOBAL_SET(\"TronkPoly\",(Math.floor(Math.quotient((nbPoly),3))));\nblockly_var_ModifTronk = (nbPoly) == 5 && (nbP) < 11 || (nbPoly) == 7 && (nbP) < 5 || (nbPoly) == 8 && (nbP) < 8;\nif (blockly_var_ModifTronk == true) {\n  GLOBAL_INC(\"TronkPoly\",1);\n}\nif ((nbPoly) == 9 && (nbP) > 18) {\n  GLOBAL_INC(\"TronkPoly\",-1);\n}\nTURTLE_ROTATE_PT((O));\nTURTLE_TURN(-(Math.minus(90,Math.quotient(180,(nbPoly)))));\nPolyCote1();\nreturn TURTLE_RESULT()\n};\nbl_iaaaijfhi()","-15.55","5.8875");
