blk_turtle_exp_O=Expression("blk_turtle_exp_O","","","","var bl_cefeeeedi=function(){\nTURTLE_INIT(\"O\",O);\n/**\n * Décrire cette fonction…\n */\nfunction Init() {\n  TURTLE_COLOUR(9);\n  GLOBAL_SET(\"Rsuiv\",(R));\n  GLOBAL_SET(\"theta\",(Math.quotient(360,(nbP))));\n  GLOBAL_SET(\"theta2\",(Math.quotient(180,(nbP))));\n  GLOBAL_SET(\"AB\",(Math.times(Math.times(2,(GLOBAL_GET(\"Rsuiv\"))),Math.sin((GLOBAL_GET(\"theta2\"))))));\n  GLOBAL_SET(\"ccar\",(Math.quotient((d((T),(U))),(d((T),(M))))));\n  GLOBAL_SET(\"nbCote\",(nbPoly));\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n  TURTLE_ROTATE_PT((O));\n  TURTLE_TURN(-(Math.minus(90,Math.quotient(180,(GLOBAL_GET(\"nbCote\"))))));\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction ChangerDeNiveau() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((GLOBAL_GET(\"NewS\")));\n  TURTLE_ROTATE_PT((O));\n  GLOBAL_SET(\"ccar\",(Math.times((GLOBAL_GET(\"ccar\")),Math.quotient((d((O),(GLOBAL_GET(\"NewS\")))),(GLOBAL_GET(\"Rsuiv\"))))));\n  GLOBAL_SET(\"Rsuiv\",(d((O),(GLOBAL_GET(\"NewS\")))));\n  GLOBAL_SET(\"AB\",(Math.times(Math.times(2,(GLOBAL_GET(\"Rsuiv\"))),Math.sin((GLOBAL_GET(\"theta2\"))))));\n  TURTLE_UP(false);\n  TURTLE_TURN(-(Math.minus(90,Math.quotient(180,(GLOBAL_GET(\"nbCote\"))))));\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Poly() {\n  for (var blockly_var_count2 = 1 ; blockly_var_count2 <= (GLOBAL_GET(\"nbCote\")) ; blockly_var_count2++){\n    TURTLE_MV((GLOBAL_GET(\"ccar\")),false);\n    TURTLE_TURN((Math.quotient(360,(GLOBAL_GET(\"nbCote\")))));\n  };\n  TURTLE_FILL(60);\n  TURTLE_TURN((Math.quotient(360,(GLOBAL_GET(\"nbCote\")))));\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction PolyRetour() {\n   var blockly_var_PolyR = [];\n  blockly_var_PolyR.push(TURTLE_POS());\n  for (var blockly_var_count3 = 1 ; blockly_var_count3 <= (GLOBAL_GET(\"nbCote\")) ; blockly_var_count3++){\n    TURTLE_MV((GLOBAL_GET(\"ccar\")),false);\n    TURTLE_TURN((Math.quotient(360,(GLOBAL_GET(\"nbCote\")))));\n    blockly_var_PolyR.push(TURTLE_POS());\n  };\n  TURTLE_FILL(60);\n   var blockly_var_k = Math.plus(Math.floor(Math.quotient((GLOBAL_GET(\"nbCote\")),2)),1);\n  if ((GLOBAL_GET(\"nbCote\")) % 2 == 0) {\n     var blockly_var_PtRetour = (blockly_var_PolyR[blockly_var_k-1]);\n  } else {\n    blockly_var_PtRetour = Math.quotient(Math.plus((blockly_var_PolyR[blockly_var_k-1]),(blockly_var_PolyR[(Math.plus(blockly_var_k,1))-1])),2);\n  }\n  TURTLE_TURN((Math.quotient(360,(GLOBAL_GET(\"nbCote\")))));\n  return blockly_var_PtRetour;\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction UnTour() {\n  for (var blockly_var_count4 = 1 ; blockly_var_count4 <= Math.minus((nbP),1) ; blockly_var_count4++){\n    Poly();\n    TURTLE_ROTATE_PT((O));\n    TURTLE_UP(true);\n    TURTLE_TURN(-(90));\n    TURTLE_TURN((GLOBAL_GET(\"theta2\")));\n    TURTLE_MV((GLOBAL_GET(\"AB\")),false);\n    TURTLE_ROTATE_PT((O));\n    TURTLE_TURN(-(Math.minus(90,Math.quotient(180,(GLOBAL_GET(\"nbCote\"))))));\n    TURTLE_UP(false);\n  };\n  GLOBAL_SET(\"NewS\",(PolyRetour()));\n  TURTLE_COLOUR_INCREMENT(8);\n}\n\n\nInit();\nfor (var blockly_var_count = 1 ; blockly_var_count <= (n) ; blockly_var_count++){\n  UnTour();\n  ChangerDeNiveau();\n};\nreturn TURTLE_RESULT()\n};\nbl_cefeeeedi()","-15.55","5.8875");
