"Q\"></arg></mutation><field name=\"NAME\">Translation</field><comment pinned=\"false\" h=\"80\" w=\"160\">Décrire cette fonction…</comment><statement name=\"STACK\"><block type=\"turtle_pen\" id=\"F@+A!lnaJ5[c.#5DI59I\"><field name=\"PEN\">penUp</field><next><block type=\"turtle_turn_pt\" id=\"{r@p?^qXS{S~-?7{=tth\"><value name=\"VALUE\"><shadow type=\"dgpad_get_point_short_turtle\" id=\"Ef]S7@z}!*N:w7i72Y2Q\"><field name=\"NAME\">B</field></shadow><block type=\"math_arithmetic\" id=\"SOHL(fzOVmJzTO+69SJy\"><field name=\"OP\">ADD</field><value name=\"A\"><block type=\"turtle_position\" id=\"u}X[ioCHT/kh![}`MH4N\"></block></value><value name=\"B\"><block type=\"math_arithmetic\" id=\"%`iv_r^9|!4dc_Afc!8S\"><field name=\"OP\">MINUS</field><value name=\"A\"><block type=\"variables_get\" id=\";Y15??_7KQ:q_4|cY`#@\"><field name=\"VAR\">Q</field></block></value><value name=\"B\"><block type=\"variables_get\" id=\"5}4Zj]{]h{hZAXTK@?XN\"><field name=\"VAR\">P</field></block></value></block></value></block></value><next><block type=\"turtle_move\" id=\"[94:H|t7(`O.==`Ufq*W\"><field name=\"DIR\">moveForward</field><field name=\"UNITS\">un</field><value name=\"VALUE\"><shadow type=\"math_number\" id=\",2hxP=ZKps*ZDxE*+PS-\"><field name=\"NUM\">60</field></shadow><block type=\"dgpad_distance\" id=\"g^WXL^fk#=n7Os?Bl#3Z\"><value name=\"FROM\"><block type=\"variables_get\" id=\"156,mx/4k`5Ur3zZ]wVm\"><field name=\"VAR\">P</field></block></value><value name=\"TO\"><block type=\"variables_get\" id=\"iG_R!iKuQgq5dYKN.R_i\"><field name=\"VAR\">Q</field></block></value></block></value><next><block type=\"turtle_pen\" id=\"v#TRU{0bxd_4_-M@k.QD\"><field name=\"PEN\">penDown</field></block></next></block></next></block></next></block></statement></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction BugCouleurBord() {\n  TURTLE_UP(true);\n  TURTLE_MV(60,true);\n  TURTLE_MV(-60,true);\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction PentaListe(blockly_local_LL,blockly_local_LA,blockly_local_sens,blockly_local_Cinit,blockly_local_deltaC,blockly_local_kC) {\n  TURTLE_COLOUR(10);\n  for (var blockly_var_i2 = 1 ; blockly_var_i2 <= 5 ; blockly_var_i2 = blockly_var_i2 + 1){\n    TURTLE_MV((blockly_local_LL[blockly_var_i2-1]),false);\n    if (blockly_local_sens == 1) {\n      TURTLE_TURN((Math.minus(180,(blockly_local_LA[blockly_var_i2-1]))));\n    } else {\n      TURTLE_TURN(-(Math.minus(180,(blockly_local_LA[blockly_var_i2-1]))));\n    }\n  };\n  TURTLE_COLOUR((Math.plus(blockly_local_Cinit,Math.times(blockly_local_deltaC,blockly_local_kC))));\n  TURTLE_FILL(30);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction BlocDe4(blockly_local_LaCoul,blockly_local_LeDelta) {\n  for (var blockly_var_i2 = 1 ; blockly_var_i2 <= 4 ; blockly_var_i2 = blockly_var_i2 + 1){\n    CDEAB(1, blockly_local_LaCoul, blockly_local_LeDelta, blockly_var_i2);\n    BugCouleurBord();\n    TURTLE_TURN((90));\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Init() {\n  GLOBAL_SET(\"angA\",(Math.Angle180((E),(A),(B))));\n  GLOBAL_SET(\"angB\",(Math.Angle180((A),(B),(C))));\n  GLOBAL_SET(\"angC\",(Math.Angle180((B),(C),(D))));\n  GLOBAL_SET(\"angD\",(Math.Angle180((C),(D),(E))));\n  GLOBAL_SET(\"angE\",(Math.Angle180((D),(E),(A))));\n  GLOBAL_SET(\"a\",(d((A),(E))));\n  GLOBAL_SET(\"b\",(d((A),(B))));\n  GLOBAL_SET(\"c\",(d((B),(C))));\n  GLOBAL_SET(\"d\",(d((C),(D))));\n  GLOBAL_SET(\"e\",(d((D),(E))));\n  TURTLE_WIDTH(2);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction CDEAB(blockly_local_s,blockly_local_Ci,blockly_local_delta,blockly_local_k) {\n  PentaListe([(GLOBAL_GET(\"d\")), (GLOBAL_GET(\"e\")), (GLOBAL_GET(\"a\")), (GLOBAL_GET(\"b\")), (GLOBAL_GET(\"c\"))], [(GLOBAL_GET(\"angD\")), (GLOBAL_GET(\"angE\")), (GLOBAL_GET(\"angA\")), (GLOBAL_GET(\"angB\")), (GLOBAL_GET(\"angC\"))], blockly_local_s, blockly_local_Ci, blockly_local_delta, blockly_local_k);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Translation(blockly_local_P,blockly_local_Q) {\n  TURTLE_UP(true);\n  TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus(blockly_local_Q,blockly_local_P))));\n  TURTLE_MV((d(blockly_local_P,blockly_local_Q)),false);\n  TURTLE_UP(false);\n}\n\n\nInit();\nfor (var blockly_var_i = -3 ; blockly_var_i <= 4 ; blockly_var_i = blockly_var_i + 1){\n  for (var blockly_var_j = -3 ; blockly_var_j <= 3 ; blockly_var_j = blockly_var_j + 1){\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT((Math.plus((C),Math.plus(Math.times(blockly_var_j,Math.minus((V),(C))),Math.times(blockly_var_i,Math.minus((U),(C)))))));\n    TURTLE_ROTATE_PT((Math.plus((TURTLE_POS()),Math.minus((D),(C)))));\n    TURTLE_UP(false);\n    BlocDe4(Math.plus(17,Math.times(5,Math.plus(blockly_var_i,3))), 9);\n  };\n};","parents":["V","U","D","E","A","B"]},"current":"onlogo"});


