*WM\"><field name=\"NAME\">A</field></shadow><block type=\"dgpad_get_list\" id=\"WICwxr2-pZ^Mv{ERf5E-\"><value name=\"NAME\"><block type=\"variables_get\" id=\":pq6kmV,66V.1B}P/H[0\"><field name=\"VAR\">Pointage</field></block></value><value name=\"INDEX\"><block type=\"math_arithmetic\" id=\"|JN%9t?PO+ZJ:mb8#Cf?\"><field name=\"OP\">ADD</field><value name=\"A\"><block type=\"variables_get\" id=\"c[cNijP)iN)1hCJh}(~W\"><field name=\"VAR\">i</field></block></value><value name=\"B\"><block type=\"math_number\" id=\"z)}.BVtQ3-{NXax7V|C.\"><field name=\"NUM\">1</field></block></value></block></value></block></value><next><block type=\"controls_repeat_ext\" id=\"7c/FbViFk#i)btNN!q.T\"><value name=\"TIMES\"><block type=\"math_number\" id=\"UPT[sUbypo?lnz`eAu0-\"><field name=\"NUM\">6</field></block></value><statement name=\"DO\"><block type=\"procedures_callnoreturn\" id=\"%+Q|FI87[WG%wykN0Qv.\" inline=\"true\"><mutation name=\"ABCDE\"><arg name=\"s\"></arg><arg name=\"k\"></arg></mutation><value name=\"ARG0\"><block type=\"math_number\" id=\"}R:(Xt_EYTF1=]l6n]bd\"><field name=\"NUM\">1</field></block></value><value name=\"ARG1\"><block type=\"math_arithmetic\" id=\"jTKU?C@a1Xf0Uel+g}=3\"><field name=\"OP\">MINUS</field><value name=\"A\"><block type=\"variables_get\" id=\"URMoiT9FL!@iR}e5~#sf\"><field name=\"VAR\">i</field></block></value><value name=\"B\"><block type=\"math_number\" id=\"Dc7#[AB3wan/qnN{*s{`\"><field name=\"NUM\">1</field></block></value></block></value><next><block type=\"procedures_callnoreturn\" id=\"A@br*D7})S*S,TNCOd_J\"><mutation name=\"BugCouleurBord\"></mutation><next><block type=\"turtle_turn\" id=\"DP7VRiCIPy*vdwl:URNr\"><field name=\"DIR\">turnLeft</field><value name=\"VALUE\"><shadow type=\"turtle_angle_input\" id=\"pD2]{c~cl)yC|l{X;-{M\"><field name=\"ANGLE\">60</field></shadow></value></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction BugCouleurBord() {\n  TURTLE_UP(true);\n  TURTLE_MV(60,true);\n  TURTLE_MV(-60,true);\n  TURTLE_UP(false);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction PentaListe(blockly_local_LL,blockly_local_LA,blockly_local_sens,blockly_local_couleur) {\n  TURTLE_COLOUR(10);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_MV((blockly_local_LL[blockly_var_i-1]),false);\n    if (blockly_local_sens == 1) {\n      TURTLE_TURN((Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    } else {\n      TURTLE_TURN(-(Math.minus(180,(blockly_local_LA[blockly_var_i-1]))));\n    }\n  };\n  TURTLE_COLOUR((Math.plus(10,Math.times(6,blockly_local_couleur))));\n  TURTLE_FILL(30);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction FleurCentrale() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n  TURTLE_ROTATE_PT((B));\n  TURTLE_UP(false);\n  for (var blockly_var_count = 1 ; blockly_var_count <= 6 ; blockly_var_count++){\n    ABCDE(1, 7);\n    BugCouleurBord();\n    TURTLE_TURN((60));\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Init() {\n  GLOBAL_SET(\"angA\",(Math.Angle180((E),(A),(B))));\n  GLOBAL_SET(\"angB\",(Math.Angle180((A),(B),(C))));\n  GLOBAL_SET(\"angC\",(Math.Angle180((B),(C),(D))));\n  GLOBAL_SET(\"angD\",(Math.Angle180((C),(D),(E))));\n  GLOBAL_SET(\"angE\",(Math.Angle180((D),(E),(A))));\n  GLOBAL_SET(\"a\",(d((A),(E))));\n  GLOBAL_SET(\"b\",(d((A),(B))));\n  GLOBAL_SET(\"c\",(d((B),(C))));\n  GLOBAL_SET(\"d\",(d((C),(D))));\n  GLOBAL_SET(\"e\",(d((D),(E))));\n  TURTLE_WIDTH(2);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Couronne1() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n   var blockly_var_Pointage = [];\n  blockly_var_Pointage.push(D);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((D));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(D))),false);\n    blockly_var_Pointage.push(TURTLE_POS());\n  };\n  for (var blockly_var_i = 0 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((U));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(U))),false);\n    TURTLE_UP(false);\n    TURTLE_ROTATE_PT((blockly_var_Pointage[(Math.plus(blockly_var_i,1))-1]));\n    for (var blockly_var_count2 = 1 ; blockly_var_count2 <= 6 ; blockly_var_count2++){\n      ABCDE(1, blockly_var_i);\n      BugCouleurBord();\n      TURTLE_TURN((60));\n    };\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction ABCDE(blockly_local_s,blockly_local_k) {\n  PentaListe([(GLOBAL_GET(\"b\")), (GLOBAL_GET(\"c\")), (GLOBAL_GET(\"d\")), (GLOBAL_GET(\"e\")), (GLOBAL_GET(\"a\"))], [(GLOBAL_GET(\"angB\")), (GLOBAL_GET(\"angC\")), (GLOBAL_GET(\"angD\")), (GLOBAL_GET(\"angE\")), (GLOBAL_GET(\"angA\"))], blockly_local_s, blockly_local_k);\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Couronne2P2() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n   var blockly_var_Pointage = [];\n  blockly_var_Pointage.push(D3);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((D3));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(D3))),false);\n    blockly_var_Pointage.push(TURTLE_POS());\n  };\n  for (var blockly_var_i = 0 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((V2));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(V2))),false);\n    TURTLE_UP(false);\n    TURTLE_ROTATE_PT((blockly_var_Pointage[(Math.plus(blockly_var_i,1))-1]));\n    for (var blockly_var_count3 = 1 ; blockly_var_count3 <= 6 ; blockly_var_count3++){\n      ABCDE(1, Math.plus(Math.times(3,blockly_var_i),2));\n      BugCouleurBord();\n      TURTLE_TURN((60));\n    };\n  };\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction Couronne2P1() {\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((A));\n   var blockly_var_Pointage = [];\n  blockly_var_Pointage.push(D2);\n  for (var blockly_var_i = 1 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((D2));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(D2))),false);\n    blockly_var_Pointage.push(TURTLE_POS());\n  };\n  for (var blockly_var_i = 0 ; blockly_var_i <= 5 ; blockly_var_i = blockly_var_i + 1){\n    TURTLE_UP(true);\n    TURTLE_JOIN_PT((A));\n    TURTLE_ROTATE_PT((U));\n    TURTLE_TURN((Math.times(blockly_var_i,60)));\n    TURTLE_MV((d((A),(V))),false);\n    TURTLE_UP(false);\n    TURTLE_ROTATE_PT((blockly_var_Pointage[(Math.plus(blockly_var_i,1))-1]));\n    for (var blockly_var_count4 = 1 ; blockly_var_count4 <= 6 ; blockly_var_count4++){\n      ABCDE(1, Math.minus(blockly_var_i,1));\n      BugCouleurBord();\n      TURTLE_TURN((60));\n    };\n  };\n}\n\n\nInit();\nFleurCentrale();\nCouronne1();\nCouronne2P1();\nCouronne2P2();","parents":["A","B","E","D","U","D3","V2","D2","V"]},"current":"onlogo"});


