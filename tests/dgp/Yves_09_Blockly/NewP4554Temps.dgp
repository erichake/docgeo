\"><block type=\"math_single\" id=\"^3Sd4XvCRhYIu7oBV5[?\"><field name=\"OP\">ABS</field><value name=\"NUM\"><block type=\"variables_get\" id=\"G`,ag3JzJh?N-tRX}9AI\"><field name=\"VAR\">ps</field></block></value></block></value></block></value></block></statement><next><block type=\"variables_set\" id=\"aua*WZBy6P,(%DUi,-1b\"><field name=\"VAR\">AOB</field><value name=\"VALUE\"><block type=\"math_arithmetic\" id=\"w32V##^!)2U`m5%50#Ez\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"math_number\" id=\"ehC%*sqOso.U-=;YK9,k\"><field name=\"NUM\">-1</field></block></value><value name=\"B\"><block type=\"math_arithmetic\" id=\"wz(EIIzQF^y}(%6-0R[J\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\" id=\"GVEB^2wdQNA4-Na|+J7F\"><field name=\"VAR\">sgn</field></block></value><value name=\"B\"><block type=\"variables_get\" id=\":7g?2K)#2UD?{tW6YZT;\"><field name=\"VAR\">AOB</field></block></value></block></value></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name=\"RETURN\"><block type=\"variables_get\" id=\"^:)DPky,bZZ,f2_.y1*Q\"><field name=\"VAR\">AOB</field></block></value></block><block type=\"variables_set\" id=\"X:01vtec`Q2{hdWa]EW9\" x=\"0\" y=\"538\"><field name=\"VAR\">dt</field><value name=\"VALUE\"><block type=\"procedures_callreturn\" id=\"PI0Z|SmoE_6Jw(=O,*QZ\" inline=\"true\"><mutation name=\"angleOriente\"><arg name=\"PA\"></arg><arg name=\"PO\"></arg><arg name=\"PB\"></arg></mutation><value name=\"ARG0\"><block type=\"dgpad_global_get\" id=\"sj_Z0O:?m4ap=BW{6%gy\"><field name=\"VAR\">oldPoint</field></block></value><value name=\"ARG1\"><block type=\"dgpad_get_object_short\" id=\"dZ/EG/Wi{q#(Pb.lGo`3\"><field name=\"NAME\">Ce45</field></block></value><value name=\"ARG2\"><block type=\"dgpad_get_object_short\" id=\"ZA3+fttz#RdP{;!6e*p3\"><field name=\"NAME\">Pm</field></block></value></block></value><next><block type=\"dgpad_global_inc\" id=\"t:9]%%wZntkR!O_G1#H~\"><field name=\"VAR\">Theta</field><value name=\"NAME\"><block type=\"variables_get\" id=\"|B%.n37zzHQv@fKJMavj\"><field name=\"VAR\">dt</field></block></value><next><block type=\"dgpad_global_set\" id=\"XnWDBbwG5ClVNlD*m+V.\"><field name=\"VAR\">oldPoint</field><value name=\"NAME\"><block type=\"dgpad_get_object_short\" id=\"7M{]=~t)9#VQsD;+k)1r\"><field name=\"NAME\">M</field></block></value><next><block type=\"dgpad_return\" id=\"RK},Sd{O:Z4*sRy0A_{q\"><value name=\"NAME\"><block type=\"dgpad_global_get\" id=\"tvJXHW7B*#[/BKO2q)0d\"><field name=\"VAR\">Theta</field></block></value></block></next></block></next></block></next></block></xml>","sync":"/**\n * Décrire cette fonction…\n */\nfunction angleOriente(blockly_local_PA,blockly_local_PO,blockly_local_PB) {\n   var blockly_var_AOB = (Math.Angle180(blockly_local_PA,blockly_local_PO,blockly_local_PB));\n   var blockly_var_u = Math.minus(blockly_local_PA,blockly_local_PO);\n   var blockly_var_v = Math.minus(blockly_local_PB,blockly_local_PO);\n  blockly_var_u = [Math.minus(0,(blockly_var_u[2-1])), (blockly_var_u[1-1])];\n   var blockly_var_ps = Math.plus(Math.times((blockly_var_u[1-1]),(blockly_var_v[1-1])),Math.times((blockly_var_u[2-1]),(blockly_var_v[2-1])));\n  if (blockly_var_ps == 0) {\n     var blockly_var_sgn = 1;\n  } else {\n    blockly_var_sgn = Math.quotient(blockly_var_ps,Math.abs(blockly_var_ps));\n  }\n  blockly_var_AOB = Math.times(-1,Math.times(blockly_var_sgn,blockly_var_AOB));\n  return blockly_var_AOB;\n}\n\n\nblockly_var_dt = angleOriente((GLOBAL_GET(\"oldPoint\")), (Ce45), (Pm));\nGLOBAL_INC(\"Theta\",blockly_var_dt);\nGLOBAL_SET(\"oldPoint\",(M));\nreturn ((GLOBAL_GET(\"Theta\")));","parents":["Ce45","Pm","M"]},"current":"oncompute"});
BLK(nbTour,{"oncompute":{"xml":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><block type=\"variables_set\" id=\"IL#xwke[3:RI@-Rnjd1O\" x=\"-430\" y=\"165\"><field name=\"VAR\">arrondirT</field><value name=\"VALUE\"><block type=\"math_arithmetic\" id=\"L|:g~tBl-w!B!u]DHj.Q\"><field name=\"OP\">DIVIDE</field><value name=\"A\"><block type=\"math_round\" id=\"~#(BXtqz?Z/aLCf%hXHy\"><field name=\"OP\">ROUNDDOWN</field><value name=\"NUM\"><block type=\"dgpad_get_object_short\" id=\"%.v[LdFAnk-w|m2XMc!Y\"><field name=\"NAME\">c</field></block></value></block></value><value name=\"B\"><block type=\"math_number\" id=\"Sl8Nh?uo(@uP;MSlc@)4\"><field name=\"NUM\">360</field></block></value></block></value><next><block type=\"variables_set\" id=\"wyx%}|T`%yrN43~jGki2\"><field name=\"VAR\">oldT</field><value name=\"VALUE\"><block type=\"math_round\" id=\"G{IJfohQz`ZG(Z_eN#CG\"><field name=\"OP\">ROUNDDOWN</field><value name=\"NUM\"><block type=\"variables_get\" id=\"pkW7P+B_wrQKAJ}uFy9V\"><field name=\"VAR\">arrondirT</field></block></value></block></value><next><block type=\"dgpad_return\" id=\"Bcjc:].lXf,#@.La]x*;\"><value name=\"NAME\"><block type=\"variables_get\" id=\"@9dqiU1XLP#p6pK#l8X;\"><field name=\"VAR\">oldT</field></block></value></block></next></block></next></block></xml>","sync":"blockly_var_arrondirT = Math.quotient(Math.floor(c),360);\nblockly_var_oldT = Math.floor(blockly_var_arrondirT);\nreturn (blockly_var_oldT);","parents":["c"]},"current":"oncompute"});
BLK(chM,{"oncompute":{"xml":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><block type=\"dgpad_return\" id=\"%7qRLk6X5T%(q-caeKw-\" x=\"9\" y=\"3\"><value name=\"NAME\"><block type=\"math_number_property\" id=\"%r+#L06~?7IgZ(J|}*j[\"><mutation divisor_input=\"false\"></mutation><field name=\"PROPERTY\">ODD</field><value name=\"NUMBER_TO_CHECK\"><block type=\"dgpad_get_object_short\" id=\"4S[fXEUpQpa**V`MFf@b\"><field name=\"NAME\">nbTour</field></block></value></block></value></block></xml>","sync":"return (((nbTour) % 2 == 1));","parents":["nbTour"]},"current":"oncompute"});


