Text("<span style=\"color:#0000FF\">$Courbe \\; int\\acute{e}grale \\; de :$\n\n<span style=\"color:#FF0000\">$x\\,'=ax+by+f(t)$\n$y\\,'=cx+dy+g(t)$\n<span style=\"color:#0000FF\">\n$a$ = <input target=\"a2\">\n$b$ = <input target=\"b2\">\n$c$ = <input target=\"c2\">\n$d$ = <input target=\"d2\">\n\n<span style=\"color:#AA3300\">$f(t)$ = <input target=\"f\">\n$g(t)$ = <input target=\"g\"><span style=\"color:#FF0000\">\n\n$x(M_0)$ = <input target=\"x0M\">\n$y(M_0)$ = <input target=\"y0M\">\n<span style=\"color:#666633\">\n",28,69,252,386,"c:rgba(113,202,246,0.18);s:3;r:15;p:4");
Text("<div style='font-size:14px;color:#0000FF;text-align:left'>Coordonn\u00e9es du point courant de la courbe\n\n<div style='font-size:14px;color:#FF0000;text-align:left'>issue de $M_0$ : $(%Traj3D_M[LeTps][0]% \\; ; \\; %Traj3D_M[LeTps][1]% \\; ; \\; %Traj3D_M[LeTps][2]%)$\n<div style='font-size:14px;color:#0000FF;text-align:left'>\n",23,544,307,82,"c:rgba(240,237,57,0.18);s:3;r:15;p:3");
