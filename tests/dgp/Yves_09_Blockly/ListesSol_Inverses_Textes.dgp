// Blockly :
BLK(PtCarr,{"onlogo":{"xml":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><block type=\"procedures_defnoreturn\" id=\"i8O[]UC_0~4d@G;beDW6\" collapsed=\"true\" x=\"251\" y=\"-204\"><field name=\"NAME\">LesCommentaires</field><comment pinned=\"false\" h=\"80\" w=\"160\">Décrire cette fonction…</comment><statement name=\"STACK\"><block type=\"dgpad_create_list\" id=\"n@4:)OIEF*@4gw_zs(hW\"><field name=\"VAR\">LesComm</field><next><block type=\"dgpad_create_list\" id=\"M69DcRFA7U6^^Kj-FA]~\"><field name=\"VAR\">CommInv</field><next><block type=\"dgpad_push\" id=\"}#H75_zTK7KW*hjlC;Lc\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"jw+H~W-r{UM);/bQwlo9\"><field name=\"TEXT\">Première solution. Pièce H décalée pour placer les 6 bleues</field></block></value><next><block type=\"dgpad_push\" id=\"]6GffY}HE;}lM8;lZFro\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\".ZH01D/quXu?!eiO{II(\"><field name=\"TEXT\">H devient G. Commencer à se repèrer par les codes couleurs</field></block></value><next><block type=\"dgpad_push\" id=\"Z~qdz=m1AM=0xk)ntbQ:\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"iI3@s0/n*G8t4Pj.Ha(y\"><field name=\"TEXT\">Solution avec G centré. Les 6 \"EA\" sont autour de G</field></block></value><next><block type=\"dgpad_push\" id=\"g4-rbPx_~~j=gXu11?N(\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"hKx],))^3hSV=]X(C-/k\"><field name=\"TEXT\">G devient H. W et X deviennent O  et P mais gardent leurs couleurs.</field></block></value><next><block type=\"dgpad_push\" id=\"-dNCCm,+Wgr;doQDPkGG\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"l[cl2w;=VdGVo;N{/O]6\"><field name=\"TEXT\">F au centre. On pourrait le mettre en D par échange C / R </field></block></value><next><block type=\"dgpad_push\" id=\"H2OWuEsn;P~%Lm={-rKA\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"ywR*@|B46pzXSo~Cq:B!\"><field name=\"TEXT\">F est invariant par inversion (retournement)</field></block></value><next><block type=\"dgpad_push\" id=\"scEJ!KSw-gc`]|@}ri9_\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"*?o{QLP8Pv).=,xzeRy~\"><field name=\"TEXT\">I au centre \"1C1B\" en Q-M.  Ech. Q / S donne J au centre</field></block></value><next><block type=\"dgpad_push\" id=\"HG+#5@e25uV5Us!Ksfay\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\",fI2DzH1V}duB,}vj3[I\"><field name=\"TEXT\">I est stable par inverse. Ech. devient A / B pour K au centre.</field></block></value><next><block type=\"dgpad_push\" id=\"Q1~H@FhoRbD5nrF2%(6a\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"Jmfj6VM8{3%QmO^H?sgW\"><field name=\"TEXT\">I au centre \"1C1B\" en A-Q.  Ech. A / B donne K au centre.</field></block></value><next><block type=\"dgpad_push\" id=\"hl?40ayGIOO)a9eXz(Bb\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"/![/@!C69ww,zVuF`*7u\"><field name=\"TEXT\">L'échange devient devient S / Q pour J au centre.</field></block></value><next><block type=\"dgpad_push\" id=\"uFn@;^NXbz}#ox!m!4HQ\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"KR3Xc4GkF*(,htIFuS,0\"><field name=\"TEXT\">W au centre, \"1C\" en D. Ech. L / R fait passer de W à V.</field></block></value><next><block type=\"dgpad_push\" id=\"r97|7SP=1t@T5H,dey(e\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"zQxWYJpB)/BqP-`e@Lb?\"><field name=\"TEXT\">L'échange transforme L / C pour X au centre..</field></block></value><next><block type=\"dgpad_push\" id=\"E8@0o26M8C#xB,DU7m)q\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"A0tbf.%{Sh/WR-j``~um\"><field name=\"TEXT\">V au centre avec l'échange L / R proposé à n=6.</field></block></value><next><block type=\"dgpad_push\" id=\"%{lR~fk:fLzF+|V=*Iu4\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"%0f/P0zhk@JY8F}i4Qge\"><field name=\"TEXT\">L'inverse de L est N. On peut encore faire l'éch. L / C. pour O au centre</field></block></value><next><block type=\"dgpad_push\" id=\"!MF-u4GMaW{r#7CCdvIH\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"!us#%RYFxL?@!vM1BVlU\"><field name=\"TEXT\">C au centre, \"2B\" en C et B. L'échange L / R tourne C d'un quart de tour.</field></block></value><next><block type=\"dgpad_push\" id=\":K5prBrFx*87|(}G_?@y\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"{Yp%!`1:h1xDGSp[zB`|\"><field name=\"TEXT\">L'inverse de C est R.</field></block></value><next><block type=\"dgpad_push\" id=\"x9Po6/:mt%VP-%Yf=bNn\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"=.0tw/.E`FBy/O}BkRXA\"><field name=\"TEXT\">U au centre, \"2B\" en R et A. L'échange A / B met \"2B\" en haut.</field></block></value><next><block type=\"dgpad_push\" id=\"CbzH+S1!A8vu-Q8hr#Je\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"]7kOcNSbjIK1Nq9(uE*v\"><field name=\"TEXT\">L'inverse de U est E. On peut trans. E en G mais contour non minimal</field></block></value><next><block type=\"dgpad_push\" id=\"GO(i!05Mn@FA~e.1g!DC\"><field name=\"VARNAME\">LesComm</field><value name=\"NAME\"><block type=\"text\" id=\"eKP2bg;et1fgX7Cxl)TU\"><field name=\"TEXT\">P au centre, \"1B\" avec T au dessus, ce qui bloque un peu les modifs.</field></block></value><next><block type=\"dgpad_push\" id=\"q%Jp7v@8]z!X1.9muAQB\"><field name=\"VARNAME\">CommInv</field><value name=\"NAME\"><block type=\"text\" id=\"mSXK/:{K^oGV0vU#~E-i\"><field name=\"TEXT\">L'inverse de P est X. </field></block></value><next><block type=\"dgpad_push\" id=\"FK20xG+,;R.XS}G+N4F1\"