s 6 bleues'));\n  blockly_var_CommInv.push(TURTLE_TEXT('H devient G. Commencer à se repèrer par les codes couleurs'));\n  blockly_var_LesComm.push(TURTLE_TEXT('Solution avec G centré. Les 6 \"EA\" sont autour de G'));\n  blockly_var_CommInv.push(TURTLE_TEXT('G devient H. W et X deviennent O  et P mais gardent leurs couleurs.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('F au centre. On pourrait le mettre en D par échange C / R '));\n  blockly_var_CommInv.push(TURTLE_TEXT('F est invariant par inversion (retournement)'));\n  blockly_var_LesComm.push(TURTLE_TEXT('I au centre \"1C1B\" en Q-M.  Ech. Q / S donne J au centre'));\n  blockly_var_CommInv.push(TURTLE_TEXT('I est stable par inverse. Ech. devient A / B pour K au centre.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('I au centre \"1C1B\" en A-Q.  Ech. A / B donne K au centre.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'échange devient devient S / Q pour J au centre.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('W au centre, \"1C\" en D. Ech. L / R fait passer de W à V.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'échange transforme L / C pour X au centre..'));\n  blockly_var_LesComm.push(TURTLE_TEXT('V au centre avec l\\'échange L / R proposé à n=6.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de L est N. On peut encore faire l\\'éch. L / C. pour O au centre'));\n  blockly_var_LesComm.push(TURTLE_TEXT('C au centre, \"2B\" en C et B. L\\'échange L / R tourne C d\\'un quart de tour.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de C est R.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('U au centre, \"2B\" en R et A. L\\'échange A / B met \"2B\" en haut.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de U est E. On peut trans. E en G mais contour non minimal'));\n  blockly_var_LesComm.push(TURTLE_TEXT('P au centre, \"1B\" avec T au dessus, ce qui bloque un peu les modifs.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de P est X. '));\n  blockly_var_LesComm.push(TURTLE_TEXT('L au centre, \"1C1B\" (aire 1) en A et M. Nombreuses variantes sur \"les EA\".'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L est invariant mais tourné de 90°. '));\n  blockly_var_LesComm.push(TURTLE_TEXT('M au centre, \"1C1B\" (aire 1)  original sur une seule pièce R.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('M est invariant, R devient C avec \"1C1B\" au même sommet.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('R au centre, Plusieurs variantes sur la ligne centrale pour M au centre.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de R est C. Là aussi variantes sur la ligne centrale.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('S au centre  dans un configuration \"3C en ligne 1\"'));\n  blockly_var_CommInv.push(TURTLE_TEXT('L\\'inverse de S est B, et donc \"3B\" en ligne 1 également.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('B au centre dans une belle version très \"symétrique\" (régulière).'));\n  blockly_var_CommInv.push(TURTLE_TEXT('Idem, bien entendu pour son inverse S.'));\n  blockly_var_LesComm.push(TURTLE_TEXT('A au centre. On peut échanger AKH et NFC - fig suivante.'));\n  blockly_var_CommInv.push(TURTLE_TEXT('Ce qui va échanger QJG en VFR'));\n  blockly_var_LesComm.push(TURTLE_TEXT('A au centre. Réalisation de la transformation annoncée'));\n  blockly_var_CommInv.push(TURTLE_TEXT('Et automatiquement de son inverse QJG en VFR'));\n  blockly_var_LesComm.push(TURTLE_TEXT('A au centre.  Echanges possibles  DT / FK., Q / R,  ou L / V ...'));\n  blockly_var_CommInv.push(TURTLE_TEXT('Et tous les inverses correspondants ...'));\n  TURTLE_UP(true);\n  TURTLE_JOIN_PT((PtCarr));\n  TURTLE_RESET();\n  TURTLE_TURN(-(90));\n  TURTLE_MV(11,false);\n  TURTLE_TURN((90));\n  TURTLE_MV(-1,false);\n  TURTLE_FONT('Arial',14,'normal','left');\n  if ((ChInv) == 0) {\n    TURTLE_COLOUR(53);\n    TURTLE_PRINT((blockly_var_LesComm[(n)-1]));\n  } else {\n    TURTLE_COLOUR(10);\n    TURTLE_PRINT((blockly_var_CommInv[(n)-1]));\n  }\n}\n\n/**\n * Décrire cette fonction…\n */\nfunction NommagePoints() {\n  if ((cCentre) == 0) {\n     var blockly_var_decal = 15;\n    TURTLE_UP(true);\n    TURTLE_FONT('Verdana',18,'normal','center');\n    TURTLE_JOIN_PT((A));\n    TURTLE_COLOUR(54);\n    TURTLE_RESET();\n    BLK_STL(\"listA\",\"setLayer\",[-1]);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('A'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('Q'));\n    }\n    TURTLE_JOIN_PT((B));\n    TURTLE_COLOUR(28);\n    TURTLE_RESET();\n    BLK_STL(\"listB\",\"setLayer\",[-1]);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('B'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('S'));\n    }\n    TURTLE_JOIN_PT((C));\n    TURTLE_COLOUR(54);\n    BLK_STL(\"listC\",\"setLayer\",[-1]);\n    TURTLE_RESET();\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('C'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('R'));\n    }\n    TURTLE_JOIN_PT((D));\n    TURTLE_RESET();\n    TURTLE_COLOUR(40);\n    BLK_STL(\"listD\",\"setLayer\",[-1]);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('D'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('T'));\n    }\n    TURTLE_JOIN_PT((E));\n    BLK_STL(\"listE\",\"setLayer\",[-1]);\n    TURTLE_RESET();\n    TURTLE_COLOUR(13);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('E'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('U'));\n    }\n    TURTLE_JOIN_PT((G));\n    TURTLE_RESET();\n    BLK_STL(\"listG\",\"setLayer\",[-1]);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TURTLE_PRINT(TURTLE_TEXT('G'));\n    } else {\n      TURTLE_PRINT(TURTLE_TEXT('H'));\n    }\n    TURTLE_JOIN_PT((H));\n    TURTLE_RESET();\n    BLK_STL(\"listH\",\"setLayer\",[-1]);\n    TURTLE_COLOUR(13);\n    TURTLE_MV(blockly_var_decal,true);\n    if ((ChInv) == 0) {\n      TU