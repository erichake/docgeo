// Macros :
$macros={};
$macros["1Points1Milieu2pts"]={
	name:"1.Points/1 Milieu 2 pts",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
U=Point("U","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
k=Expression("k","","","","sqrt((d(A,U)*d(B,U))/(d(A,V)*d(B,V)))","-10.455329997738522","3.0377035352788098");
P=Point("P","(U+k*V)/(1+k)","0");
P2=Point("P2","(U-k*V)/(1-k)","0");
C31=Circle("C31",oAB,U);
Q=MidPoint("Q",P2,P);
C2=Circle("C2",Q,P2);
Int1=OrderedIntersection("Int1",C31,C2,0);
Int2=OrderedIntersection("Int2",C31,C2,1);
I=Point("m"+A+B,"Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
STL(I,"c:#fc092f;s:4.5;sn:true;f:15;sp:2");
return [I];
}};

$macros["1Points2Interdeuxdroites"]={
	name:"1.Points/2 Inter. deux droites",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdU=DefinitionPoint("IdU",C1,0);
IdN=DefinitionPoint("IdN",C11,0);
cMN=Center("cMN",C11);
cUV=Center("cUV",C1);
C2=Circle("C2",cMN,IdN);
C3=Circle("C3",cUV,IdU);
Int1=OrderedIntersection("Int1",C3,C2,0);
Int2=OrderedIntersection("Int2",C3,C2,1);
Inter=Point("Inter","Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
STL(Inter,"c:#0000b2;s:6;sn:true;f:30");
return [Inter];
}};

$macros["1Points3SymorthoArc1pt"]={
	name:"1.Points/3 Sym ortho Arc 1pt",
	parameters:["circle","point"],
	exec:
	function (C1,M){
Aa=DefinitionPoint("Aa",C1,0);
Oo=Center("Oo",C1);
SymM=Point("Sym"+M,"Oo+(M-Oo)*d(Oo,Aa)^2/d(Oo,M)^2","0");
STL(SymM,"c:#0000b2;s:6;f:18");
return [SymM];
}};

$macros["1Points4SymCentraleCtrPt"]={
	name:"1.Points/4 Sym Centrale Ctr Pt",
	parameters:["circle","point","point"],
	exec:
	function(Hz,I,A){
B=Point("B","((Hz*Hz+mod(I)*mod(I))*A-2*I*Hz*Hz)/(2*conj(I)*A-Hz*Hz-mod(I)*mod(I))","0");
STL(B,"c:#fc092f;s:6;sn:true;f:17;sp:2");
return [B];
}};

$macros["1Points5SymorthoCercle1pt"]={
	name:"1.Points/5 Sym ortho Cercle 1pt",
	parameters:["circle","point"],
	exec:
	function (C1,M){
Oo=Center("Oo",C1);
SymM=Point("Sym"+M,"Oo+(M-Oo)*C1^2/d(Oo,M)^2","0");
STL(SymM,"c:#0000b2;s:6;f:18");
return [SymM];
}};

$macros["2Droites1Droite2pts"]={
	name:"2.Droites/1 Droite 2 pts",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
IdA=Point("IdA","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
P2=Point("P2","oAB+d(IdA,oAB)*((IdA+IdB)/2-oAB)/d((IdA+IdB)/2,oAB)","0");
Drt=Arc3pts("Drt"+A+B,IdA,P2,IdB);
STL(Drt,"c:#cc66cc;s:1;f:30;p:0");
return [Drt];
}};

$macros["2Droites2Segmenthyper"]={
	name:"2.Droites/2 Segment hyper",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
P2=Point("P2","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
Seg=Arc3pts("Seg"+A+B,A,P2,B);
STL(Seg,"c:#cc66cc;s:1;f:30;p:0");
return [Seg];
}};

$macros["2Droites3PerpDroitePoint"]={
	name:"2.Droites/3 Perp Droite Point",
	parameters:["circle","circle","point"],
	exec:
	function (Hz,C1,P){
OHz=Center("OHz",Hz);
mPC1=Point("mPC1","(OHz+(P-OHz)*Hz^2/d(OHz,P)^2+P)/2","0");
IdA=DefinitionPoint("IdA",C1,0);
L1=Line("L1",OHz,mPC1);
Perp1=Perpendicular("Perp1",L1,mPC1);
CtrAB=Center("CtrAB",C1);
mPAB=Point("mPAB","(CtrAB+(P-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P)^2+P)/2","0");
L2=Line("L2",CtrAB,P);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P);
R1=Ray("R1",P1,mPAB);
P4=OrderedIntersection("P4",R1,C2,0);
P5=OrderedIntersection("P5",C2,Hz,1);
P6=OrderedIntersection("P6",C2,Hz,0);
Hperp=Arc3pts("Hperp",P5,P4,P6);
STL(Hperp,"c:#007c00;s:2;sn:true;f:30;p:0");
return [Hperp];
}};

$macros["2Droites4PerpCommune"]={
	name:"2.Droites/4 Perp Commune",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdU=DefinitionPoint("IdU",C1,0);
IdV=DefinitionPoint("IdV",C1,2);
IdN=DefinitionPoint("IdN",C11,0);
IdM=DefinitionPoint("IdM",C11,2);
L1=Line("L1",IdN,IdM);
L2=Line("L2",IdU,IdV);
oPC=OrderedIntersection("oPC",L2,L1,0);
C2=Circle1("C2",oPC,"sqrt(d(OHz,oPC)^2-Hz^2)");
S1=Segment("S1",OHz,oPC);
IdPC1=OrderedIntersection("IdPC1",C2,Hz,1);
PtPC=OrderedIntersection("PtPC",S1,C2,1);
IdPC2=OrderedIntersection("IdPC2",C2,Hz,0);
PComm=Arc3pts("PComm",IdPC1,PtPC,IdPC2);
STL(PComm,"c:#007c00;s:1.5;sn:true;f:30;p:0");
return [PComm];
}};

$macros["2Droites5MediatriceetMilieu"]={
	name:"2.Droites/5 Mediatrice et Milieu",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
U=Point("U","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
k=Expression("k","","","","sqrt((d(A,U)*d(B,U))/(d(A,V)*d(B,V)))","-10.455329997738522","3.0377035352788098");
P=Point("P","(U+k*V)/(1+k)","0");
P2=Point("P2","(U-k*V)/(1-k)","0");
C31=Circle("C31",oAB,U);
Q=MidPoint("Q",P2,P);
C2=Circle("C2",Q,P2);
IdMed1=OrderedIntersection("IdMed1",Hz,C2,0);
IdMed2=OrderedIntersection("IdMed2",Hz,C2,1);
Med=Arc3pts("Med"+A+B,IdMed2,P,IdMed1);
cMed=Center("cMed"+A+B,Med);
C20=Circle("C20",cMed,IdMed2);
Int1=OrderedIntersection("Int1",C31,C20,0);
Int2=OrderedIntersection("Int2",C31,C20,1);
I=Point("I","Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
STL(Med,"c:#cc66cc;s:1;f:30;p:0");
STL(I,"c:#fc092f;s:4.5;sn:true;f:15;sp:2");
// STL(IdMed1,"c:#fc092f;s:4.5;sn:true;f:15;sp:2");
// STL(IdMed2,"c:#fc092f;s:4.5;sn:true;f:15;sp:2");
return [Med,I];
}};

$macros["2Droites6BissectriceAOB"]={
	name:"2.Droites/6 Bissectrice AOB",
	parameters:["circle","point","point","point"],
	exec:
	function (Hz,P3,P2,P4){
OHz=Center("OHz",Hz);
oAB=Point("oAB","[(y(P3)*(x(P2)^2+y(P2)^2+Hz^2)-y(P2)*(x(P3)^2+y(P3)^2+Hz^2))/(2*(x(P2)*y(P3)-x(P3)*y(P2))),(x(P2)*(x(P3)^2+y(P3)^2+Hz^2)-x(P3)*(x(P2)^2+y(P2)^2+Hz^2))/(2*(x(P2)*y(P3)-x(P3)*y(P2)))]","0");
oAB0=Point("oAB0","[(y(P4)*(x(P2)^2+y(P2)^2+Hz^2)-y(P2)*(x(P4)^2+y(P4)^2+Hz^2))/(2*(x(P2)*y(P4)-x(P4)*y(P2))),(x(P2)*(x(P4)^2+y(P4)^2+Hz^2)-x(P4)*(x(P2)^2+y(P2)^2+Hz^2))/(2*(x(P2)*y(P4)-x(P4)*y(P2)))]","0");
mPC1=Point("mPC1","(OHz+(P2-OHz)*Hz^2/d(OHz,P2)^2+P2)/2","0");
U=Point("U","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
U0=Point("U0","[(2*Hz^2*x(oAB0)^2+2*Hz*y(oAB0)*sqrt(x(oAB0)^2+y(oAB0)^2-Hz^2)*abs(x(oAB0)))/(2*x(oAB0)*(x(oAB0)^2+y(oAB0)^2)),(2*y(oAB0)*Hz^2-2*Hz*sqrt(x(oAB0)^2+y(oAB0)^2-Hz^2)*abs(x(oAB0)))/(2*(x(oAB0)^2+y(oAB0)^2))]","0");
V0=Point("V0","[(2*Hz^2*x(oAB0)^2-2*Hz*y(oAB0)*sqrt(x(oAB0)^2+y(oAB0)^2-Hz^2)*abs(x(oAB0)))/(2*x(oAB0)*(x(oAB0)^2+y(oAB0)^2)),(2*y(oAB0)*Hz^2+2*Hz*sqrt(x(oAB0)^2+y(oAB0)^2-Hz^2)*abs(x(oAB0)))/(2*(x(oAB0)^2+y(oAB0)^2))]","0");
L1=Line("L1",OHz,mPC1);
IdB=Point("IdB","V*(d(P2,V)>d(P3,V))+U*(d(P2,V)<d(P3,V))","0");
IdB0=Point("IdB0","V0*(d(P2,V0)>d(P4,V0))+U0*(d(P2,V0)<d(P4,V0))","0");
Perp1=Perpendicular("Perp1",L1,mPC1);
oAB1=Point("oAB1","[(y(IdB)*(x(IdB0)^2+y(IdB0)^2+Hz^2)-y(IdB0)*(x(IdB)^2+y(IdB)^2+Hz^2))/(2*(x(IdB0)*y(IdB)-x(IdB)*y(IdB0))),(x(IdB0)*(x(IdB)^2+y(IdB)^2+Hz^2)-x(IdB)*(x(IdB0)^2+y(IdB0)^2+Hz^2))/(2*(x(IdB0)*y(IdB)-x(IdB)*y(IdB0)))]","0");
P20=Point("P20","oAB1+d(IdB0,oAB1)*((IdB0+IdB)/2-oAB1)/d((IdB0+IdB)/2,oAB1)","0");
U1=Point("U1","[(2*Hz^2*x(oAB1)^2+2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2-2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
V1=Point("V1","[(2*Hz^2*x(oAB1)^2-2*Hz*y(oAB1)*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*x(oAB1)*(x(oAB1)^2+y(oAB1)^2)),(2*y(oAB1)*Hz^2+2*Hz*sqrt(x(oAB1)^2+y(oAB1)^2-Hz^2)*abs(x(oAB1)))/(2*(x(oAB1)^2+y(oAB1)^2))]","0");
IdB1=Point("IdB1","V1*(d(IdB0,V1)>d(IdB,V1))+U1*(d(IdB0,V1)<d(IdB,V1))","0");
IdA=Point("IdA","V1*(d(IdB0,V1)<d(IdB,V1))+U1*(d(IdB0,V1)>d(IdB,V1))","0");
C11=Arc3pts("C11",IdA,P20,IdB1);
CtrAB=Center("CtrAB",C11);
mPAB=Point("mPAB","(CtrAB+(P2-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P2)^2+P2)/2","0");
L2=Line("L2",CtrAB,P2);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P2);
R1=Ray("R1",P1,mPAB);
P40=OrderedIntersection("P40",R1,C2,0);
Idbiss1=OrderedIntersection("Idbiss1",C2,Hz,1);
Idbiss2=OrderedIntersection("Idbiss2",C2,Hz,0);
Biss=Arc3pts("Biss",Idbiss1,P40,Idbiss2);
STL(Biss,"c:#2ea3e4;s:1;sn:true;f:30;p:0");
return [Biss];
}};

$macros["2Droites7Demidroite"]={
	name:"2.Droites/7 Demi droite",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
U=Point("U","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdB=Point("IdB","V*(d(A,V)>d(B,V))+U*(d(A,V)<d(B,V))","0");
DemiDrt=Arc3pts("DemiDrt",A,B,IdB);
STL(IdB,"c:#0000b2;s:6;sn:true;f:30");
STL(DemiDrt,"c:#cc66cc;s:1;f:30;p:0");
return [IdB,DemiDrt];
}};

$macros["2Droites9AvecIdeaux1Droiteorientee"]={
	name:"2.Droites/9 Avec Ideaux/1 Droite orientee",
	parameters:["circle","point","point"],
	exec:
	function (Hz,U,V){
oAB=Point("oAB","[(y(V)*(x(U)^2+y(U)^2+Hz^2)-y(U)*(x(V)^2+y(V)^2+Hz^2))/(2*(x(U)*y(V)-x(V)*y(U))),(x(U)*(x(V)^2+y(V)^2+Hz^2)-x(V)*(x(U)^2+y(U)^2+Hz^2))/(2*(x(U)*y(V)-x(V)*y(U)))]","0");
IdU=Point("IdU","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
IdV=Point("IdV","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
Por=Point("Por","oAB+d(IdU,oAB)*((IdU+IdV)/2-oAB)/d((IdU+IdV)/2,oAB)","0");
IdUor=Point("Id"+U+"or","IdU*(d(IdU,U)<d(IdV,U))+IdV*(d(IdU,U)>d(IdV,U))","0");
IdVor=Point("Id"+V+"or","IdV*(d(IdV,V)<d(IdV,U))+IdU*(d(IdV,V)>d(IdV,U))","0");
DrtOr=Arc3pts("DrtOr"+U+V,IdUor,Por,IdVor);
STL(DrtOr,"c:#cc66cc;s:1;f:20;p:0");
STL(IdUor,"c:#0000b2;s:4.5;sn:true;f:15");
STL(IdVor,"c:#0000b2;s:4.5;sn:true;f:15");
return [DrtOr,IdUor,IdVor];
}};

$macros["2Droites9AvecIdeaux2Mediatrice"]={
	name:"2.Droites/9 Avec Ideaux/2 Mediatrice",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
oAB=Point("oAB","[(y(B)*(x(A)^2+y(A)^2+Hz^2)-y(A)*(x(B)^2+y(B)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A))),(x(A)*(x(B)^2+y(B)^2+Hz^2)-x(B)*(x(A)^2+y(A)^2+Hz^2))/(2*(x(A)*y(B)-x(B)*y(A)))]","0");
P20=Point("P20","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
U=Point("U","[(2*Hz^2*x(oAB)^2+2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2-2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
V=Point("V","[(2*Hz^2*x(oAB)^2-2*Hz*y(oAB)*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*x(oAB)*(x(oAB)^2+y(oAB)^2)),(2*y(oAB)*Hz^2+2*Hz*sqrt(x(oAB)^2+y(oAB)^2-Hz^2)*abs(x(oAB)))/(2*(x(oAB)^2+y(oAB)^2))]","0");
C1=Arc3pts("C1",U,P20,V);
cUV=Center("cUV",C1);
k=Expression("k","","","","sqrt((d(A,U*d(B,U))/(d(A,V)*d(B,V)))","-10.455329997738522","3.0377035352788098");
P=Point("P","(U+k*V)/(1+k)","0");
P2=Point("P2","(U-k*V)/(1-k)","0");
C31=Circle("C31",cUV,U);
Q=MidPoint("Q",P2,P);
C2=Circle("C2",Q,P2);
Id1=OrderedIntersection("Id1",Hz,C2,0);
Id2=OrderedIntersection("Id2",Hz,C2,1);
C3=Arc3pts("C3",Id2,P,Id1);
cMN=Center("cMN",C3);
C20=Circle("C20",cMN,Id2);
Int1=OrderedIntersection("Int1",C31,C20,0);
Int2=OrderedIntersection("Int2",C31,C20,1);
I=Point("I","Int1*(d(OHz,Int1)<Hz)+Int2*(d(OHz,Int2)<Hz)","0");
STL(Id1,"c:#0000b2;s:4.5;f:15");
STL(Id2,"c:#0000b2;s:4.5;f:15");
STL(C3,"c:#cc66cc;s:1;f:30;p:0");
STL(I,"c:#fc092f;s:4.5;sn:true;f:15;sp:2");
return [Id1,Id2,C3,I];
}};

$macros["2Droites9AvecIdeaux3PerpDroitePoint"]={
	name:"2.Droites/9 Avec Ideaux/3 Perp Droite Point",
	parameters:["circle","circle","point"],
	exec:
	function (Hz,C1,P){
OHz=Center("OHz",Hz);
mPC1=Point("mPC1","(OHz+(P-OHz)*Hz^2/d(OHz,P)^2+P)/2","0");
IdA=DefinitionPoint("IdA",C1,0);
L1=Line("L1",OHz,mPC1);
Perp1=Perpendicular("Perp1",L1,mPC1);
CtrAB=Center("CtrAB",C1);
mPAB=Point("mPAB","(CtrAB+(P-CtrAB)*d(CtrAB,IdA)^2/d(CtrAB,P)^2+P)/2","0");
L2=Line("L2",CtrAB,P);
Perp2=Perpendicular("Perp2",L2,mPAB);
P1=OrderedIntersection("P1",Perp1,Perp2,0);
C2=Circle("C2",P1,P);
R1=Ray("R1",P1,mPAB);
P4=OrderedIntersection("P4",R1,C2,0);
IdPerp1=OrderedIntersection("IdPerp1",C2,Hz,1);
IdPerp2=OrderedIntersection("IdPerp2",C2,Hz,0);
Hperp=Arc3pts("Hperp",IdPerp1,P4,IdPerp2);
STL(IdPerp1,"c:#0000b2;s:4.5;f:15");
STL(IdPerp2,"c:#0000b2;s:4.5;f:15");
STL(Hperp,"c:#007c00;s:2;sn:true;f:30;p:0");
return [Hperp,IdPerp1,IdPerp2];
}};

$macros["2Droites9AvecIdeaux4PerpCommune"]={
	name:"2.Droites/9 Avec Ideaux/4 Perp Commune",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz,C11,C1){
OHz=Center("OHz",Hz);
IdU=DefinitionPoint("IdU",C1,0);
