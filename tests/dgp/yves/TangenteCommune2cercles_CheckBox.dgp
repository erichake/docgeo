Text("<div style='font-size:18px;color:#CC0000;text-align:center'>Tangentes communes \n\u00e0 deux cercles pseudosph\u00e8riques<div style='font-size:14px;color:#0000FF;text-align:left'>\nCacher\nLe rep\u00e8re <input type=checkbox target=\"ChRep\">\nLes latitudes <input type=checkbox target=\"ChPt\"> \nLes Points des cercles <input type=checkbox target=\"ChCerc\">\n",23,19,211,183,"c:rgba(246,174,35,0.18);s:3;r:15;p:4");
