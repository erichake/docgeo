}};

$macros["DroiteFeuillePrinc"]={
	name:"Droite Feuille Princ",
	parameters:["expression"],
	exec:
	function (CstAB){
Pmax1F=Point("Pmax1F","[min(-CstAB[0]+sqrt(CstAB[1]-1),\u03C0),-1]","0");
Pmin1F=Point("Pmin1F","[max(-CstAB[0]-sqrt(CstAB[1]-1),-\u03C0),-1]","0");
SegDrte1F=Segment("SegDrte1F",Pmin1F,Pmax1F);
tetaK=PointOn("tetaK",SegDrte1F,0.8);
chuK=Expression("chuK","chuK = ","","","sqrt(CstAB[1]-(x(tetaK)+CstAB[0])^2)","2","-0.7");
uK=Expression("uK","uK = ","","","log(chuK+sqrt(chuK^2-1))","2.","-0.5");
PtDrt=Point("PtDrt","[cos(x(tetaK))/chuK,sin(x(tetaK))/chuK,uK-(exp(uK)-exp(-uK))/(exp(uK)+exp(-uK))]","0");
LaDroite1F=Locus("LaDrt1F",PtDrt,tetaK);
STL(LaDroite1F,"c:#b40000;s:3;f:30;p:0");
return [LaDroite1F];
}};

$macros["DroiteparConst"]={
	name:"Droite par Const",
	parameters:["expression"],
	exec:
	function (CstAB){
PmaxDrte=Point("PmaxDrte","[-CstAB[0]+sqrt(CstAB[1]-1),-1]","0");
PminDrte=Point("PminDrte","[-CstAB[0]-sqrt(CstAB[1]-1),-1]","0");
SegDrte=Segment("SegDrte",PminDrte,PmaxDrte);
tetaK=PointOn("tetaK",SegDrte,0.8);
chuK=Expression("chuK","chuK = ","","","sqrt(CstAB[1]-(x(tetaK)+CstAB[0])^2)","2","-0.7");
uK=Expression("uK","uK = ","","","log(chuK+sqrt(chuK^2-1))","2.","-0.5");
PtDrt=Point("PtDrt","[cos(x(tetaK))/chuK,sin(x(tetaK))/chuK,uK-(exp(uK)-exp(-uK))/(exp(uK)+exp(-uK))]","0");
LaDroite=Locus("LaDroite",PtDrt,tetaK);
STL(LaDroite,"c:#b40000;s:3;f:30;p:0");
return [LaDroite];
}};

$macros["HoricycleAltitude"]={
	name:"Horicycle Altitude",
	parameters:["point"],
	exec:
	function (uG){
altG=Expression("altG","","","","uG[2]","-1.6498183460809837","-0.40080332701402427");
G1=Point("G1","[2/(exp(altG)+exp(-altG)),0,altG-(exp(altG)-exp(-altG))/(exp(altG)+exp(-altG))]","0");
G2=Point("G2","[0,2/(exp(altG)+exp(-altG)),altG-(exp(altG)-exp(-altG))/(exp(altG)+exp(-altG))]","0");
P13=Point("P13","[-2/(exp(altG)+exp(-altG)),0,altG-(exp(altG)-exp(-altG))/(exp(altG)+exp(-altG))]","0");
C11=Circle3pts3D("C11",G1,G2,P13);
STL(C11,"c:#cc66cc;s:1;f:30;p:0");
return [C11];
}};

$macros["Inverse1ptcercle"]={
	name:"Inverse 1pt (cercle)",
	parameters:["circle","point"],
	exec:
	function (C1,M){
Oo=Center("Oo",C1);
P1=Point("P1","Oo+(M-Oo)*C1^2/d(Oo,M)^2","0");
STL(P1,"c:#0000b2;s:6;f:30");
return [P1];
}};

$macros["KBCercleOA"]={
	name:"KB Cercle O A",
	parameters:["point","point","circle"],
	exec:
	function (O,A,C1){
OHz=Center("OHz",C1);
Drt1=Line("Drt1",O,A);
L2=Line("L2",OHz,O);
Perp1=Perpendicular("Perp1",Drt1,OHz);
Syma1=Reflection("Syma1",L2,A);
Perp11=Perpendicular("Perp11",Drt1,O);
P4=OrderedIntersection("P4",Perp1,Drt1,0);
P11=Point("P11","OHz+(P4-OHz)*C1^2/d(OHz,P4)^2","0");
L11=Line("L11",O,P11);
L1=Line("L1",A,P11);
Perp12=Perpendicular("Perp12",L11,OHz);
P41=OrderedIntersection("P41",Perp12,L11,0);
P12=Point("P12","OHz+(P41-OHz)*C1^2/d(OHz,P41)^2","0");
C11=Circle("C11",O,P12);
Perp2=Perpendicular("Perp2",Drt1,P12);
P42=OrderedIntersection("P42",Perp11,C11,1);
L12=Line("L12",P42,A);
P51=OrderedIntersection("P51",Perp2,L12,0);
Symc1=Symmetry("Symc1",P12,P51);
L211=Line("L211",P42,Symc1);
D=OrderedIntersection("D",L211,Drt1,0);
Syma2=Reflection("Syma2",L2,D);
L4=Line("L4",D,Syma1);
L22=Line("L22",Syma2,Syma1);
P=OrderedIntersection("P",L22,L1,0);
Perp13=Perpendicular("Perp13",Drt1,P);
N=OrderedIntersection("N",Perp13,Drt1,0);
M=OrderedIntersection("M",L4,Perp13,0);
L5=Line("L5",A,M);
L6=Line("L6",Syma2,N);
Pt12=OrderedIntersection("Pt12",L6,L5,0);
Quad=Quadric("Quad",Syma2,D,Syma1,Pt12,A);
STL(Quad,"c:#00adff;s:1;f:30;p:500");
return [Quad];
}};

$macros["KBversPSbool"]={
	name:"KB vers PS bool",
	parameters:["expression","point","point","point","point"],
	exec:
	function (MoinsPi,Okb,Ikb,Jkb,M){
CdM=Expression("CdM","","","","[log(sqrt(1-(x(M)-x(Odl))^2/(x(Idl)-x(Odl))^2-(y(M)-y(Odl))^2/(y(Jdl)-y(Odl))^2)/(1-(x(M)-x(Odl))/(x(Idl)-x(Odl)))+sqrt((sqrt(1-(x(M)-x(Odl))^2/(x(Idl)-x(Odl))^2-(y(M)-y(Odl))^2/(y(Jdl)-y(Odl))^2)/(1-(x(M)-x(Odl))/(x(Idl)-x(Odl))))^2-1)),((y(M)-y(Odl))/(y(Jdl)-y(Odl)))/((x(M)-x(Odl))/(x(Idl)-x(Odl))-1)-MoinsPi*\u03C0]","2.2","-2.8");
STL(CdM,"c:#551b53;s:7;sn:true;f:15;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [CdM];
}};

$macros["PointparCoord"]={
	name:"Point par Coord",
	parameters:["expression"],
	exec:
	function (CdPtC){
LePt=Point("LePt","[2*cos(CdPtC[1])/(exp(CdPtC[0])+exp(-CdPtC[0])),2*sin(CdPtC[1])/(exp(CdPtC[0])+exp(-CdPtC[0])),CdPtC[0]-(exp(CdPtC[0])-exp(-CdPtC[0]))/(exp(CdPtC[0])+exp(-CdPtC[0]))]","0");
STL(LePt,"c:#0000b2;s:6;f:18");
return [LePt];
