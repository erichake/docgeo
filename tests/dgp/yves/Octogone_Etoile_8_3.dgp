// Macros :
$macros={};
$macros["1Points1Inter2droites"]={
	name:"1.Points/1 Inter 2 droites",
	parameters:["circle","circle","circle"],
	exec:
	function (Hz, C4, C40) {
Ohz=Center("Ohz",Hz);
A=DefinitionPoint("A",C4,1);
E=DefinitionPoint("E",C40,1);
CtrDrte=Center("CtrDrte",C4);
CtrDrte0=Center("CtrDrte0",C40);
C5=Circle("C5",CtrDrte,A);
C6=Circle("C6",CtrDrte0,E);
Sol1=OrderedIntersection("Sol1",C5,C6,1);
Sol2=OrderedIntersection("Sol2",C5,C6,0);
Inter=Point("Inter","Sol2*(d(Sol2,Ohz)<Hz)+Sol1*(d(Sol1,Ohz)<Hz)","0");
STL(Inter,"c:#760012;s:6;f:15;sp:2");
return [Inter];
}};

$macros["1Points2Poledunedroite"]={
	name:"1.Points/2 Pole d'une droite",
	parameters:["circle","circle"],
	exec:
	function(Hz,Drt){
OHz=Center("OHz",Hz);
A=DefinitionPoint("A",Drt,1);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
L5=PerpendicularBisector("L5",A,antiA);
cAB=Center("cAB",Drt);
S4=Segment("S4",cAB,A);
R1=Ray("R1",OHz,cAB);
Perp1=Perpendicular("Perp1",S4,A);
P6=OrderedIntersection("P6",Perp1,L5,0);
C1=Circle("C1",P6,A);
Pole=OrderedIntersection("Pole",R1,C1,0);
STL(Pole,"c:#0000b2;s:6;sn:true;f:15;sp:2");
return [Pole];
}};

$macros["1Points3Symortho1pt"]={
	name:"1.Points/3 Sym ortho 1 pt",
	parameters:["circle","circle","point"],
	exec:
	function(Hz,DrtAB,M){
OHz=Center("OHz",Hz);
bAB=DefinitionPoint("bAB",DrtAB,0);
cAB=Center("cAB",DrtAB);
invM=Point("invM","cAB+(M-cAB)*d(cAB,bAB)^2/d(cAB,M)^2","0");
antiinvM=Point("antiinvM","OHz-(invM+OHz)*Hz^2/d(OHz,invM)^2","0");
symM=Point("sOrtho"+M,"(d(OHz,invM)<Hz)?invM:antiinvM","0");
STL(symM,"c:#fc092f;s:6;sn:true;f:15;sp:2");
return [symM];
}};

$macros["1Points4Milieux2pts"]={
	name:"1.Points/4 Milieux 2 pts",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
L1=Line("L1",A,B);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
SymSymc1=Point("SymSymc1","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
SupportAB=Circle3pts("SupportAB",A,B,antiA);
L5=PerpendicularBisector("L5",A,SymSymc1);
P1=OrderedIntersection("P1",Hz,SupportAB,0);
P2=OrderedIntersection("P2",Hz,SupportAB,1);
Drt=Arc3pts("Drt",P1,A,P2);
CtrDrte=Center("CtrDrte",Drt);
S4=Segment("S4",CtrDrte,A);
R1=Ray("R1",OHz,CtrDrte);
C6=Circle("C6",CtrDrte,A);
C52=Circle("C52",CtrDrte,A);
Perp1=Perpendicular("Perp1",S4,A);
P6=OrderedIntersection("P6",Perp1,L5,0);
C1=Circle("C1",P6,A);
PoleAB=OrderedIntersection("PoleAB",R1,C1,0);
antiPoleAB=Point("antiPoleAB","OHz-(PoleAB+OHz)*Hz^2/d(OHz,PoleAB)^2","0");
L2=PerpendicularBisector("L2",PoleAB,antiPoleAB);
cMed1=OrderedIntersection("cMed1",L1,L2,0);
C2=Circle("C2",cMed1,PoleAB);
S1=Segment("S1",cMed1,PoleAB);
P3=OrderedIntersection("P3",Hz,C2,1);
P4=OrderedIntersection("P4",Hz,C2,0);
Perp2=Perpendicular("Perp2",S1,PoleAB);
C3=Arc3pts("C3",P3,PoleAB,P4);
cMed2=OrderedIntersection("cMed2",L2,Perp2,0);
CtrDrte0=Center("CtrDrte0",C3);
C4=Circle("C4",cMed2,PoleAB);
C51=Circle("C51",CtrDrte0,PoleAB);
P5=OrderedIntersection("P5",Hz,C4,1);
P7=OrderedIntersection("P7",Hz,C4,0);
Sol1=OrderedIntersection("Sol1",C51,C6,1);
Sol2=OrderedIntersection("Sol2",C51,C6,0);
C7=Arc3pts("C7",P5,PoleAB,P7);
I=Point("I","Sol2*(d(Sol2,OHz)<Hz)+Sol1*(d(Sol1,OHz)<Hz)","0");
CtrDrte00=Center("CtrDrte00",C7);
C60=Circle("C60",CtrDrte00,PoleAB);
Sol10=OrderedIntersection("Sol10",C52,C60,1);
Sol20=OrderedIntersection("Sol20",C52,C60,0);
J=Point("J","Sol20*(d(Sol20,OHz)<Hz)+Sol10*(d(Sol10,OHz)<Hz)","0");
STL(I,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:5.927475359607631");
STL(J,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:0.629247079026396");
return [I,J];
}};

$macros["1Points5SymCentraleCtrPt"]={
	name:"1.Points/5 Sym Centrale Ctr Pt",
	parameters:["circle","point","point"],
	exec:
	function(Hz,I,M){
OHz=Center("OHz",Hz);
antiP=Point("antiP","OHz-(I+OHz)*Hz^2/d(OHz,I)^2","0");
L1=PerpendicularBisector("L1",I,antiP);
L2=Line("L2",I,antiP);
pC=OrderedIntersection("pC",L1,L2,0);
C2=Circle("C2",pC,I);
antipC=Point("antipC","OHz-(pC+OHz)*Hz^2/d(OHz,pC)^2","0");
Po2=OrderedIntersection("Po2",Hz,C2,0);
Po1=OrderedIntersection("Po1",Hz,C2,1);
C3=Circle("C3",antipC,Po1);
Pom=OrderedIntersection("Pom",L2,C3,0);
Poconst=Point("Poconst","antipC+d(Po1,antipC)*((Po1+Pom)/2-antipC)/d((Po1+Pom)/2,antipC)","0");
polaire=Arc3pts("polaire",Po1,Poconst,Po2);
Oo=Center("Oo",polaire);
P10=Point("P10","Oo+(M-Oo)*d(Oo,Po1)^2/d(Oo,M)^2","0");
antiA0=Point("antiA0","OHz-(P10+OHz)*Hz^2/d(OHz,P10)^2","0");
sIM=Point("sc"+I+M,"(d(OHz,P10)<Hz)?P10:antiA0","0");
STL(sIM,"c:#fc092f;s:5;sn:true;f:15;sp:2");
return [sIM];
}};

$macros["2Droites1Droite2pts"]={
	name:"2.Droites/1 Droite 2 pts",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
SupportAB=Circle3pts("SupportAB",A,B,antiA);
b1=OrderedIntersection("b1"+A+B,Hz,SupportAB,0);
b2=OrderedIntersection("b2"+A+B,Hz,SupportAB,1);
Drt=Arc3pts("Drt"+A+B,b1,A,b2);
STL(Drt,"c:#cc66cc;s:1;sn:true;f:30;p:0");
return [Drt];
}};

$macros["2Droites2Perpendiculaire"]={
	name:"2.Droites/2 Perpendiculaire",
	parameters:["circle","circle","point"],
	exec:
	function(Hz,DrtAB,M){
OHz=Center("OHz",Hz);
A=DefinitionPoint("A",DrtAB,1);
antiA0=Point("antiA0","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
antiM=Point("antiM","OHz-(M+OHz)*Hz^2/d(OHz,M)^2","0");
L5=PerpendicularBisector("L5",A,antiA0);
cAB=Center("cAB",DrtAB);
S4=Segment("S4",cAB,A);
R1=Ray("R1",OHz,cAB);
Perp1=Perpendicular("Perp1",S4,A);
P6=OrderedIntersection("P6",Perp1,L5,0);
C1=Circle("C1",P6,A);
PoleAB=OrderedIntersection("PoleAB",R1,C1,0);
C2=Circle3pts("C2",M,PoleAB,antiM);
bPerp1=OrderedIntersection("bPerp1",Hz,C2,1);
bPerp2=OrderedIntersection("bPerp2",Hz,C2,0);
EllPerp=Arc3pts("EllPerp",bPerp1,M,bPerp2);
STL(EllPerp,"c:#0bd81f;s:1;sn:true;f:30;p:0");
return [EllPerp];
}};

$macros["2Droites3Segmentelliptique"]={
	name:"2.Droites/3 Segment elliptique",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
OHz=Center("OHz",Hz);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
LongAB=Expression("LongAB","","","","2*atan(mod(Hz*(A-B)/(Hz*Hz+conj(A)*B)))","1.2","1.5");
C1=Circle3pts("C1",A,B,antiA);
oAB=Center("oAB",C1);
Id1=OrderedIntersection("Id1",Hz,C1,0);
Id2=OrderedIntersection("Id2",Hz,C1,1);
bdA=Point("bdA","Id1*(d(Id1,A)<d(Id1,B))+Id2*(d(Id2,A)<d(Id2,B))","0");
bdB=Point("bdB","Id2*(d(Id1,A)<d(Id1,B))+Id1*(d(Id2,A)<d(Id2,B))","0");
mAB=Point("mAB","oAB+d(A,oAB)*((A+B)/2-oAB)/d((A+B)/2,oAB)","0");
mbdAA=Point("mIdAA","oAB+d(bdA,oAB)*((bdA+A)/2-oAB)/d((bdA+A)/2,oAB)","0");
mbdBB=Point("mbdBB","oAB+d(bdB,oAB)*((bdB+B)/2-oAB)/d((bdB+B)/2,oAB)","0");
partAB=Arc3pts("partAB",A,mAB,B);
partBbdB=Arc3pts("partBbdB",B,mbdBB,bdB);
partAbdA=Arc3pts("partAbdA",A,mbdAA,bdA);
GereSeg=Expression("GereSeg","","","","partAB.setHidden(LongAB>90);partAbdA.setHidden(LongAB<=90);partBbdB.setHidden(LongAB<=90);\"gestion segment\"","-1.7848412102712403","1.100064788240483");
STL(partAB,"c:#0024ff;h:1;s:1;sn:true;f:30;p:0");
STL(partBbdB,"c:#0024ff;s:1;sn:true;f:30;p:0");
STL(partAbdA,"c:#0024ff;s:1;sn:true;f:30;p:0");
STL(GereSeg,"c:#577f1d;s:7;f:17;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [partAB,partBbdB,partAbdA,GereSeg];
}};

$macros["2Droites4Polairedunpoint"]={
	name:"2.Droites/4 Polaire d'un point",
	parameters:["circle","point"],
	exec:
	function(Hz,P){
OHz=Center("OHz",Hz);
antiP=Point("antiP","OHz-(P+OHz)*Hz^2/d(OHz,P)^2","0");
L1=PerpendicularBisector("L1",P,antiP);
L2=Line("L2",P,antiP);
pC=OrderedIntersection("pC",L1,L2,0);
C2=Circle("C2",pC,P);
antipC=Point("antipC","OHz-(pC+OHz)*Hz^2/d(OHz,pC)^2","0");
Po2=OrderedIntersection("Po2",Hz,C2,0);
Po1=OrderedIntersection("Po1",Hz,C2,1);
C3=Circle("C3",antipC,Po1);
Pom=OrderedIntersection("Pom",L2,C3,0);
Poconst=Point("Poconst","antipC+d(Po1,antipC)*((Po1+Pom)/2-antipC)/d((Po1+Pom)/2,antipC)","0");
polaire=Arc3pts("polaire",Po1,Poconst,Po2);
STL(polaire,"c:#fc092f;s:1;sn:true;f:30;p:0");
return [polaire];
}};

$macros["2Droites5MediateuretMilieux"]={
	name:"2.Droites/5 Mediateur et Milieux",
	parameters:["circle","point","point"],
	exec:
	function(Hz,A,B){
Ohz=Center("Ohz",Hz);
L1=Line("L1",A,B);
antiA=Point("antiA","Ohz-(A+Ohz)*Hz^2/d(Ohz,A)^2","0");
SymSymc1=Point("SymSymc1","Ohz-(A+Ohz)*Hz^2/d(Ohz,A)^2","0");
SupportAB=Circle3pts("SupportAB",A,B,antiA);
L5=PerpendicularBisector("L5",A,SymSymc1);
P1=OrderedIntersection("P1",Hz,SupportAB,0);
P2=OrderedIntersection("P2",Hz,SupportAB,1);
Drt=Arc3pts("Drt",P1,A,P2);
CtrDrte=Center("CtrDrte",Drt);
S4=Segment("S4",CtrDrte,A);
R1=Ray("R1",Ohz,CtrDrte);
C6=Circle("C6",CtrDrte,A);
C52=Circle("C52",CtrDrte,A);
Perp1=Perpendicular("Perp1",S4,A);
P6=OrderedIntersection("P6",Perp1,L5,0);
C1=Circle("C1",P6,A);
PoleAB=OrderedIntersection("PoleAB",R1,C1,0);
antiPoleAB=Point("antiPoleAB","Ohz-(PoleAB+Ohz)*Hz^2/d(Ohz,PoleAB)^2","0");
L2=PerpendicularBisector("L2",PoleAB,antiPoleAB);
cMed1=OrderedIntersection("cMed1",L1,L2,0);
C2=Circle("C2",cMed1,PoleAB);
S1=Segment("S1",cMed1,PoleAB);
P3=OrderedIntersection("P3",Hz,C2,1);
P4=OrderedIntersection("P4",Hz,C2,0);
Perp2=Perpendicular("Perp2",S1,PoleAB);
Med1=Arc3pts("Med1"+A+B,P3,PoleAB,P4);
cMed2=OrderedIntersection("cMed2",L2,Perp2,0);
CtrMed1=Center("CtrMed1",Med1);
C4=Circle("C4",cMed2,PoleAB);
C51=Circle("C51",CtrMed1,PoleAB);
P5=OrderedIntersection("P5",Hz,C4,1);
P7=OrderedIntersection("P7",Hz,C4,0);
Sol1=OrderedIntersection("Sol1",C51,C6,1);
Sol2=OrderedIntersection("Sol2",C51,C6,0);
Med2=Arc3pts("Med2"+A+B,P5,PoleAB,P7);
I=Point("I","Sol2*(d(Sol2,Ohz)<Hz)+Sol1*(d(Sol1,Ohz)<Hz)","0");
CtrMed2=Center("CtrMed2",Med2);
C60=Circle("C60",CtrMed2,PoleAB);
Sol10=OrderedIntersection("Sol10",C52,C60,1);
Sol20=OrderedIntersection("Sol20",C52,C60,0);
J=Point("J","Sol20*(d(Sol20,Ohz)<Hz)+Sol10*(d(Sol10,Ohz)<Hz)","0");
STL(Med1,"c:#fc092f;s:1;f:30;p:0");
STL(Med2,"c:#fc092f;s:1;f:30;p:0");
STL(I,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:5.927475359607631");
STL(J,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:0.629247079026396");
return [Med1,Med2,I,J];
}};

$macros["2Droites6Bissecteurs2drtes"]={
	name:"2.Droites/6 Bissecteurs 2 drtes",
	parameters:["circle","circle","circle"],
	exec:
	function(Hz,DrtAB,DrtAC){
OHz=Center("OHz",Hz);
A=DefinitionPoint("A",DrtAC,1);
antiA1=Point("antiA1","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
antiA2=Point("antiA2","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
L5=PerpendicularBisector("L5",A,antiA1);
L50=PerpendicularBisector("L50",A,antiA2);
cAB0=Center("cAB0",DrtAB);
cAB=Center("cAB",DrtAC);
S4=Segment("S4",cAB,A);
R1=Ray("R1",OHz,cAB);
S40=Segment("S40",cAB0,A);
R10=Ray("R10",OHz,cAB0);
Perp1=Perpendicular("Perp1",S4,A);
Perp10=Perpendicular("Perp10",S40,A);
P6=OrderedIntersection("P6",Perp1,L5,0);
P60=OrderedIntersection("P60",Perp10,L50,0);
C1=Circle("C1",P6,A);
C10=Circle("C10",P60,A);
PoleAC=OrderedIntersection("PoleAC",R1,C1,0);
PoleAB=OrderedIntersection("PoleAB",R10,C10,0);
L1=Line("L1",PoleAC,PoleAB);
antiA3=Point("antiA3","OHz-(PoleAC+OHz)*Hz^2/d(OHz,PoleAC)^2","0");
SymSymc1=Point("SymSymc1","OHz-(PoleAC+OHz)*Hz^2/d(OHz,PoleAC)^2","0");
SupportAB1=Circle3pts("SupportAB1",PoleAC,PoleAB,antiA3);
L51=PerpendicularBisector("L51",PoleAC,SymSymc1);
P12=OrderedIntersection("P12",Hz,SupportAB1,0);
P21=OrderedIntersection("P21",Hz,SupportAB1,1);
Drt=Arc3pts("Drt",P12,PoleAC,P21);
CtrDrte=Center("CtrDrte",Drt);
S41=Segment("S41",CtrDrte,PoleAC);
R11=Ray("R11",OHz,CtrDrte);
C6=Circle("C6",CtrDrte,PoleAC);
C52=Circle("C52",CtrDrte,PoleAC);
Perp11=Perpendicular("Perp11",S41,PoleAC);
P61=OrderedIntersection("P61",Perp11,L51,0);
C11=Circle("C11",P61,PoleAC);
PoleAB0=OrderedIntersection("PoleAB0",R11,C11,0);
antiPoleAB=Point("antiPoleAB","OHz-(PoleAB0+OHz)*Hz^2/d(OHz,PoleAB0)^2","0");
L2=PerpendicularBisector("L2",PoleAB0,antiPoleAB);
cMed1=OrderedIntersection("cMed1",L1,L2,0);
C2=Circle("C2",cMed1,PoleAB0);
S1=Segment("S1",cMed1,PoleAB0);
P3=OrderedIntersection("P3",Hz,C2,1);
P4=OrderedIntersection("P4",Hz,C2,0);
Perp2=Perpendicular("Perp2",S1,PoleAB0);
LaBissA1=Arc3pts("LaBissA1",P3,PoleAB0,P4);
cMed2=OrderedIntersection("cMed2",L2,Perp2,0);
Oo=Center("Oo",LaBissA1);
C4=Circle("C4",cMed2,PoleAB0);
C51=Circle("C51",Oo,PoleAB0);
P5=OrderedIntersection("P5",Hz,C4,1);
P7=OrderedIntersection("P7",Hz,C4,0);
Sol1=OrderedIntersection("Sol1",C51,C6,1);
Sol2=OrderedIntersection("Sol2",C51,C6,0);
LaBissA2=Arc3pts("LaBissA2",P5,PoleAB0,P7);
Oo0=Center("Oo0",LaBissA2);
bissA1=Point("bissA1","Sol2*(d(Sol2,OHz)<Hz)+Sol1*(d(Sol1,OHz)<Hz)","0");
C60=Circle("C60",Oo0,PoleAB0);
Sol10=OrderedIntersection("Sol10",C52,C60,1);
Sol20=OrderedIntersection("Sol20",C52,C60,0);
bissA2=Point("bissA2","Sol20*(d(Sol20,OHz)<Hz)+Sol10*(d(Sol10,OHz)<Hz)","0");
STL(LaBissA1,"c:#fc092f;s:1;f:30;p:0");
STL(LaBissA2,"c:#fc092f;s:1;f:30;p:0");
STL(bissA1,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:5.927475359607631");
STL(bissA2,"c:#fc092f;s:5;sn:true;f:15;sp:2;np:0.629247079026396");
return [LaBissA1,LaBissA2,bissA1,bissA2];
}};

$macros["3Calculs1Distanceelliptique"]={
	name:"3.Calculs/1 Distance elliptique",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
long=Expression("long","","","","2*atan(mod((A/Hz-B/Hz)/(1+conj(A/Hz)*B/Hz)))","0.6","1.35");
dell=Expression("d"+A+B,"","","","min(long,180-long)","1.5","-0.25");
STL(dell,"c:#421601;s:7;sn:true;f:24;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [dell];
}};

$macros["3Calculs2Longueurelliptique"]={
	name:"3.Calculs/2 Longueur elliptique",
	parameters:["circle","point","point"],
	exec:
	function (Hz,A,B){
long=Expression("Long"+A+B,"","","","2*atan(mod(Hz*(A-B)/(Hz*Hz+conj(A)*B)))","-1.2","0.3");
STL(long,"c:#5d0f34;s:7;sn:true;f:24;p:2;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [long];
}};

$macros["3Calculs3AngleBAC"]={
	name:"3.Calculs/3 Angle BAC",
	parameters:["circle","point","point","point"],
	exec:
	function(Hz,B,A,C){
OHz=Center("OHz",Hz);
L2=PerpendicularBisector("L2",A,B);
L3=PerpendicularBisector("L3",A,C);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
L1=PerpendicularBisector("L1",A,antiA);
cAB=OrderedIntersection("cAB",L1,L2,0);
cAC=OrderedIntersection("cAC",L1,L3,0);
S1=Segment("S1",cAC,A);
S2=Segment("S2",A,cAB);
Perp1=Perpendicular("Perp1",S2,A);
Perp2=Perpendicular("Perp2",S1,A);
P3=OrderedIntersection("P3",L1,Perp2,0);
P4=OrderedIntersection("P4",L1,Perp1,0);
ang=Angle("ang"+A,P4,A,P3);
STL(ang,"c:#006633;s:4;f:24;p:1");
return [ang];
}};

$macros["4Cercles1CercleCtrPt"]={
	name:"4.Cercles/1 Cercle Ctr Pt",
	parameters:["circle","point","point"],
	exec:
	function(Hz,O,A){
OHz=Center("OHz",Hz);
L1=Line("L1",O,A);
Perp1=Perpendicular("Perp1",L1,O);
bd1A=OrderedIntersection("bd1A",L1,Hz,0);
bd6A=OrderedIntersection("bd6A",Perp1,Hz,0);
bd2A=Symmetry("bd2A",OHz,bd1A);
R1=AngleBisector("R1",bd1A,O,bd6A);
Axe1=Arc3pts("Axe1",bd1A,O,bd2A);
bd5A=Symmetry("bd5A",OHz,bd6A);
Oo=Center("Oo",Axe1);
bd3A=OrderedIntersection("bd3A",R1,Hz,0);
Axe2=Arc3pts("Axe2",bd6A,O,bd5A);
Oo0=Center("Oo0",Axe2);
bd4A=Symmetry("bd4A",OHz,bd3A);
