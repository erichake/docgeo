$macros["4Cercles2CerclesupportEuclid"]={
	name:"4.Cercles/2 Cercle support Euclid",
	parameters:["circle","point","point"],
	exec:
	function(Hz,O,A){
OHz=Center("OHz",Hz);
L1=Line("L1",O,A);
Perp1=Perpendicular("Perp1",L1,O);
bd1A=OrderedIntersection("bd1A",L1,Hz,0);
