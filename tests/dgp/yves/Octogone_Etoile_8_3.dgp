return [PtEll];
}};

$macros["5Technique3InverseArc1pt"]={
	name:"5.Technique/3 Inverse Arc 1pt",
	parameters:["circle","point"],
	exec:
	function (Hz,M){
Aa=DefinitionPoint("Aa",Hz,0);
