}};

$macros["5Technique2PointElliptique"]={
	name:"5.Technique/2 Point Elliptique",
	parameters:["circle","point"],
	exec:
	function(Hz,A){
OHz=Center("OHz",Hz);
antiA=Point("antiA","OHz-(A+OHz)*Hz^2/d(OHz,A)^2","0");
PtEll=Point(A+"ell","(d(OHz,A)<Hz)?A:antiA","0");
STL(PtEll,"c:#fc092f;s:5;sn:true;f:17;sp:2");
return [PtEll];
}};

$macros["5Technique3InverseArc1pt"]={
	name:"5.Technique/3 Inverse Arc 1pt",
	parameters:["circle","point"],
	exec:
	function (Hz,M){
Aa=DefinitionPoint("Aa",Hz,0);
OHz=Center("OHz",Hz);
Inv=Point("Inv"+M,"OHz+(M-OHz)*d(OHz,Aa)^2/d(OHz,M)^2","0");
STL(Inv,"c:#0000b2;s:5;f:15");
return [Inv];
}};

$macros["5Technique4InverseCercle1pt"]={
