}};

$macros["4Cercles2CerclesupportEuclid"]={
	name:"4.Cercles/2 Cercle support Euclid",
	parameters:["circle","point","point"],
	exec:
	function(Hz,O,A){
OHz=Center("OHz",Hz);
L1=Line("L1",O,A);
Perp1=Perpendicular("Perp1",L1,O);
bd1A=OrderedIntersection("bd1A",L1,Hz,0);
bd6A=OrderedIntersection("bd6A",Perp1,Hz,0);
bd2A=Symmetry("bd2A",OHz,bd1A);
R1=AngleBisector("R1",bd1A,O,bd6A);
Axe1=Arc3pts("Axe1",bd1A,O,bd2A);
bd5A=Symmetry("bd5A",OHz,bd6A);
Oo=Center("Oo",Axe1);
bd3A=OrderedIntersection("bd3A",R1,Hz,0);
Axe2=Arc3pts("Axe2",bd6A,O,bd5A);
Oo0=Center("Oo0",Axe2);
bd4A=Symmetry("bd4A",OHz,bd3A);
sA1=Point("sA1","Oo+(A-Oo)*d(Oo,bd1A)^2/d(Oo,A)^2","0");
Axe3=Arc3pts("Axe3",bd3A,O,bd4A);
sA3=Point("sA3","Oo0+(A-Oo0)*d(Oo0,bd6A)^2/d(Oo0,A)^2","0");
Oo1=Center("Oo1",Axe3);
sA2=Point("sA2","Oo1+(A-Oo1)*d(Oo1,bd3A)^2/d(Oo1,A)^2","0");
Cell=Circle3pts("Cell",sA2,sA3,sA1);
STL(Cell,"c:#ff8a1c;s:1;sn:true;f:30;p:0");
return [Cell];
}};

$macros["5Technique1Antipodie1pt"]={
	name:"5.Technique/1 Antipodie 1 pt",
	parameters:["circle","point"],
	exec:
	function(Hz,A){
OHz=Center("OHz",Hz);
