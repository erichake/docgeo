Text("<div style='font-size:16px;color:#CC0000;text-align:center'>Mod\u00e8le euclidien\nsur la sph\u00e8re priv\u00e9e du point N\n<div style='font-size:14px;color:#AA6600;text-align:left'>\nCacher\n\nLes lattitudes <input type=checkbox target=\"Latt\">\nLes m\u00e9ridiens <input type=checkbox target=\"Mer\">\n<div style='font-size:14px;color:#0000FF;text-align:left'>\nMontrer\n\nLa parall\u00e9le \u00e0 (BC) passant par A <input type=checkbox target=\"BCparA\"> \nLa parall\u00e9le \u00e0 (AC) passant par B <input type=checkbox target=\"ACparB\">\nLe triangle ABC <input type=checkbox target=\"ABC\">\nLe th\u00e9or\u00e8me des milieux <input type=checkbox target=\"ThMil\">\nM\u00e9diatrice et cercle circonscrit <input type=checkbox target=\"Med\">\nHauteurs et orthocentre <input type=checkbox target=\"Ortho\">",485,50,275,311,"c:rgba(105,209,251,0.18);s:3;r:15;p:4");
