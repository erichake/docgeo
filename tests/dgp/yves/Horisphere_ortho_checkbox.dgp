// Macros :
$macros={};
$macros["Cercle3pts"]={
	name:"Cercle 3 pts",
	parameters:["point","point","point"],
	exec:
	function (D2,D3,D4){
C12=Circle3pts3D("C12",D2,D3,D4);
Center4=Center("Center4",C12);
STL(C12,"c:#ed2010;s:2;f:30;p:0");
STL(Center4,"c:#ed2010;s:6;f:30;sp:1");
return [C12,Center4];
}};

$macros["CercleAltuA"]={
	name:"Cercle Alt uA",
	parameters:["point"],
	exec:
	function (uA){
AltA=Expression("AltA","","","","uA","-1.8470552860566665","-2.03345536079633");
P6=Point("P6","[0,sqrt(AltA[2]*(2-AltA[2])),AltA[2]]","0");
P8=Point("P8","[sqrt(AltA[2]*(2-AltA[2])),0,AltA[2]]","0");
Symc1=Symmetry("Symc1",uA,P6);
C1=Circle3pts3D("C1",Symc1,P8,P6);
STL(C1,"c:#cc66cc;s:1;f:30;p:0");
return [C1];
}};

$macros["Doubleretour"]={
	name:"Double retour",
	parameters:["point"],
	exec:
	function (U1){
sU1=Point("sU1","[U1[0],-U1[1],0]","1");
