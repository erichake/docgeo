S5=Segment("S5",stC,stI);
CdstD=Expression("CdstD","","","","stI","0.503085268188287","-2.060253955437747");
S7=Segment("S7",stA,stK);
L1=Line("L1",Ce,Be);
P17=OrderedIntersection("P17",S6,S5,0);
Perp1=Perpendicular("Perp1",L1,Ae);
P7=OrderedIntersection("P7",L1,Perp1,0);
sU1=Point("sU1","[P7[0],-P7[1],0]","1");
CdstD4=Expression("CdstD4","","","","sU1","0.18366605029096195","-1.734051560368143");
hA=Point("hA","[4*CdstD4[0]/(4+CdstD4[0]^2+CdstD4[1]^2),4*CdstD4[1]/(4+CdstD4[0]^2+CdstD4[1]^2),2*(CdstD4[0]^2+CdstD4[1]^2)/(4+CdstD4[0]^2+CdstD4[1]^2)]","1");
STL(hA,"c:#eb1e0f;s:4;sn:true;f:17;sp:2");
return [hA];
}};

$macros["ProjEcran"]={
