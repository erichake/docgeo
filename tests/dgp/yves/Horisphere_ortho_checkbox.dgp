stI=MidPoint("stI",stA,stB);
stJ=MidPoint("stJ",stA,stC);
stK=MidPoint("stK",stC,stB);
Be=Point("Be","[stB[0],-stB[1]]","0");
Ae=Point("Ae","[stA[0],-stA[1]]","0");
Ce=Point("Ce","[stC[0],-stC[1]]","0");
CdstD1=Expression("CdstD1","","","","stJ","0.503085268188287","-2.060253955437747");
