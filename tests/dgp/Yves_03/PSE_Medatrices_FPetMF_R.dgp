Q=OrderedIntersection("Q",L4,L1,0);
P12=Point("P12","Odl+(Q-Odl)*DL^2/d(Odl,Q)^2","0");
L21=Line("L21",Odl,P12);
Perp2=Perpendicular("Perp2",L21,P12);
P7=OrderedIntersection("P7",Perp2,DL,1);
P8=OrderedIntersection("P8",Perp2,DL,0);
LaMed=Segment("LaMed",P7,P8);
STL(LaMed,"c:#006633;s:1;f:24");
return [LaMed];

}};

$macros["KBdroitesPerpcommune"]={
	name:"KBdroites/Perp commune",
