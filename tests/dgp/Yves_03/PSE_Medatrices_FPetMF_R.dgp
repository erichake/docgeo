// Macros :
$macros={};
$macros["CercleLesCoefguA"]={
	name:"Cercle LesCoef g uA",
	parameters:["expression","expression","point"],
	exec:
	function(LesCoef,g,uA){
Pxap=Point("Pxap","[LesCoef[0]*(exp(uA[2])-exp(-uA[2]))/2,0,g(uA[2])]","1");
Pxam=Point("Pxam","[-LesCoef[0]*(exp(uA[2])-exp(-uA[2]))/2,0,g(uA[2])]","1");
Pya=Point("Pya","[0,LesCoef[0]*(exp(uA[2])-exp(-uA[2]))/2,g(uA[2])]","1");
CercleA=Circle3pts3D("CercleA",Pxap,Pxam,Pya);
STL(CercleA,"c:#0000b2;s:1;sn:true;f:30;p:0");
return [CercleA];
}};

$macros["CoordparAoAuA"]={
	name:"Coord par A oA uA",
	parameters:["point","point","point"],
	exec:
	function (A,oA,uA){
Ea=Expression("Ea","","","","A-oA","0.4","-0.7");
CdA=Expression("CdA","","","","[uA[2],IF(Ea[1]>0,acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)),-acos(Ea[0]/sqrt(Ea[0]^2+Ea[1]^2)))]","-1","-1.5");
STL(CdA,"c:#435805;s:7;sn:true;f:24;p:4;cL:200;cPT:YzojNzgwMDEzO3M6MTA7ZjozMA==");
return [CdA];
}};

$macros["FeuillePxpOdl2pts"]={
	name:"FeuilleP xp Odl 2 pts",
	parameters:["expression","point","point","point"],
	exec:
	function(xp,Odl,Akb,Bkb){
L1=Line("L1",Akb,Bkb);
AltMax=Expression("AltMax","","","","log((1+sqrt(1-xp^2))/xp)","-2.9082943334708573","-3.089821337020832");
FPi=Point("FPi","Odl+[(exp(-AltMax)-exp(AltMax))*cos(xp*(-\u03C0))/(exp(-AltMax)+exp(AltMax)),(exp(-AltMax)-exp(AltMax))*sin(xp*(-\u03C0))/(exp(-AltMax)+exp(AltMax))]","0");
FPs=Point("FPs","Odl+[(exp(-AltMax)-exp(AltMax))*cos(xp*\u03C0)/(exp(-AltMax)+exp(AltMax)),(exp(-AltMax)-exp(AltMax))*sin(xp*\u03C0)/(exp(-AltMax)+exp(AltMax))]","0");
P10=Point("P10","Odl+[(exp(-AltMax)-exp(AltMax))/(exp(-AltMax)+exp(AltMax)),0]","0");
ArcFP=Arc3pts("ArcFP",FPi,P10,FPs);
PartInf=Segment("PartInf",Odl,FPi);
PartSup=Segment("PartSup",Odl,FPs);
Barc1=OrderedIntersection("Barc1",L1,ArcFP,1);
Bsup=OrderedIntersection("Bsup",PartSup,L1,0);
Binf=OrderedIntersection("Binf",PartInf,L1,0);
Barc2=OrderedIntersection("Barc2",L1,ArcFP,0);
FPgene=Expression("FPgene","","","","var tab=[];if(isNaN(Barc1.getX())){ if(isNaN(Barc2.getX())){var tab=[Binf,Bsup]} else{if(isNaN(Binf.getX())){var tab=[Barc2,Bsup]} else{var tab=[Barc2,Binf]}}} else{if(isNaN(Barc2.getX())){ if(isNaN(Binf.getX())){var tab=[Barc1,Bsup]} else{var tab=[Barc1,Binf]}} else{var tab=[Barc1,Barc2]}};tab","-2.831048800045337","-2.201497702627343");
FPab1=Point("FPab1","FPgene[0]","0");
FPab2=Point("FPab2","FPgene[1]","0");
fpAB=Segment("fpAB",FPab1,FPab2);
STL(FPab1,"c:#0000b2;s:4;f:15;sp:1");
STL(FPab2,"c:#0000b2;s:4;f:15;sp:1");
STL(fpAB,"c:#006633;s:1;f:24");
return [FPab1,FPab2,fpAB];
}};

$macros["FPxpOdl2pts"]={
	name:"FP xp Odl 2 pts",
	parameters:["expression","point","point","point"],
	exec:
	function(xp,Odl,Akb,Bkb){
L1=Line("L1",Akb,Bkb);
AltMax=Expression("AltMax","","","","log((1+sqrt(1-xp^2))/xp)","-3.4421325639496883","-3.6569801476225114");
S11=Point("S1-","Odl+[(exp(-AltMax)-exp(AltMax))*cos(xp*(-\u03C0))/(exp(-AltMax)+exp(AltMax)),(exp(-AltMax)-exp(AltMax))*sin(xp*(-\u03C0))/(exp(-AltMax)+exp(AltMax))]","0");
S12=Point("S1+","Odl+[(exp(-AltMax)-exp(AltMax))*cos(xp*\u03C0)/(exp(-AltMax)+exp(AltMax)),(exp(-AltMax)-exp(AltMax))*sin(xp*\u03C0)/(exp(-AltMax)+exp(AltMax))]","0");
P10=Point("P10","Odl+[(exp(-AltMax)-exp(AltMax))/(exp(-AltMax)+exp(AltMax)),0]","0");
ArcFP=Arc3pts("ArcFP",S11,P10,S12);
PartInf=Segment("PartInf",Odl,S11);
PartSup=Segment("PartSup",Odl,S12);
Barc=OrderedIntersection("Barc",L1,ArcFP,1);
Bsup=OrderedIntersection("Bsup",PartSup,L1,0);
Binf=OrderedIntersection("Binf",PartInf,L1,0);
ABkbFP=Expression("ABkbFP","","","","isNaN(Barc.getX())?[Binf,Bsup]:isNaN(Bsup.getX())?[Barc,Binf]:[Barc,Bsup]","-1.2936567272214634","-5.211196710362079");
AB1=Point("AB1","ABkbFP[0]","0");
AB2=Point("AB2","ABkbFP[1]","0");
SegAB=Segment("SegAB",AB1,AB2);
STL(SegAB,"c:#006633;s:1;sn:true;f:24");
return [SegAB];
}};

$macros["KBversPSEPointLesCoefgOdlPt"]={
	name:"KB vers PSE Point LesCoef g Odl Pt",
	parameters:["expression","expression","point","point"],
	exec:
	function(LesCoef,g,Odl,Mkb){
longM=Expression("longM","","","","(x(Mkb)<x(Odl))?(atan((y(Mkb)-y(Odl))/(x(Mkb)-x(Odl)))/LesCoef[0]):((atan((y(Mkb)-y(Odl))/(x(Mkb)-x(Odl)))+\u03C0*(1-2*(y(Mkb)>y(Odl))))/LesCoef[0])","-1.37593878054297","-2.422749347799914");
CdM=Expression("CdM","","","","[log((1+(x(Mkb)-x(Odl))/cos(LesCoef[0]*longM))/(1-(x(Mkb)-x(Odl))/cos(LesCoef[0]*longM)))/2,longM]","-2.3816083211391605","-2.788447362562165");
Mpse=Point("Mpse","[LesCoef[0]*(exp(CdM[0])-exp(-CdM[0]))*cos(CdM[1]-\u03C0)/2,LesCoef[0]*(exp(CdM[0])-exp(-CdM[0]))*sin(CdM[1]-\u03C0)/2,g(CdM[0])]","1");
STL(Mpse,"c:#fc092f;s:5;sn:true;f:17;sp:2");
return [Mpse];
}};

$macros["KBcyclesCercleCtrPt"]={
	name:"KBcycles/Cercle Ctr Pt",
	parameters:["point","point","circle"],
	exec:
	function (O,A,DL){
Odl=Center("Odl",DL);
S1=Line("S1",O,A);
L2=Line("L2",Odl,O);
Perp11=Perpendicular("Perp11",S1,Odl);
Perp1=Perpendicular("Perp1",S1,Odl);
Syma1=Reflection("Syma1",L2,A);
P41=OrderedIntersection("P41",Perp11,S1,0);
P4=OrderedIntersection("P4",Perp1,S1,0);
P111=Point("P111","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
L11=Line("L11",O,P111);
L1=Line("L1",A,P11);
Perp12=Perpendicular("Perp12",L11,Odl);
P411=OrderedIntersection("P411",Perp12,L11,0);
P112=Point("P112","Odl+(P411-Odl)*DL^2/d(Odl,P411)^2","0");
L21=Line("L21",A,P112);
P6=OrderedIntersection("P6",L21,L11,0);
d1=Line("d1",P112,P6);
C11=Circle("C11",P6,P112);
Perp111=Perpendicular("Perp111",d1,P6);
Perp2=Perpendicular("Perp2",d1,P112);
P42=OrderedIntersection("P42",Perp111,C11,1);
L111=Line("L111",P42,A);
P51=OrderedIntersection("P51",Perp2,L111,0);
Symc1=Symmetry("Symc1",P112,P51);
L211=Line("L211",P42,Symc1);
D=OrderedIntersection("D",L211,d1,0);
Syma2=Reflection("Syma2",L2,D);
L4=Line("L4",D,Syma1);
L3=Line("L3",D,A);
L22=Line("L22",Syma2,Syma1);
P=OrderedIntersection("P",L22,L1,0);
Perp13=Perpendicular("Perp13",L3,P);
N=OrderedIntersection("N",Perp13,L3,0);
M=OrderedIntersection("M",L4,Perp13,0);
L5=Line("L5",A,M);
L6=Line("L6",Syma2,N);
C12=OrderedIntersection("C12",L6,L5,0);
KBC=Quadric("KBC",Syma2,D,Syma1,C12,A);
STL(KBC,"c:#007c7c;s:2.5;f:30;p:200");
STL(Odl,"c:#0000b2;s:5;sn:true;f:15;sp:1");
return [KBC];
}};

$macros["KBcyclesEquidistCnkABM"]={
	name:"KBcycles/Equidist Cnk A B M",
	parameters:["point","point","point","circle"],
	exec:
	function (A,B,M,DL){
Odl=Center("Odl",DL);
L1=Line("L1",A,B);
M2=MidPoint("M2",A,B);
P1=OrderedIntersection("P1",L1,DL,1);
P2=OrderedIntersection("P2",L1,DL,0);
S1=Segment("S1",P1,P2);
M1=MidPoint("M1",P1,A);
Perp1=Perpendicular("Perp1",S1,Odl);
Perp10=Perpendicular("Perp10",S1,Odl);
P4=OrderedIntersection("P4",Perp1,S1,0);
P40=OrderedIntersection("P40",Perp10,S1,0);
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
P110=Point("P110","Odl+(P40-Odl)*DL^2/d(Odl,P40)^2","0");
L10=Line("L10",M1,P11);
L11=Line("L11",M2,P110);
P5=OrderedIntersection("P5",L10,DL,1);
P6=OrderedIntersection("P6",L10,DL,0);
P50=OrderedIntersection("P50",L11,DL,1);
P60=OrderedIntersection("P60",L11,DL,0);
S2=Segment("S2",P5,P6);
S20=Segment("S20",P50,P60);
Perp12=Perpendicular("Perp12",S2,Odl);
Perp13=Perpendicular("Perp13",S20,Odl);
P410=OrderedIntersection("P410",Perp12,S2,0);
P411=OrderedIntersection("P411",Perp13,S20,0);
P112=Point("P112","Odl+(P410-Odl)*DL^2/d(Odl,P410)^2","0");
P113=Point("P113","Odl+(P411-Odl)*DL^2/d(Odl,P411)^2","0");
L2=Line("L2",M,P112);
L20=Line("L20",M,P113);
P62=OrderedIntersection("P62",L2,S2,0);
P63=OrderedIntersection("P63",L20,S20,0);
d1=Line("d1",P112,P62);
DL1=Circle("DL1",P62,P112);
d10=Line("d10",P113,P63);
DL10=Circle("DL10",P63,P113);
Perp110=Perpendicular("Perp110",d1,P62);
Perp2=Perpendicular("Perp2",d1,P112);
Perp111=Perpendicular("Perp111",d10,P63);
Perp20=Perpendicular("Perp20",d10,P113);
P42=OrderedIntersection("P42",Perp110,DL1,1);
P420=OrderedIntersection("P420",Perp111,DL10,1);
L110=Line("L110",P42,M);
L111=Line("L111",P420,M);
P510=OrderedIntersection("P510",Perp2,L110,0);
P511=OrderedIntersection("P511",Perp20,L111,0);
SymDL=Symmetry("SymDL",P112,P510);
SymDL0=Symmetry("SymDL0",P113,P511);
L21=Line("L21",P42,SymDL);
L210=Line("L210",P420,SymDL0);
ell1=OrderedIntersection("ell1",L21,d1,0);
ell2=OrderedIntersection("ell2",L210,d10,0);
EquidC=Quadric("EquidC",P1,ell1,M,ell2,P2);
STL(EquidC,"c:#ff8a1c;o:0.1;s:2;f:30;p:500");
return [EquidC];
}};

$macros["KBcyclesEquidistLieuDrtPt"]={
	name:"KBcycles/Equidist Lieu Drt Pt",
	parameters:["line","point","circle"],
	exec:
	function (S1,M,DL){
Odl=Center("Odl",DL);
P3=PointOn("P3",S1,0.16191169266626568);
Perp12=Perpendicular("Perp12",S1,Odl);
P42=OrderedIntersection("P42",Perp12,S1,0);
P112=Point("P112","Odl+(P42-Odl)*DL^2/d(Odl,P42)^2","0");
L10=Line("L10",P3,P112);
P5=OrderedIntersection("P5",L10,DL,1);
P6=OrderedIntersection("P6",L10,DL,0);
S2=Segment("S2",P5,P6);
Perp13=Perpendicular("Perp13",S2,Odl);
P410=OrderedIntersection("P410",Perp13,S2,0);
P113=Point("P113","Odl+(P410-Odl)*DL^2/d(Odl,P410)^2","0");
L2=Line("L2",M,P113);
P60=OrderedIntersection("P60",L2,S2,0);
d1=Line("d1",P113,P60);
DL1=Circle("DL1",P60,P113);
Perp110=Perpendicular("Perp110",d1,P60);
Perp2=Perpendicular("Perp2",d1,P113);
P420=OrderedIntersection("P420",Perp110,DL1,1);
L11=Line("L11",P420,M);
P51=OrderedIntersection("P51",Perp2,L11,0);
SymDL=Symmetry("SymDL",P113,P51);
L21=Line("L21",P420,SymDL);
D=OrderedIntersection("D",L21,d1,0);
EquidL=Locus("EquidL",D,P3);
STL(EquidL,"c:#fc092f;o:0.08;s:2.5;f:30;p:200");
return [EquidL];
}};

$macros["KBcyclesHoricycleOA"]={
	name:"KBcycles/Horicycle O A",
	parameters:["point","point","circle"],
	exec:
	function (P1,P2,DL){
Odl=Center("Odl",DL);
R1=Ray("R1",P1,Odl);
P3=OrderedIntersection("P3",R1,DL,0,P1);
Perp1=Perpendicular("Perp1",R1,Odl);
M1=MidPoint("M1",Odl,P3);
P4=OrderedIntersection("P4",Perp1,DL,0);
Perp2=Perpendicular("Perp2",R1,M1);
S1=Segment("S1",P1,P4);
P5=OrderedIntersection("P5",Perp2,DL,0);
P7=OrderedIntersection("P7",Perp2,DL,1);
Perp10=Perpendicular("Perp10",S1,Odl);
S2=Segment("S2",P1,P5);
S4=Segment("S4",P1,P7);
P41=OrderedIntersection("P41",Perp10,S1,0);
P11=Point("P11","Odl+(P41-Odl)*DL^2/d(Odl,P41)^2","0");
Perp12=Perpendicular("Perp12",S2,Odl);
Perp13=Perpendicular("Perp13",S4,Odl);
L2=Line("L2",P2,P11);
P410=OrderedIntersection("P410",Perp12,S2,0);
P411=OrderedIntersection("P411",Perp13,S4,0);
P60=OrderedIntersection("P60",L2,S1,0);
P110=Point("P110","Odl+(P410-Odl)*DL^2/d(Odl,P410)^2","0");
P111=Point("P111","Odl+(P411-Odl)*DL^2/d(Odl,P411)^2","0");
d1=Line("d1",P11,P60);
DL1=Circle("DL1",P60,P11);
L20=Line("L20",P2,P110);
L22=Line("L22",P2,P111);
Perp11=Perpendicular("Perp11",d1,P60);
Perp20=Perpendicular("Perp20",d1,P11);
P61=OrderedIntersection("P61",L20,S2,0);
P62=OrderedIntersection("P62",L22,S4,0);
P42=OrderedIntersection("P42",Perp11,DL1,1);
d10=Line("d10",P110,P61);
DL10=Circle("DL10",P61,P110);
d11=Line("d11",P111,P62);
DL11=Circle("DL11",P62,P111);
L11=Line("L11",P42,P2);
Perp110=Perpendicular("Perp110",d10,P61);
Perp21=Perpendicular("Perp21",d10,P110);
Perp111=Perpendicular("Perp111",d11,P62);
Perp22=Perpendicular("Perp22",d11,P111);
P51=OrderedIntersection("P51",Perp20,L11,0);
P420=OrderedIntersection("P420",Perp110,DL10,1);
P421=OrderedIntersection("P421",Perp111,DL11,1);
SymDL=Symmetry("SymDL",P11,P51);
L110=Line("L110",P420,P2);
L111=Line("L111",P421,P2);
L21=Line("L21",P42,SymDL);
P510=OrderedIntersection("P510",Perp21,L110,0);
P511=OrderedIntersection("P511",Perp22,L111,0);
ell1=OrderedIntersection("ell1",L21,d1,0);
SymDL0=Symmetry("SymDL0",P110,P510);
SymDL1=Symmetry("SymDL1",P111,P511);
L210=Line("L210",P420,SymDL0);
L211=Line("L211",P421,SymDL1);
ell2=OrderedIntersection("ell2",L210,d10,0);
ell3=OrderedIntersection("ell3",L211,d11,0);
HoriOA=Quadric("HoriOA",P1,ell1,P2,ell2,ell3);
STL(HoriOA,"c:#00adff;s:1;f:30;p:500");
return [HoriOA];
}};

$macros["KBdroitesBiss3pts"]={
	name:"KBdroites/Biss 3 pts",
	parameters:["point","point","point","circle"],
	exec:
	function (B,A,C,DL){
Odl=Center("Odl",DL);
R1=Ray("R1",A,B);
R2=Ray("R2",A,C);
P1=OrderedIntersection("P1",R1,DL,0);
P2=OrderedIntersection("P2",R2,DL,0);
S1=Segment("S1",P1,P2);
Perp1=Perpendicular("Perp1",S1,Odl);
P4=OrderedIntersection("P4",Perp1,S1,0);
P11=Point("P11","Odl+(P4-Odl)*DL^2/d(Odl,P4)^2","0");
L1=Line("L1",A,P11);
P5=OrderedIntersection("P5",L1,DL,1);
P6=OrderedIntersection("P6",L1,DL,0);
Biss=Segment("Biss",P5,P6);
STL(Biss,"c:#006633;s:1;f:24");
return [Biss];
}};

