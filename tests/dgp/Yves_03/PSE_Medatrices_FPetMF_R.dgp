$macros["KBdroitesMeddontOdl"]={
	name:"KBdroites/Med dont Odl",
	parameters:["circle","point"],
	exec:
	function (DL,A){
Odl=Center("Odl",DL);
L1=Line("L1",Odl,A);
Perp1=Perpendicular("Perp1",L1,Odl);
Perp2=Perpendicular("Perp2",L1,A);
P1=OrderedIntersection("P1",Perp1,DL,0);
P2=OrderedIntersection("P2",Perp2,DL,0);
L2=Line("L2",P1,P2);
P3=OrderedIntersection("P3",L2,L1,0);
P12=Point("P12","Odl+(P3-Odl)*DL^2/d(Odl,P3)^2","0");
L21=Line("L21",Odl,P12);
Perp21=Perpendicular("Perp21",L21,P12);
P7=OrderedIntersection("P7",Perp21,DL,1);
P8=OrderedIntersection("P8",Perp21,DL,0);
LaMed=Segment("LaMed",P7,P8);
STL(LaMed,"c:#006633;s:1;f:24");
return [LaMed];

}};

$macros["KBdroitesMediatrice"]={
	name:"KBdroites/Mediatrice",
	parameters:["point","point","circle"],
	exec:
	function (A,B,DL){
Odl=Center("Odl",DL);
