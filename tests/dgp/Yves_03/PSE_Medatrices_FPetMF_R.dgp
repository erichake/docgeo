Text("<div style='font-size:18px;color:#CC0000;text-align:center'> PSE - Cercle circonscrit<div style='font-size:14px;color:#0000FF;text-align:left'>\nMontrer les m\u00e9diatrices  :   <select target=\"ChFP\">\n  <option value=\"1\">sur la feuille principale</option>\n  <option value=\"2\">Sur toutes les feuilles</option>\n</select>",22,9,452,79,"c:rgba(247,249,162,0.18);s:3;r:15;p:4");
