<CaR>
<Script Name="Construction du Snub Cube" onload="false">
x0=0.543689012692;
x1=x0*x0;
a=Math.sqrt((x0*x0+x1*x1)/2);
if(getC().is3D()){

	// points du polyèdre
	Point(&quot;p000&quot;,&quot;x(Z)+(x(X)-x(O))*_x0+(x(Y)-x(O))*(-_x1)+(x(Z)-x(O))*(-1)&quot;,&quot;y(Z)+(y(X)-y(O))*_x0+(y(Y)-y(O))*(-_x1)+(y(Z)-y(O))*(-1)&quot;);
