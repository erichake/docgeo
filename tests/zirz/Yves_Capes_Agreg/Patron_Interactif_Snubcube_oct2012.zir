	Point(&quot;p012&quot;,&quot;x(Z)+(x(X)-x(O))*(-1)+(x(Y)-x(O))*(-_x1)+(x(Z)-x(O))*(-_x0)&quot;,&quot;y(Z)+(y(X)-y(O))*(-1)+(y(Y)-y(O))*(-_x1)+(y(Z)-y(O))*(-_x0)&quot;);
