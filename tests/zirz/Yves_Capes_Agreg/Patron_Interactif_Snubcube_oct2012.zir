	}
   
	//texte explicatif
	Text(&quot;Consigne&quot;,&quot;Lancer l&apos;algorithme depuis l&apos;icone de script (en haut à gauche) puis suivez les instructions en bas de l&apos;écran.&quot;,&quot;windowcx-windoww+5/pixel&quot;,&quot;windowcy+windowh/2-60/pixel&quot;);
	SetColor(&quot;Consigne&quot;, &quot;red&quot;);
	
	Text(&quot;reste&quot;,&quot;Nombre de face(s) du patron à construire :&quot;,&quot;windowcx-windoww+5/pixel&quot;,&quot;windowcy+windowh/2-80/pixel&quot;);
	Expression(&quot;rest&quot;,&quot;38&quot;,&quot;windowcx-windoww+275/pixel&quot;,&quot;windowcy+windowh/2-94/pixel&quot;);

	SetColor(&quot;reste,rest&quot;, &quot;blue&quot;);
	Text(&quot;Tnftt&quot;,&quot;**Cette arête n&apos;est plus utilisable&quot;,&quot;windowcx-windoww+3/pixel&quot;,&quot;windowcy+windowh/2-100/pixel&quot;);
	Text(&quot;Tnfntt&quot;,&quot;**Cette arête n&apos;est pas encore utilisable&quot;,&quot;windowcx-windoww+3/pixel&quot;,&quot;windowcy+windowh/2-100/pixel&quot;);
	SetHide(&quot;Tnftt,Tnfntt&quot;,true);
	SetColor(&quot;Tnftt,Tnfntt&quot;, &quot;black&quot;);
	SetHide(Expression(&quot;t&quot;,0,0,0), true);
	t = getC().find(&quot;t&quot;);
	t = getZC().JCM.addSlider(t,250,20,300,29);
	t.setShowUnit(false);
	t.setMin(0.0);
	t.setMax(1.0);
	t.setVal(0.0);
	t.setSnap(false);
	t.setComment(&quot;Déplier / Plier&quot;);
	t.setShowVal(false);
	t.setShowTicks(false);

	Intersection(&quot;u&quot;,&quot;a000&quot;,&quot;s7&quot;);
	
	Expression(&quot;p&quot;,&quot;0.96*d(O,u)/d(O,X)&quot;,0,0);
	Expression(&quot;c&quot;,&quot;2*p&quot;,0,0);
	Expression(&quot;h&quot;,&quot;p*tan(30)&quot;,0,0);
	Expression(&quot;ang1&quot;,&quot;t*37.0108&quot;,0,0);
	Expression(&quot;ang2&quot;,&quot;t*26.7656&quot;,0,0);
	SetHide(&quot;p,c,h,ang1,ang2&quot;, true);		
	SetHide(&quot;u&quot;,true);

} else {
	Println(&quot;Vous n&apos;êtes pas en mode 3D&quot;);
}

</Script>
<Script Name="Construction manuelle du patron " onload="false">
//Objet carré
Carre = function(art0, art1, art2, art3){
	this.point = new Array(4);
	var o,z;//centre et extrémité du vect orthogonal
	this.arete = new Array(art0, art1, art2, art3);
	this.segment = new Array(4);
	this.etat = 0; //non traitee = 0 ; traitee = 1
}
//objet triangle
Triangle = function(art0, art1, art2){
	this.point = new Array(3);
	var o,z;//
	this.arete = new Array(art0, art1, art2);
	this.segment = new Array(3);
	this.etat = 0;
}


//Fonction nouveau triangle
NouveauTriangle = function(face, ancf, nvlf, dira, dirn){
	//dira = direction dans laquelle on quite l&apos;ancf (ancienne face)
	//dirn = direction depuis laquelle on arrive sur la nvlf
	var l, o, z, qm, q0, q1, q2, q3, poly, i, R, G, B, p;

	o = face[ancf].o;
	z = face[ancf].z;

	l = face[ancf].arete.length;//vient-on d&apos;un Carre (l=4) ou d&apos;un Triangle (l=3) ?
	q0 = face[nvlf].point[dirn] = face[ancf].point[(1+dira)%l];
	q1 = face[nvlf].point[(1+dirn)%3] = face[ancf].point[dira];
	qm = MidPoint(q0, q1);
	if(l==4){
		
		q3 = face[nvlf].o = Point(&quot;x(&quot;+qm+&quot;)+h/p*cos(ang1)*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+h*sin(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+qm+&quot;)+h/p*cos(ang1)*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+h*sin(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	} else {
		q3 = face[nvlf].o = Point(&quot;x(&quot;+qm+&quot;)+cos(ang2)*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+h*sin(ang2)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+qm+&quot;)+cos(ang2)*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+h*sin(ang2)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	}
	q2=face[nvlf].point[(2+dirn)%3] = Point(&quot;3*x(&quot;+q3+&quot;)-2*x(&quot;+qm+&quot;)&quot;,&quot;3*y(&quot;+q3+&quot;)-2*y(&quot;+qm+&quot;)&quot;);

	if(l==4){
		face[nvlf].z = Point(&quot;x(&quot;+q3+&quot;)-sin(ang1)/p*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+cos(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+q3+&quot;)-sin(ang1)/p*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+cos(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	} else {
		face[nvlf].z = Point(&quot;x(&quot;+q3+&quot;)-sin(ang2)/h*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+cos(ang2)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+q3+&quot;)-sin(ang2)/h*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+cos(ang2)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	}
	
	//représentation de cette nouvelle face
	poly = face[nvlf].point[0];
	for(i=1; i&lt;3; i++){
		poly += &quot;,&quot;+face[nvlf].point[i];
	}
	R = Math.floor( 255*Math.random() + 1 );
	G = Math.floor( 255*Math.random() + 1 );
	B = Math.floor( 255*Math.random() + 1 );
	SetRGBColor(p=Polygon(poly), R, G, B);
	SetHide(poly, true); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
	SetHide(face[nvlf].o+&quot;,&quot;+face[nvlf].z+&quot;,&quot;+qm, true);

	face[nvlf].etat = 1;
}

// fonction nouveau carré
NouveauCarre = function(face, ancf, nvlf, dira, dirn){
	var o, z, i, p0, p1, pm, p4, poly, i, p;

	o = face[ancf].o;
	z = face[ancf].z;

	p0 = face[nvlf].point[dirn] = face[ancf].point[(1+dira)%3];
	p1 = face[nvlf].point[(1+dirn)%4] = face[ancf].point[dira];
	pm = MidPoint(p0, p1);
	p4 = face[nvlf].o = Point(&quot;x(&quot;+pm+&quot;)+p/h*cos(ang1)*(x(&quot;+pm+&quot;)-x(&quot;+o+&quot;))+sin(ang1)*p*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;, &quot;y(&quot;+pm+&quot;)+p/h*cos(ang1)*(y(&quot;+pm+&quot;)-y(&quot;+o+&quot;))+sin(ang1)*p*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);	
	face[nvlf].point[(2+dirn)%4] = Point(&quot;x(&quot;+p4+&quot;)+(x(&quot;+p4+&quot;)-x(&quot;+p0+&quot;))&quot;, &quot;y(&quot;+p4+&quot;)+(y(&quot;+p4+&quot;)-y(&quot;+p0+&quot;))&quot;);
	face[nvlf].point[(3+dirn)%4] = Point(&quot;x(&quot;+p4+&quot;)+(x(&quot;+p4+&quot;)-x(&quot;+p1+&quot;))&quot;, 
	&quot;y(&quot;+p4+&quot;)+(y(&quot;+p4+&quot;)-y(&quot;+p1+&quot;))&quot;);
	face[nvlf].z = Point(&quot;x(&quot;+p4+&quot;)-sin(ang1)/h*(x(&quot;+pm+&quot;)-x(&quot;+o+&quot;))+cos(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;, &quot;y(&quot;+p4+&quot;)-sin(ang1)/h*(y(&quot;+pm+&quot;)-y(&quot;+o+&quot;))+cos(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	
	//représentation de cette nouvelle face
	poly = face[nvlf].point[0];
	for(i=1; i&lt;4; i++){
		poly += &quot;,&quot;+face[nvlf].point[i];
	}
	SetColor(p=Polygon(poly), &quot;black&quot;); //toujours en noir
	SetHide(poly, true); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
	SetHide(face[nvlf].o+&quot;,&quot;+face[nvlf].z+&quot;,&quot;+pm, true);

	face[nvlf].etat = 1;
}

//gère la création ou supression des segments proposés sur les faces du patron
GeranceSegments = function(face, liste_faces_creees, nb_faces_creees, nvlf){
	var i, j, l, f, l_nf, k, occ;

	l = face[nvlf].arete.length;
	//on passe en revue toutes les arêtes de la face nvlf
	for(i=0; i&lt;l; i++){
		occ = 0;
		art = face[nvlf].arete[i];
		//on cherche si cette arête appartient à une (autre) face déjà créée
		//on peut s&apos;arrêter dès qu&apos;on a trouvé une occurrence
		for(j=0; (occ==0)&amp;&amp;(j&lt;nb_faces_creees); j++){
			f = liste_faces_creees[j];
			l_f = face[f].arete.length;
			for(k=0; (k&lt;l_f)&amp;&amp;(face[f].arete[k]!=art); k++){} //on cherche le rang de l&apos;arête
			occ += face[f].arete[k]==art; //incrémentation si on a trouvé une occurence de cette arête
		}
		//si on a trouvé une face f, il faut supprimer le segment proposé sur cette face
		if(occ!=0){
			Delete(face[f].segment[k]); //on le détruit (DELETE... DELETE... DELETE...)
			face[f].segment[k] = &quot;deleted&quot;; // on efface son occurence dans la face concernée
			SetColor(face[f].arete[k], &quot;black&quot;);
		} else { //sinon on le créé sur la nouvelle face
			face[nvlf].segment[i] = Segment(face[nvlf].point[i], face[nvlf].point[(i+1)%l]);
			SetColor(face[nvlf].segment[i], &quot;blue&quot;);
			SetHide(face[nvlf].segment[i], false);
			SetThickness(face[nvlf].segment[i], &quot;normal&quot;);
			SetColor(face[nvlf].arete[i], &quot;green&quot;);
		}
	}
}

// Construction du patron
ConstructionPatron = function(){
	var face, liste_faces_creees, liste_faces_afaire, nb_faces_creees, nftt, nfntt, ancf, nvlf, l, s, err, occ, dira, dirn, p;

	//Initialisation des 38 faces
	face = new Array(38);
	//carré au sol, avec en plus les points qui existent déjà
	face[0] = new Carre(&quot;a000&quot;, &quot;a001&quot;, &quot;a002&quot;, &quot;a003&quot;);
	face[0].point = [&quot;p000&quot;, &quot;p001&quot;, &quot;p002&quot;, &quot;p003&quot;];
	face[0].o = &quot;O&quot;; face[0].z = &quot;Z&quot;;
	//1er étage
	face[1] = new Triangle(&quot;a000&quot;, &quot;a100&quot;, &quot;a101&quot;);
	face[2] = new Triangle(&quot;a001&quot;, &quot;a103&quot;, &quot;a104&quot;);
	face[3] = new Triangle(&quot;a002&quot;, &quot;a106&quot;, &quot;a107&quot;);
	face[4] = new Triangle(&quot;a003&quot;, &quot;a109&quot;, &quot;a110&quot;);
	//2è etage
	face[5] = new Triangle(&quot;a102&quot;, &quot;a101&quot;, &quot;a200&quot;);
	face[6] = new Triangle(&quot;a103&quot;, &quot;a102&quot;, &quot;a201&quot;);
	face[7] = new Triangle(&quot;a105&quot;, &quot;a104&quot;, &quot;a202&quot;);
	face[8] = new Triangle(&quot;a106&quot;, &quot;a105&quot;, &quot;a203&quot;);
	face[9] = new Triangle(&quot;a108&quot;, &quot;a107&quot;, &quot;a204&quot;);
	face[10] = new Triangle(&quot;a109&quot;, &quot;a108&quot;, &quot;a205&quot;);
	face[11] = new Triangle(&quot;a111&quot;, &quot;a110&quot;, &quot;a206&quot;);
	face[12] = new Triangle(&quot;a100&quot;, &quot;a111&quot;, &quot;a207&quot;);
	//3è étage

	face[13] = new Triangle(&quot;a200&quot;, &quot;a300&quot;, &quot;a301&quot;);
	face[14] = new Carre(&quot;a201&quot;, &quot;a302&quot;, &quot;a407&quot;, &quot;a303&quot;);
	face[15] = new Triangle(&quot;a202&quot;, &quot;a303&quot;, &quot;a304&quot;);
	face[16] = new Carre(&quot;a203&quot;, &quot;a305&quot;, &quot;a401&quot;, &quot;a306&quot;);
	face[17] = new Triangle(&quot;a204&quot;, &quot;a306&quot;, &quot;a307&quot;);
	face[18] = new Carre(&quot;a205&quot;, &quot;a308&quot;, &quot;a403&quot;, &quot;a309&quot;);
	face[19] = new Triangle(&quot;a206&quot;, &quot;a309&quot;, &quot;a310&quot;);
	face[20] = new Carre(&quot;a207&quot;, &quot;a311&quot;, &quot;a405&quot;, &quot;a300&quot;);
	//4è étage
	face[21] = new Triangle(&quot;a302&quot;, &quot;a301&quot;, &quot;a406&quot;);
	face[22] = new Triangle(&quot;a305&quot;, &quot;a304&quot;, &quot;a400&quot;);
	face[23] = new Triangle(&quot;a308&quot;, &quot;a307&quot;, &quot;a402&quot;);
	face[24] = new Triangle(&quot;a311&quot;, &quot;a310&quot;, &quot;a404&quot;);
	//5è étage
	face[25] = new Triangle(&quot;a501&quot;, &quot;a400&quot;, &quot;a500&quot;);
	face[26] = new Triangle(&quot;a503&quot;, &quot;a401&quot;, &quot;a502&quot;);
	face[27] = new Triangle(&quot;a504&quot;, &quot;a402&quot;, &quot;a503&quot;);
	face[28] = new Triangle(&quot;a506&quot;, &quot;a403&quot;, &quot;a505&quot;);
	face[29] = new Triangle(&quot;a507&quot;, &quot;a404&quot;, &quot;a506&quot;);
	face[30] = new Triangle(&quot;a509&quot;, &quot;a405&quot;, &quot;a508&quot;);
	face[31] = new Triangle(&quot;a510&quot;, &quot;a406&quot;, &quot;a509&quot;);
	face[32] = new Triangle(&quot;a500&quot;, &quot;a407&quot;, &quot;a511&quot;);
	//6è étage
	face[33] = new Triangle(&quot;a502&quot;, &quot;a501&quot;, &quot;a600&quot;);
	face[34] = new Triangle(&quot;a505&quot;, &quot;a504&quot;, &quot;a601&quot;);
	face[35] = new Triangle(&quot;a508&quot;, &quot;a507&quot;, &quot;a602&quot;);
	face[36] = new Triangle(&quot;a511&quot;, &quot;a510&quot;, &quot;a603&quot;);
	//7è étage
	face[37] = new Carre(&quot;a600&quot;, &quot;a603&quot;, &quot;a602&quot;, &quot;a601&quot;);

	liste_faces_creees = new Array();
	liste_faces_afaire = new Array(38);
	for(i=0; i&lt;38; i++){
		liste_faces_afaire[i] = i;
	}

	//construction de la face au sol
	p=Polygon(&quot;p000,p001,p002,p003&quot;); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
	for(i=0; i&lt;4; i++){
		face[0].segment[i] = Segment(face[0].point[i], face[0].point[(i+1)%4]);
		SetHide(face[0].segment[i], true);
		SetColor(face[0].arete[i], &quot;green&quot;);
	}
	face[0].etat = 1;
	liste_faces_creees[0] = 0;
	liste_faces_afaire.splice(0,1);	
	SetExpressionValue(&quot;rest&quot;, 37);

	//construction des autres faces
	for(nb_faces_creees=1; nb_faces_creees&lt;38; nb_faces_creees++){
		nftt = nfntt = 0; //Nombre de Faces (Non) Traitée(s) Trouvée(s)
		while(nftt*nfntt==0){
			while(true){
				try{
					s = InteractiveInput(&quot;Cliquez sur un segment bleu ou une arête verte&quot;,&quot;Segment&quot;);
					break;
				}
				catch(err){}
			}
			//identification des faces auxquelles appartient le segment sélectionné
			if(s.substring(0,1)==&quot;s&quot;){ //si on a cliqué sur un segment
				//identification de l&apos;ancienne face
				occ = 0;
				for(i=1; (occ==0)&amp;&amp;(i&lt;nb_faces_creees); i++){ //attention début à 1
					nf = liste_faces_creees[i];
					l = face[nf].arete.length;
					for(j=0; (j&lt;l)&amp;&amp;(face[nf].segment[j]!=s); j++){}
					if(face[nf].segment[j]==s){
						occ = 1;
						nftt++;
						ancf = nf;
						s = face[ancf].arete[j];
						dira = j; //direction absolue dans laquelle on va construire la nvlf
					}
				}
				occ = 0;
				for(i=0; (occ==0)&amp;&amp;(i&lt;38-nb_faces_creees); i++){
					nf = liste_faces_afaire[i];
					l = face[nf].arete.length;
					for(j=0; (j&lt;l)&amp;&amp;(face[nf].arete[j]!=s); j++){}
					if(face[nf].arete[j]==s){
						occ = 1;
						nvlf = nf;
						nfntt++;
						dirn = j; //direction absolue depuis laquelle on vient de ancf
					}
				}
			} else { //si on a cliqué sur une arête
				nftt = nfntt = 0;
				for(i=0; (i&lt;38)&amp;&amp;(nftt+nfntt!=2); i++){
					l = face[i].arete.length;
					for(j=0; (j&lt;l)&amp;&amp;(face[i].arete[j]!=s); j++){}
					if(j!=l){
						if(face[i].etat==1){
							ancf = i;
							nftt++;
							dira = j;
						} else {
							nvlf = i;
							nfntt++;
							dirn = j;
						}
					}
				}
				//si on a cliqué sur une arête dont les deux
				//faces ont déjà été créées
				if(nftt==2){
					SetHide(&quot;Tnftt&quot;, false);
					Pause(500);
					SetHide(&quot;Tnftt&quot;, true);
				}
				//si on a cliqué sur une arête dont les deux
				//faces n&apos;ont pas été créées
				if(nfntt==2){
					SetHide(&quot;Tnfntt&quot;, false);
					Pause(500);
					SetHide(&quot;Tnfntt&quot;, true);
				}
			}
		}

		if(face[nvlf].arete.length==4){
			NouveauCarre(face, ancf, nvlf, dira, dirn);
		} else {
			NouveauTriangle(face, ancf, nvlf, dira, dirn);
		}
		GeranceSegments(face, liste_faces_creees, nb_faces_creees, nvlf);
		liste_faces_creees.push(nvlf);
		//on supprime la face nvlf de la liste des faces à faire
		for(i=0; liste_faces_afaire[i]!=nvlf; i++){}
		liste_faces_afaire.splice(i, 1);
		SetExpressionValue(&quot;rest&quot;, 37-nb_faces_creees);
	}
}
ConstructionPatron();
</Script>
<Script Name="Construction aléatoire du patron" onload="false">
Carre = function(art0, art1, art2, art3){
	this.point = new Array(4);
	var o,z;
	this.arete = new Array(art0, art1, art2, art3);
	this.segment = new Array(4);
	this.etat = 0;
}
	Triangle = function(art0, art1, art2){
		this.point = new Array(3);
		var o,z;//
		this.arete = new Array(art0, art1, art2);
		this.segment = new Array(3);
		this.etat = 0;
	}

	NouveauTriangle = function(face, ancf, nvlf, dira, dirn){
		var l, o, z, qm, q0, q1, q2, q3, poly, i, R, G, B, p;

		o = face[ancf].o;
		z = face[ancf].z;

		l = face[ancf].arete.length
		q0 = face[nvlf].point[dirn] = face[ancf].point[(1+dira)%l];
		q1 = face[nvlf].point[(1+dirn)%3] = face[ancf].point[dira];
		qm = MidPoint(q0, q1);
		if(l==4){	
			q3 = face[nvlf].o = Point(&quot;x(&quot;+qm+&quot;)+h/p*cos(ang1)*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+h*sin(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+qm+&quot;)+h/p*cos(ang1)*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+h*sin(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
		} else {
			q3 = face[nvlf].o = Point(&quot;x(&quot;+qm+&quot;)+cos(ang2)*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+h*sin(ang2)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+qm+&quot;)+cos(ang2)*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+h*sin(ang2)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
		}
		q2=face[nvlf].point[(2+dirn)%3] = Point(&quot;3*x(&quot;+q3+&quot;)-2*x(&quot;+qm+&quot;)&quot;,&quot;3*y(&quot;+q3+&quot;)-2*y(&quot;+qm+&quot;)&quot;);
		if(l==4){
			face[nvlf].z = Point(&quot;x(&quot;+q3+&quot;)-sin(ang1)/p*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+cos(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+q3+&quot;)-sin(ang1)/p*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+cos(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
		} else {
			face[nvlf].z = Point(&quot;x(&quot;+q3+&quot;)-sin(ang2)/h*(x(&quot;+qm+&quot;)-x(&quot;+o+&quot;))+cos(ang2)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;,&quot;y(&quot;+q3+&quot;)-sin(ang2)/h*(y(&quot;+qm+&quot;)-y(&quot;+o+&quot;))+cos(ang2)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
		}
	
		poly = face[nvlf].point[0];
		for(i=1; i&lt;3; i++){
			poly += &quot;,&quot;+face[nvlf].point[i];
		}
		R = Math.floor( 255*Math.random() + 1 );
		G = Math.floor( 255*Math.random() + 1 );
		B = Math.floor( 255*Math.random() + 1 );
		SetRGBColor(p=Polygon(poly), R, G, B);
		SetHide(poly, true); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
		SetHide(face[nvlf].o+&quot;,&quot;+face[nvlf].z+&quot;,&quot;+qm, true);
	}

	NouveauCarre = function(face, ancf, nvlf, dira, dirn){
		var o, z, i, p0, p1, pm, p4, poly, i, p;

		o = face[ancf].o;
		z = face[ancf].z;

		p0 = face[nvlf].point[dirn] = face[ancf].point[(1+dira)%3];
		p1 = face[nvlf].point[(1+dirn)%4] = face[ancf].point[dira];
		pm = MidPoint(p0, p1);
		p4 = face[nvlf].o = Point(&quot;x(&quot;+pm+&quot;)+p/h*cos(ang1)*(x(&quot;+pm+&quot;)-x(&quot;+o+&quot;))+sin(ang1)*p*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;, &quot;y(&quot;+pm+&quot;)+p/h*cos(ang1)*(y(&quot;+pm+&quot;)-y(&quot;+o+&quot;))+sin(ang1)*p*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);	
		face[nvlf].point[(2+dirn)%4] = Point(&quot;x(&quot;+p4+&quot;)+(x(&quot;+p4+&quot;)-x(&quot;+p0+&quot;))&quot;, &quot;y(&quot;+p4+&quot;)+(y(&quot;+p4+&quot;)-y(&quot;+p0+&quot;))&quot;);
		face[nvlf].point[(3+dirn)%4] = Point(&quot;x(&quot;+p4+&quot;)+(x(&quot;+p4+&quot;)-x(&quot;+p1+&quot;))&quot;, 
		&quot;y(&quot;+p4+&quot;)+(y(&quot;+p4+&quot;)-y(&quot;+p1+&quot;))&quot;);
		face[nvlf].z = Point(&quot;x(&quot;+p4+&quot;)-sin(ang1)/h*(x(&quot;+pm+&quot;)-x(&quot;+o+&quot;))+cos(ang1)*(x(&quot;+z+&quot;)-x(&quot;+o+&quot;))&quot;, &quot;y(&quot;+p4+&quot;)-sin(ang1)/h*(y(&quot;+pm+&quot;)-y(&quot;+o+&quot;))+cos(ang1)*(y(&quot;+z+&quot;)-y(&quot;+o+&quot;))&quot;);
	
		poly = face[nvlf].point[0];
		for(i=1; i&lt;4; i++){
			poly += &quot;,&quot;+face[nvlf].point[i];
		}
		SetColor(p=Polygon(poly), &quot;black&quot;);
		SetHide(poly, true); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
		SetHide(face[nvlf].o+&quot;,&quot;+face[nvlf].z+&quot;,&quot;+pm, true);
	}

	GestionListeAretes = function(face, liste_faces_creees, nb_faces_creees, nvlf, liste_aretes_cliquables){
		var i, j, l, f, l_f, k, occ;

		l = face[nvlf].arete.length;
		for(i=0; i&lt;l; i++){
			occ = 0;
			art = face[nvlf].arete[i];
			for(j=0; (occ==0)&amp;&amp;(j&lt;nb_faces_creees); j++){
				f = liste_faces_creees[j];
				l_f = face[f].arete.length;
				for(k=0;(k&lt;l_f)&amp;&amp;(face[f].arete[k]!=art); k++){}
				if(face[f].arete[k]==art){
					occ++;
				} 
			}
			if(occ!=0){
				for(j=0; liste_aretes_cliquables[j]!=face[f].arete[k]; j++){}
				liste_aretes_cliquables.splice(j, 1);
			}
			else {
				liste_aretes_cliquables.push(face[nvlf].arete[i]);
			}
		}
	}

	ConstructionPatron = function(){
		var face, liste_faces_creees, liste_faces_afaire, nb_faces_creees, ancf, nvlf, l, s, err, occ, dira, dirn, p;
		var liste_aretes_cliquables = new Array();

		face = new Array(38);
		face[0] = new Carre(&quot;a000&quot;, &quot;a001&quot;, &quot;a002&quot;, &quot;a003&quot;);
		face[0].point = [&quot;p000&quot;, &quot;p001&quot;, &quot;p002&quot;, &quot;p003&quot;];
		face[0].o = &quot;O&quot;; face[0].z = &quot;Z&quot;;
		face[1] = new Triangle(&quot;a000&quot;, &quot;a100&quot;, &quot;a101&quot;);
		face[2] = new Triangle(&quot;a001&quot;, &quot;a103&quot;, &quot;a104&quot;);
		face[3] = new Triangle(&quot;a002&quot;, &quot;a106&quot;, &quot;a107&quot;);
		face[4] = new Triangle(&quot;a003&quot;, &quot;a109&quot;, &quot;a110&quot;);
		face[5] = new Triangle(&quot;a102&quot;, &quot;a101&quot;, &quot;a200&quot;);
		face[6] = new Triangle(&quot;a103&quot;, &quot;a102&quot;, &quot;a201&quot;);
		face[7] = new Triangle(&quot;a105&quot;, &quot;a104&quot;, &quot;a202&quot;);
		face[8] = new Triangle(&quot;a106&quot;, &quot;a105&quot;, &quot;a203&quot;);
		face[9] = new Triangle(&quot;a108&quot;, &quot;a107&quot;, &quot;a204&quot;);
		face[10] = new Triangle(&quot;a109&quot;, &quot;a108&quot;, &quot;a205&quot;);
		face[11] = new Triangle(&quot;a111&quot;, &quot;a110&quot;, &quot;a206&quot;);
		face[12] = new Triangle(&quot;a100&quot;, &quot;a111&quot;, &quot;a207&quot;);
		face[13] = new Triangle(&quot;a200&quot;, &quot;a300&quot;, &quot;a301&quot;);
		face[14] = new Carre(&quot;a201&quot;, &quot;a302&quot;, &quot;a407&quot;, &quot;a303&quot;);
		face[15] = new Triangle(&quot;a202&quot;, &quot;a303&quot;, &quot;a304&quot;);
		face[16] = new Carre(&quot;a203&quot;, &quot;a305&quot;, &quot;a401&quot;, &quot;a306&quot;);
		face[17] = new Triangle(&quot;a204&quot;, &quot;a306&quot;, &quot;a307&quot;);
		face[18] = new Carre(&quot;a205&quot;, &quot;a308&quot;, &quot;a403&quot;, &quot;a309&quot;);
		face[19] = new Triangle(&quot;a206&quot;, &quot;a309&quot;, &quot;a310&quot;);
		face[20] = new Carre(&quot;a207&quot;, &quot;a311&quot;, &quot;a405&quot;, &quot;a300&quot;);
		face[21] = new Triangle(&quot;a302&quot;, &quot;a301&quot;, &quot;a406&quot;);
		face[22] = new Triangle(&quot;a305&quot;, &quot;a304&quot;, &quot;a400&quot;);
		face[23] = new Triangle(&quot;a308&quot;, &quot;a307&quot;, &quot;a402&quot;);
		face[24] = new Triangle(&quot;a311&quot;, &quot;a310&quot;, &quot;a404&quot;);
		face[25] = new Triangle(&quot;a501&quot;, &quot;a400&quot;, &quot;a500&quot;);
		face[26] = new Triangle(&quot;a503&quot;, &quot;a401&quot;, &quot;a502&quot;);
		face[27] = new Triangle(&quot;a504&quot;, &quot;a402&quot;, &quot;a503&quot;);
		face[28] = new Triangle(&quot;a506&quot;, &quot;a403&quot;, &quot;a505&quot;);
		face[29] = new Triangle(&quot;a507&quot;, &quot;a404&quot;, &quot;a506&quot;);
		face[30] = new Triangle(&quot;a509&quot;, &quot;a405&quot;, &quot;a508&quot;);
		face[31] = new Triangle(&quot;a510&quot;, &quot;a406&quot;, &quot;a509&quot;);
		face[32] = new Triangle(&quot;a500&quot;, &quot;a407&quot;, &quot;a511&quot;);
		face[33] = new Triangle(&quot;a502&quot;, &quot;a501&quot;, &quot;a600&quot;);
		face[34] = new Triangle(&quot;a505&quot;, &quot;a504&quot;, &quot;a601&quot;);
		face[35] = new Triangle(&quot;a508&quot;, &quot;a507&quot;, &quot;a602&quot;);
		face[36] = new Triangle(&quot;a511&quot;, &quot;a510&quot;, &quot;a603&quot;);
		face[37] = new Carre(&quot;a600&quot;, &quot;a603&quot;, &quot;a602&quot;, &quot;a601&quot;);

		liste_faces_creees = new Array();
		liste_faces_afaire = new Array(38);
		for(i=0; i&lt;38; i++){
			liste_faces_afaire[i] = i;
		}

		p=Polygon(&quot;p000,p001,p002,p003&quot;); SetFilled(p,true); SetThickness(p,&quot;thin&quot;);
		for(i=0; i&lt;4; i++){
			liste_aretes_cliquables.push(face[0].arete[i]);
		}
		face[0].etat = 1;
		liste_faces_creees[0] = 0;
		liste_faces_afaire.splice(0,1);	
		SetExpressionValue(&quot;rest&quot;, 37);

		for(nb_faces_creees=1; nb_faces_creees&lt;38; nb_faces_creees++){
			l = liste_aretes_cliquables.length;
			i = Math.floor( l*Math.random() );
			a = liste_aretes_cliquables[i];

			occ = 0;
			for(i=0; (occ==0)&amp;&amp;(i&lt;nb_faces_creees); i++){
				f = liste_faces_creees[i];
				l = face[f].arete.length;
				for(j=0; (j&lt;l)&amp;&amp;(face[f].arete[j]!=a); j++){}
				if(face[f].arete[j]==a){
					occ = 1;
					ancf = f;
					dira = j;
				}
			}
			occ = 0;
			for(i=0; (occ==0)&amp;&amp;(i&lt;38-nb_faces_creees); i++){
				f = liste_faces_afaire[i];
				l = face[f].arete.length;
				for(j=0; (j&lt;l)&amp;&amp;(face[f].arete[j]!=a); j++){}
				if(face[f].arete[j]==a){
					occ = 1;
					nvlf = f;
					dirn = j;
				}
			}

			if(face[nvlf].arete.length==4){
				NouveauCarre(face, ancf, nvlf, dira, dirn);
			} else {
				NouveauTriangle(face, ancf, nvlf, dira, dirn);
			}
			GestionListeAretes(face, liste_faces_creees, nb_faces_creees, nvlf, liste_aretes_cliquables);
			
			liste_faces_creees.push(nvlf);
			for(i=0; liste_faces_afaire[i]!=nvlf; i++){}
			liste_faces_afaire.splice(i, 1);
			SetExpressionValue(&quot;rest&quot;, 37-nb_faces_creees);
		}
	}
	ConstructionPatron();
</Script>
