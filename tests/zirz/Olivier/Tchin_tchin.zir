<?xml version="1.0" encoding="utf-8"?>
<CaR>
<Script Name="jeter le contenu du verre A" mousedrag="e1" onload="false">
SetExpressionValue(&quot;cont1&quot;,0);
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);
jtextA=GetText(&quot;affichage_historique_A&quot;);
jtextA = jtextA + &quot;,&quot; + 0;
SetText(&quot;affichage_historique_A&quot;, jtextA);
</Script>
<Script Name="jeter le contenu du verre B" mousedrag="e2" onload="false">
SetExpressionValue(&quot;cont2&quot;,0);
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);
jtextB=GetText(&quot;affichage_historique_B&quot;);
jtextB = jtextB + &quot;,&quot; + 0;
SetText(&quot;affichage_historique_B&quot;, jtextB);
</Script>
<Script Name="robinet: remplir à raz-bord le verre A" mousedrag="r1" onload="false">
jV1=GetExpressionValue(&quot;V1&quot;);
SetExpressionValue(&quot;cont1&quot;,jV1);
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);
jtextA=GetText(&quot;affichage_historique_A&quot;);
jtextA = jtextA + &quot;,&quot; + &quot;_jV1&quot;;
SetText(&quot;affichage_historique_A&quot;, jtextA);
</Script>
<Script Name="robinet: remplir à raz-bord le verre B" mousedrag="r2" onload="false">
jV2=GetExpressionValue(&quot;V2&quot;);
SetExpressionValue(&quot;cont2&quot;,jV2);
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);
jtextB=GetText(&quot;affichage_historique_B&quot;);
jtextB = jtextB + &quot;,&quot; + &quot;_jV2&quot;;
SetText(&quot;affichage_historique_B&quot;, jtextB);</Script>
<Script Name="verser autant que possible (sans débordement) le contenu du verre A dans le verre B" mousedrag="v12" onload="false">
jV1=GetExpressionValue(&quot;V1&quot;);
jV2=GetExpressionValue(&quot;V2&quot;);
jk1=GetExpressionValue(&quot;k1&quot;);
jk2=GetExpressionValue(&quot;k2&quot;);
total=jk1+jk2;
if (total&lt;=jV2){
	SetExpressionValue(&quot;cont1&quot;,0);
	SetExpressionValue(&quot;cont2&quot;,total);
	jtextA=GetText(&quot;affichage_historique_A&quot;);
	jtextA = jtextA + &quot;,&quot; + 0;
	SetText(&quot;affichage_historique_A&quot;, jtextA);
	jtextB=GetText(&quot;affichage_historique_B&quot;);
	jtextB = jtextB + &quot;,&quot; + total;
	SetText(&quot;affichage_historique_B&quot;, jtextB);

} else {
	reste_dans_A=total-jV2;
	SetExpressionValue(&quot;cont1&quot;,reste_dans_A);
	SetExpressionValue(&quot;cont2&quot;,jV2)
	jtextA=GetText(&quot;affichage_historique_A&quot;);
	jtextA = jtextA + &quot;,&quot; + reste_dans_A;
	SetText(&quot;affichage_historique_A&quot;, jtextA);
	jtextB=GetText(&quot;affichage_historique_B&quot;);
	jtextB = jtextB + &quot;,&quot; + jV2;
	SetText(&quot;affichage_historique_B&quot;, jtextB);
}
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);</Script>
<Script Name="verser autant que possible (sans débordement) le contenur du verre B dans le verre A" mousedrag="v21" onload="false">
jV1=GetExpressionValue(&quot;V1&quot;);
jV2=GetExpressionValue(&quot;V2&quot;);
jk1=GetExpressionValue(&quot;k1&quot;);
jk2=GetExpressionValue(&quot;k2&quot;);
total=jk1+jk2;
if (total&lt;=jV1){
	SetExpressionValue(&quot;cont2&quot;,0);
	SetExpressionValue(&quot;cont1&quot;,total);
	jtextA=GetText(&quot;affichage_historique_A&quot;);
	jtextA = jtextA + &quot;,&quot; + total;
	SetText(&quot;affichage_historique_A&quot;, jtextA);
	jtextB=GetText(&quot;affichage_historique_B&quot;);
	jtextB = jtextB + &quot;,&quot; + 0;
	SetText(&quot;affichage_historique_B&quot;, jtextB);

} else {
	reste_dans_B=total-jV1;
	SetExpressionValue(&quot;cont2&quot;,reste_dans_B);
	SetExpressionValue(&quot;cont1&quot;,jV1)
	jtextA=GetText(&quot;affichage_historique_A&quot;);
	jtextA = jtextA + &quot;,&quot; + jV1;
	SetText(&quot;affichage_historique_A&quot;, jtextA);
	jtextB=GetText(&quot;affichage_historique_B&quot;);
	jtextB = jtextB + &quot;,&quot; + reste_dans_B;
	SetText(&quot;affichage_historique_B&quot;, jtextB);
}
jcompteur=GetExpressionValue(&quot;compteur&quot;)+1;
SetExpressionValue(&quot;compteur&quot;,jcompteur);</Script>
<Script Name="remise à zéro du compteur des actions élémentaires" mousedrag="zero" onload="false">
SetExpressionValue(&quot;compteur&quot;,0)
jk1=GetExpressionValue(&quot;k1&quot;)
jk2=GetExpressionValue(&quot;k2&quot;)
SetText(&quot;affichage_historique_A&quot;,&quot;Historique des doses de A: \n _jk1&quot;);
SetText(&quot;affichage_historique_B&quot;,&quot;Historique des doses de B: \n _jk2&quot;);
</Script>
