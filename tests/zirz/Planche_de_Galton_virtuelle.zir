<?xml version="1.0" encoding="utf-8"?>
<CaR>
<Script Name="1000 billes" mousedrag="a" onload="false">
function UnePartieAdixRebonds(){
	for (i=1; i&lt;=10; i=i+1){
		h=Math.ceil(Math.random()*2);
		if (h==1){
			Move(p,X(p)-1,Y(p)-1);
			
		} else {
			Move(p,X(p)+1,Y(p)-1);
			
		}
		Pause(rythme);
	}
	issue=X(p)/2;
	//	issue correspond à la moitié de la différence algébrique entre le nombre de fois 
	//	où la balle P aura rebondi vers la droite et le nombre de fois où  elle aura rebondi vers la gauche.
	//	Cette moitié de différence peut prendre toutes les valeurs entières comprises entre -5 et 5 si l&apos;on a pris soin d&apos;initialiser x(P) à 0.
	return issue
	
}
p=&quot;P&quot;;
Move(p,0,25);
var tableau=new Array();
for (i=0; i&lt;11; i=i+1){
	tableau[i]=0;
	PenDown(&quot;R&quot;+i,false);
	Move(&quot;R&quot;+i,2*i-10,0);
	SetAlias(&quot;T&quot;+i,0);
}

SetHide(&quot;affichageBille&quot;,true);
nb=1000;
somme=0;
karsomme=0;
var moyenne=0;
var ecarttype=0;
for (j=1; j&lt;=nb; j=j+1){
	rythme=GetExpressionValue(&quot;w&quot;);
	SetExpressionValue(&quot;j&quot;,j);
	SetHide(&quot;affichageBille&quot;,false);
	SetText(&quot;affichageBille&quot;,&quot;$\\mbox{Nombre total de bille(s) tombée(s): _j.$\n$\\mbox{Détails de la répartition au bas des 11 colonnes. &quot;);
	UnePartieAdixRebonds();
	somme=somme+issue;
	karsomme=karsomme+Math.pow(issue,2);
	moyenne=somme/j;
	EXdeux=karsomme/j;
	ecarttype=Math.sqrt(EXdeux-Math.pow(moyenne,2));
	SetText(&quot;texte_moyenne_et_ecarttype&quot;,&quot;$\\mbox{ Moyenne expérimentale: _moyenne ;} $\n $\\mbox{écart-type expérimental:_ecarttype}&quot;);
	SetExpressionValue(&quot;ecarttype&quot;,ecarttype);
	SetExpressionValue(&quot;moyenne&quot;,moyenne);
	rangR=issue+5;
	SetHide(&quot;T&quot;+rangR,false);
	tableau[rangR]=tableau[rangR]+1;
	SetAlias(&quot;T&quot;+rangR,tableau[rangR]);	
	Pause(rythme);
	PenDown(&quot;R&quot;+rangR,true);
	SetHide(&quot;R&quot;+rangR,false);
	rang=rangR+1;
	SetFilled(&quot;poly&quot;+rang,true);
	Move(&quot;R&quot;+rangR,2*issue,tableau[rangR]/20);
	Pause(5*rythme);
	SetFilled(&quot;poly&quot;+rang,false);
	Move(p,0,25);
}
for (i=0; i&lt;11; i=i+1){
	PenDown(&quot;R&quot;+i,false);
}
</Script>
