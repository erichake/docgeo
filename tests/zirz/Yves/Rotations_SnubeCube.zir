<CaR>
<Script Name="Points" mousedrag="" mouseup="" onload="false">
// la solution réelle de x3+x2+x-1=0

x0=0.543689012692;
x1=x0*x0;

function TracePoint(nom,ux,uy,uz){
	vx=ux;
	vy=uy;
	vz=uz;	up=Point(nom,&quot;x(O)+(x(X)-x(O))*_vx+(x(Y)-x(O))*_vy+(x(Z)-x(O))*_vz&quot;,&quot;y(O)+(y(X)-y(O))*_vx+(y(Y)-y(O))*_vy+(y(Z)-y(O))*_vz&quot;);
}

Shownames();
TracePoint(&quot;A1&quot;,1,x0,x1);
TracePoint(&quot;A2&quot;,1,x1,-x0);
TracePoint(&quot;A3&quot;,1,-x0,-x1);
TracePoint(&quot;A4&quot;,1,-x1,x0);
TracePoint(&quot;A5&quot;,-1,x1,x0);
TracePoint(&quot;A6&quot;,-1,x0,-x1);
TracePoint(&quot;A7&quot;,-1,-x1,-x0);
TracePoint(&quot;A8&quot;,-1,-x0,x1);
TracePoint(&quot;B1&quot;,x1,1,x0);
TracePoint(&quot;B2&quot;,x0,1,-x1);
TracePoint(&quot;B3&quot;,-x1,1,-x0);
TracePoint(&quot;B4&quot;,-x0,1,x1);
TracePoint(&quot;B5&quot;,x0,-1,x1);
TracePoint(&quot;B6&quot;,x1,-1,-x0);
TracePoint(&quot;B7&quot;,-x0,-1,-x1);
TracePoint(&quot;B8&quot;,-x1,-1,x0);
TracePoint(&quot;C1&quot;,x0,x1,1);
TracePoint(&quot;C2&quot;,x1,-x0,1);
TracePoint(&quot;C3&quot;,-x0,-x1,1);
TracePoint(&quot;C4&quot;,-x1,x0,1);
TracePoint(&quot;C5&quot;,x1,x0,-1);
TracePoint(&quot;C6&quot;,x0,-x1,-1);
TracePoint(&quot;C7&quot;,-x1,-x0,-1);
TracePoint(&quot;C8&quot;,-x0,x1,-1);
SetShowName(&quot;A1,A2,A3,A4,A5,A6,A7,A8&quot;,true);
SetShowName(&quot;B1,B2,B3,B4,B5,B6,B7,B8&quot;,true);
SetShowName(&quot;C1,C2,C3,C4,C5,C6,C7,C8&quot;,true);
</Script>
<Script Name="Rotation" mousedrag="" mouseup="" onload="false">
x0=0.543689012692;
x1=x0*x0;

nouvx=&quot;(m11*_vx+m12*_vy+m13*_vz)&quot;;
nouvy=&quot;(m21*_vx+m22*_vy+m23*_vz)&quot;;
nouvz=&quot;(m31*_vx+m32*_vy+m33*_vz)&quot;;

function RotatePoint(nom,ux,uy,uz){
	vx=ux;
	vy=uy;
	vz=uz;	up=Point(nom,&quot;x(O)+(x(X)-x(O))*&quot;+nouvx+&quot;+(x(Y)-x(O))*&quot;+nouvy+&quot;+(x(Z)-x(O))*&quot;+nouvz,&quot;y(O)+(y(X)-y(O))*&quot;+nouvx+&quot;+(y(Y)-y(O))*&quot;+nouvy+&quot;+(y(Z)-y(O))*&quot;+nouvz);
}

Shownames();
RotatePoint(&quot;nA1&quot;,1,x0,x1);
RotatePoint(&quot;nA2&quot;,1,x1,-x0);
RotatePoint(&quot;nA3&quot;,1,-x0,-x1);
RotatePoint(&quot;nA4&quot;,1,-x1,x0);
RotatePoint(&quot;nA5&quot;,-1,x1,x0);
RotatePoint(&quot;nA6&quot;,-1,x0,-x1);
RotatePoint(&quot;nA7&quot;,-1,-x1,-x0);
RotatePoint(&quot;nA8&quot;,-1,-x0,x1);
RotatePoint(&quot;nB1&quot;,x1,1,x0);
RotatePoint(&quot;nB2&quot;,x0,1,-x1);
RotatePoint(&quot;nB3&quot;,-x1,1,-x0);
RotatePoint(&quot;nB4&quot;,-x0,1,x1);
RotatePoint(&quot;nB5&quot;,x0,-1,x1);
RotatePoint(&quot;nB6&quot;,x1,-1,-x0);
RotatePoint(&quot;nB7&quot;,-x0,-1,-x1);
RotatePoint(&quot;nB8&quot;,-x1,-1,x0);
RotatePoint(&quot;nC1&quot;,x0,x1,1);
RotatePoint(&quot;nC2&quot;,x1,-x0,1);
RotatePoint(&quot;nC3&quot;,-x0,-x1,1);
RotatePoint(&quot;nC4&quot;,-x1,x0,1);
RotatePoint(&quot;nC5&quot;,x1,x0,-1);
RotatePoint(&quot;nC6&quot;,x0,-x1,-1);
RotatePoint(&quot;nC7&quot;,-x1,-x0,-1);
RotatePoint(&quot;nC8&quot;,-x0,x1,-1);
SetShowName(&quot;nA1,nA2,nA3,nA4,nA5,nA6,nA7,nA8&quot;,true);
SetShowName(&quot;nB1,nB2,nB3,nB4,nB5,nB6,nB7,nB8&quot;,true);
SetShowName(&quot;nC1,nC2,nC3,nC4,nC5,nC6,nC7,nC8&quot;,true);
</Script>
