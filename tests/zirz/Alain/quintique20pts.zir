<?xml version="1.0" encoding="utf-8"?><CaR><Script Name="algebrique" onload="false">function includes(tab,elt){//pour savoir si un point est déjà pris	test=false;	for (i in tab){		if (tab[i]==elt){			test=true;		}	}	return test;}var degre=5;//degré de la courbevar N=(degre+1)*(degre+2)/2-1;//nombre de pointsvar points=new Array();//les noms des pointswhile(points.length&lt;N){	p=InteractiveInput(&quot;point numéro &quot;+(points.length),&quot;Point&quot;);	if (!includes(points,p)){//pour pas prendre 2 fois le même point		points.push(p);	}}coeff=new Array();for(n=0;n&lt;N;n++){	coeff[n]=new Array();}for(n=0;n&lt;N;n++){	k=0;	//colonne du second membre	e=Expression(&quot;Er0n&quot;+n+&quot;k0&quot;,&quot;1&quot;,&quot;windoww&quot;,&quot;windowh&quot;);	SetHide(e,true);	for (i=1;i&lt;=degre;i++){		for(j=0;j&lt;=i;j++){			k++;			e=Expression(&quot;Er0n&quot;+n+&quot;k&quot;+k,&quot;x(&quot;+points[n]+&quot;)^&quot;+(i-j)+&quot;*y(&quot;+points[n]+&quot;)^&quot;+j,&quot;windoww&quot;,&quot;windowh&quot;);			SetHide(e,true);		}	}}//Maintenant on a une matrice N*(N+1);//yapluka triangulariser les N dernières colonnes for(r=1;r&lt;N;r++){ //numéro du passage	for(n=r;n&lt;N;n++){ //ligne		pivot=&quot;-Er&quot;+(r-1)+&quot;n&quot;+n+&quot;k&quot;+r+&quot;/Er&quot;+(r-1)+&quot;n&quot;+(r-1)+&quot;k&quot;+r;		e=Expression(&quot;Er&quot;+r+&quot;n&quot;+n+&quot;k0&quot;,&quot;Er&quot;+(r-1)+&quot;n&quot;+n+&quot;k0&quot;+pivot+&quot;*Er&quot;+(r-1)+&quot;n&quot;+(r-1)+&quot;k0&quot;,&quot;windoww&quot;,&quot;windowh&quot;);		SetHide(e,true);		for(k=r+1;k&lt;=N;k++){ //colonne			e=Expression(&quot;Er&quot;+r+&quot;n&quot;+n+&quot;k&quot;+k,&quot;Er&quot;+(r-1)+&quot;n&quot;+n+&quot;k&quot;+k+pivot+&quot;*Er&quot;+(r-1)+&quot;n&quot;+(r-1)+&quot;k&quot;+k,&quot;windoww&quot;,&quot;windowh&quot;);			SetHide(e,true);		}	}}//Maintenant que c&apos;est triangulaire, on résout e=Expression(&quot;c&quot;+N,&quot;-Er&quot;+(N-1)+&quot;n&quot;+(N-1)+&quot;k0&quot;+&quot;/Er&quot;+(N-1)+&quot;n&quot;+(N-1)+&quot;k&quot;+N,&quot;windoww&quot;,&quot;windowh&quot;);SetHide(e,true);for(n=N-1;n&gt;0;n--){	formule=&quot;(-Er&quot;+(n-1)+&quot;n&quot;+(n-1)+&quot;k0&quot;;	for(k=n;k&lt;N;k++){		formule+=&quot;-c&quot;+(k+1)+&quot;*Er&quot;+(n-1)+&quot;n&quot;+(n-1)+&quot;k&quot;+(k+1);	}	formule+=&quot;)/Er&quot;+(n-1)+&quot;n&quot;+(n-1)+&quot;k&quot;+n;	e=Expression(&quot;c&quot;+n,formule,&quot;windoww&quot;,&quot;windowh&quot;);	SetHide(e,true);}equation=&quot;1&quot;k=0;for (i=1;i&lt;=degre;i++){	for(j=0;j&lt;=i;j++){		k++;		equation+=&quot;+c&quot;+k+&quot;*x^&quot;+(i-j)+&quot;*y^&quot;+j;	}}alg_curve=ImplicitPlot(equation);</Script><Construction><Window x="0.0" y="0.0" w="8.0"/><Windowdim w="1024" h="658"/><Preferences minfontsize="14" minpointsize="3" minlinesize="1" arrowsize="12" selectionsize="12" monkeyspeed="9" gridopacity="13" digits.lengths="5" digits.edit="5" digits.angles="0" colorbackground="245,245,245" colorbackgroundx="139" colorbackgroundy="9" colorbackgroundPal="4" fig3D="false" figDP="false"/><Objects><Point name="P1" n="84" color="2" x="0.4260355029585803" y="3.7869822485207107" shape="circle">Point</Point><Point name="P2" n="85" color="2" x="-2.1680473372781064" y="2.783431952662723" shape="circle">Point</Point><Point name="P3" n="86" color="2" x="-1.7704142011834323" y="-0.018934911242603825" shape="circle">Point</Point><Point name="P4" n="87" color="2" x="1.0319526627218938" y="-0.35976331360946734" shape="circle">Point</Point><Point name="P5" n="88" color="2" x="2.3195266272189343" y="1.7798816568047329" shape="circle">Point</Point><Point name="P6" n="89" color="2" x="0.9183431952662726" y="3.048520710059173" shape="circle">Point</Point><Point name="P7" n="90" color="2" x="-1.1266272189349111" y="3.105325443786982" shape="circle">Point</Point><Point name="P8" n="91" color="2" x="-1.9976331360946746" y="1.5526627218934905" shape="circle">Point<