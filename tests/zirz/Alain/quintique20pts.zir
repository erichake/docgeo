h" value="x(P1)^2*y(P1)^2" prompt="Valeur" fixed="true">Expression &quot;x(P1)^2*y(P1)^2&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k13" n="117" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^1*y(P1)^3" prompt="Valeur" fixed="true">Expression &quot;x(P1)^1*y(P1)^3&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k14" n="118" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^0*y(P1)^4" prompt="Valeur" fixed="true">Expression &quot;x(P1)^0*y(P1)^4&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k15" n="119" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^5*y(P1)^0" prompt="Valeur" fixed="true">Expression &quot;x(P1)^5*y(P1)^0&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k16" n="120" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^4*y(P1)^1" prompt="Valeur" fixed="true">Expression &quot;x(P1)^4*y(P1)^1&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k17" n="121" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^3*y(P1)^2" prompt="Valeur" fixed="true">Expression &quot;x(P1)^3*y(P1)^2&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k18" n="122" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^2*y(P1)^3" prompt="Valeur" fixed="true">Expression &quot;x(P1)^2*y(P1)^3&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k19" n="123" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^1*y(P1)^4" prompt="Valeur" fixed="true">Expression &quot;x(P1)^1*y(P1)^4&quot; à 0.0, 0.0</Expression><Expression name="Er0n0k20" n="124" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P1)^0*y(P1)^5" prompt="Valeur" fixed="true">Expression &quot;x(P1)^0*y(P1)^5&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k0" n="125" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="1" prompt="Valeur" fixed="true">Expression &quot;1&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k1" n="126" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^1*y(P2)^0" prompt="Valeur" fixed="true">Expression &quot;x(P2)^1*y(P2)^0&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k2" n="127" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^0*y(P2)^1" prompt="Valeur" fixed="true">Expression &quot;x(P2)^0*y(P2)^1&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k3" n="128" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^2*y(P2)^0" prompt="Valeur" fixed="true">Expression &quot;x(P2)^2*y(P2)^0&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k4" n="129" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^1*y(P2)^1" prompt="Valeur" fixed="true">Expression &quot;x(P2)^1*y(P2)^1&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k5" n="130" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^0*y(P2)^2" prompt="Valeur" fixed="true">Expression &quot;x(P2)^0*y(P2)^2&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k6" n="131" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^3*y(P2)^0" prompt="Valeur" fixed="true">Expression &quot;x(P2)^3*y(P2)^0&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k7" n="132" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^2*y(P2)^1" prompt="Valeur" fixed="true">Expression &quot;x(P2)^2*y(P2)^1&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k8" n="133" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^1*y(P2)^2" prompt="Valeur" fixed="true">Expression &quot;x(P2)^1*y(P2)^2&quot; à 0.0, 0.0</Expression><Expression name="Er0n1k9" n="134" color="1" hidden="true" showvalue="true" x="windoww" y="windowh" value="x(P2)^0*y(P2)^3" prompt="Valeur" fixed="true">Expression &quot;x(P2)^0*y(P2)^3&quot; à 0.0, 0.0</Expression><Expression n