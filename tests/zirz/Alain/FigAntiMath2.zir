<CaR>
<Macro Name="PourAntiMath" showduplicates="true">
<Parameter name="f2">f2</Parameter>
<Parameter name="M">M</Parameter>
<Objects>
<Point name="M" n="0" mainparameter="true" x="1.5471510076819879" y="1.8126384587043405">Point</Point>
<Function name="f2" n="1" color="4" showname="true" showvalue="true" mainparameter="true" f="0" x="0.0" y="0.0" var="x">f2(x)=0</Function>
<Point name="P5" n="2" color="5" hidden="super" x="x(M)+1" actx="2.547151007681988" y="y(M)+f2(x(M),y(M))" acty="1.8126384587043405" shape="circle" fixed="true">Point</Point>
<Ray name="r1" n="3" color="4" hidden="super" from="M" to="P5">Demi-droite d&apos;origine M vers P5</Ray>
<Circle name="c1" n="4" scolor="153,218,255" hidden="super" fixed="0.61664" midpoint="M" acute="true">Cercle de centre M de rayon 0.61664</Circle>
<Intersection name="P1" n="5" color="5" hidden="super" first="r1" second="c1" shape="circle" which="first">Intersection entre r1 et c1</Intersection>
<Segment name="s1" n="6" color="3" target="true" from="M" to="P1" arrow="true">Segment de M à P1</Segment>
</Objects>
</Macro>
<Script Name="PourAntiMath">
for (i=0; i&lt;10; i=i+1){
	for (j=0; j&lt;10; j=j+1){
		k=10*i+j
		a=Point(&quot;A&quot;+k,-5+i,-5+j);
		ExecuteMacro(&quot;PourAntiMath&quot;,&quot;f2,A&quot;+k);
	}
}





</Script>
