<?xml version="1.0" encoding="utf-8"?>
<CaR>
<Script Name="Monte-Carlo" onload="false">
for(n=0;n&lt;=100;n++){
	a=Point(&quot;A&quot;+n,n,0);
	SetHide(a,true);
	b=Point(&quot;B&quot;+n,n,0);
	SetHide(b,true);
	s=Segment(&quot;s&quot;+n,a,b);
}

//le script ci-dessus peut être fait
//avant pour préparer la figure
for(n=1;n&lt;=400;n++){
	NbSi=0;
	for(k=1;k&lt;=100;k++){
		x=Math.random();
		y=Math.random();
		if (x*x+y*y&lt;1){
			NbSi++;
		}
	}
	Move(&quot;B&quot;+NbSi,NbSi,Y(&quot;B&quot;+NbSi)+1);
}
</Script>
