<?xml version="1.0" encoding="utf-8"?>
<CaR>
<Macro Name="Trct_1_etape" showduplicates="true">
<Parameter name="A0">A0</Parameter>
<Parameter name="B0">B0</Parameter>
<Parameter name="A">A</Parameter>
<Objects>
<Point name="A0" n="0" mainparameter="true" x="0.16712079927338763" y="-0.9591280653950953">Point</Point>
<Point name="B0" n="1" mainparameter="true" x="-1.5476839237057218" y="2.0490463215258847">Point</Point>
<Ray name="r1" n="2" color="5" hidden="super" from="A0" to="B0">Demi-droite d&apos;origine A vers B</Ray>
<Point name="A" n="3" mainparameter="true" x="1.290432295592014" y="-0.9591280653950953">Point</Point>
<Circle3 name="c1" n="4" color="2" hidden="super" from="A0" to="B0" midpoint="A">Arc de cercle de centre A0 de rayon allant de A à B</Circle3>
<Intersection name="P3" n="5" color="1" showname="true" xcoffset="0.6207617079976671" ycoffset="0.4285306781925382" keepclose="true" target="true" first="r1" second="c1" shape="dcross" which="first">Intersection entre r1 et c1</Intersection>
<Ray name="r2" n="6" color="1" target="true" from="A" to="P3">Demi-droite d&apos;origine A0 vers P3</Ray>
</Objects>
</Macro>
<Script Name="Tractrice n étapes" onload="false">
n = Math.pow(2,6);
a0 = InteractiveInput(&quot;Extrémité 1 du segment&quot;,&quot;Point&quot;);
b0 = InteractiveInput(&quot;Extrémité 2 du segment&quot;,&quot;Point&quot;);
a = InteractiveInput(&quot;Point sur le cercle&quot;,&quot;Point&quot;);

q = a0;
t = [b0,&quot;&quot;];
a = Angle(a,&quot;O&quot;,a0); SetHide(a,true); ReflexAngle(a,true);
for(i=1; i&lt;=n; i++){
	r = q;
	l = FixedAngle(r,&quot;O&quot;,&quot;-_a/_n&quot;); SetHide(l,true);
	q = Intersections(l,&quot;C&quot;).split(&quot;,&quot;)[0];
	t = ExecuteMacro(&quot;Trct_1_etape&quot;,&quot;_r,&quot;+t[0]+&quot;,_q&quot;);
	SetPointType(&quot;_q,&quot;+t[0],&quot;point&quot;);
	SetHide(t[1]+&quot;,_q&quot;,true);
}
SetPointType(t[0],&quot;circle&quot;);
</Script>
