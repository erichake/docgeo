<Point name="O" n="19" color="2" showname="true" xcoffset="0.12220111393332722" ycoffset="-0.7576469063866336" keepclose="true" x="4.352933813145711" y="3.6186114132823253" shape="dcross">Point</Point>
<Text name="Text1" n="24" showname="true" showvalue="true" x="-6.620726218067158" y="11.561683818948657">Appliquer le script à $A_0, B_0, A_1$
puis encore une fois à $A_1,..., A_2$</Text>
<Circle name="C" n="22" color="2" fixed="3.78564" midpoint="O" acute="true">Cercle de centre O de rayon 3.78564</Circle>
