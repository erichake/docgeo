<?xml version="1.0" encoding="utf-8"?>
<CaR>
<Script Name="pointA" mousedrag="A" onload="false">
xC=2*X(&quot;O&quot;)-X(&quot;A&quot;);
yC=2*Y(&quot;O&quot;)-Y(&quot;A&quot;);
Move(&quot;C&quot;,xC,yC);

xB=X(&quot;O&quot;)+Y(&quot;O&quot;)-Y(&quot;A&quot;);
yB=Y(&quot;O&quot;)+X(&quot;A&quot;)-X(&quot;O&quot;);
Move(&quot;B&quot;,xB,yB);

xD=X(&quot;C&quot;)+X(&quot;A&quot;)-X(&quot;B&quot;);
yD=Y(&quot;C&quot;)+Y(&quot;A&quot;)-Y(&quot;B&quot;);
Move(&quot;D&quot;,xD,yD);
</Script>
<Script Name="pointB" mousedrag="B" onload="false">
xD=2*X(&quot;O&quot;)-X(&quot;B&quot;);
yD=2*Y(&quot;O&quot;)-Y(&quot;B&quot;);
Move(&quot;D&quot;,xD,yD);

xC=X(&quot;O&quot;)+Y(&quot;O&quot;)-Y(&quot;B&quot;);
yC=Y(&quot;O&quot;)+X(&quot;B&quot;)-X(&quot;O&quot;);
Move(&quot;C&quot;,xC,yC);

xA=X(&quot;D&quot;)+X(&quot;B&quot;)-X(&quot;C&quot;);
yA=Y(&quot;D&quot;)+Y(&quot;B&quot;)-Y(&quot;C&quot;);
Move(&quot;A&quot;,xA,yA);
</Script>
<Script Name="pointC" mousedrag="C" onload="false">
xA=2*X(&quot;O&quot;)-X(&quot;C&quot;);
yA=2*Y(&quot;O&quot;)-Y(&quot;C&quot;);
Move(&quot;A&quot;,xA,yA);

xD=X(&quot;O&quot;)+Y(&quot;O&quot;)-Y(&quot;C&quot;);
yD=Y(&quot;O&quot;)+X(&quot;C&quot;)-X(&quot;O&quot;);
Move(&quot;D&quot;,xD,yD);

xB=X(&quot;A&quot;)+X(&quot;C&quot;)-X(&quot;D&quot;);
yB=Y(&quot;A&quot;)+Y(&quot;C&quot;)-Y(&quot;D&quot;);
Move(&quot;B&quot;,xB,yB);
</Script>
<Script Name="pointD" mousedrag="D" onload="false">
xB=2*X(&quot;O&quot;)-X(&quot;D&quot;);
yB=2*Y(&quot;O&quot;)-Y(&quot;D&quot;);
Move(&quot;B&quot;,xB,yB);

xA=X(&quot;O&quot;)+Y(&quot;O&quot;)-Y(&quot;D&quot;);
yA=Y(&quot;O&quot;)+X(&quot;D&quot;)-X(&quot;O&quot;);
Move(&quot;A&quot;,xA,yA);

xC=X(&quot;B&quot;)+X(&quot;D&quot;)-X(&quot;A&quot;);
yC=Y(&quot;B&quot;)+Y(&quot;D&quot;)-Y(&quot;A&quot;);
Move(&quot;C&quot;,xC,yC);
</Script>
<Script Name="pointO" mousedrag="O" onload="false">
xAC=X(&quot;C&quot;)-X(&quot;A&quot;);
yAC=Y(&quot;C&quot;)-Y(&quot;A&quot;);

Move(&quot;C&quot;,X(&quot;O&quot;)+xAC/2,Y(&quot;O&quot;)+yAC/2);
Move(&quot;A&quot;,X(&quot;O&quot;)-xAC/2,Y(&quot;O&quot;)-yAC/2);

//xBD=X(&quot;D&quot;)-X(&quot;B&quot;);
//yBD=Y(&quot;D&quot;)-Y(&quot;B&quot;);
//
//Move(&quot;D&quot;,X(&quot;O&quot;)+xBD/2,Y(&quot;O&quot;)+yBD/2);
//Move(&quot;B&quot;,X(&quot;O&quot;)-xBD/2,Y(&quot;O&quot;)-yBD/2);

xB=X(&quot;O&quot;)+Y(&quot;O&quot;)-Y(&quot;A&quot;);
yB=Y(&quot;O&quot;)+X(&quot;A&quot;)-X(&quot;O&quot;);
Move(&quot;B&quot;,xB,yB);

xD=X(&quot;C&quot;)+X(&quot;A&quot;)-X(&quot;B&quot;);
yD=Y(&quot;C&quot;)+Y(&quot;A&quot;)-Y(&quot;B&quot;);
Move(&quot;D&quot;,xD,yD);
</Script>
