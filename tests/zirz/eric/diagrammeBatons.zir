<?xml version="1.0" encoding="utf-8"?><CaR><Script Name="points" onload="false">for (i=0; i&lt;=100; i=i+1){	p=Point(&quot;A&quot;+i,i,0);	SetHide(p,true);	q=Point(&quot;B&quot;+i,i,0);	SetHide(q,true);	Segment(p,q);}for(n=0;n&lt;400;n++){	rouges=0;	for(j=0;j&lt;100;j++){		x=Math.random();		y=Math.random();		if(y&lt;x*x){			rouges++;		}	}	p=&quot;B&quot;+rouges;	Move(p,X(p),Y(p)+1);	Pause(10);}</Script><Construction><Window x="25.11411483726571" y="19.163134928447104" w="41.6584284206127" showgrid="true"/><Windowdim w="1024" h="658"/><Preferences minfontsize="16" minpointsize="3" minlinesize="1" arrowsize="15" selectionsize="8" monkeyspeed="22" gridopacity="13" digits.lengths="5" digits.edit="5" digits.angles="0" colorbackground="245,245,245" colorbackgroundx="139" colorbackgroundy="9" colorbackgroundPal="4" fig3D="false" figDP="false"/><Grid color="3" thickness="0"/><Objects><Line name="yAxis" n="1" yaxis="true">Y axis</Line><Line name="xAxis" n="0" xaxis="true">X axis</Line><Function name="f1" n="2" color="1" hidden="true" x="x" y="x*x" var="x" min="0" max="1" d="0" shape="cross" color="1">Fonction ( x , x*x )</Function></Objects></Construction></CaR>